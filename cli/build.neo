; NeoKit's build, ported from compiler/build.py: discover an application's
; pages and API routes, compile its views, bundle browser assets, generate
; generated/{common,render,server,paths,migrate}.neo and build them with the
; native Neo compiler. Each public gen_ function mirrors the Python function
; of the same name; a Python BuildError is Err(message) with the same text,
; and an OSError or CalledProcessError (which neokit prints the same way) is
; Err with Python's str() of it.
;
; The framework root (Python's ROOT) is the explicit `root` argument. The
; entry points the command layer uses:
;   gen_build(root, app, out, target, profile) -> Result<GenBuilt, text>
;   gen_prepare(root) -> Result<cache directory, text>
;   gen_refresh_assets(root, app, out) -> Result<out/assets, text>
;   gen_build_migration(root, app, out) -> Result<migration binary, text>
;   gen_native_build(root, source, target, profile, package_root) -> Result<target, text>
;   gen_compiler_env(root) -> Result<environment list, text>
;   gen_compiler_command(environment) -> argv prefix
; app "" and out "" are build()'s defaults (ROOT/examples/studio and
; ROOT/build/studio); package_root "" is ROOT.
;
; The generated files, manifest.json, out/assets and snapshots/ are byte for
; byte what build.py writes, with the differences cli/PORTING.md documents:
; - gzip variants come from std:deflate (other bytes, same payload), there is
;   no Brotli encoder (brotli_compressed never gives a variant), and
;   responsive images come from libvips (cli/assets.neo).
; - Directories get the modes Python gives them (cli/host.neo).
; - content_type: CONTENT_TYPES first, as in Python. For other suffixes
;   Python asks mimetypes, whose table depends on the machine's
;   /etc/mime.types; here gen_mime_table is that table as Python 3.12 has
;   it on the test box (Ubuntu 24.04, media-types), generated by
;   tests/cli_golden/build/generate.py, and guess_type's suffix and
;   encoding rules (.svgz, .tgz, x.css.gz, the case-sensitive .gz) are
;   followed. Another machine's Python may answer differently.
; - cache_identity hashes the same bases and suffixes as Python, with
;   ROOT/compiler while it exists and ROOT/cli once it is gone.
; - Where Python crashes with TypeError or AttributeError on a malformed
;   config (a non-text loader or handler, an unhashable cache_query element,
;   a [server] table that is not a table in build_migration), this returns
;   the BuildError the surrounding check words. A TOML float is printed with
;   its TOML lexeme where Python would print its repr, and a float redirect
;   status (301.0 equals 301 in Python) is refused.
import "std:json"
import "std:option"
import "std:result"
import "std:io"
import "std:fs"
import "std:process"
import "std:time"
import "std:sha256"
import "text.neo"
import "host.neo"
import "toml.neo"
import "pyjson.neo"
import "templates.neo"
import "routes.neo"
import "assets.neo"
import "actions.neo"

; ---------------------------------------------------------------- results and lists

private fn gen_ok(borrow value:Arr u8 _) -> Result<Arr u8 _,Arr u8 _> = Ok::<Arr u8 _,Arr u8 _>(value)
private fn gen_err(borrow message:Arr u8 _) -> Result<Arr u8 _,Arr u8 _> = Err::<Arr u8 _,Arr u8 _>(message)
private fn gen_done() -> Result<bool,Arr u8 _> = Ok::<bool,Arr u8 _>(true)
private fn gen_fail(borrow message:Arr u8 _) -> Result<bool,Arr u8 _> = Err::<bool,Arr u8 _>(message)
private fn gen_two(borrow a:Arr u8 _, borrow b:Arr u8 _) -> Arr Arr u8 _ _ = push(push(text_words(),a),b)
private fn gen_int_at(borrow values:Arr i64 _, i:i64) -> i64 = if i>=0 && i<len(values) then values[i] else 0
private fn gen_json_at(borrow values:Arr Json _, i:i64) -> Json = if i>=0 && i<len(values) then values[i] else json_none().value
; dict.fromkeys(paths): the paths in order, each Path once.
private fn gen_unique_paths(borrow paths:Arr Arr u8 _ _) -> Arr Arr u8 _ _
  = loop (out=text_words(), i=0) while i<len(paths)
      next (let path=text_word(paths,i) in
            if loop (j=0, found=false) while !found && j<len(out) next (j+1, host_path_equal(text_word(out,j),path)) yield found then out else push(out,path), i+1)
      yield out
; Path(path) in paths.
private fn gen_path_member(borrow paths:Arr Arr u8 _ _, borrow path:Arr u8 _) -> bool
  = loop (i=0, found=false) while !found && i<len(paths) next (i+1, host_path_equal(text_word(paths,i),path)) yield found

; A Python dict with str keys and values (asset bindings, files), in
; insertion order.
private fn gen_pair_at(borrow pairs:Arr MetaPair _, i:i64) -> MetaPair
  = if i>=0 && i<len(pairs) then pairs[i] else MetaPair { key=text_empty(), value=text_empty() }
private fn gen_pair_index(borrow pairs:Arr MetaPair _, borrow key:Arr u8 _) -> i64
  = loop (i:i64{i>=0}=0, found= -1) while found<0 && i<len(pairs) next (i+1, if text_equal(pairs[i].key,key) then i else -1) yield found
private fn gen_pair_put(move pairs:Arr MetaPair _, borrow key:Arr u8 _, borrow value:Arr u8 _) -> Arr MetaPair _
  = let at=gen_pair_index(pairs,key) in
    if at>=0 && at<len(pairs) then set(pairs,at,MetaPair { key=key, value=value }) else push(pairs,MetaPair { key=key, value=value })
private fn gen_pair_value(borrow pairs:Arr MetaPair _, borrow key:Arr u8 _) -> Arr u8 _ = gen_pair_at(pairs,gen_pair_index(pairs,key)).value
private fn gen_tpl_pairs(borrow pairs:Arr MetaPair _) -> Arr TplPair _
  = loop (out=tpl_no_pairs(), i=0) while i<len(pairs) next (push(out,TplPair { key=gen_pair_at(pairs,i).key, value=gen_pair_at(pairs,i).value }), i+1) yield out
private fn gen_keys(borrow pairs:Arr MetaPair _) -> Arr Arr u8 _ _
  = loop (out=text_words(), i=0) while i<len(pairs) next (push(out,gen_pair_at(pairs,i).key), i+1) yield out

; ---------------------------------------------------------------- Python text helpers

; repr() of bytes: b'...' as Python prints it.
fn gen_bytes_repr(borrow data:Arr u8 _) -> Arr u8 _
  = let quote=if text_contains(data,"'") && !text_contains(data,"\"") then 34 else 39 in
    let body=loop (o=push(concat(text_empty(),"b"),u8(quote)), i=0) while i<len(data)
      next (let b=text_byte(data,i) in
            if b==quote || b==92 then push(push(o,u8(92)),u8(b))
            else if b==9 then concat(o,"\\t") else if b==10 then concat(o,"\\n") else if b==13 then concat(o,"\\r")
            else if b>=32 && b<127 then push(o,u8(b)) else concat(o,"\\x",text_hex(b,2)), i+1) yield o in
    push(body,u8(quote))
; repr() of a TOML value as Python sees it (a float prints its TOML lexeme).
fn gen_repr(borrow value:Json) -> Arr u8 _
  = if toml_is_text(value) then text_repr(toml_text(value))
    else if toml_is_bool(value) then (if toml_bool(value) then "True" else "False")
    else if value.kind==3 then (if toml_is_int(value) then text_int(toml_int(value)) else value.raw)
    else if toml_is_array(value) then
      let items=toml_items(value) in
      concat("[",text_join(arr(i in 0..len(items)) gen_repr(gen_json_at(items,i)),", "),"]")
    else if toml_is_table(value) then
      concat("{",text_join(loop (out=text_words(), i=0) while i<toml_size(value) next (push(out,concat(text_repr(toml_key_at(value,i)),": ",gen_repr(toml_value_at(value,i)))), i+1) yield out,", "),"}")
    else "None"
; repr() of config.get(key): None when absent.
private fn gen_repr_get(borrow config:Json, borrow key:Arr u8 _) -> Arr u8 _
  = match toml_get(config,key) { None => "None", Some(value) => gen_repr(value) }
; bool(config.get(key, fallback)).
private fn gen_truthy(borrow config:Json, borrow key:Arr u8 _, fallback:bool) -> bool
  = match toml_get(config,key) { None => fallback, Some(value) => toml_truthy(value) }
; Every byte of text in low..126 (re's [\x20-\x7e] or [\x21-\x7e]).
private fn gen_ascii_range(borrow text:Arr u8 _, low:i64) -> bool
  = loop (i=0, ok=true) while ok && i<len(text) next (i+1, text_byte(text,i)>=low && text_byte(text,i)<=126) yield ok
; f'{value:.0f}' for a duration in nanoseconds shown in milliseconds
; (round half to even).
private fn gen_round_ms(ns:i64) -> i64
  = let whole=ns/1000000 in let rest=ns-whole*1000000 in
    if rest>500000 || (rest==500000 && whole-whole/2*2==1) then whole+1 else whole

; ---------------------------------------------------------------- content types

fn gen_html_type() -> Arr u8 _ = "text/html; charset=utf-8"
private fn gen_immutable() -> Arr u8 _ = "public, max-age=31536000, immutable"
private fn gen_revalidate() -> Arr u8 _ = "public, no-cache"
; CONTENT_TYPES[suffix], or "".
fn gen_known_type(borrow suffix:Arr u8 _) -> Arr u8 _
  = if text_equal(suffix,".js") || text_equal(suffix,".mjs") then "text/javascript; charset=utf-8"
    else if text_equal(suffix,".css") then "text/css; charset=utf-8"
    else if text_equal(suffix,".html") then "text/html; charset=utf-8"
    else if text_equal(suffix,".txt") then "text/plain; charset=utf-8"
    else if text_equal(suffix,".json") || text_equal(suffix,".map") then "application/json; charset=utf-8"
    else if text_equal(suffix,".webmanifest") then "application/manifest+json"
    else if text_equal(suffix,".xml") then "application/xml"
    else if text_equal(suffix,".svg") then "image/svg+xml"
    else if text_equal(suffix,".png") then "image/png"
    else if text_equal(suffix,".jpg") || text_equal(suffix,".jpeg") then "image/jpeg"
    else if text_equal(suffix,".gif") then "image/gif"
    else if text_equal(suffix,".webp") then "image/webp"
    else if text_equal(suffix,".avif") then "image/avif"
    else if text_equal(suffix,".ico") then "image/x-icon"
    else if text_equal(suffix,".woff2") then "font/woff2"
    else if text_equal(suffix,".woff") then "font/woff"
    else if text_equal(suffix,".wasm") then "application/wasm"
    else if text_equal(suffix,".pdf") then "application/pdf" else ""
; mimetypes.types_map[ext] (the strict table) as Python 3.12 has it on the
; test box, Ubuntu 24.04, where /etc/mime.types extends the built-in table;
; "" when not listed. gen_mime_table at the end of this file is generated.
fn gen_mime_type(borrow ext:Arr u8 _) -> Arr u8 _
  = let table=gen_mime_table() in
    let at=if len(ext)==0 then -1 else text_find(table,concat("\x1e",ext,"\x1f"),0) in
    if at<0 then text_empty() else
    let start=at+len(ext)+2 in
    let stop=text_find(table,"\x1e",start) in
    text_slice(table,start,if stop<0 then len(table) else stop)
; posixpath.splitext(path).
type GenSplitext = { base:Arr u8 _, ext:Arr u8 _ }
private fn gen_splitext(borrow path:Arr u8 _) -> GenSplitext
  = let sep=text_rfind(path,"/") in let dot=text_rfind(path,".") in
    if dot<=sep then GenSplitext { base=path, ext=text_empty() } else
    let first=loop (i=sep+1) while i<dot && text_byte(path,i)==46 next (i+1) yield i in
    if first<dot then GenSplitext { base=text_slice(path,0,dot), ext=text_from(path,dot) }
    else GenSplitext { base=path, ext=text_empty() }
private fn gen_suffix_map(borrow ext:Arr u8 _) -> Arr u8 _
  = if text_equal(ext,".svgz") then ".svg.gz"
    else if text_equal(ext,".tgz") || text_equal(ext,".taz") || text_equal(ext,".tz") then ".tar.gz"
    else if text_equal(ext,".tbz2") then ".tar.bz2" else if text_equal(ext,".txz") then ".tar.xz" else ""
private fn gen_encoding(borrow ext:Arr u8 _) -> bool
  = text_equal(ext,".gz") || text_equal(ext,".Z") || text_equal(ext,".bz2") || text_equal(ext,".xz") || text_equal(ext,".br")
; mimetypes.guess_type(url)[0] for a path, or "" for None.
fn gen_guess_type(borrow url:Arr u8 _) -> Arr u8 _
  = let mapped=loop (s=gen_splitext(url)) while len(gen_suffix_map(text_lower_unicode(s.ext)))>0
      next (gen_splitext(concat(s.base,gen_suffix_map(text_lower_unicode(s.ext))))) yield s in
    let plain=if gen_encoding(mapped.ext) then gen_splitext(mapped.base) else mapped in
    gen_mime_type(text_lower_unicode(plain.ext))
; content_type(url).
fn gen_content_type(borrow url:Arr u8 _) -> Arr u8 _
  = let known=gen_known_type(text_lower_unicode(host_suffix(url))) in
    if len(known)>0 then known else
    let guessed=gen_guess_type(url) in
    let kind=if len(guessed)>0 then guessed else "application/octet-stream" in
    if text_starts(kind,"text/") then concat(kind,"; charset=utf-8") else kind

; ---------------------------------------------------------------- the compiler

private effect(fs) fn gen_native_root(borrow path:Arr u8 _) -> bool
  = host_is_file(host_join(path,"bin/neoc")) || host_is_file(host_join(path,".neo-build/bin/neoc"))
; compiler_env(): this process's environment with NEO_HOME and NEO_ROOT set
; to the native Neo toolchain (NEO_HOME, else ROOT/../neo, else the
; directory of the `neo` on PATH) and NEOC removed.
effect(fs,env) fn gen_compiler_env(borrow root:Arr u8 _) -> Result<Arr Arr u8 _ _,Arr u8 _>
  = let sibling=host_join(host_parent(root),"neo") in
    let launcher=host_which("neo") in
    let found=if len(launcher)>0 then host_resolve(launcher) else gen_ok(text_empty()) in
    let candidate=match found { Ok(path) => if len(path)>0 then host_parent(path) else text_empty(), Err(message) => text_empty() } in
    let fallback=if gen_native_root(sibling) then sibling else if len(candidate)>0 && gen_native_root(candidate) then candidate else sibling in
    let configured=env_get("NEO_HOME") in
    let chosen=if configured.present then configured.value else fallback in
    let expanded=host_expanduser(chosen)? in
    let compiler=host_resolve(expanded)? in
    if !gen_native_root(compiler) || !host_is_file(host_join(compiler,"neo"))
    then Err::<Arr Arr u8 _ _,Arr u8 _>(concat("Set NEO_HOME to an installed native Neo toolchain; checked ",compiler)) else
    Ok::<Arr Arr u8 _ _,Arr u8 _>(host_env_remove(host_env_set(host_env_set(env_list(),"NEO_HOME",compiler),"NEO_ROOT",compiler),"NEOC"))
; compiler_command(environment): [NEO_HOME/neo].
fn gen_compiler_command(borrow environment:Arr Arr u8 _ _) -> Arr Arr u8 _ _
  = text_one(host_join(host_env_get(environment,"NEO_HOME").value,"neo"))

; library_cache(): the prepared-library cache directory; enabled is false
; for NEOKIT_LIBRARY_CACHE=off.
type GenCache = { enabled:bool, path:Arr u8 _ }
effect(fs,env) fn gen_library_cache() -> Result<GenCache,Arr u8 _>
  = let value=env_get("NEOKIT_LIBRARY_CACHE") in
    if value.present && text_equal(value.value,"off") then Ok::<GenCache,Arr u8 _>(GenCache { enabled=false, path=text_empty() })
    else if value.present && len(value.value)>0 then
      (let expanded=host_expanduser(value.value)? in let resolved=host_resolve(expanded)? in
       Ok::<GenCache,Arr u8 _>(GenCache { enabled=true, path=resolved }))
    else let home=host_cache_home()? in Ok::<GenCache,Arr u8 _>(GenCache { enabled=true, path=host_join(home,"neokit/native") })

; native_build(source, target, profile=profile, package_root=package_root):
; builds beside the target, then renames it into place, and prints the
; compiler's output. Returns the target path.
effect(fs,env,process,time) fn gen_native_build(borrow root:Arr u8 _, borrow source:Arr u8 _, borrow target:Arr u8 _, borrow profile:Arr u8 _,
    borrow package_root:Arr u8 _) -> Result<Arr u8 _,Arr u8 _>
  = let made=host_mkdirs(host_parent(target))? in
    let base=gen_compiler_env(root)? in
    let env=host_env_setdefault(base,"NEO_INLINE_BUDGET","100") in
    let staged=host_with_name(target,concat(host_name(target),".next"))? in
    let dev=text_equal(profile,"dev") in
    let command=text_concat_words(gen_compiler_command(env),gen_two("build",host_normalize(source))) in
    let options=text_concat_words(command,gen_two("-o",staged)) in
    let optimized=text_concat_words(text_concat_words(options,gen_two("--opt-level",if dev then "0" else "3")),
      gen_two("--package-root",if len(package_root)>0 then host_normalize(package_root) else root)) in
    let flagged=if dev then push(optimized,"--dev") else optimized in
    let cache=gen_library_cache()? in
    let full=if cache.enabled then text_concat_words(text_concat_words(flagged,gen_two("--library-cache",cache.path)),gen_two("--library-root",host_join(root,"src/lib.neo"))) else flagged in
    let run=host_run_with(full,env,root,text_empty()) in
    if !run.ok then gen_err(run.error) else
    let stdout=text_universal_newlines(run.output) in
    if run.code!=0 then
      (let removed=host_remove_file(staged,true)? in gen_err(concat(stdout,"\n",text_universal_newlines(run.errors))))
    else let moved=host_rename(staged,target)? in
      let shown=text_strip(stdout) in
      let printed=if len(shown)>0 then print_out(concat(shown,"\n")) else int_ok(0) in
      gen_ok(host_normalize(target))

; prepare(): checks NeoKit's libraries into the library cache without
; building an application. Returns the cache directory.
effect(fs,env,process,time) fn gen_prepare(borrow root:Arr u8 _) -> Result<Arr u8 _,Arr u8 _>
  = let cache=gen_library_cache()? in
    if !cache.enabled then gen_err("NEOKIT_LIBRARY_CACHE=off disables library preparation") else
    let made=host_mkdir_mode(cache.path,448,true,true)? in
    let folder=host_mkdtemp("prepare-",cache.path)? in
    let built=gen_prepare_in(root,folder) in
    let removed=host_remove_tree(folder) in
    match built {
      Err(message) => gen_err(message),
      Ok(target) => match removed {
        Err(message) => gen_err(message),
        Ok(count) => let printed=print_out(concat("Prepared checked NeoKit libraries: ",cache.path,"\n")) in gen_ok(cache.path)
      }
    }
private effect(fs,env,process,time) fn gen_prepare_in(borrow root:Arr u8 _, borrow folder:Arr u8 _) -> Result<Arr u8 _,Arr u8 _>
  = let source=host_join(folder,"prepare.neo") in
    let written=host_write_text(source,concat("import ",tpl_literal(host_join(root,"src/lib.neo")),"\neffect fn main() -> unit = noop()\n"))? in
    gen_native_build(root,source,host_join(folder,"prepare"),"release",text_empty())

; package_context(app): the nearest directory holding a neo.toml, from the
; resolved app upwards, else ROOT.
effect(fs) fn gen_package_context(borrow root:Arr u8 _, borrow app:Arr u8 _) -> Result<Arr u8 _,Arr u8 _>
  = let path=host_resolve(app)? in
    let candidates=push(text_words(),path) in
    let all=text_concat_words(candidates,host_parents(path)) in
    let found=loop (i=0, found=text_empty()) while len(found)==0 && i<len(all)
      next (i+1, if host_is_file(host_join(text_word(all,i),"neo.toml")) then text_word(all,i) else text_empty()) yield found in
    gen_ok(if len(found)>0 then found else root)

; cache_identity(app): a hash of the toolchain and every source a build can
; depend on, so cached pages from another build are never served.
type GenDigest = { stream:Sha256Stream, err:Arr u8 _ }
private effect(fs) fn gen_digest_executables(move d:GenDigest, borrow directory:Arr u8 _) -> GenDigest
  = let found=host_glob(directory,"neoc*") in
    loop (s=d, i=0) while len(s.err)==0 && i<len(found)
      next (let path=text_word(found,i) in
            if !host_is_file(path) then s else
            match host_read_bytes(path) { Ok(data) => s with { stream=sha256_stream_add(s.stream,data) }, Err(message) => s with { err=message } }, i+1) yield s
private fn gen_hashed_suffix(borrow suffix:Arr u8 _) -> bool
  = text_equal(suffix,".neo") || text_equal(suffix,".ax") || text_equal(suffix,".view") || text_equal(suffix,".toml")
    || text_equal(suffix,".lock") || text_equal(suffix,".py")
private effect(fs) fn gen_digest_file(move d:GenDigest, borrow base:Arr u8 _, borrow directory:Arr u8 _, borrow name:Arr u8 _) -> GenDigest
  = let path=host_join(directory,name) in
    if !gen_hashed_suffix(host_suffix(path)) then d else
    let relative=match host_relative_to(path,base) { Ok(text) => text, Err(message) => text_empty() } in
    match host_read_bytes(path) {
      Err(message) => d with { err=message },
      Ok(data) => d with { stream=sha256_stream_add(sha256_stream_add(sha256_stream_add(d.stream,host_normalize(base)),relative),data) }
    }
private effect(fs) fn gen_digest_base(move d:GenDigest, borrow base:Arr u8 _) -> GenDigest
  = let skip=push(push(push(push(push(push(push(text_words(),"node_modules"),".git"),"__pycache__"),".neo-build"),"build"),".next"),".neokit") in
    let walked=host_walk(host_normalize(base),skip,false) in
    loop (s=d, i:i64{i>=0}=0) while len(s.err)==0 && i<len(walked)
      next (loop (t=s, j=0) while len(t.err)==0 && j<len(walked[i].names) next (gen_digest_file(t,base,walked[i].path,text_word(walked[i].names,j)), j+1) yield t, i+1)
      yield s
effect(fs,env) fn gen_cache_identity(borrow root:Arr u8 _, borrow app:Arr u8 _) -> Result<Arr u8 _,Arr u8 _>
  = let env=gen_compiler_env(root)? in
    let compiler=host_env_get(env,"NEO_HOME").value in
    let package=gen_package_context(root,app)? in
    let python=host_join(root,"compiler") in
    let tooling=if host_is_dir(python) then python else host_join(root,"cli") in
    let bases=gen_unique_paths(push(push(push(push(push(push(text_words(),package),app),host_join(root,"src")),tooling),host_join(compiler,"stdlib")),host_join(compiler,"runtime"))) in
    let start=GenDigest { stream=sha256_stream_start(), err=text_empty() } in
    let tools=gen_digest_executables(gen_digest_executables(start,host_join(compiler,"bin")),host_join(compiler,".neo-build/bin")) in
    let all=loop (s=tools, i=0) while len(s.err)==0 && i<len(bases) next (gen_digest_base(s,text_word(bases,i)), i+1) yield s in
    if len(all.err)>0 then gen_err(all.err) else gen_ok(text_slice(host_hex(sha256_stream_finish(all.stream)),0,16))

; ---------------------------------------------------------------- discover

type GenRoute = { path:Arr u8 _, key:Arr u8 _, config:Json, template:TplTemplate, source:Arr u8 _, config_path:Arr u8 _,
  paths:Arr Arr u8 _ _, dynamic:bool, guard:Arr u8 _, paths_fn:Arr u8 _, loader:Arr u8 _, mode:Arr u8 _,
  client:bool, exported:bool, is_async:bool, async_timeout:i64, ttl:i64, stale:i64, tag:Arr u8 _,
  has_query:bool, query:Arr Arr u8 _ _, control:Arr u8 _ }
private fn gen_blank_template() -> TplTemplate = TplTemplate { name=text_empty(), props=tpl_no_pairs(), body=text_empty(), path=text_empty(), types=tpl_no_types() }
private fn gen_blank_route() -> GenRoute
  = GenRoute { path=text_empty(), key=text_empty(), config=json_none().value, template=gen_blank_template(), source=text_empty(), config_path=text_empty(),
      paths=text_words(), dynamic=false, guard=text_empty(), paths_fn=text_empty(), loader=text_empty(), mode=text_empty(),
      client=false, exported=false, is_async=false, async_timeout=0, ttl=0, stale=0, tag=text_empty(),
      has_query=false, query=text_words(), control=text_empty() }
private fn gen_no_routes() -> Arr GenRoute _ = arr(i in 0..0) gen_blank_route()
private fn gen_route_at(borrow routes:Arr GenRoute _, i:i64) -> GenRoute = if i>=0 && i<len(routes) then routes[i] else gen_blank_route()

private effect(fs) fn gen_load_toml(borrow path:Arr u8 _) -> Result<Json,Arr u8 _>
  = let text=host_read_text(path)? in toml_load(path,text)
private fn gen_reserved(borrow url:Arr u8 _) -> bool
  = text_equal(url,"/_web") || text_equal(url,"/_neokit") || text_starts(url,"/_web/") || text_starts(url,"/_neokit/")
; optional_name(config, key, path): "" for None.
private fn gen_optional_name(borrow config:Json, borrow key:Arr u8 _, borrow path:Arr u8 _) -> Result<Arr u8 _,Arr u8 _>
  = let found=toml_get_text(config,key,"") in
    if !found.present then gen_ok(text_empty())
    else if !found.ok || !tpl_name(found.value) then gen_err(concat(path,": ",key," must name a Neo function"))
    else gen_ok(found.value)

type GenPageConfig = { loader:Arr u8 _, mode:Arr u8 _, client:bool, exported:bool, is_async:bool, async_timeout:i64,
  ttl:i64, stale:i64, tag:Arr u8 _, has_query:bool, query:Arr Arr u8 _ _, control:Arr u8 _, guard:Arr u8 _, paths_fn:Arr u8 _ }
type GenQuery = { present:bool, names:Arr Arr u8 _ _ }
private fn gen_query_name(borrow name:Arr u8 _) -> bool = len(name)>=1 && len(name)<=64 && text_only(name,"A-Za-z0-9_.-")
private fn gen_query_names(borrow names:Arr Arr u8 _ _) -> bool
  = loop (i=0, ok=true) while ok && i<len(names) next (i+1, gen_query_name(text_word(names,i))) yield ok
private fn gen_cache_query(borrow config:Json, borrow at:Arr u8 _, ttl:i64) -> Result<GenQuery,Arr u8 _>
  = if !toml_has(config,"cache_query") then Ok::<GenQuery,Arr u8 _>(GenQuery { present=false, names=text_words() })
    else if ttl==0 then Err::<GenQuery,Arr u8 _>(concat(at,"cache_query requires cache_ttl")) else
    let texts=toml_get_texts(config,"cache_query") in
    if !texts.ok || len(texts.values)>16 || !text_distinct(texts.values) || !gen_query_names(texts.values)
    then Err::<GenQuery,Arr u8 _>(concat(at,"cache_query must list up to 16 distinct query parameter names"))
    else Ok::<GenQuery,Arr u8 _>(GenQuery { present=true, names=texts.values })
private fn gen_page_err(borrow message:Arr u8 _) -> Result<GenPageConfig,Arr u8 _> = Err::<GenPageConfig,Arr u8 _>(message)
; discover()'s checks of one page.toml, in Python's order.
private fn gen_page_config(borrow config:Json, borrow config_path:Arr u8 _, borrow route:Arr u8 _) -> Result<GenPageConfig,Arr u8 _>
  = let at=concat(config_path,": ") in
    let loader=toml_get_text(config,"loader","") in
    if !loader.ok || !tpl_name(loader.value) then gen_page_err(concat(at,"loader must name a Neo function")) else
    let mode=toml_get_text(config,"mode","ssr") in
    if !mode.ok || !(text_equal(mode.value,"ssr") || text_equal(mode.value,"static")) then gen_page_err(concat(at,"mode must be ssr or static")) else
    let client=toml_get_bool(config,"client",false) in
    if !client.ok then gen_page_err(concat(at,"client must be a boolean")) else
    let exported=toml_get_bool(config,"export",true) in
    if !exported.ok then gen_page_err(concat(at,"export must be a boolean")) else
    let is_async=toml_get_bool(config,"async",false) in
    if !is_async.ok then gen_page_err(concat(at,"async must be a boolean")) else
    let timeout=toml_get_int(config,"async_timeout_ms",10000) in
    if !timeout.ok || timeout.value<1 || timeout.value>120000 then gen_page_err(concat(at,"async_timeout_ms must be 1..120000")) else
    let is_static=text_equal(mode.value,"static") in
    if is_async.value && is_static then gen_page_err("async pages require mode=ssr") else
    let ttl=toml_get_int(config,"cache_ttl",0) in
    if !ttl.ok || ttl.value<0 || ttl.value>86400 then gen_page_err(concat(at,"cache_ttl must be 0..86400 seconds")) else
    let stale=toml_get_int(config,"stale_ttl",0) in
    if !stale.ok || stale.value<0 || stale.value>86400 || (stale.value!=0 && ttl.value==0) then gen_page_err("stale_ttl must be 0..86400 and requires cache_ttl") else
    let tag=toml_get_text(config,"cache_tag",route) in
    if !tag.ok then gen_page_err(concat(at,"cache_tag must be text")) else
    let query=gen_cache_query(config,at,ttl.value)? in
    let control=toml_get_text(config,"cache_control","") in
    if control.present && (!control.ok || len(control.value)<1 || len(control.value)>200 || !gen_ascii_range(control.value,32))
    then gen_page_err(concat(at,"cache_control must be one header value"))
    else if control.present && (ttl.value!=0 || is_static) then gen_page_err(concat(at,"cache_control is for uncached SSR pages; cache_ttl and static pages set their own")) else
    let guard=gen_optional_name(config,"guard",config_path)? in
    if len(guard)>0 && is_static then gen_page_err(concat(at,"static pages are prerendered and cannot run a guard"))
    else if len(guard)>0 && exported.present && exported.value then gen_page_err(concat(at,"guarded pages cannot be exported")) else
    let paths_fn=gen_optional_name(config,"paths_fn",config_path)? in
    Ok::<GenPageConfig,Arr u8 _>(GenPageConfig { loader=loader.value, mode=mode.value, client=client.value,
      exported=if len(guard)>0 then false else exported.value, is_async=is_async.value, async_timeout=timeout.value,
      ttl=ttl.value, stale=stale.value, tag=tag.value, has_query=query.present, query=query.names, control=control.value,
      guard=guard, paths_fn=paths_fn })
private fn gen_path_problem(borrow config_path:Arr u8 _, borrow route:Arr u8 _, borrow path:Arr u8 _) -> Arr u8 _
  = if !route_canonical_path(path) then concat(config_path,": export paths must be canonical URL paths")
    else if !route_matches(route,path) then concat(config_path,": path ",text_repr(path)," does not match ",route) else text_empty()
private fn gen_page_paths(borrow config:Json, borrow config_path:Arr u8 _, borrow route:Arr u8 _, dynamic:bool) -> Result<Arr Arr u8 _ _,Arr u8 _>
  = let given=toml_get_texts(config,"paths") in
    if !given.ok then Err::<Arr Arr u8 _ _,Arr u8 _>(concat(config_path,": paths must be a list of URL strings")) else
    let paths=if given.present then given.values else if dynamic then text_words() else text_one(route) in
    let bad=loop (i=0, bad=text_empty()) while len(bad)==0 && i<len(paths) next (i+1, gen_path_problem(config_path,route,text_word(paths,i))) yield bad in
    if len(bad)>0 then Err::<Arr Arr u8 _ _,Arr u8 _>(bad) else Ok::<Arr Arr u8 _ _,Arr u8 _>(paths)
private fn gen_route_err(borrow message:Arr u8 _) -> Result<GenRoute,Arr u8 _> = Err::<GenRoute,Arr u8 _>(message)
; One app/**/page.toml as discover() reads it.
private effect(fs) fn gen_page(borrow app:Arr u8 _, borrow config_path:Arr u8 _) -> Result<GenRoute,Arr u8 _>
  = let config=gen_load_toml(config_path)? in
    let folder=host_parent(config_path) in
    let route=route_path(folder,host_join(app,"app"))? in
    if gen_reserved(route) then gen_route_err("The /_web/ and /_neokit/ namespaces are reserved") else
    let key=concat("Page_",text_slice(host_sha256_hex(route),0,10)) in
    let page=gen_page_config(config,config_path,route)? in
    let view=host_join(folder,"page.view") in
    let source=host_read_text(view)? in
    let template=tpl_parse(key,source,view)? in
    if !text_equal(tpl_get(template.props,"title"),"text") then gen_route_err(concat(config_path,": pages require a title: text prop")) else
    let dynamic=text_contains(route,"[") in
    if len(page.paths_fn)>0 && !dynamic then gen_route_err(concat(config_path,": paths_fn is for dynamic routes")) else
    let paths=gen_page_paths(config,config_path,route,dynamic)? in
    if text_equal(page.mode,"static") && dynamic && len(paths)==0 && len(page.paths_fn)==0
    then gen_route_err(concat(config_path,": static dynamic routes need paths or paths_fn")) else
    let props=meta_metadata_props(config)? in
    Ok::<GenRoute,Arr u8 _>(GenRoute { path=route, key=key, config=config, template=template, source=host_join(folder,"page.neo"),
      config_path=host_normalize(config_path), paths=paths, dynamic=dynamic, guard=page.guard, paths_fn=page.paths_fn,
      loader=page.loader, mode=page.mode, client=page.client, exported=page.exported, is_async=page.is_async,
      async_timeout=page.async_timeout, ttl=page.ttl, stale=page.stale, tag=page.tag, has_query=page.has_query,
      query=page.query, control=page.control })
type GenRoutes = { routes:Arr GenRoute _, err:Arr u8 _, failed:bool }
private fn gen_route_paths(borrow routes:Arr GenRoute _) -> Arr Arr u8 _ _
  = arr(i in 0..len(routes)) gen_route_at(routes,i).path
; discover(app): the pages of app (resolved), in precedence order.
effect(fs) fn gen_discover(borrow app:Arr u8 _) -> Result<Arr GenRoute _,Arr u8 _>
  = let configs=host_rglob(host_join(app,"app"),"page.toml") in
    let s=loop (s=GenRoutes { routes=gen_no_routes(), err=text_empty(), failed=false }, i=0) while !s.failed && i<len(configs)
      next (match gen_page(app,text_word(configs,i)) {
              Ok(route) => s with { routes=push(s.routes,route) },
              Err(message) => GenRoutes { routes=gen_no_routes(), err=message, failed=true } }, i+1) yield s in
    if s.failed then Err::<Arr GenRoute _,Arr u8 _>(s.err)
    else if len(s.routes)==0 then Err::<Arr GenRoute _,Arr u8 _>("No app/**/page.toml routes found") else
    let order=route_precedence_order(gen_route_paths(s.routes)) in
    let sorted=arr(i in 0..len(order)) gen_route_at(s.routes,gen_int_at(order,i)) in
    let shapes=arr(i in 0..len(sorted)) route_shape(gen_route_at(sorted,i).path) in
    if !text_distinct(shapes) then Err::<Arr GenRoute _,Arr u8 _>("Two pages resolve to the same route (check (group) folders and parameter names)")
    else Ok::<Arr GenRoute _,Arr u8 _>(sorted)
; The paths a sitemap lists: every path of every route with export=true.
private fn gen_exported_paths(borrow routes:Arr GenRoute _) -> Arr Arr u8 _ _
  = loop (out=text_words(), i=0) while i<len(routes)
      next (let route=gen_route_at(routes,i) in if route.exported then text_concat_words(out,route.paths) else out, i+1) yield out

; ---------------------------------------------------------------- paths_fn

private fn gen_paths_code(borrow root:Arr u8 _, borrow routes:Arr GenRoute _, borrow listed:Arr i64 _) -> Arr u8 _
  = let sources=gen_unique_paths(arr(i in 0..len(listed)) gen_route_at(routes,gen_int_at(listed,i)).source) in
    let imports=loop (out=text_one(concat("import ",tpl_literal(host_join(root,"src/lib.neo")))), i=0) while i<len(sources)
      next (push(out,concat("import ",tpl_literal(text_word(sources,i)))), i+1) yield out in
    let lines=push(imports,"fn neokit_lines(paths:Arr Arr u8 _ n) -> Arr u8 _ = str_concat_parts(arr(i in 0..n) check i>=0 && i<n in concat(paths[i],\"\\n\"))") in
    let calls=loop (out=text_empty(), i=0) while i<len(listed)
      next (concat(out,"let w",text_int(i),"=print_out(concat(\"#\\n\",neokit_lines(",gen_route_at(routes,gen_int_at(listed,i)).paths_fn,"()))) in "), i+1) yield out in
    concat(text_join(push(lines,concat("effect fn main() -> unit = ",calls,"noop()")),"\n"),"\n")
type GenGroup = { paths:Arr Arr u8 _ _, err:Arr u8 _ }
private fn gen_group_step(move g:GenGroup, borrow route:GenRoute, borrow path:Arr u8 _) -> GenGroup
  = if !route_canonical_path(path) || !route_matches(route.path,path)
    then g with { err=concat(host_join(host_parent(route.source),"page.toml"),": paths_fn returned ",text_repr(path),", which does not match ",route.path) }
    else if text_member(g.paths,path) then g else g with { paths=push(g.paths,path) }
; One route's paths after its paths_fn group (one path per line).
private fn gen_listed_paths(borrow route:GenRoute, borrow group:Arr u8 _) -> Result<Arr Arr u8 _ _,Arr u8 _>
  = let lines=text_splitlines(group) in
    let g=loop (g=GenGroup { paths=route.paths, err=text_empty() }, j=0) while len(g.err)==0 && j<len(lines)
      next (gen_group_step(g,route,text_word(lines,j)), j+1) yield g in
    if len(g.err)>0 then Err::<Arr Arr u8 _ _,Arr u8 _>(g.err)
    else if len(g.paths)>100000 then Err::<Arr Arr u8 _ _,Arr u8 _>(concat(route.path,": more than 100,000 static paths"))
    else Ok::<Arr Arr u8 _ _,Arr u8 _>(g.paths)
private fn gen_set_paths(move routes:Arr GenRoute _, k:i64, borrow paths:Arr Arr u8 _ _) -> Arr GenRoute _
  = if k>=0 && k<len(routes) then set(routes,k,gen_route_at(routes,k) with { paths=paths }) else routes
type GenMerge = { routes:Arr GenRoute _, err:Arr u8 _ }
private fn gen_merge_group(move m:GenMerge, k:i64, borrow group:Arr u8 _) -> GenMerge
  = match gen_listed_paths(gen_route_at(m.routes,k),group) {
      Ok(paths) => GenMerge { routes=gen_set_paths(m.routes,k,paths), err=text_empty() },
      Err(message) => GenMerge { routes=gen_no_routes(), err=message } }
; resolve_paths(routes, out, profile, package_root): builds and runs
; generated/paths.neo once to list the pages of every paths_fn route.
effect(fs,env,process,time) fn gen_resolve_paths(borrow root:Arr u8 _, borrow routes:Arr GenRoute _, borrow out:Arr u8 _, borrow profile:Arr u8 _,
    borrow package_root:Arr u8 _) -> Result<Arr GenRoute _,Arr u8 _>
  = let listed=loop (o=arr(i in 0..0) 0, i=0) while i<len(routes) next (if len(gen_route_at(routes,i).paths_fn)>0 then push(o,i) else o, i+1) yield o in
    if len(listed)==0 then Ok::<Arr GenRoute _,Arr u8 _>(routes) else
    let source=host_join(out,"generated/paths.neo") in
    let written=host_write_text(source,gen_paths_code(root,routes,listed))? in
    let binary=host_join(out,"paths") in
    let built=gen_native_build(root,source,binary,profile,package_root)? in
    let run=host_run(text_one(binary)) in
    if !run.ok then Err::<Arr GenRoute _,Arr u8 _>(run.error)
    else if run.code!=0 then Err::<Arr GenRoute _,Arr u8 _>(concat("paths_fn failed:\n",host_decode_replace(run.errors))) else
    let invalid=host_utf8_error(run.output) in
    if len(invalid)>0 then Err::<Arr GenRoute _,Arr u8 _>(invalid) else
    let groups=text_split(run.output,"#\n") in
    if len(groups)-1!=len(listed) then Err::<Arr GenRoute _,Arr u8 _>("paths_fn produced unexpected output") else
    let merged=loop (m=GenMerge { routes=routes, err=text_empty() }, j=0) while len(m.err)==0 && j<len(listed)
      next (gen_merge_group(m,gen_int_at(listed,j),text_word(groups,j+1)), j+1) yield m in
    if len(merged.err)>0 then Err::<Arr GenRoute _,Arr u8 _>(merged.err) else Ok::<Arr GenRoute _,Arr u8 _>(merged.routes)

; ---------------------------------------------------------------- browser assets

private fn gen_css_name(borrow name:Arr u8 _) -> bool
  = len(name)>4 && text_ends(name,".css") && text_only(text_slice(name,0,len(name)-4),"a-zA-Z0-9_-")
private fn gen_css_names(borrow names:Arr Arr u8 _ _) -> bool
  = loop (i=0, ok=true) while ok && i<len(names) next (i+1, gen_css_name(text_word(names,i))) yield ok
; css_inputs(app): the [css] tailwind inputs of web.toml.
effect(fs) fn gen_css_inputs(borrow app:Arr u8 _) -> Result<Arr Arr u8 _ _,Arr u8 _>
  = let config=gen_load_toml(host_join(app,"web.toml"))? in
    let css=toml_get_table(config,"css") in
    if !css.ok then Err::<Arr Arr u8 _ _,Arr u8 _>("web.toml [css] must be a table") else
    let inputs=toml_get_texts(css.value,"tailwind") in
    if !inputs.ok || !gen_css_names(inputs.values) then Err::<Arr Arr u8 _ _,Arr u8 _>("[css] tailwind must list CSS filenames from styles/, e.g. [\"site.css\"]")
    else if !text_distinct(inputs.values) then Err::<Arr Arr u8 _ _,Arr u8 _>("[css] tailwind contains duplicate filenames") else
    let styles=host_join(app,"styles") in
    let missing=loop (i=0, missing=text_empty()) while len(missing)==0 && i<len(inputs.values)
      next (i+1, let path=host_join(styles,text_word(inputs.values,i)) in if host_is_file(path) then text_empty() else path) yield missing in
    if len(missing)>0 then Err::<Arr Arr u8 _ _,Arr u8 _>(concat("Missing Tailwind input: ",missing)) else Ok::<Arr Arr u8 _ _,Arr u8 _>(inputs.values)

type GenTailwind = { entry:Arr u8 _, version:Arr u8 _ }
private effect(fs) fn gen_tailwind(borrow root:Arr u8 _, borrow app:Arr u8 _) -> Result<GenTailwind,Arr u8 _>
  = let local=host_join(app,"node_modules/@tailwindcss/cli/package.json") in
    let shared=host_join(root,"node_modules/@tailwindcss/cli/package.json") in
    let package=if host_is_file(local) then local else if host_is_file(shared) then shared else text_empty() in
    if len(package)==0 then Err::<GenTailwind,Arr u8 _>("Tailwind is enabled: run bun install in the NeoKit project, or bun add --dev --exact tailwindcss @tailwindcss/cli in your app") else
    let text=host_read_text(package)? in
    let parsed=json_parse(text) in
    let bin=json_get(parsed.value,"bin") in
    let tool=json_get(bin.value,"tailwindcss") in
    let version=json_get(parsed.value,"version") in
    if !parsed.ok then Err::<GenTailwind,Arr u8 _>(concat(package,": ",parsed.error.message))
    else if !bin.present then Err::<GenTailwind,Arr u8 _>("'bin'")
    else if !tool.present then Err::<GenTailwind,Arr u8 _>("'tailwindcss'")
    else if !version.present then Err::<GenTailwind,Arr u8 _>("'version'") else
    Ok::<GenTailwind,Arr u8 _>(GenTailwind { entry=host_join(host_parent(package),json_text(tool.value).value),
      version=if version.value.kind==4 then json_text(version.value).value else version.value.raw })
; compile_css(app, source, directory): runs the installed Tailwind CLI on one
; stylesheet and prints its version, the file, the size and the time.
effect(fs,env,process,time) fn gen_compile_css(borrow root:Arr u8 _, borrow app:Arr u8 _, borrow source:Arr u8 _, borrow directory:Arr u8 _) -> Result<Arr u8 _,Arr u8 _>
  = let tailwind=gen_tailwind(root,app)? in
    let start=monotonic_ns() in
    let temporary=host_mkdtemp(".tailwind-",directory)? in
    let output=host_join(temporary,"output.css") in
    let argv=push(push(push(push(push(push(push(push(push(push(text_words(),"bun"),tailwind.entry),"--input"),host_normalize(source)),"--output"),output),"--cwd"),app),"--minify"),"--silent") in
    let run=host_run_with(argv,env_list(),app,text_empty()) in
    let content=if run.ok && run.code==0 then host_read_bytes(output) else gen_ok(text_empty()) in
    let removed=host_remove_tree(temporary) in
    if !run.ok then gen_err(run.error)
    else if run.code!=0 then gen_err(concat("Tailwind failed for ",host_normalize(source),":\n",text_universal_newlines(run.output),text_universal_newlines(run.errors))) else
    match content {
      Err(message) => gen_err(message),
      Ok(data) => match removed {
        Err(message) => gen_err(message),
        Ok(count) =>
          let finish=monotonic_ns() in
          let printed=print_out(concat("Tailwind ",tailwind.version,": ",host_name(source),", ",text_int(len(data))," bytes, ",
            text_int(gen_round_ms(finish.value-start.value)),"ms\n")) in
          gen_ok(data)
      }
    }
; client_entry(app): app/client/index.{ts,tsx,js,jsx}, else ROOT/client/index.js.
effect(fs) fn gen_client_entry(borrow root:Arr u8 _, borrow app:Arr u8 _) -> Arr u8 _
  = let folder=host_join(app,"client") in
    if host_is_file(host_join(folder,"index.ts")) then host_join(folder,"index.ts")
    else if host_is_file(host_join(folder,"index.tsx")) then host_join(folder,"index.tsx")
    else if host_is_file(host_join(folder,"index.js")) then host_join(folder,"index.js")
    else if host_is_file(host_join(folder,"index.jsx")) then host_join(folder,"index.jsx")
    else host_join(root,"client/index.js")
private effect(fs) fn gen_remove_existing(borrow path:Arr u8 _) -> Result<i64,Arr u8 _>
  = if host_exists(path) then host_remove_tree(path) else Ok::<i64,Arr u8 _>(0)
private effect(fs) fn gen_move_existing(borrow path:Arr u8 _, borrow target:Arr u8 _) -> Result<i64,Arr u8 _>
  = if host_exists(path) then host_rename(path,target) else Ok::<i64,Arr u8 _>(0)
type GenBundle = { assets:Arr MetaPair _, files:Arr MetaPair _ }
private effect(fs,env,process,time) fn gen_bundle_client(borrow entry:Arr u8 _, borrow staging:Arr u8 _, dev:bool) -> Result<Arr MetaPair _,Arr u8 _>
  = if !host_is_file(entry) then Ok::<Arr MetaPair _,Arr u8 _>(meta_no_pairs()) else
    let argv=push(push(push(push(push(push(push(push(push(push(push(text_words(),"bun"),"build"),entry),"--target=browser"),"--format=esm"),"--splitting"),
      "--reject-unresolved"),concat("--entry-naming=",if dev then "client.js" else "client-[hash].js")),"--chunk-naming=chunk-[hash].js"),
      concat("--outdir=",staging)),if dev then "--sourcemap=linked" else "--minify") in
    let run=host_run_inherit(argv,env_list(),text_empty()) in
    if !run.ok then Err::<Arr MetaPair _,Arr u8 _>(run.error)
    else if run.code!=0 then Err::<Arr MetaPair _,Arr u8 _>(host_process_error(argv,run)) else
    let entries=host_glob(staging,if dev then "client.js" else "client-*.js") in
    if len(entries)!=1 then Err::<Arr MetaPair _,Arr u8 _>("Expected one browser client entry") else
    let name=host_name(text_word(entries,0)) in
    let written=host_write_text(host_join(staging,"neokit-client.js"),concat("import ",pj_quote(concat("./",name)),";\n"))? in
    Ok::<Arr MetaPair _,Arr u8 _>(push(meta_no_pairs(),MetaPair { key="client.js", value=concat("/_web/",name) }))
private effect(fs,env,process,time) fn gen_style_content(borrow root:Arr u8 _, borrow app:Arr u8 _, borrow file:Arr u8 _, borrow staging:Arr u8 _,
    borrow tailwind:Arr Arr u8 _ _) -> Result<Arr u8 _,Arr u8 _>
  = if text_member(tailwind,host_name(file)) then gen_compile_css(root,app,file,staging) else host_read_bytes(file)
type GenStyles = { assets:Arr MetaPair _, err:Arr u8 _ }
private effect(fs,env,process,time) fn gen_style(move s:GenStyles, borrow root:Arr u8 _, borrow app:Arr u8 _, borrow file:Arr u8 _, borrow staging:Arr u8 _,
    borrow tailwind:Arr Arr u8 _ _, dev:bool) -> GenStyles
  = match gen_style_content(root,app,file,staging,tailwind) {
      Err(message) => GenStyles { assets=meta_no_pairs(), err=message },
      Ok(content) =>
        let name=if dev then host_name(file) else concat(host_stem(file),"-",text_slice(host_sha256_hex(content),0,12),".css") in
        match host_write_bytes(host_join(staging,name),content) {
          Err(message) => GenStyles { assets=meta_no_pairs(), err=message },
          Ok(count) => GenStyles { assets=gen_pair_put(s.assets,host_name(file),concat("/_web/",name)), err=text_empty() }
        }
    }
private effect(fs,process) fn gen_dev_files(borrow root:Arr u8 _, borrow staging:Arr u8 _, dev:bool) -> Result<i64,Arr u8 _>
  = if !dev then Ok::<i64,Arr u8 _>(0) else
    let script=host_read_bytes(host_join(root,"client/dev.js"))? in
    let a=host_write_bytes(host_join(staging,"neokit-dev.js"),script)? in
    host_write_text(host_join(staging,"neokit-dev.css"),"#neokit-dev-error{position:fixed;inset:1rem;z-index:2147483647;overflow:auto;padding:2rem;background:#211522;color:#fff;border:2px solid #ef7c8e;white-space:pre-wrap;font:14px/1.6 ui-monospace,monospace}")
type GenFiles = { files:Arr MetaPair _, err:Arr u8 _ }
private effect(fs) fn gen_asset_file(move s:GenFiles, borrow directory:Arr u8 _, borrow path:Arr u8 _) -> GenFiles
  = if !host_is_file(path) then s else
    match host_read_bytes(path) {
      Err(message) => GenFiles { files=meta_no_pairs(), err=message },
      Ok(data) => let relative=match host_relative_to(path,directory) { Ok(text) => text, Err(message) => text_empty() } in
        GenFiles { files=gen_pair_put(s.files,concat("/_web/",relative),data), err=text_empty() }
    }
private effect(fs) fn gen_public_file(move s:GenFiles, borrow public:Arr u8 _, borrow path:Arr u8 _) -> GenFiles
  = if host_is_symlink(path) then GenFiles { files=meta_no_pairs(), err="Public symlinks are not supported" }
    else if !host_is_file(path) then s else
    let url=concat("/",match host_relative_to(path,public) { Ok(text) => text, Err(message) => text_empty() }) in
    if text_starts(url,"/_web/") || text_starts(url,"/_neokit/") then GenFiles { files=meta_no_pairs(), err="The /_web/ and /_neokit/ namespaces are reserved" } else
    match host_read_bytes(path) {
      Err(message) => GenFiles { files=meta_no_pairs(), err=message },
      Ok(data) => GenFiles { files=gen_pair_put(s.files,url,data), err=text_empty() }
    }
; bundle_assets(app, out, profile): bundles the browser client and the
; stylesheets into out/assets (swapped in whole) and returns the asset
; bindings and the files the server embeds (assets, then public/).
effect(fs,env,process,time) fn gen_bundle_assets(borrow root:Arr u8 _, borrow app:Arr u8 _, borrow out:Arr u8 _, borrow profile:Arr u8 _) -> Result<GenBundle,Arr u8 _>
  = let dev=text_equal(profile,"dev") in
    let staging=host_join(out,".assets-next") in
    let cleared=gen_remove_existing(staging)? in
    let made=host_mkdir(staging,true,false)? in
    let tailwind=gen_css_inputs(app)? in
    let entry=gen_client_entry(root,app) in
    let client=gen_bundle_client(entry,staging,dev)? in
    let styles=host_glob(host_join(app,"styles"),"*.css") in
    let css=loop (s=GenStyles { assets=client, err=text_empty() }, i=0) while len(s.err)==0 && i<len(styles)
      next (gen_style(s,root,app,text_word(styles,i),staging,tailwind,dev), i+1) yield s in
    if len(css.err)>0 then Err::<GenBundle,Arr u8 _>(css.err) else
    let extras=gen_dev_files(root,staging,dev)? in
    let directory=host_join(out,"assets") in
    let previous=host_join(out,".assets-previous") in
    let p1=gen_remove_existing(previous)? in
    let p2=gen_move_existing(directory,previous)? in
    let p3=host_rename(staging,directory)? in
    let p4=gen_remove_existing(previous)? in
    let found=host_rglob(directory,"*") in
    let assets=loop (s=GenFiles { files=meta_no_pairs(), err=text_empty() }, i=0) while len(s.err)==0 && i<len(found)
      next (gen_asset_file(s,directory,text_word(found,i)), i+1) yield s in
    if len(assets.err)>0 then Err::<GenBundle,Arr u8 _>(assets.err) else
    let public=host_join(app,"public") in
    let listed=if host_exists(public) then host_rglob(public,"*") else text_words() in
    let all=loop (s=assets, i=0) while len(s.err)==0 && i<len(listed)
      next (gen_public_file(s,public,text_word(listed,i)), i+1) yield s in
    if len(all.err)>0 then Err::<GenBundle,Arr u8 _>(all.err) else Ok::<GenBundle,Arr u8 _>(GenBundle { assets=css.assets, files=all.files })
; public_urls(app): the URL of every file in app/public.
effect(fs) fn gen_public_urls(borrow app:Arr u8 _) -> Arr Arr u8 _ _
  = let public=host_join(app,"public") in
    let found=if host_exists(public) then host_rglob(public,"*") else text_words() in
    loop (out=text_words(), i=0) while i<len(found)
      next (let path=text_word(found,i) in
            if host_is_file(path) then push(out,concat("/",match host_relative_to(path,public) { Ok(text) => text, Err(message) => text_empty() })) else out, i+1) yield out
; Writes the /_web/ files among pairs into out/assets, as development
; builds serve them from disk.
private effect(fs,process) fn gen_write_web_files(borrow out:Arr u8 _, borrow pairs:Arr MetaPair _) -> Result<i64,Arr u8 _>
  = let s=loop (err=text_empty(), i=0) while len(err)==0 && i<len(pairs)
      next (let pair=gen_pair_at(pairs,i) in
            if !text_starts(pair.key,"/_web/") then err else
            let destination=host_join(host_join(out,"assets"),text_from(pair.key,6)) in
            match host_mkdirs(host_parent(destination)) {
              Err(message) => message,
              Ok(count) => match host_write_bytes(destination,pair.value) { Err(message) => message, Ok(written) => text_empty() } }, i+1) yield err in
    if len(s)>0 then Err::<i64,Arr u8 _>(s) else Ok::<i64,Arr u8 _>(0)
; refresh_assets(app, out): development rebundling of the browser modules
; and stylesheets without rebuilding the server. Returns out/assets.
effect(fs,env,process,time) fn gen_refresh_assets(borrow root:Arr u8 _, borrow app_arg:Arr u8 _, borrow out_arg:Arr u8 _) -> Result<Arr u8 _,Arr u8 _>
  = let app=host_resolve(app_arg)? in let out=host_resolve(out_arg)? in
    let valid=gen_validate_output(root,app,out)? in
    let bundle=gen_bundle_assets(root,app,out,"dev")? in
    let config=gen_load_toml(host_join(app,"web.toml"))? in
    let routes=gen_discover(app)? in
    let extra=meta_generated_assets(app,config,gen_exported_paths(routes),host_join(out,".image-cache"))? in
    let written=gen_write_web_files(out,extra.files)? in
    gen_ok(host_join(out,"assets"))

; ---------------------------------------------------------------- output directory

; validate_output(app, out): out must not be or contain a source directory
; and must be empty or an earlier NeoKit build.
effect(fs) fn gen_validate_output(borrow root:Arr u8 _, borrow app:Arr u8 _, borrow out:Arr u8 _) -> Result<bool,Arr u8 _>
  = if host_path_equal(out,app) || gen_path_member(host_parents(app),out) || host_path_equal(out,root) || gen_path_member(host_parents(root),out)
    then gen_fail("Build output must not replace source directories") else
    let fixed=push(push(push(push(text_words(),host_join(root,"src")),host_join(root,"compiler")),host_join(root,"client")),host_join(root,"tests")) in
    let sources=if host_path_equal(out,host_join(app,".neokit/build")) then fixed else push(fixed,app) in
    let parents=host_parents(out) in
    let inside=loop (i=0, found=false) while !found && i<len(sources)
      next (i+1, host_path_equal(text_word(sources,i),out) || gen_path_member(parents,text_word(sources,i))) yield found in
    if inside then gen_fail("Build output must be outside source directories")
    else if !host_exists(out) then gen_done() else
    let names=host_listdir(out)? in
    if len(names)>0 && !host_is_file(host_join(out,".neokit-build")) then gen_fail("Build output must be empty or an existing NeoKit build") else gen_done()

; ---------------------------------------------------------------- web.toml

type GenRealtime = { channels:i64, history:i64, payload:i64 }
private fn gen_bounded(borrow options:Json, borrow name:Arr u8 _, fallback:i64, minimum:i64, maximum:i64) -> Result<i64,Arr u8 _>
  = let value=toml_get_int(options,name,fallback) in
    if !value.ok || value.value<minimum || value.value>maximum
    then Err::<i64,Arr u8 _>(concat("[realtime] ",name," must be an integer from ",text_int(minimum)," to ",text_int(maximum)))
    else Ok::<i64,Arr u8 _>(value.value)
; realtime_options(config): [realtime] channels, history, max_event_bytes.
fn gen_realtime_options(borrow config:Json) -> Result<GenRealtime,Arr u8 _>
  = let options=toml_get_table(config,"realtime") in
    if !options.ok then Err::<GenRealtime,Arr u8 _>("[realtime] must be a table") else
    let channels=gen_bounded(options.value,"channels",16,1,64)? in
    let history=gen_bounded(options.value,"history",128,1,1024)? in
    let payload=gen_bounded(options.value,"max_event_bytes",4096,64,8192)? in
    if 64+channels*(128+history*(80+payload))>67108864 then Err::<GenRealtime,Arr u8 _>("[realtime] shared event storage exceeds 64 MiB")
    else Ok::<GenRealtime,Arr u8 _>(GenRealtime { channels=channels, history=history, payload=payload })

type GenRedirect = { source:Arr u8 _, target:Arr u8 _, status:i64, query:bool, absolute:bool }
private fn gen_no_redirects() -> Arr GenRedirect _ = arr(i in 0..0) GenRedirect { source=text_empty(), target=text_empty(), status=0, query=false, absolute=false }
private fn gen_redirect_at(borrow rules:Arr GenRedirect _, i:i64) -> GenRedirect
  = if i>=0 && i<len(rules) then rules[i] else GenRedirect { source=text_empty(), target=text_empty(), status=0, query=false, absolute=false }
; set(table) <= allowed.
private fn gen_only_keys(borrow table:Json, borrow allowed:Arr Arr u8 _ _) -> bool
  = loop (i=0, ok=true) while ok && i<toml_size(table) next (i+1, text_member(allowed,toml_key_at(table,i))) yield ok
private fn gen_host_char(b:i64) -> bool = (b>=65 && b<=90) || (b>=97 && b<=122) || (b>=48 && b<=57) || b==46 || b==45
; Where https?://[A-Za-z0-9.-]+(?::\d{1,5})? can end so that the rest is
; empty or starts with "/" (\d is any Unicode decimal digit, as in Python),
; or -1.
private fn gen_origin_end(borrow text:Arr u8 _) -> i64
  = let scheme=if text_starts(text,"https://") then 8 else if text_starts(text,"http://") then 7 else -1 in
    if scheme<0 then -1 else
    let host=loop (i=scheme) while i<len(text) && gen_host_char(text_byte(text,i)) next (i+1) yield i in
    if host==scheme then -1
    else if text_byte(text,host)!=58 then (if host==len(text) || text_byte(text,host)==47 then host else -1) else
    let digits=loop (i=host+1, n=0) while n<5 && i<len(text) && text_is_decimal(text_code_at(text,i)) next (i+text_char_width(text,i), n+1) yield i in
    if digits==host+1 then -1 else if digits==len(text) || text_byte(text,digits)==47 then digits else -1
; re.fullmatch(r'https?://[A-Za-z0-9.-]+(?::\d{1,5})?', origin).
fn gen_origin(borrow origin:Arr u8 _) -> bool = let end=gen_origin_end(origin) in end>=0 && end==len(origin)
; The absolute redirect target pattern: an origin, then nothing or "/" and
; printable ASCII.
fn gen_absolute_url(borrow target:Arr u8 _) -> bool
  = let end=gen_origin_end(target) in end>=0 && gen_ascii_range(text_from(target,end),33)
; The relative redirect target pattern: "/" not followed by "/", printable
; ASCII, no backslash.
fn gen_relative_url(borrow target:Arr u8 _) -> bool
  = text_starts(target,"/") && text_byte(target,1)!=47 && gen_ascii_range(target,33) && !text_contains(target,"\\")
private fn gen_redirect_status(value:i64) -> bool = value==301 || value==302 || value==303 || value==307 || value==308
private fn gen_rule(borrow rule:Json) -> Result<GenRedirect,Arr u8 _>
  = if !toml_is_table(rule) || !gen_only_keys(rule,push(push(push(push(text_words(),"from"),"to"),"status"),"query"))
    then Err::<GenRedirect,Arr u8 _>("Each [[redirects]] entry takes from, to, status and query") else
    let source=toml_get_text(rule,"from","") in
    if !source.present || !source.ok || !route_canonical_path(source.value) || text_contains(source.value,"[")
    then Err::<GenRedirect,Arr u8 _>(concat("Redirect from must be a canonical literal path: ",gen_repr_get(rule,"from"))) else
    let target=toml_get_text(rule,"to","") in
    let absolute=target.present && target.ok && gen_absolute_url(target.value) in
    let relative=target.present && target.ok && gen_relative_url(target.value) in
    if !(absolute || relative) || text_contains(target.value,"\"")
    then Err::<GenRedirect,Arr u8 _>(concat("Redirect to must be a path or an http(s) URL without spaces: ",gen_repr_get(rule,"to"))) else
    let status=toml_get_int(rule,"status",308) in
    let query=toml_get_bool(rule,"query",true) in
    if !status.ok || !gen_redirect_status(status.value) || !query.ok
    then Err::<GenRedirect,Arr u8 _>("Redirect status must be one of (301, 302, 303, 307, 308); query must be a boolean")
    else Ok::<GenRedirect,Arr u8 _>(GenRedirect { source=source.value, target=target.value, status=status.value, query=query.value, absolute=absolute })
type GenRules = { rules:Arr GenRedirect _, err:Arr u8 _ }
private fn gen_rule_step(move s:GenRules, borrow rule:Json) -> GenRules
  = match gen_rule(rule) { Ok(checked) => s with { rules=push(s.rules,checked) }, Err(message) => GenRules { rules=gen_no_redirects(), err=message } }
; redirect_rules(config): the checked [[redirects]] entries.
fn gen_redirect_rules(borrow config:Json) -> Result<Arr GenRedirect _,Arr u8 _>
  = match toml_get(config,"redirects") {
      None => Ok::<Arr GenRedirect _,Arr u8 _>(gen_no_redirects()),
      Some(rules) =>
        if !toml_is_array(rules) then Err::<Arr GenRedirect _,Arr u8 _>("[[redirects]] must be an array of tables") else
        let items=toml_items(rules) in
        let s=loop (s=GenRules { rules=gen_no_redirects(), err=text_empty() }, i=0) while len(s.err)==0 && i<len(items)
          next (gen_rule_step(s,gen_json_at(items,i)), i+1) yield s in
        if len(s.err)>0 then Err::<Arr GenRedirect _,Arr u8 _>(s.err)
        else if !text_distinct(arr(i in 0..len(s.rules)) gen_redirect_at(s.rules,i).source) then Err::<Arr GenRedirect _,Arr u8 _>("Duplicate redirect source")
        else Ok::<Arr GenRedirect _,Arr u8 _>(s.rules)
    }
; redirect_response(rule).
fn gen_redirect_response(borrow rule:GenRedirect) -> Arr u8 _
  = let target=tpl_literal(rule.target) in
    let location=if rule.query
      then concat("concat(",target,",if len(request.query)>0 then concat(",tpl_literal(if text_contains(rule.target,"?") then "&" else "?"),",request.query) else \"\")")
      else target in
    if rule.absolute then gen_header(concat("web_status(web_reply(200,\"\",\"text/plain; charset=utf-8\"),",text_int(rule.status),")"),"Location",location)
    else concat("web_redirect(",location,",",text_int(rule.status),")")

type GenSite = { config:Json, realtime:GenRealtime, access_log:bool, timing:bool, grace:i64, has_csp:bool, csp:Arr u8 _,
  before:Arr u8 _, after:Arr u8 _, startup:Arr u8 _, redirects:Arr GenRedirect _ }
private fn gen_hook(borrow server:Json, borrow name:Arr u8 _) -> Result<Arr u8 _,Arr u8 _>
  = let found=toml_get_text(server,name,"") in
    if found.present && (!found.ok || !tpl_name(found.value)) then gen_err(concat("[server] ",name," must name a Neo function")) else gen_ok(found.value)
; build()'s checks of web.toml before it discovers routes.
fn gen_site(borrow config:Json, dev:bool) -> Result<GenSite,Arr u8 _>
  = let realtime=gen_realtime_options(config)? in
    let server=toml_get_table(config,"server") in
    if !server.ok then Err::<GenSite,Arr u8 _>("[server] must be a table") else
    let access_log=toml_get_bool(server.value,"access_log",false) in
    if !access_log.ok then Err::<GenSite,Arr u8 _>("access_log must be a boolean") else
    let timing=toml_get_bool(server.value,"timing",false) in
    if !timing.ok then Err::<GenSite,Arr u8 _>("timing must be a boolean") else
    let grace=toml_get_int(server.value,"shutdown_grace_ms",30000) in
    if !grace.ok || grace.value<1 || grace.value>120000 then Err::<GenSite,Arr u8 _>("shutdown_grace_ms must be an integer from 1 to 120000") else
    let security=toml_get_table(config,"security") in
    if !security.ok || !gen_only_keys(security.value,text_one("csp")) then Err::<GenSite,Arr u8 _>("[security] supports only csp") else
    let csp=toml_get_text(security.value,"csp","") in
    if csp.present && (!csp.ok || len(csp.value)<1 || len(csp.value)>4096 || !gen_ascii_range(csp.value,32))
    then Err::<GenSite,Arr u8 _>("[security] csp must be a Content-Security-Policy value of up to 4096 printable ASCII characters") else
    let before=gen_hook(server.value,"before")? in
    let after=gen_hook(server.value,"after")? in
    let startup=gen_hook(server.value,"startup")? in
    let redirects=gen_redirect_rules(config)? in
    Ok::<GenSite,Arr u8 _>(GenSite { config=config, realtime=realtime, access_log=access_log.value, timing=timing.value,
      grace=if dev && grace.value>1000 then 1000 else grace.value, has_csp=csp.present, csp=csp.value,
      before=before, after=after, startup=startup, redirects=redirects })

; ---------------------------------------------------------------- views

type GenLayout = { folder:Arr u8 _, template:TplTemplate }
type GenViews = { components:Arr TplTemplate _, layout:TplTemplate, layouts:Arr GenLayout _ }
private fn gen_layout_at(borrow layouts:Arr GenLayout _, i:i64) -> GenLayout
  = if i>=0 && i<len(layouts) then layouts[i] else GenLayout { folder=text_empty(), template=gen_blank_template() }
private fn gen_layout_index(borrow layouts:Arr GenLayout _, borrow folder:Arr u8 _) -> i64
  = loop (i=0, found= -1) while found<0 && i<len(layouts) next (i+1, if host_path_equal(gen_layout_at(layouts,i).folder,folder) then i else -1) yield found
private fn gen_template_at(borrow templates:Arr TplTemplate _, i:i64) -> TplTemplate
  = if i>=0 && i<len(templates) then templates[i] else gen_blank_template()
private fn gen_props_has(borrow props:Arr TplPair _, borrow key:Arr u8 _, borrow kind:Arr u8 _) -> bool
  = tpl_has(props,key) && text_equal(tpl_get(props,key),kind)
; a == b for two props dicts (order does not matter).
private fn gen_same_props(borrow a:Arr TplPair _, borrow b:Arr TplPair _) -> bool
  = len(a)==len(b) && loop (i:i64{i>=0}=0, ok=true) while ok && i<len(a) next (i+1, gen_props_has(b,a[i].key,a[i].value)) yield ok
private fn gen_layout_props(borrow props:Arr TplPair _) -> bool
  = gen_props_has(props,"title","text") && gen_props_has(props,"content","html") && gen_props_has(props,"client","bool") && gen_props_has(props,"mode","text")
    && (len(props)==4 || (len(props)==5 && gen_props_has(props,"head","html")))
; Development layouts load the browser reload script and the error overlay.
fn gen_dev_layout(borrow source:Arr u8 _) -> Arr u8 _
  = let parts=text_rpartition(source,"</body>") in
    let scripted=if len(parts.before)>0 then concat(parts.before,"<script type=\"module\" src=\"/_web/neokit-dev.js\"></script></body>",parts.after) else source in
    text_replace_first(scripted,"</head>","<link rel=\"stylesheet\" href=\"/_web/neokit-dev.css\"></head>")
type GenParsed = { templates:Arr TplTemplate _, err:Arr u8 _ }
private effect(fs) fn gen_parse_component(move s:GenParsed, borrow path:Arr u8 _) -> GenParsed
  = match host_read_text(path) {
      Err(message) => GenParsed { templates=tpl_no_templates(), err=message },
      Ok(source) => match tpl_parse(host_stem(path),source,path) {
        Err(message) => GenParsed { templates=tpl_no_templates(), err=message },
        Ok(template) => s with { templates=push(s.templates,template) } } }
private fn gen_component_name(borrow name:Arr u8 _) -> bool = tpl_name(name) && !text_starts(name,"Page_") && !text_equal(name,"Layout")
type GenNested = { layouts:Arr GenLayout _, err:Arr u8 _ }
private effect(fs) fn gen_nested_layout(move s:GenNested, borrow app:Arr u8 _, borrow root_props:Arr TplPair _, borrow path:Arr u8 _) -> GenNested
  = if host_path_equal(host_parent(path),host_join(app,"app")) then s else
    let relative=match host_relative_to(path,app) { Ok(text) => text, Err(message) => text_empty() } in
    match host_read_text(path) {
      Err(message) => GenNested { layouts=s.layouts, err=message },
      Ok(source) => match tpl_parse(concat("Layout_",text_slice(host_sha256_hex(relative),0,10)),source,path) {
        Err(message) => GenNested { layouts=s.layouts, err=message },
        Ok(nested) => if !gen_same_props(nested.props,root_props) then GenNested { layouts=s.layouts, err=concat(path,": nested layouts use the root layout props") }
          else s with { layouts=push(s.layouts,GenLayout { folder=host_parent(path), template=nested }) } } }
; build()'s components (app/components/*.view), the root layout (with the
; development script and stylesheet in dev) and the nested layouts.
effect(fs) fn gen_views(borrow app:Arr u8 _, dev:bool) -> Result<GenViews,Arr u8 _>
  = let files=host_glob(host_join(app,"components"),"*.view") in
    let parsed=loop (s=GenParsed { templates=tpl_no_templates(), err=text_empty() }, i=0) while len(s.err)==0 && i<len(files)
      next (gen_parse_component(s,text_word(files,i)), i+1) yield s in
    if len(parsed.err)>0 then Err::<GenViews,Arr u8 _>(parsed.err) else
    let bad=loop (i=0, bad=false) while !bad && i<len(parsed.templates) next (i+1, !gen_component_name(gen_template_at(parsed.templates,i).name)) yield bad in
    if bad then Err::<GenViews,Arr u8 _>("Invalid or reserved component name") else
    let layout_path=host_join(app,"app/layout.view") in
    let source=host_read_text(layout_path)? in
    let layout=tpl_parse("Layout",if dev then gen_dev_layout(source) else source,layout_path)? in
    if !gen_layout_props(layout.props) then Err::<GenViews,Arr u8 _>("layout.view props must be title:text, content:html, client:bool, mode:text and optionally head:html") else
    let found=host_rglob(host_join(app,"app"),"layout.view") in
    let start=push(arr(i in 0..0) GenLayout { folder=text_empty(), template=gen_blank_template() },GenLayout { folder=host_join(app,"app"), template=layout }) in
    let nested=loop (s=GenNested { layouts=start, err=text_empty() }, i=0) while len(s.err)==0 && i<len(found)
      next (gen_nested_layout(s,app,layout.props,text_word(found,i)), i+1) yield s in
    if len(nested.err)>0 then Err::<GenViews,Arr u8 _>(nested.err)
    else Ok::<GenViews,Arr u8 _>(GenViews { components=parsed.templates, layout=layout, layouts=nested.layouts })

; ---------------------------------------------------------------- generated code helpers

private fn gen_route_condition(borrow path:Arr u8 _) -> Arr u8 _
  = if text_contains(path,"[") then concat("web_route_match(",tpl_literal(path),",request.path)") else concat("str_equal(request.path,",tpl_literal(path),")")
private fn gen_route_request(borrow path:Arr u8 _, borrow expression:Arr u8 _) -> Arr u8 _
  = if text_contains(path,"[") then concat("web_routed(",expression,",",tpl_literal(path),")") else expression
; allowed_method(allowed).
fn gen_allowed_method(borrow allowed:Arr Arr u8 _ _) -> Arr u8 _
  = concat("(",text_join(arr(i in 0..len(allowed)) concat("str_equal(request.method,",tpl_literal(text_word(allowed,i)),")")," || "),")")
private fn gen_get_head() -> Arr u8 _ = gen_allowed_method(gen_two("GET","HEAD"))
; header(response, name, value).
fn gen_header(borrow response:Arr u8 _, borrow name:Arr u8 _, borrow value:Arr u8 _) -> Arr u8 _
  = concat("web_with_header(",response,",",tpl_literal(name),",",value,")")
private fn gen_reply(borrow body:Arr u8 _, borrow ctype:Arr u8 _, borrow control:Arr u8 _, borrow encoding:Arr u8 _, packed:bool,
    not_modified:bool, borrow etag:Arr u8 _) -> Arr u8 _
  = let base=concat("web_reply(200,",tpl_literal(body),",",tpl_literal(ctype),")") in
    let status=if not_modified then concat("web_status(",base,",304)") else base in
    let cached=gen_header(status,"Cache-Control",tpl_literal(control)) in
    let encoded=if len(encoding)>0 then gen_header(cached,"Content-Encoding",tpl_literal(encoding)) else cached in
    let varied=if packed then gen_header(encoded,"Vary","\"Accept-Encoding\"") else encoded in
    gen_header(varied,"ETag",etag)
; embedded_response(data, ctype, control): the GET/HEAD response for bytes
; embedded at build time, with its gzip variant, ETag and 304 replies.
fn gen_embedded_response(borrow data:Arr u8 _, borrow ctype:Arr u8 _, borrow control:Arr u8 _) -> Arr u8 _
  = let etag=tpl_literal(concat("W/\"",text_slice(host_sha256_hex(data),0,24),"\"")) in
    let packed=if meta_compressible(ctype) then meta_compressed(data) else none_bytes() in
    let smallest=if packed.present then meta_brotli_compressed(data,packed) else none_bytes() in
    let plain=gen_reply(data,ctype,control,text_empty(),packed.present,false,etag) in
    let gzipped=if packed.present then concat("(if neokit_accepts(accepted,\"gzip\") then ",gen_reply(packed.value,ctype,control,"gzip",true,false,etag)," else ",plain,")") else plain in
    let brotli=if smallest.present then concat("(if neokit_accepts(accepted,\"br\") then ",gen_reply(smallest.value,ctype,control,"br",true,false,etag)," else ",gzipped,")") else gzipped in
    let response=if packed.present then concat("let accepted=web_request_header(request,\"accept-encoding\") in ",brotli) else brotli in
    concat("(if !",gen_get_head()," then web_method_not_allowed(\"GET, HEAD\") else if neokit_not_modified(request,",etag,") then ",
      gen_reply(text_empty(),ctype,control,text_empty(),packed.present,true,etag)," else ",response,")")

; ---------------------------------------------------------------- API routes

type GenCors = { present:bool, origins:Arr Arr u8 _ _, headers:Arr Arr u8 _ _, credentials:bool }
private fn gen_no_cors() -> GenCors = GenCors { present=false, origins=text_words(), headers=text_words(), credentials=false }
private fn gen_origins_ok(borrow origins:Arr Arr u8 _ _) -> bool
  = loop (i=0, ok=true) while ok && i<len(origins) next (i+1, text_equal(text_word(origins,i),"*") || gen_origin(text_word(origins,i))) yield ok
private fn gen_header_name(borrow name:Arr u8 _) -> bool = len(name)>=1 && len(name)<=64 && text_only(name,"A-Za-z0-9-")
private fn gen_header_names(borrow names:Arr Arr u8 _ _) -> bool
  = loop (i=0, ok=true) while ok && i<len(names) next (i+1, gen_header_name(text_word(names,i))) yield ok
private fn gen_wildcard(borrow origins:Arr Arr u8 _ _) -> bool = len(origins)==1 && text_equal(text_word(origins,0),"*")
; cors_options(config, path, streaming): present is false without cors.
fn gen_cors_options(borrow config:Json, borrow path:Arr u8 _, streaming:bool) -> Result<GenCors,Arr u8 _>
  = match toml_get(config,"cors") {
      None => Ok::<GenCors,Arr u8 _>(gen_no_cors()),
      Some(value) =>
        if streaming then Err::<GenCors,Arr u8 _>(concat(path,": cors is supported on buffered API routes")) else
        let star=toml_is_text(value) && text_equal(toml_text(value),"*") in
        let given=toml_get_texts(config,"cors") in
        let origins=if star then text_one("*") else given.values in
        if !(star || given.ok) || len(origins)==0 || len(origins)>32 || (text_member(origins,"*") && len(origins)>1) || !gen_origins_ok(origins)
        then Err::<GenCors,Arr u8 _>(concat(path,": cors must be \"*\" or a list of origins like \"https://app.example\"")) else
        let headers=toml_get_texts(config,"cors_headers") in
        let names=if headers.present then headers.values else text_one("content-type") in
        if !headers.ok || !gen_header_names(names) then Err::<GenCors,Arr u8 _>(concat(path,": cors_headers must list request header names")) else
        let credentials=toml_get_bool(config,"cors_credentials",false) in
        if !credentials.ok || (credentials.value && gen_wildcard(origins))
        then Err::<GenCors,Arr u8 _>(concat(path,": cors_credentials must be a boolean and cannot be used with \"*\"")) else
        if toml_has(config,"input") && gen_truthy(config,"csrf",true)
        then Err::<GenCors,Arr u8 _>(concat(path,": cross-origin typed actions need csrf=false and their own authentication")) else
        Ok::<GenCors,Arr u8 _>(GenCors { present=true, origins=origins, headers=names, credentials=credentials.value })
    }
private fn gen_granted(borrow response:Arr u8 _, borrow cors:GenCors) -> Arr u8 _
  = let origin=gen_header(response,"Access-Control-Allow-Origin",if gen_wildcard(cors.origins) then "\"*\"" else "origin") in
    let credentials=if cors.credentials then gen_header(origin,"Access-Control-Allow-Credentials","\"true\"") else origin in
    gen_header(credentials,"Vary","\"Origin\"")
; cors_function(name, call, allowed, cors).
fn gen_cors_function(borrow name:Arr u8 _, borrow call:Arr u8 _, borrow allowed:Arr Arr u8 _ _, borrow cors:GenCors) -> Arr u8 _
  = let allowed_origin=if gen_wildcard(cors.origins) then "true"
      else concat("(",text_join(arr(i in 0..len(cors.origins)) concat("str_equal(origin,",tpl_literal(text_word(cors.origins,i)),")")," || "),")") in
    let methods=loop (out=text_words(), i=0) while i<len(allowed) next (if text_equal(text_word(allowed,i),"OPTIONS") then out else push(out,text_word(allowed,i)), i+1) yield out in
    let empty="web_status(web_reply(200,\"\",\"text/plain; charset=utf-8\"),204)" in
    let preflight=gen_header(gen_header(gen_header(gen_granted(empty,cors),"Access-Control-Allow-Methods",tpl_literal(text_join(methods,", "))),
      "Access-Control-Allow-Headers",tpl_literal(text_join(cors.headers,", "))),"Access-Control-Max-Age","\"600\"") in
    let refused=gen_header(empty,"Vary","\"Origin\"") in
    concat("effect fn ",name,"(request:WebRequest) -> WebResponse = let origin=web_request_header(request,\"origin\") in ",
      "let allowed=",allowed_origin," in if str_equal(request.method,\"OPTIONS\") then (if allowed then ",preflight," else ",refused,") else ",
      "let response=",call," in if allowed && len(origin)>0 then ",gen_granted("response",cors)," else ",gen_header("response","Vary","\"Origin\""))

type GenApi = { url:Arr u8 _, handler:Arr u8 _, allowed:Arr Arr u8 _ _, streaming:bool }
type GenAsync = { url:Arr u8 _, timeout:i64 }
type GenApis = { code:Arr Arr u8 _ _, apis:Arr GenApi _, realtime:Arr Arr u8 _ _, asyncs:Arr GenAsync _, cors:Arr Arr u8 _ _ }
private fn gen_no_apis() -> Arr GenApi _ = arr(i in 0..0) GenApi { url=text_empty(), handler=text_empty(), allowed=text_words(), streaming=false }
private fn gen_api_at(borrow apis:Arr GenApi _, i:i64) -> GenApi
  = if i>=0 && i<len(apis) then apis[i] else GenApi { url=text_empty(), handler=text_empty(), allowed=text_words(), streaming=false }
private fn gen_no_asyncs() -> Arr GenAsync _ = arr(i in 0..0) GenAsync { url=text_empty(), timeout=0 }
private fn gen_async_at(borrow asyncs:Arr GenAsync _, i:i64) -> GenAsync
  = if i>=0 && i<len(asyncs) then asyncs[i] else GenAsync { url=text_empty(), timeout=0 }
; async_routes[url]=timeout.
private fn gen_async_put(move asyncs:Arr GenAsync _, borrow url:Arr u8 _, timeout:i64) -> Arr GenAsync _
  = let at=loop (i=0, found= -1) while found<0 && i<len(asyncs) next (i+1, if text_equal(gen_async_at(asyncs,i).url,url) then i else -1) yield found in
    if at>=0 && at<len(asyncs) then set(asyncs,at,GenAsync { url=url, timeout=timeout }) else push(asyncs,GenAsync { url=url, timeout=timeout })
private fn gen_async_has(borrow asyncs:Arr GenAsync _, borrow url:Arr u8 _) -> bool
  = loop (i=0, found=false) while !found && i<len(asyncs) next (i+1, text_equal(gen_async_at(asyncs,i).url,url)) yield found
; config.get('methods', ['GET']) == ['GET'].
private fn gen_get_only(borrow config:Json) -> bool
  = match toml_get(config,"methods") {
      None => true,
      Some(value) => let items=toml_items(value) in
        toml_is_array(value) && len(items)==1 && toml_is_text(gen_json_at(items,0)) && text_equal(toml_text(gen_json_at(items,0)),"GET") }
private fn gen_typed_code(borrow config:Json, borrow adapter:Arr u8 _, typed:bool) -> Result<Arr Arr u8 _ _,Arr u8 _>
  = if !typed then Ok::<Arr Arr u8 _ _,Arr u8 _>(text_words()) else
    let made=act_adapter(config,adapter)? in
    Ok::<Arr Arr u8 _ _,Arr u8 _>(gen_two("import \"std:http_input\"",made.code))
private fn gen_api_err(borrow message:Arr u8 _) -> Result<GenApis,Arr u8 _> = Err::<GenApis,Arr u8 _>(message)
; One app/**/route.toml as build() reads it.
private effect(fs) fn gen_api_route(borrow s:GenApis, borrow app:Arr u8 _, borrow path:Arr u8 _) -> Result<GenApis,Arr u8 _>
  = let config=gen_load_toml(path)? in
    let at=concat(path,": ") in
    let realtime=toml_get_bool(config,"realtime",false) in
    if !realtime.ok then gen_api_err(concat(at,"realtime must be a boolean"))
    else if realtime.value && (gen_truthy(config,"async",false) || toml_has(config,"input") || !gen_get_only(config))
    then gen_api_err(concat(at,"realtime routes require GET, no typed action and no async admission wrapper")) else
    let is_async=toml_get_bool(config,"async",false) in
    if !is_async.ok then gen_api_err(concat(at,"async must be a boolean")) else
    let timeout=toml_get_int(config,"async_timeout_ms",10000) in
    if !timeout.ok || timeout.value<1 || timeout.value>120000 then gen_api_err(concat(at,"async_timeout_ms must be 1..120000")) else
    let stream=toml_get_bool(config,"stream",false) in
    if !realtime.value && !stream.ok then gen_api_err(concat(at,"stream must be a boolean")) else
    let url=route_path(host_parent(path),host_join(app,"app"))? in
    if gen_reserved(url) then gen_api_err("The /_web/ and /_neokit/ namespaces are reserved") else
    let handler=toml_get_text(config,"handler","") in
    if !handler.ok || !tpl_name(handler.value) then gen_api_err("API routes require a named Neo handler") else
    let streaming=realtime.value || stream.value in
    let cors=gen_cors_options(config,path,streaming)? in
    let imported=push(s.code,concat("import ",tpl_literal(host_join(host_parent(path),"route.neo")))) in
    let typed=toml_has(config,"input") in
    if typed && streaming then gen_api_err("Typed action adapters return buffered WebResponse values") else
    let adapter=concat("Action_",text_slice(host_sha256_hex(url),0,12)) in
    let extra=gen_typed_code(config,adapter,typed)? in
    let called=if typed then adapter else handler.value in
    let allowed=route_methods_or(config,path,text_one(if typed then "POST" else "GET"))? in
    if cors.present && text_member(allowed,"OPTIONS") then gen_api_err(concat(at,"cors answers OPTIONS itself; remove it from methods")) else
    let wrapper=concat("Cors_",text_slice(host_sha256_hex(url),0,12)) in
    Ok::<GenApis,Arr u8 _>(GenApis { code=text_concat_words(imported,extra),
      apis=push(s.apis,GenApi { url=url, handler=if cors.present then wrapper else called,
        allowed=if cors.present then push(allowed,"OPTIONS") else allowed, streaming=streaming }),
      realtime=if realtime.value then push(s.realtime,url) else s.realtime,
      asyncs=if is_async.value then gen_async_put(s.asyncs,url,timeout.value) else s.asyncs,
      cors=if cors.present then push(s.cors,gen_cors_function(wrapper,concat(called,"(request)"),allowed,cors)) else s.cors })
type GenApiLoop = { apis:GenApis, err:Arr u8 _ }
private fn gen_blank_apis() -> GenApis
  = GenApis { code=text_words(), apis=gen_no_apis(), realtime=text_words(), asyncs=gen_no_asyncs(), cors=text_words() }
private effect(fs) fn gen_api_step(move s:GenApiLoop, borrow app:Arr u8 _, borrow path:Arr u8 _) -> GenApiLoop
  = match gen_api_route(s.apis,app,path) {
      Ok(updated) => GenApiLoop { apis=updated, err=text_empty() },
      Err(message) => GenApiLoop { apis=gen_blank_apis(), err=message } }
private effect(fs) fn gen_api_routes(borrow app:Arr u8 _, borrow start:GenApis) -> Result<GenApis,Arr u8 _>
  = let configs=host_rglob(host_join(app,"app"),"route.toml") in
    let s=loop (s=GenApiLoop { apis=start, err=text_empty() }, i=0) while len(s.err)==0 && i<len(configs)
      next (gen_api_step(s,app,text_word(configs,i)), i+1) yield s in
    if len(s.err)>0 then gen_api_err(s.err) else Ok::<GenApis,Arr u8 _>(s.apis)
; The API routes in precedence order.
private fn gen_sorted_apis(borrow apis:Arr GenApi _) -> Arr GenApi _
  = let order=route_precedence_order(arr(i in 0..len(apis)) gen_api_at(apis,i).url) in
    arr(i in 0..len(order)) gen_api_at(apis,gen_int_at(order,i))

; ---------------------------------------------------------------- common.neo

type GenRender = { code:Arr u8 _, jsonld:bool }
private fn gen_wrap(borrow expressions:Arr TplPair _, borrow template:TplTemplate, borrow content:Arr u8 _, borrow head:Arr u8 _, borrow client:Arr u8 _) -> Arr u8 _
  = let base=push(push(push(push(push(tpl_no_pairs(),TplPair { key="p_content.bytes", value=content }),
      TplPair { key="p_content", value=concat("web_html(",content,")") }),TplPair { key="p_title", value="props.title" }),
      TplPair { key="p_client", value=client }),TplPair { key="p_mode", value="(if request.server then \"native SSR\" else \"static export\")" }) in
    let mapping=if tpl_has(template.props,"head")
      then push(push(base,TplPair { key="p_head.bytes", value=head }),TplPair { key="p_head", value=concat("web_html(",head,")") }) else base in
    tpl_substitute(tpl_get(expressions,template.name),mapping)
; The ancestors of a page folder whose layouts wrap it, nearest first.
private fn gen_ancestors(borrow app:Arr u8 _, borrow folder:Arr u8 _) -> Arr Arr u8 _ _
  = let base=host_join(app,"app") in
    let parents=host_parents(folder) in
    let kept=loop (out=text_words(), i=0) while i<len(parents)
      next (let p=text_word(parents,i) in if !host_path_equal(p,base) && host_is_relative_to(p,base) then push(out,p) else out, i+1) yield out in
    if host_path_equal(folder,base) then kept else text_concat_words(text_one(folder),kept)
; The render_ function of one page: its document inside the nested and root
; layouts, with the page's metadata in <head>.
private fn gen_render_route(borrow app:Arr u8 _, borrow config:Json, borrow views:GenViews, borrow expressions:Arr TplPair _, borrow route:GenRoute) -> Result<GenRender,Arr u8 _>
  = let props=route.template.props in
    let names=arr(i in 0..len(props)) gen_prop_key(props,i) in
    let args=text_join(arr(i in 0..len(names)) concat("props.",text_word(names,i)),",") in
    let key=route.key in
    let client=if route.client then "true" else "false" in
    let ancestors=gen_ancestors(app,host_parent(route.source)) in
    let document=loop (document=concat("text_",key,"(",args,")"), i=0) while i<len(ancestors)
      next (let at=gen_layout_index(views.layouts,text_word(ancestors,i)) in
            if at<0 then document else
            let nested=gen_layout_at(views.layouts,at).template in
            let outlet=concat("concat(",tpl_literal(concat("<div data-web-outlet=\"",nested.name,"\">")),",",document,",",tpl_literal("</div>"),")") in
            concat("concat(",tpl_literal(concat("<div data-web-layout=\"",nested.name,"\">")),",",gen_wrap(expressions,nested,outlet,"\"\"",client),",",tpl_literal("</div>"),")"),
            i+1) yield document in
    let dynamic_keys=meta_metadata_props(route.config)? in
    let static_head=meta_metadata(config,route.config,toml_keys(dynamic_keys))? in
    let kinds=arr(i in 0..len(props)) tpl_get(props,text_word(names,i)) in
    let dynamic=meta_dynamic_metadata(config,route.config,names,kinds)? in
    let head_parts=text_concat_words(if len(static_head)>0 then text_one(tpl_literal(static_head)) else text_words(),dynamic.parts) in
    let head=if len(head_parts)>1 then concat("concat(",text_join(head_parts,","),")") else if len(head_parts)==1 then text_word(head_parts,0) else "\"\"" in
    let line=gen_render_line(key,route.loader,args) in
    if tpl_has(views.layout.props,"head") then Ok::<GenRender,Arr u8 _>(GenRender { code=concat(line,gen_wrap(expressions,views.layout,document,head,client),")"), jsonld=dynamic.jsonld })
    else if len(dynamic.parts)>0 then Err::<GenRender,Arr u8 _>(concat(route.path,": [metadata.props] needs head:html in layout.view, rendered in <head> as {{ head }}")) else
    let wrapped=gen_wrap(expressions,views.layout,document,"\"\"",client) in
    if len(static_head)==0 then Ok::<GenRender,Arr u8 _>(GenRender { code=concat(line,wrapped,")"), jsonld=dynamic.jsonld })
    else if !text_contains(wrapped,"</head>") then Err::<GenRender,Arr u8 _>("layout.view needs </head> for [site]/[metadata] tags, or a head:html prop") else
    let literal=tpl_literal(static_head) in
    Ok::<GenRender,Arr u8 _>(GenRender { code=concat(line,text_replace_first(wrapped,"</head>",concat(text_slice(literal,1,len(literal)-1),"</head>")),")"), jsonld=dynamic.jsonld })
private fn gen_prop_key(borrow pairs:Arr TplPair _, i:i64) -> Arr u8 _ = if i>=0 && i<len(pairs) then pairs[i].key else text_empty()
private fn gen_render_line(borrow key:Arr u8 _, borrow loader:Arr u8 _, borrow args:Arr u8 _) -> Arr u8 _
  = concat("effect fn render_",key,"(request: WebRequest, fragment: bool) -> WebHtml = let props=",loader,"(request) in if fragment then view_",key,"(",args,") else web_html(")
; The cached_ function of a page with cache_ttl.
private fn gen_cached_code(borrow route:GenRoute, borrow identity:Arr u8 _) -> Arr u8 _
  = let key=route.key in
    let control=tpl_literal(concat("public, max-age=",text_int(route.ttl),if route.stale!=0 then concat(", stale-while-revalidate=",text_int(route.stale)) else text_empty())) in
    let bypass=if route.has_query then text_empty() else " || len(request.query)>0" in
    let names=route.query in
    let lets=if !route.has_query then text_empty()
      else loop (o=text_empty(), i=0) while i<len(names) next (concat(o,"let q",text_int(i),"=web_query_get(request.query,",tpl_literal(text_word(names,i)),") in "), i+1) yield o in
    let pieces=arr(i in 0..len(names)) concat("(if q",text_int(i),".present then concat(\"1:\",int_text(len(q",text_int(i),".value)),\":\",q",text_int(i),".value) else \"0\")") in
    let query_key=if !route.has_query then "\"\"" else concat("concat(\"?\",",text_join(pieces,",\";\","),")") in
    concat(concat("effect fn cached_",key,"(request:WebRequest,fragment:bool) -> WebResponse = ",
      "if !neokit_cacheable(request)",bypass," then web_document(render_",key,"(request,fragment)) else ",
      lets,"let cache=neokit_cache() in let key=concat(",tpl_literal(identity),",request.path,",query_key,",if fragment then \":fragment\" else \":document\") in "),
      concat("let entry=web_cache_tagged_key(cache,key,",tpl_literal(route.tag),",request.stamp) in let hit=web_cache_read(cache,entry,request.stamp) in ",
      "let configured=env_get(\"NEOKIT_REVALIDATE_TOKEN\").value in let supplied=web_request_header(request,\"x-neokit-revalidate\") in ",
      "let force=len(configured)>=32 && crypto_equal(configured,supplied) in ",
      "if hit.present && !force then let split=str_find(hit.value,\"\\n\") in let until=int_parse(str_slice(hit.value,0,split.value)) in ",
      "let stale=until.ok && until.value<=request.stamp in "),
      concat("let queued=if stale && len(configured)>=32 && !fragment then web_cache_enqueue(cache,entry,concat(request.path,if len(request.query)>0 then concat(\"?\",request.query) else \"\"),request.stamp) else int_ok(0) in ",
      "neokit_cached(web_reply(200,str_slice(hit.value,split.value+1,len(hit.value)),\"text/html; charset=utf-8\"),",control,",if stale then \"STALE\" else \"HIT\") else ",
      "let response=web_document(render_",key,"(request,fragment)) in "),
      concat("let stored=web_cache_write(cache,entry,concat(int_text(request.stamp+",text_int(route.ttl*1000),"),\"\\n\",response.body),request.stamp,",text_int((route.ttl+route.stale)*1000),") in ",
      "neokit_cached(response,",control,",\"MISS\")"))
; The page_ function of a page served by the server (not mode=static).
private fn gen_page_code(borrow route:GenRoute) -> Arr u8 _
  = let key=route.key in
    let plain=concat("web_document(render_",key,"(request,fragment))") in
    let response=if route.ttl>0 then concat("cached_",key,"(request,fragment)")
      else if len(route.control)>0 then gen_header(gen_header(plain,"Cache-Control",tpl_literal(route.control)),"Vary","\"X-Web-Fragment\"") else plain in
    let guarded=if len(route.guard)>0 then concat("let guarded=",route.guard,"(request) in if guarded.status!=0 then neokit_page_response(guarded) else ",response) else response in
    concat("effect fn page_",key,"(request:WebRequest,fragment:bool) -> WebResponse = ",guarded)

type GenCommon = { code:Arr Arr u8 _ _, apis:GenApis, all_paths:Arr Arr u8 _ _, not_found:bool, server_error:bool }
type GenRenders = { code:Arr Arr u8 _ _, jsonld:bool, err:Arr u8 _ }
private fn gen_render_step(move s:GenRenders, borrow app:Arr u8 _, borrow config:Json, borrow views:GenViews, borrow expressions:Arr TplPair _, borrow route:GenRoute) -> GenRenders
  = match gen_render_route(app,config,views,expressions,route) {
      Ok(render) => GenRenders { code=push(s.code,render.code), jsonld=s.jsonld || render.jsonld, err=text_empty() },
      Err(message) => GenRenders { code=text_words(), jsonld=false, err=message } }
private fn gen_any_cached(borrow routes:Arr GenRoute _) -> bool
  = loop (i=0, found=false) while !found && i<len(routes) next (i+1, gen_route_at(routes,i).ttl>0) yield found
private fn gen_insert(borrow words:Arr Arr u8 _ _, at:i64, borrow word:Arr u8 _) -> Arr Arr u8 _ _
  = loop (out=text_words(), i=0) while i<=len(words)
      next (let o=if i==at then push(out,word) else out in if i<len(words) then push(o,text_word(words,i)) else o, i+1) yield out
private effect(fs) fn gen_optional_view(borrow path:Arr u8 _, borrow name:Arr u8 _) -> Result<TplTemplate,Arr u8 _>
  = let source=host_read_text(path)? in tpl_parse(name,source,path)
; The lines of generated/common.neo, and what server.neo needs from them.
private effect(fs,env) fn gen_common(borrow root:Arr u8 _, borrow app:Arr u8 _, dev:bool, borrow site:GenSite, borrow routes:Arr GenRoute _,
    borrow views:GenViews, borrow bundle:GenBundle) -> Result<GenCommon,Arr u8 _>
  = let imports=gen_two(concat("import ",tpl_literal(host_join(root,"src/lib.neo"))),concat("import ",tpl_literal(host_join(root,"src/assets.neo")))) in
    let with_dev=if dev then push(imports,concat("import ",tpl_literal(host_join(root,"src/dev.neo")))) else imports in
    let with_csp=if site.has_csp then push(with_dev,concat("import ",tpl_literal(host_join(root,"src/security.neo")))) else with_dev in
    let observed=if site.access_log || site.timing then push(with_csp,"import \"std:http_observability\"") else with_csp in
    let hooked=if len(site.before)>0 || len(site.after)>0 || len(site.startup)>0 then push(observed,concat("import ",tpl_literal(host_join(app,"app/hooks.neo")))) else observed in
    let pages=arr(i in 0..len(routes)) gen_route_at(routes,i).template in
    let layouts=arr(i in 0..len(views.layouts)) gen_layout_at(views.layouts,i).template in
    let base_templates=gen_join_templates(gen_join_templates(views.components,pages),layouts) in
    let error_path=host_join(app,"app/not-found.view") in
    let has_not_found=host_is_file(error_path) in
    let not_found=if has_not_found then gen_optional_view(error_path,"NotFound") else Ok::<TplTemplate,Arr u8 _>(gen_blank_template()) in
    let error_template=match not_found { Ok(t) => t, Err(message) => gen_blank_template() } in
    match not_found { Err(message) => Err::<GenCommon,Arr u8 _>(message), Ok(t) =>
    if has_not_found && len(error_template.props)>0 then Err::<GenCommon,Arr u8 _>("not-found.view currently takes @props()") else
    let templates=if has_not_found then push(base_templates,error_template) else base_templates in
    let cached=if gen_any_cached(routes) then push(hooked,concat("import ",tpl_literal(host_join(root,"src/cache.neo")))) else hooked in
    let sources=gen_unique_paths(arr(i in 0..len(routes)) gen_route_at(routes,i).source) in
    let sourced=loop (out=cached, i=0) while i<len(sources) next (push(out,concat("import ",tpl_literal(text_word(sources,i)))), i+1) yield out in
    let page_asyncs=loop (out=gen_no_asyncs(), i=0) while i<len(routes)
      next (let route=gen_route_at(routes,i) in if route.is_async then gen_async_put(out,route.path,route.async_timeout) else out, i+1) yield out in
    let apis=gen_api_routes(app,GenApis { code=sourced, apis=gen_no_apis(), realtime=text_words(), asyncs=page_asyncs, cors=text_words() })? in
    let code=if len(apis.realtime)>0 then push(apis.code,concat("import ",tpl_literal(host_join(root,"src/realtime.neo")))) else apis.code in
    let all_paths=text_concat_words(text_concat_words(text_concat_words(gen_route_paths(routes),arr(i in 0..len(apis.apis)) gen_api_at(apis.apis,i).url),gen_keys(bundle.files)),
      arr(i in 0..len(site.redirects)) gen_redirect_at(site.redirects,i).source) in
    if !text_distinct(all_paths) then Err::<GenCommon,Arr u8 _>("A page/API/asset/redirect route is duplicated")
    else if !text_distinct(arr(i in 0..len(all_paths)) route_shape(text_word(all_paths,i))) then Err::<GenCommon,Arr u8 _>("Ambiguous page/API/asset routes differ only in parameter names") else
    let server_error_path=host_join(app,"app/error.view") in
    let has_server_error=host_is_file(server_error_path) in
    let server_error=if has_server_error then gen_optional_view(server_error_path,"ServerError") else Ok::<TplTemplate,Arr u8 _>(gen_blank_template()) in
    match server_error { Err(message) => Err::<GenCommon,Arr u8 _>(message), Ok(error) =>
    if has_server_error && !(len(error.props)==2 && gen_props_has(error.props,"status","int") && gen_props_has(error.props,"message","text"))
    then Err::<GenCommon,Arr u8 _>("error.view takes status:int,message:text") else
    let all_templates=if has_server_error then push(templates,error) else templates in
    let compiled=tpl_compile_all(all_templates,views.components,gen_tpl_pairs(bundle.assets))? in
    let with_views=text_concat_words(push(code,compiled.code),apis.cors) in
    let not_found_body=if has_not_found then "text_NotFound()" else "\"Not Found\"" in
    let not_found_type=if has_not_found then gen_html_type() else "text/plain; charset=utf-8" in
    let pages_code=push(push(with_views,concat("fn neokit_not_found() -> WebResponse = web_reply(404,",not_found_body,",",tpl_literal(not_found_type),")")),
      "fn neokit_page_response(response:WebResponse) -> WebResponse = if response.status==404 && len(response.body)==0 then let page=neokit_not_found() in page with { headers=response.headers } else response") in
    let rendered=loop (s=GenRenders { code=pages_code, jsonld=false, err=text_empty() }, i=0) while len(s.err)==0 && i<len(routes)
      next (gen_render_step(s,app,site.config,views,compiled.expressions,gen_route_at(routes,i)), i+1) yield s in
    if len(rendered.err)>0 then Err::<GenCommon,Arr u8 _>(rendered.err) else
    let headed=if rendered.jsonld then gen_insert(rendered.code,1,concat("import ",tpl_literal(host_join(root,"src/head.neo")))) else rendered.code in
    let identity=if gen_any_cached(routes) then gen_cache_identity(root,app) else gen_ok(text_empty()) in
    match identity { Err(message) => Err::<GenCommon,Arr u8 _>(message), Ok(build_identity) =>
    let with_cache=loop (out=headed, i=0) while i<len(routes)
      next (let route=gen_route_at(routes,i) in
            if route.ttl==0 then out
            else push(out,gen_cached_code(route,text_slice(host_sha256_hex(concat(build_identity,text_join(out,""))),0,16))), i+1) yield out in
    let with_pages=loop (out=with_cache, i=0) while i<len(routes)
      next (let route=gen_route_at(routes,i) in if text_equal(route.mode,"static") then out else push(out,gen_page_code(route)), i+1) yield out in
    Ok::<GenCommon,Arr u8 _>(GenCommon { code=with_pages, apis=apis, all_paths=all_paths, not_found=has_not_found, server_error=has_server_error })
    } } }
private fn gen_join_templates(borrow a:Arr TplTemplate _, borrow b:Arr TplTemplate _) -> Arr TplTemplate _
  = loop (out=a, i=0) while i<len(b) next (push(out,gen_template_at(b,i)), i+1) yield out

; ---------------------------------------------------------------- render.neo

type GenExport = { route:i64, path:Arr u8 _ }
private fn gen_export_at(borrow exports:Arr GenExport _, i:i64) -> GenExport = if i>=0 && i<len(exports) then exports[i] else GenExport { route= -1, path=text_empty() }
private fn gen_no_exports() -> Arr GenExport _ = arr(i in 0..0) GenExport { route= -1, path=text_empty() }
; export_routes: (route, path) for every path of every route with export=true.
private fn gen_exports(borrow routes:Arr GenRoute _) -> Arr GenExport _
  = loop (out=gen_no_exports(), i=0) while i<len(routes)
      next (let route=gen_route_at(routes,i) in
            if !route.exported then out else loop (o=out, j=0) while j<len(route.paths) next (push(o,GenExport { route=i, path=text_word(route.paths,j) }), j+1) yield o, i+1) yield out
private fn gen_export_paths(borrow exports:Arr GenExport _) -> Arr Arr u8 _ _ = arr(i in 0..len(exports)) gen_export_at(exports,i).path
; generated/render.neo for the pages to prerender.
fn gen_render_code(borrow routes:Arr GenRoute _, borrow exports:Arr GenExport _, not_found:bool) -> Arr u8 _
  = let count=len(exports) in
    let pages=loop (out=text_one("import \"common.neo\""), i=0) while i<count
      next (let item=gen_export_at(exports,i) in let route=gen_route_at(routes,item.route) in
            let request=concat("web_static_request(",tpl_literal(item.path),")") in
            let routed=if route.dynamic then concat("web_routed(",request,",",tpl_literal(route.path),")") else request in
            push(out,concat("effect fn neokit_page_",text_int(i),"() -> Arr u8 _ = render_",route.key,"(",routed,",false).bytes")), i+1) yield out in
    let with_404=if not_found then push(pages,"fn neokit_page_404() -> Arr u8 _ = text_NotFound()") else pages in
    let frames=text_concat_words(arr(i in 0..count) concat("neokit_page_",text_int(i),"()"),if not_found then text_one("neokit_page_404()") else text_words()) in
    let all=loop (o=text_empty(), i=0) while i<len(frames)
      next (concat(o,"let b",text_int(i),"=",text_word(frames,i)," in let w",text_int(i),"=print_out(concat(int_text(len(b",text_int(i),")),\"\\n\",b",text_int(i),")) in "), i+1) yield o in
    let one=loop (o=text_empty(), i=0) while i<count next (concat(o,"if index==",text_int(i)," then neokit_page_",text_int(i),"() else "), i+1) yield o in
    let lines=push(push(push(with_404,concat("effect fn neokit_render_all() -> unit = ",all,"noop()")),
      concat("effect fn neokit_render_one(index: i64) -> unit = let body = ",one,"\"\" in let written=print_out(body) in noop()")),
      concat("effect fn main(index: i64) -> unit = if index==",text_int(count)," then neokit_render_all() else neokit_render_one(index)")) in
    concat(text_join(lines,"\n"),"\n")
type GenFrames = { frames:Arr Arr u8 _ _, at:i64, err:Arr u8 _ }
; int(bytes) for the decimal sizes the renderer prints (ASCII whitespace
; around an optional sign and digits).
private fn gen_frame_size(borrow text:Arr u8 _) -> IntResult
  = let trimmed=text_strip_chars(text," \t\n\r\x0b\x0c") in
    let digits=if text_starts(trimmed,"+") then text_from(trimmed,1) else trimmed in
    if len(digits)==0 || !text_only(digits,"0-9") then int_error(22,"invalid literal",0) else int_parse(digits)
private fn gen_frame_step(move s:GenFrames, borrow output:Arr u8 _) -> GenFrames
  = let newline=text_find(output,"\n",s.at) in
    if newline<0 then s with { err="subsection not found" } else
    let raw=text_slice(output,s.at,newline) in
    let size=gen_frame_size(raw) in
    if !size.ok then s with { err=concat("invalid literal for int() with base 10: ",gen_bytes_repr(raw)) } else
    GenFrames { frames=push(s.frames,text_slice(output,newline+1,newline+1+size.value)), at=newline+1+size.value, err=text_empty() }
; read_frames(output, count): the length-prefixed pages the renderer prints.
fn gen_read_frames(borrow output:Arr u8 _, count:i64) -> Result<Arr Arr u8 _ _,Arr u8 _>
  = let s=loop (s=GenFrames { frames=text_words(), at=0, err=text_empty() }) while len(s.err)==0 && s.at<len(output) next (gen_frame_step(s,output)) yield s in
    if len(s.err)>0 then Err::<Arr Arr u8 _ _,Arr u8 _>(s.err)
    else if len(s.frames)!=count then Err::<Arr Arr u8 _ _,Arr u8 _>(concat("Static renderer produced ",text_int(len(s.frames))," pages; expected ",text_int(count)))
    else Ok::<Arr Arr u8 _ _,Arr u8 _>(s.frames)
; snapshot_file(directory, path): /feed.xml exports as a file, /docs as
; docs/index.html.
fn gen_snapshot_file(borrow directory:Arr u8 _, borrow path:Arr u8 _) -> Arr u8 _
  = let relative=text_lstrip_chars(path,"/") in
    if text_contains(text_rpartition(relative,"/").after,".") then host_join(directory,relative)
    else host_join(host_join(directory,relative),"index.html")
type GenRendered = { snapshots:Arr MetaPair _, has_404:bool, page_404:Arr u8 _, exports:Arr GenExport _, available:Arr Arr u8 _ _ }
; Prerenders the pages build() exports (only the static ones for target
; server) with generated/render.neo.
private effect(fs,env,process,time) fn gen_render_pages(borrow root:Arr u8 _, borrow out:Arr u8 _, borrow target:Arr u8 _, borrow profile:Arr u8 _,
    borrow package_root:Arr u8 _, borrow routes:Arr GenRoute _, not_found:bool) -> Result<GenRendered,Arr u8 _>
  = let all=gen_exports(routes) in
    if !text_distinct(gen_export_paths(all)) then Err::<GenRendered,Arr u8 _>("Export paths overlap")
    else if loop (i=0, bad=false) while !bad && i<len(routes) next (i+1, let r=gen_route_at(routes,i) in text_equal(r.mode,"static") && !r.exported) yield bad
    then Err::<GenRendered,Arr u8 _>("Static server routes must have export=true") else
    let available=gen_export_paths(all) in
    let exports=if text_equal(target,"server")
      then loop (o=gen_no_exports(), i=0) while i<len(all)
        next (let e=gen_export_at(all,i) in if text_equal(gen_route_at(routes,e.route).mode,"static") then push(o,e) else o, i+1) yield o
      else all in
    let count=len(exports) in
    let source=host_join(out,"generated/render.neo") in
    let written=host_write_text(source,gen_render_code(routes,exports,not_found))? in
    if count==0 && text_equal(target,"server") then Ok::<GenRendered,Arr u8 _>(GenRendered { snapshots=meta_no_pairs(), has_404=false, page_404=text_empty(), exports=exports, available=available }) else
    let binary=host_join(out,"render") in
    let built=gen_native_build(root,source,binary,profile,package_root)? in
    let run=host_run(gen_two(binary,text_int(count))) in
    if !run.ok then Err::<GenRendered,Arr u8 _>(run.error)
    else if run.code!=0 then Err::<GenRendered,Arr u8 _>(concat("Static rendering failed:\n",host_decode_replace(run.errors))) else
    let frames=gen_read_frames(run.output,count+(if not_found then 1 else 0))? in
    let snapshots=loop (o=meta_no_pairs(), i=0) while i<count next (gen_pair_put(o,gen_export_at(exports,i).path,text_word(frames,i)), i+1) yield o in
    Ok::<GenRendered,Arr u8 _>(GenRendered { snapshots=snapshots, has_404=not_found, page_404=if not_found then text_word(frames,count) else text_empty(), exports=exports, available=available })

; ---------------------------------------------------------------- server.neo

private fn gen_prior(borrow all_paths:Arr Arr u8 _ _, borrow url:Arr u8 _) -> Arr Arr u8 _ _
  = loop (out=text_words(), i=0) while i<len(all_paths)
      next (let path=text_word(all_paths,i) in if route_precedence_less(path,url) then push(out,gen_route_condition(path)) else out, i+1) yield out
private fn gen_methods_text(borrow allowed:Arr Arr u8 _ _) -> Arr u8 _ = tpl_literal(text_join(allowed,", "))
type GenServer = { dev:bool, target:Arr u8 _, public_dir:Arr u8 _, assets_dir:Arr u8 _ }
; The dispatch line of each redirect, page and API route, before sorting.
private fn gen_dispatch_routes(borrow server:GenServer, borrow site:GenSite, borrow routes:Arr GenRoute _, borrow apis:GenApis,
    borrow snapshots:Arr MetaPair _) -> Result<Arr MetaPair _,Arr u8 _>
  = let redirects=loop (out=meta_no_pairs(), i=0) while i<len(site.redirects)
      next (let rule=gen_redirect_at(site.redirects,i) in
            push(out,MetaPair { key=rule.source, value=concat("if str_equal(request.path,",tpl_literal(rule.source),") then ",gen_redirect_response(rule)," else") }), i+1) yield out in
    let pages=loop (s=GenFiles { files=redirects, err=text_empty() }, i=0) while len(s.err)==0 && i<len(routes)
      next (let route=gen_route_at(routes,i) in
            if text_equal(route.mode,"static") && !text_equal(server.target,"static") then
              loop (t=s, j=0) while len(t.err)==0 && j<len(route.paths)
                next (let path=text_word(route.paths,j) in
                      let at=gen_pair_index(snapshots,path) in
                      if at<0 then GenFiles { files=meta_no_pairs(), err="Static server routes must have export=true" }
                      else t with { files=push(t.files,MetaPair { key=path, value=concat("if str_equal(request.path,",tpl_literal(path),") then ",
                        gen_embedded_response(gen_pair_at(snapshots,at).value,gen_html_type(),gen_revalidate())," else") }) }, j+1) yield t
            else
              let response=concat("page_",route.key,"(",gen_route_request(route.path,"request"),",fragment)") in
              s with { files=push(s.files,MetaPair { key=route.path, value=concat("if ",gen_route_condition(route.path)," then (if !",gen_get_head(),
                " then web_method_not_allowed(\"GET, HEAD\") else ",response,") else") }) }, i+1) yield s in
    if len(pages.err)>0 then Err::<Arr MetaPair _,Arr u8 _>(pages.err) else
    let sorted=gen_sorted_apis(apis.apis) in
    let all=loop (out=pages.files, i=0) while i<len(sorted)
      next (let api=gen_api_at(sorted,i) in
            let response=if api.streaming
              then (if text_member(apis.realtime,api.url) then "web_reply(200,\"\",\"text/event-stream; charset=utf-8\")" else "web_reply(200,\"\",\"text/html; charset=utf-8\")")
              else concat(api.handler,"(",gen_route_request(api.url,"request"),")") in
            push(out,MetaPair { key=api.url, value=concat("if ",gen_route_condition(api.url)," then (if !",gen_allowed_method(api.allowed),
              " then web_method_not_allowed(",gen_methods_text(api.allowed),") else ",response,") else") }), i+1) yield out in
    Ok::<Arr MetaPair _,Arr u8 _>(all)
; generated/server.neo.
private fn gen_server_code(borrow server:GenServer, borrow site:GenSite, borrow routes:Arr GenRoute _, borrow common:GenCommon,
    borrow files:Arr MetaPair _, borrow public:Arr Arr u8 _ _, borrow snapshots:Arr MetaPair _) -> Result<Arr u8 _,Arr u8 _>
  = let dev=server.dev in
    let head=gen_two("import \"common.neo\"","effect fn web_dispatch(request: WebRequest, fragment: bool) -> WebResponse =") in
    let disk=if !dev then head else push(push(head,
      concat("let disk=if ",gen_get_head()," then neokit_dev_read(",tpl_literal(server.public_dir),",str_slice(request.path,1,len(request.path))) else web_continue() in if disk.status!=0 then disk else")),
      concat("if str_starts(request.path,\"/_web/\") then (if !",gen_get_head()," then web_method_not_allowed(\"GET, HEAD\") else neokit_dev_asset(",tpl_literal(server.assets_dir),",str_slice(request.path,6,len(request.path)))) else")) in
    let embedded=loop (out=disk, i=0) while i<len(files)
      next (let file=gen_pair_at(files,i) in let url=file.key in
            if dev && (text_starts(url,"/_web/") || text_member(public,url)) then out else
            let control=if text_starts(url,"/_web/") && !text_equal(url,"/_web/neokit-client.js") then gen_immutable() else gen_revalidate() in
            push(out,concat("if str_equal(request.path,",tpl_literal(url),") then ",gen_embedded_response(file.value,gen_content_type(url),control)," else")), i+1) yield out in
    let health=push(embedded,concat("if str_equal(request.path,\"/healthz\") then (if !",gen_get_head()," then web_method_not_allowed(\"GET, HEAD\") else web_json(",tpl_literal("{\"ok\":true}"),")) else")) in
    let status=if dev then push(health,concat("if str_equal(request.path,\"/_neokit/dev\") then web_json(let status=fs_read(env_get(\"NEOKIT_DEV_STATUS\").value) in if status.ok then status.value else ",
      tpl_literal("{\"revision\":0,\"error\":null}"),") else")) else health in
    let dispatch_routes=gen_dispatch_routes(server,site,routes,common.apis,snapshots)? in
    let order=route_precedence_order(gen_keys(dispatch_routes)) in
    let dispatched=loop (out=status, i=0) while i<len(order) next (push(out,gen_pair_at(dispatch_routes,gen_int_at(order,i)).value), i+1) yield out in
    let ended=push(dispatched,"neokit_not_found()") in
    let apis=gen_sorted_apis(common.apis.apis) in
    let all_paths=common.all_paths in
    let stream_dispatch=loop (o=text_empty(), i=0) while i<len(apis)
      next (let api=gen_api_at(apis,i) in
            if !api.streaming then o else
            let blocked=text_join(push(gen_prior(all_paths,api.url),"str_equal(request.path,\"/healthz\")")," || ") in
            concat(o,"if !head && ",gen_route_condition(api.url)," && !(",blocked,") then (if !",gen_allowed_method(api.allowed),
              " then web_encode_at(web_method_not_allowed(",gen_methods_text(api.allowed),"),false,request.stamp) else ",api.handler,"(",gen_route_request(api.url,"request"),")) else "), i+1) yield o in
    let csp=site.csp in
    let guard_response=if site.has_csp then concat("neokit_policy(guard,",tpl_literal(csp),")") else "guard" in
    let guard=if len(site.before)>0 then concat("let guard=",site.before,"(request) in if guard.status!=0 then web_encode_at(",guard_response,",head,request.stamp) else ") else text_empty() in
    let base_dispatch="web_dispatch(request,str_equal(web_header(raw,\"x-web-fragment\"),\"1\"))" in
    let after=if len(site.after)>0 then concat(site.after,"(request,",base_dispatch,")") else base_dispatch in
    let errored=if common.server_error then push(ended,"fn web_server_error(response:WebResponse) -> WebResponse = if response.status>=500 then response with {body=text_ServerError(response.status,\"The server could not complete this request.\"),content_type=\"text/html; charset=utf-8\"} else response") else ended in
    let handled=if common.server_error then concat("web_server_error(",after,")") else after in
    let dispatch=if site.has_csp then concat("neokit_policy(",handled,",",tpl_literal(csp),")") else handled in
    let asyncs=common.apis.asyncs in
    let async_stream_dispatch=loop (o=text_empty(), i=0) while i<len(apis)
      next (let api=gen_api_at(apis,i) in
            if !api.streaming || !gen_async_has(asyncs,api.url) then o else
            let prior=gen_prior(all_paths,api.url) in
            let condition=if len(prior)>0 then concat(gen_route_condition(api.url)," && !(",text_join(prior," || "),")") else gen_route_condition(api.url) in
            concat(o,"if !head && ",condition," then (if !",gen_allowed_method(api.allowed)," then web_encode_close_at(web_method_not_allowed(",gen_methods_text(api.allowed),
              "),false,request.stamp) else ",api.handler,"(",gen_route_request(api.url,"request"),")) else "), i+1) yield o in
    let buffered=concat("effect(fs,net,env,time,process) fn web_handle_buffered(raw:Arr u8 n)->Arr u8 _ = let clock=time_unix_ms() in let request=web_request(raw,clock.value) in let head=str_equal(request.method,\"HEAD\") in ",
      guard,async_stream_dispatch,"web_encode_close_at(",dispatch,",head,request.stamp)") in
    let async_order=route_precedence_order(arr(i in 0..len(asyncs)) gen_async_at(asyncs,i).url) in
    let async_dispatch=loop (o=text_empty(), i=0) while i<len(async_order)
      next (let item=gen_async_at(asyncs,gen_int_at(async_order,i)) in
            let prior=push(gen_prior(all_paths,item.url),"str_equal(request.path,\"/healthz\")") in
            let prior_dev=if dev then push(prior,"str_equal(request.path,\"/_neokit/dev\")") else prior in
            let condition=concat(gen_route_condition(item.url)," && !(",text_join(prior_dev," || "),")") in
            concat(o,"if ",condition," then let timer=deadline_after(",text_int(item.timeout),") in let started=http_response_async(raw,function(web_handle_buffered),timer.value) in if started.ok then started.value else web_encode_at(web_reply(503,\"Async capacity unavailable\",\"text/plain; charset=utf-8\"),head,request.stamp) else "), i+1) yield o in
    let with_buffered=if len(asyncs)>0 then push(errored,buffered) else errored in
    let observed=site.access_log || site.timing in
    let measured=if site.timing then "web_server_timing(wire,start.value,end.value)" else "wire" in
    let traced=if site.access_log then concat("web_trace(raw,",measured,",start.value,end.value)") else measured in
    let observed_code=if observed then concat("effect fn observed_handle(raw:Arr u8 n) -> Arr u8 _ = let start=monotonic_ns() in let wire=web_handle(raw) in let end=monotonic_ns() in ",traced,"\n") else text_empty() in
    let handle=concat("effect fn web_handle(raw: Arr u8 n) -> Arr u8 _ = let clock=time_unix_ms() in let request=web_request(raw,clock.value) in let head=str_equal(request.method,\"HEAD\") in ",
      async_dispatch,guard,stream_dispatch,"web_encode_at(",dispatch,",head,request.stamp)") in
    let events=if len(common.apis.realtime)>0 then concat("let events=events_configure(",text_int(site.realtime.channels),",",text_int(site.realtime.history),",",text_int(site.realtime.payload),") in check events.ok in ") else text_empty() in
    let startup=if len(site.startup)>0 then concat("let startup=",site.startup,"() in check startup.ok in ") else text_empty() in
    let main=concat(observed_code,"effect fn main(port: i64{port>0,port<65536}) -> i64 = let configured=http_server_options(",text_int(site.grace),",true) in check configured.ok in ",
      events,startup,"serve_effect(port,",if observed then "observed_handle" else "web_handle",")") in
    gen_ok(concat(text_join(push(push(with_buffered,handle),main),"\n"),"\n"))

; ---------------------------------------------------------------- snapshots and manifest

private effect(fs,process) fn gen_write_file(borrow path:Arr u8 _, borrow data:Arr u8 _) -> Result<i64,Arr u8 _>
  = let made=host_mkdirs(host_parent(path))? in host_write_bytes(path,data)
private effect(fs,process) fn gen_write_all(borrow directory:Arr u8 _, borrow pairs:Arr MetaPair _, pages:bool) -> Result<i64,Arr u8 _>
  = let err=loop (err=text_empty(), i=0) while len(err)==0 && i<len(pairs)
      next (let pair=gen_pair_at(pairs,i) in
            let destination=if pages then gen_snapshot_file(directory,pair.key) else host_join(directory,text_lstrip_chars(pair.key,"/")) in
            match gen_write_file(destination,pair.value) { Err(message) => message, Ok(count) => text_empty() }, i+1) yield err in
    if len(err)>0 then Err::<i64,Arr u8 _>(err) else Ok::<i64,Arr u8 _>(0)
private effect(fs,process) fn gen_write_extra(borrow directory:Arr u8 _, borrow name:Arr u8 _, borrow data:Arr u8 _, wanted:bool) -> Result<i64,Arr u8 _>
  = if !wanted then Ok::<i64,Arr u8 _>(0) else
    let made=host_mkdirs(directory)? in host_write_bytes(host_join(directory,name),data)
; snapshots/: the exported pages, 404.html, _redirects and _headers for
; static hosts, and every embedded file.
private effect(fs,process) fn gen_write_snapshots(borrow out:Arr u8 _, borrow target:Arr u8 _, borrow rendered:GenRendered, borrow site:GenSite,
    borrow files:Arr MetaPair _) -> Result<i64,Arr u8 _>
  = let directory=host_join(out,"snapshots") in
    let cleared=gen_remove_existing(directory)? in
    let pages=gen_write_all(directory,rendered.snapshots,true)? in
    let hosted=!text_equal(target,"server") in
    let missing=gen_write_extra(directory,"404.html",rendered.page_404,rendered.has_404 && hosted)? in
    let redirects=loop (o=text_empty(), i=0) while i<len(site.redirects)
      next (let rule=gen_redirect_at(site.redirects,i) in concat(o,rule.source," ",rule.target," ",text_int(rule.status),"\n"), i+1) yield o in
    let moved=gen_write_extra(directory,"_redirects",redirects,len(site.redirects)>0 && hosted)? in
    let headers=gen_write_extra(directory,"_headers",concat("/*\n  Content-Security-Policy: ",site.csp,"\n"),site.has_csp && hosted)? in
    gen_write_all(directory,files,false)
private effect(fs,env,process,time) fn gen_build_server(borrow root:Arr u8 _, borrow out:Arr u8 _, borrow target:Arr u8 _, borrow profile:Arr u8 _, borrow package_root:Arr u8 _) -> Result<Arr u8 _,Arr u8 _>
  = if text_equal(target,"static") then gen_ok(text_empty())
    else gen_native_build(root,host_join(out,"generated/server.neo"),host_join(out,"server"),profile,package_root)
private effect(fs,env,process,time) fn gen_build_revalidator(borrow root:Arr u8 _, borrow out:Arr u8 _, borrow target:Arr u8 _, borrow routes:Arr GenRoute _, borrow package_root:Arr u8 _) -> Result<Arr u8 _,Arr u8 _>
  = let stale=loop (i=0, found=false) while !found && i<len(routes) next (i+1, gen_route_at(routes,i).stale>0) yield found in
    if text_equal(target,"static") || !stale then gen_ok(text_empty())
    else gen_native_build(root,host_join(root,"src/revalidate.neo"),host_join(out,"revalidate"),"release",package_root)
private effect(fs,env,process,time) fn gen_build_migration_if(borrow root:Arr u8 _, borrow app:Arr u8 _, borrow out:Arr u8 _, borrow target:Arr u8 _) -> Result<Arr u8 _,Arr u8 _>
  = if text_equal(target,"static") || !host_is_file(host_join(app,"app/migrate.neo")) then gen_ok(text_empty()) else gen_build_migration(root,app,out)
private fn gen_jtext(borrow text:Arr u8 _) -> Json = json_value_string(text).value
private fn gen_jtexts(borrow texts:Arr Arr u8 _ _) -> Json = json_value_array(arr(i in 0..len(texts)) gen_jtext(text_word(texts,i))).value
private fn gen_jobject(borrow keys:Arr Arr u8 _ _, borrow values:Arr Json _) -> Json = json_value_object(keys,values).value
private fn gen_joptional(borrow text:Arr u8 _) -> Json = if len(text)>0 then gen_jtext(text) else json_value_null()
private fn gen_no_json() -> Arr Json _ = arr(i in 0..0) json_value_null()
private fn gen_route_json(borrow route:GenRoute) -> Json
  = gen_jobject(push(push(push(push(push(push(text_words(),"path"),"mode"),"async"),"client"),"export"),"paths"),
      push(push(push(push(push(push(gen_no_json(),gen_jtext(route.path)),gen_jtext(route.mode)),json_value_bool(route.is_async)),
        json_value_bool(route.client)),json_value_bool(route.exported)),gen_jtexts(route.paths)))
private fn gen_pairs_json(borrow pairs:Arr MetaPair _) -> Json
  = gen_jobject(gen_keys(pairs),arr(i in 0..len(pairs)) gen_jtext(gen_pair_at(pairs,i).value))
private fn gen_files_json(borrow files:Arr MetaPair _) -> Json
  = gen_jobject(gen_keys(files),arr(i in 0..len(files))
      gen_jobject(gen_two("bytes","sha256"),push(push(gen_no_json(),json_value_int(len(gen_pair_at(files,i).value))),gen_jtext(host_sha256_hex(gen_pair_at(files,i).value)))))
private fn gen_redirects_json(borrow rules:Arr GenRedirect _) -> Json
  = json_value_array(arr(i in 0..len(rules))
      gen_jobject(push(gen_two("source","target"),"status"),push(push(push(gen_no_json(),gen_jtext(gen_redirect_at(rules,i).source)),gen_jtext(gen_redirect_at(rules,i).target)),
        json_value_int(gen_redirect_at(rules,i).status)))).value
type GenOutputs = { migration:Arr u8 _, revalidator:Arr u8 _, server_bytes:i64 }
; build()'s manifest.json.
private fn gen_manifest(borrow app:Arr u8 _, borrow routes:Arr GenRoute _, borrow assets:Arr MetaPair _, borrow files:Arr MetaPair _,
    borrow rendered:GenRendered, borrow apis:Arr GenApi _, borrow site:GenSite, borrow target:Arr u8 _, borrow profile:Arr u8 _, borrow outputs:GenOutputs) -> Json
  = let omitted=text_concat_words(loop (out=text_words(), i=0) while i<len(routes)
        next (let route=gen_route_at(routes,i) in if route.exported then out else push(out,route.path), i+1) yield out,
      arr(i in 0..len(apis)) gen_api_at(apis,i).url) in
    let js=loop (total=0, i=0) while i<len(files) next (let file=gen_pair_at(files,i) in if text_ends(file.key,".js") then total+len(file.value) else total, i+1) yield total in
    let keys=push(push(push(push(push(push(push(push(push(push(push(push(push(push(push(text_words(),"app"),"routes"),"assets"),"files"),"exported_paths"),
      "available_export_paths"),"omitted_server_routes"),"redirects"),"not_found_page"),"build_target"),"profile"),"migration_binary"),"revalidator_binary"),
      "server_bytes"),"browser_js_bytes") in
    let values=push(push(push(push(push(push(push(push(push(push(push(push(push(push(push(gen_no_json(),gen_jtext(app)),
      json_value_array(arr(i in 0..len(routes)) gen_route_json(gen_route_at(routes,i))).value),gen_pairs_json(assets)),gen_files_json(files)),
      gen_jtexts(gen_keys(rendered.snapshots))),gen_jtexts(rendered.available)),gen_jtexts(omitted)),gen_redirects_json(site.redirects)),
      json_value_bool(rendered.has_404)),gen_jtext(target)),gen_jtext(profile)),gen_joptional(outputs.migration)),
      gen_joptional(outputs.revalidator)),if outputs.server_bytes<0 then json_value_null() else json_value_int(outputs.server_bytes)),json_value_int(js)) in
    gen_jobject(keys,values)

; ---------------------------------------------------------------- build

type GenBuilt = { out:Arr u8 _, manifest:Json }
type GenMerged = { bundle:GenBundle, err:Arr u8 _ }
; Adds generated_assets()'s files and bindings to the bundle (writing the
; /_web/ ones into out/assets in development).
private effect(fs,process) fn gen_merge_generated(borrow out:Arr u8 _, borrow bundle:GenBundle, borrow extra:MetaAssets, dev:bool) -> Result<GenBundle,Arr u8 _>
  = let assets=loop (a=bundle.assets, i=0) while i<len(extra.bindings) next (gen_pair_put(a,gen_pair_at(extra.bindings,i).key,gen_pair_at(extra.bindings,i).value), i+1) yield a in
    let merged=loop (s=GenFiles { files=bundle.files, err=text_empty() }, i=0) while len(s.err)==0 && i<len(extra.files)
      next (let pair=gen_pair_at(extra.files,i) in
            if gen_pair_index(s.files,pair.key)>=0 then GenFiles { files=meta_no_pairs(), err=concat("Generated asset conflicts with public file: ",pair.key) } else
            let written=if dev && text_starts(pair.key,"/_web/") then gen_write_web_files(out,push(meta_no_pairs(),pair)) else Ok::<i64,Arr u8 _>(0) in
            match written { Err(message) => GenFiles { files=meta_no_pairs(), err=message }, Ok(count) => s with { files=push(s.files,pair) } }, i+1) yield s in
    if len(merged.err)>0 then Err::<GenBundle,Arr u8 _>(merged.err) else Ok::<GenBundle,Arr u8 _>(GenBundle { assets=assets, files=merged.files })
private fn gen_built_err(borrow message:Arr u8 _) -> Result<GenBuilt,Arr u8 _> = Err::<GenBuilt,Arr u8 _>(message)
; build(app, out, target=target, profile=profile).
effect(fs,env,process,time) fn gen_build(borrow root:Arr u8 _, borrow app_arg:Arr u8 _, borrow out_arg:Arr u8 _, borrow target:Arr u8 _, borrow profile:Arr u8 _) -> Result<GenBuilt,Arr u8 _>
  = if !(text_equal(target,"server") || text_equal(target,"static") || text_equal(target,"all")) then gen_built_err("Build target must be server, static or all")
    else if !(text_equal(profile,"release") || text_equal(profile,"dev")) then gen_built_err("Build profile must be release or dev") else
    let dev=text_equal(profile,"dev") in
    let app=host_resolve(if len(app_arg)==0 then host_join(root,"examples/studio") else app_arg)? in
    if !host_is_file(host_join(app,"web.toml")) then gen_built_err(concat("No web.toml in ",app)) else
    let out=host_resolve(if len(out_arg)==0 then host_join(root,"build/studio") else out_arg)? in
    let valid=gen_validate_output(root,app,out)? in
    let made=host_mkdirs(out)? in
    let marker=host_write_text(host_join(out,".neokit-build"),"neokit v0.1\n")? in
    let generated=host_mkdir(host_join(out,"generated"),false,true)? in
    let package_root=gen_package_context(root,app)? in
    let config=gen_load_toml(host_join(app,"web.toml"))? in
    let site=gen_site(config,dev)? in
    let discovered=gen_discover(app)? in
    let routes=gen_resolve_paths(root,discovered,out,profile,package_root)? in
    let bundle=gen_bundle_assets(root,app,out,profile)? in
    let public=gen_public_urls(app) in
    let extra=meta_generated_assets(app,config,gen_exported_paths(routes),host_join(out,".image-cache"))? in
    let merged=gen_merge_generated(out,bundle,extra,dev)? in
    let views=gen_views(app,dev)? in
    let common=gen_common(root,app,dev,site,routes,views,merged)? in
    let common_written=host_write_text(host_join(out,"generated/common.neo"),concat(text_join(common.code,"\n"),"\n"))? in
    let rendered=gen_render_pages(root,out,target,profile,package_root,routes,common.not_found)? in
    let public_dir=host_resolve(host_join(app,"public"))? in
    let server=GenServer { dev=dev, target=target, public_dir=public_dir, assets_dir=host_join(out,"assets") } in
    let server_code=gen_server_code(server,site,routes,common,merged.files,public,rendered.snapshots)? in
    let server_written=host_write_text(host_join(out,"generated/server.neo"),server_code)? in
    let server_built=gen_build_server(root,out,target,profile,package_root)? in
    let snapshots=gen_write_snapshots(out,target,rendered,site,merged.files)? in
    let revalidator=gen_build_revalidator(root,out,target,routes,package_root)? in
    let migration=gen_build_migration_if(root,app,out,target)? in
    let size=if text_equal(target,"static") then Ok::<i64,Arr u8 _>(-1) else host_size(host_join(out,"server")) in
    let server_bytes=size? in
    let manifest=gen_manifest(app,routes,merged.assets,merged.files,rendered,common.apis.apis,site,target,profile,
      GenOutputs { migration=migration, revalidator=revalidator, server_bytes=server_bytes }) in
    let manifest_written=host_write_text(host_join(out,"manifest.json"),concat(pj_dumps_indent2(manifest),"\n"))? in
    Ok::<GenBuilt,Arr u8 _>(GenBuilt { out=out, manifest=manifest })

; build_migration(app, out): builds app/migrate.neo's migration runner as
; out/migrate and returns its path.
effect(fs,env,process,time) fn gen_build_migration(borrow root:Arr u8 _, borrow app_arg:Arr u8 _, borrow out_arg:Arr u8 _) -> Result<Arr u8 _,Arr u8 _>
  = let app=host_resolve(app_arg)? in let out=host_resolve(out_arg)? in
    let valid=gen_validate_output(root,app,out)? in
    let source=host_join(app,"app/migrate.neo") in
    if !host_is_file(source) then gen_err("Application has no app/migrate.neo migration entry") else
    let config=gen_load_toml(host_join(app,"web.toml"))? in
    let server=toml_get_table(config,"server") in
    if !server.ok then gen_err("[server] must be a table") else
    let handler=toml_get_text(server.value,"migrate","migrate") in
    if !handler.ok || !tpl_name(handler.value) then gen_err("[server] migrate must name a Neo function returning IntResult") else
    let made=host_mkdirs(host_join(out,"generated"))? in
    let marker=host_write_text(host_join(out,".neokit-build"),"neokit v0.1\n")? in
    let generated=host_join(out,"generated/migrate.neo") in
    let written=host_write_text(generated,concat("import \"std:process\"\nimport ",tpl_literal(source),"\neffect fn main()->unit = let result=",handler.value,
      "() in if !result.ok then let error=print_error(result.error.message) in process_exit(1) else let done=print_out(\"Migrations applied\\n\") in noop()\n"))? in
    let package_root=gen_package_context(root,app)? in
    gen_native_build(root,generated,host_join(out,"migrate"),"release",package_root)

