; NeoKit's typed HTML template compiler (.view files). Section names such as
; validate_html and compile_template are public functions without their
; tpl_ prefix; a failure is Err(message) with the message neokit prints.
;
; Text is UTF-8 bytes. Template sources are read with universal newlines,
; so callers translate CRLF and lone CR to LF before tpl_parse. Dicts are
; arrays of TplPair in insertion order; component dicts are arrays of templates
; looked up by template name (the build keys them by the same name).
;
; The cited regular expressions, str methods and html.parser are rewritten as
; scanners with the same matching (including the backtracking cases). Their
; Unicode classes and case mappings, repr() and html.unescape are cli/text.neo's
; (text_is_word_char, text_is_decimal, text_lower_unicode, text_fold_code,
; text_repr, text_html_unescape), built on the tables generated at its end.
import "std:strings"
import "std:option"
import "std:result"
import "text.neo"

; ---------------------------------------------------------------- types

; One entry of a dict with str keys and values.
type TplPair = { key:Arr u8 _, value:Arr u8 _ }
; An @type record: its name and fields (name to kind) in order.
type TplType = { name:Arr u8 _, fields:Arr TplPair _ }
; templates.Template: props and types keep declaration order.
type TplTemplate = { name:Arr u8 _, props:Arr TplPair _, body:Arr u8 _, path:Arr u8 _, types:Arr TplType _ }
; compile_template's (code, dependencies, expression).
type TplCompiled = { code:Arr u8 _, deps:Arr Arr u8 _ _, expression:Arr u8 _ }
; compile_all's code and the expressions dict it fills (template name to the
; template's text_ expression).
type TplAll = { code:Arr u8 _, expressions:Arr TplPair _ }

fn tpl_no_pairs() -> Arr TplPair _ = arr(i in 0..0) TplPair { key="", value="" }
fn tpl_no_words() -> Arr Arr u8 _ _ = arr(i in 0..0) tpl_empty()
fn tpl_no_types() -> Arr TplType _ = arr(i in 0..0) TplType { name="", fields=tpl_no_pairs() }
fn tpl_no_templates() -> Arr TplTemplate _
  = arr(i in 0..0) TplTemplate { name="", props=tpl_no_pairs(), body="", path="", types=tpl_no_types() }

; ---------------------------------------------------------------- bytes

private fn tpl_empty() -> Arr u8 _ = arr(i in 0..0) u8(0)
private fn tpl_b(borrow t:Arr u8 _, i:i64) -> i64 = if i>=0 && i<len(t) then i64(t[i]) else -1
private fn tpl_eq(borrow a:Arr u8 _, borrow b:Arr u8 _) -> bool = len(a)==len(b) && bytes_match_at(a,0,b)
private fn tpl_starts(borrow t:Arr u8 _, borrow prefix:Arr u8 _) -> bool = bytes_match_at(t,0,prefix)
private fn tpl_ends(borrow t:Arr u8 _, borrow suffix:Arr u8 _) -> bool
  = len(suffix)<=len(t) && bytes_match_at(t,len(t)-len(suffix),suffix)

; The bytes of t from a to b, for nonnegative a: bounds clamp and an empty
; range is "".
private fn tpl_slice(borrow t:Arr u8 _, a:i64, b:i64) -> Arr u8 _
  = let n=len(t) in
    let s=if a<0 then 0 else if a>n then n else a in
    let e=if b<0 then 0 else if b>n then n else b in
    if e<=s then tpl_empty() else byte_slice(t,s,e)

private fn tpl_find(borrow t:Arr u8 _, borrow needle:Arr u8 _, from:i64) -> i64
  = loop (i=if from<0 then 0 else from, found= -1) while found<0 && i+len(needle)<=len(t)
      next (i+1, if bytes_match_at(t,i,needle) then i else -1) yield found
private fn tpl_find_byte(borrow t:Arr u8 _, byte:i64, from:i64) -> i64
  = loop (i=if from<0 then 0 else from, found= -1) while found<0 && i<len(t)
      next (i+1, if tpl_b(t,i)==byte then i else -1) yield found
private fn tpl_contains(borrow t:Arr u8 _, borrow needle:Arr u8 _) -> bool = tpl_find(t,needle,0)>=0
; '{{' in text or '{%' in text
private fn tpl_has_open(borrow t:Arr u8 _) -> bool = tpl_contains(t,"{{") || tpl_contains(t,"{%")

private fn tpl_word_at(borrow words:Arr Arr u8 _ _, i:i64) -> Arr u8 _
  = if i>=0 && i<len(words) then words[i] else tpl_empty()
private fn tpl_set_word(move words:Arr Arr u8 _ _, i:i64, borrow word:Arr u8 _) -> Arr Arr u8 _ _
  = if i>=0 && i<len(words) then set(words,i,word) else words
private fn tpl_pop(borrow words:Arr Arr u8 _ _) -> Arr Arr u8 _ _
  = loop (o=tpl_no_words(), i=0) while i+1<len(words) next (push(o,tpl_word_at(words,i)), i+1) yield o
private fn tpl_words_have(borrow words:Arr Arr u8 _ _, borrow word:Arr u8 _) -> bool
  = loop (i=0, found=false) while !found && i<len(words) next (i+1, i>=0 && i<len(words) && tpl_eq(words[i],word)) yield found
private fn tpl_join(borrow words:Arr Arr u8 _ _, borrow sep:Arr u8 _) -> Arr u8 _
  = loop (o=tpl_empty(), i=0) while i<len(words)
      next (if i==0 then concat(o,tpl_word_at(words,i)) else concat(o,sep,tpl_word_at(words,i)), i+1) yield o

private fn tpl_alpha(b:i64) -> bool = (b>=65 && b<=90) || (b>=97 && b<=122)
private fn tpl_ident_start(b:i64) -> bool = tpl_alpha(b) || b==95
private fn tpl_ascii_digit(b:i64) -> bool = b>=48 && b<=57
private fn tpl_ascii_lower(b:i64) -> i64 = if b>=65 && b<=90 then b+32 else b
; ASCII case-insensitive match of an ASCII word at t[at:] (re.ASCII|re.I).
private fn tpl_ascii_ci_at(borrow t:Arr u8 _, at:i64, borrow word:Arr u8 _) -> bool
  = loop (k=0, same=true) while same && k<len(word)
      next (k+1, tpl_b(t,at+k)>=0 && tpl_ascii_lower(tpl_b(t,at+k))==tpl_b(word,k)) yield same

; ---------------------------------------------------------------- code points

; Bytes in the UTF-8 sequence starting at i (0 at the end).
private fn tpl_width(borrow t:Arr u8 _, i:i64) -> i64
  = let b=tpl_b(t,i) in if b<0 then 0 else
    let w=if b<192 then 1 else if b<224 then 2 else if b<240 then 3 else 4 in
    if i+w<=len(t) then w else len(t)-i
private fn tpl_code(borrow t:Arr u8 _, i:i64) -> i64
  = let b=tpl_b(t,i) in let w=tpl_width(t,i) in
    if w<=1 then b
    else if w==2 then bit_and(b,31)*64+bit_and(tpl_b(t,i+1),63)
    else if w==3 then bit_and(b,15)*4096+bit_and(tpl_b(t,i+1),63)*64+bit_and(tpl_b(t,i+2),63)
    else bit_and(b,7)*262144+bit_and(tpl_b(t,i+1),63)*4096+bit_and(tpl_b(t,i+2),63)*64+bit_and(tpl_b(t,i+3),63)
; Start of the code point that ends at i.
private fn tpl_prev(borrow t:Arr u8 _, i:i64) -> i64
  = loop (j=i-1) while j>0 && tpl_b(t,j)>=128 && tpl_b(t,j)<192 next (j-1) yield j

; str.isspace(), which is also re's \s for str patterns. re's \w and \d,
; str.lower() and re.IGNORECASE's case folding are text_is_word_char,
; text_is_decimal, text_lower_unicode and text_fold_code (cli/text.neo).
private fn tpl_space(code:i64) -> bool
  = (code>=9 && code<=13) || (code>=28 && code<=32) || code==133 || code==160 || code==5760
    || (code>=8192 && code<=8202) || code==8232 || code==8233 || code==8239 || code==8287 || code==12288

; str.strip() and the \s* and [\w.]* runs of the template regexes.
private fn tpl_skip_space(borrow t:Arr u8 _, i:i64) -> i64
  = loop (j=i) while j>=0 && j<len(t) && tpl_space(tpl_code(t,j)) next (j+tpl_width(t,j)) yield j
private fn tpl_skip_word(borrow t:Arr u8 _, i:i64, dots:bool) -> i64
  = loop (j=i) while j>=0 && j<len(t) && (text_is_word_char(tpl_code(t,j)) || (dots && tpl_b(t,j)==46)) next (j+tpl_width(t,j)) yield j
private fn tpl_strip(borrow t:Arr u8 _) -> Arr u8 _
  = let start=tpl_skip_space(t,0) in
    let end=loop (j=len(t)) while j>start && tpl_space(tpl_code(t,tpl_prev(t,j))) next (tpl_prev(t,j)) yield j in
    tpl_slice(t,start,end)

; str.split(sep) for a one-byte separator.
private fn tpl_split(borrow t:Arr u8 _, sep:i64) -> Arr Arr u8 _ _
  = loop (o=tpl_no_words(), start=0, i=0) while i<len(t)
      next (if tpl_b(t,i)==sep then push(o,tpl_slice(t,start,i)) else o,
            if tpl_b(t,i)==sep then i+1 else start, i+1)
      yield push(o,tpl_slice(t,start,len(t)))
; str.split() with no separator.
private fn tpl_split_space(borrow t:Arr u8 _) -> Arr Arr u8 _ _
  = loop (o=tpl_no_words(), start= -1, i=0) while i<len(t)
      next (if tpl_space(tpl_code(t,i)) && start>=0 then push(o,tpl_slice(t,start,i)) else o,
            if tpl_space(tpl_code(t,i)) then -1 else if start<0 then i else start,
            i+tpl_width(t,i))
      yield if start>=0 then push(o,tpl_slice(t,start,len(t))) else o

; ---------------------------------------------------------------- repr

; repr() of a str.
fn tpl_repr(borrow text:Arr u8 _) -> Arr u8 _ = text_repr(text)
; repr() of a list of str: the keys of a dict, as list(d) prints.
private fn tpl_keys_repr(borrow pairs:Arr TplPair _) -> Arr u8 _
  = let inner=loop (o=tpl_empty(), i=0) while i<len(pairs)
      next (if i==0 then concat(o,tpl_repr(tpl_pair_at(pairs,i).key)) else concat(o,", ",tpl_repr(tpl_pair_at(pairs,i).key)), i+1)
      yield o in
    concat("[",inner,"]")

; ---------------------------------------------------------------- dicts

private fn tpl_pair_at(borrow pairs:Arr TplPair _, i:i64) -> TplPair
  = if i>=0 && i<len(pairs) then pairs[i] else TplPair { key=tpl_empty(), value=tpl_empty() }
; Position of key in a dict, or -1.
fn tpl_index(borrow pairs:Arr TplPair _, borrow key:Arr u8 _) -> i64
  = loop (i=0, found= -1) while found<0 && i<len(pairs)
      next (i+1, if i>=0 && i<len(pairs) && tpl_eq(pairs[i].key,key) then i else -1) yield found
fn tpl_has(borrow pairs:Arr TplPair _, borrow key:Arr u8 _) -> bool = tpl_index(pairs,key)>=0
; d.get(key, "")
fn tpl_get(borrow pairs:Arr TplPair _, borrow key:Arr u8 _) -> Arr u8 _ = tpl_pair_at(pairs,tpl_index(pairs,key)).value
; d[key]=value
fn tpl_put(move pairs:Arr TplPair _, borrow key:Arr u8 _, borrow value:Arr u8 _) -> Arr TplPair _
  = let i=tpl_index(pairs,key) in
    if i>=0 && i<len(pairs) then set(pairs,i,TplPair { key=key, value=value }) else push(pairs,TplPair { key=key, value=value })
; del d[key]
private fn tpl_drop(borrow pairs:Arr TplPair _, borrow key:Arr u8 _) -> Arr TplPair _
  = let at=tpl_index(pairs,key) in
    loop (o=tpl_no_pairs(), i=0) while i<len(pairs) next (if i==at then o else push(o,tpl_pair_at(pairs,i)), i+1) yield o

private fn tpl_type_index(borrow types:Arr TplType _, borrow name:Arr u8 _) -> i64
  = loop (i=0, found= -1) while found<0 && i<len(types)
      next (i+1, if i>=0 && i<len(types) && tpl_eq(types[i].name,name) then i else -1) yield found
private fn tpl_type_fields(borrow types:Arr TplType _, i:i64) -> Arr TplPair _
  = if i>=0 && i<len(types) then types[i].fields else tpl_no_pairs()
; The component named name; like a dict built from the array, the last one
; with that name wins.
private fn tpl_template_index(borrow templates:Arr TplTemplate _, borrow name:Arr u8 _) -> i64
  = loop (i=len(templates)-1, found= -1) while found<0 && i>=0
      next (i-1, if i>=0 && i<len(templates) && tpl_eq(templates[i].name,name) then i else -1) yield found
private fn tpl_template_props(borrow templates:Arr TplTemplate _, i:i64) -> Arr TplPair _
  = if i>=0 && i<len(templates) then templates[i].props else tpl_no_pairs()

; ---------------------------------------------------------------- literal

; A Neo string literal holding value's bytes.
fn tpl_literal(borrow value:Arr u8 _) -> Arr u8 _
  = let body=loop (o=push(tpl_empty(),u8(34)), i=0) while i<len(value)
      next (let b=tpl_b(value,i) in
            if b==10 then concat(o,"\\n") else if b==13 then concat(o,"\\r") else if b==9 then concat(o,"\\t")
            else if b==34 then concat(o,"\\\"") else if b==92 then concat(o,"\\\\")
            else if b>=32 && b<127 then push(o,u8(b)) else concat(o,"\\x",text_hex(b,2)),
            i+1) yield o in
    push(body,u8(34))

; ---------------------------------------------------------------- types

private fn tpl_type_help() -> Arr u8 _ = "types: text, int, bool, html, url, text[], int[], bool[], html[], and @type records"
; TYPES[kind], or "" when kind is not a built-in type.
private fn tpl_builtin_native(borrow kind:Arr u8 _) -> Arr u8 _
  = if tpl_eq(kind,"text") then "Arr u8 _" else if tpl_eq(kind,"int") then "i64" else if tpl_eq(kind,"bool") then "bool"
    else if tpl_eq(kind,"html") then "WebHtml" else if tpl_eq(kind,"url") then "WebURL"
    else if tpl_eq(kind,"text[]") then "Arr Arr u8 _ _" else if tpl_eq(kind,"int[]") then "Arr i64 _"
    else if tpl_eq(kind,"bool[]") then "Arr bool _" else if tpl_eq(kind,"html[]") then "Arr WebHtml _" else ""
private fn tpl_builtin(borrow kind:Arr u8 _) -> bool = len(tpl_builtin_native(kind))>0
private fn tpl_record_list(borrow kind:Arr u8 _, borrow types:Arr TplType _) -> bool
  = tpl_ends(kind,"[]") && tpl_type_index(types,tpl_slice(kind,0,len(kind)-2))>=0

fn tpl_known(borrow kind:Arr u8 _, borrow types:Arr TplType _) -> bool
  = tpl_builtin(kind) || tpl_type_index(types,kind)>=0 || tpl_record_list(kind,types)

fn tpl_native(borrow kind:Arr u8 _, borrow types:Arr TplType _) -> Result<Arr u8 _,Arr u8 _>
  = if tpl_builtin(kind) then Ok::<Arr u8 _,Arr u8 _>(tpl_builtin_native(kind))
    else if tpl_type_index(types,kind)>=0 then Ok::<Arr u8 _,Arr u8 _>(kind)
    else if tpl_record_list(kind,types) then Ok::<Arr u8 _,Arr u8 _>(concat("Arr ",tpl_slice(kind,0,len(kind)-2)," _"))
    else Err::<Arr u8 _,Arr u8 _>(concat("Unknown template type ",tpl_repr(kind)))

; ---------------------------------------------------------------- fields and parse

; NAME.fullmatch: an ASCII identifier. The build uses NAME for loader,
; handler and component names too.
fn tpl_name(borrow t:Arr u8 _) -> bool
  = len(t)>0 && tpl_ident_start(tpl_b(t,0)) &&
    loop (i=1, ok=true) while ok && i<len(t) next (i+1, tpl_ident_start(tpl_b(t,i)) || tpl_ascii_digit(tpl_b(t,i))) yield ok

type TplFieldsState = { result:Arr TplPair _, err:Arr u8 _ }
private fn tpl_field(move s:TplFieldsState, borrow item:Arr u8 _, borrow path:Arr u8 _, borrow types:Arr TplType _) -> TplFieldsState
  = if len(tpl_strip(item))==0 then s else
    let parts=tpl_split(item,58) in
    let key=tpl_strip(tpl_word_at(parts,0)) in let kind=tpl_strip(tpl_word_at(parts,1)) in
    if len(parts)!=2 || !tpl_name(key) || tpl_has(s.result,key) || !tpl_known(kind,types) then
      s with { err=concat(path,": invalid/duplicate prop ",tpl_repr(item),"; ",tpl_type_help()) }
    else s with { result=push(s.result,TplPair { key=key, value=kind }) }

fn tpl_fields(borrow text:Arr u8 _, borrow path:Arr u8 _, borrow types:Arr TplType _) -> Result<Arr TplPair _,Arr u8 _>
  = let items=tpl_split(text,44) in
    let s=loop (st=TplFieldsState { result=tpl_no_pairs(), err=tpl_empty() }, i=0) while len(st.err)==0 && i<len(items)
      next (tpl_field(st,tpl_word_at(items,i),path,types), i+1) yield st in
    if len(s.err)>0 then Err::<Arr TplPair _,Arr u8 _>(s.err) else Ok::<Arr TplPair _,Arr u8 _>(s.result)

; Group 1 of a fullmatch of `(.*)\)\s*` against line[start:]: everything up to
; the last ')' when only whitespace follows it.
private fn tpl_paren_tail(borrow line:Arr u8 _, start:i64) -> Option<Arr u8 _>
  = let close=loop (i=len(line)-1, found= -1) while found<0 && i>=start next (i-1, if tpl_b(line,i)==41 then i else -1) yield found in
    if close<0 || tpl_skip_space(line,close+1)!=len(line) then None::<Arr u8 _>()
    else Some::<Arr u8 _>(tpl_slice(line,start,close))
; re.fullmatch(r'@props\((.*)\)\s*', line)
private fn tpl_props_line(borrow line:Arr u8 _) -> Option<Arr u8 _>
  = if tpl_starts(line,"@props(") then tpl_paren_tail(line,7) else None::<Arr u8 _>()

type TplTypeLine = { ok:bool, name:Arr u8 _, fields:Arr u8 _ }
; re.fullmatch(r'@type\s+([A-Za-z_]\w*)\((.*)\)\s*', line)
private fn tpl_type_line(borrow line:Arr u8 _) -> TplTypeLine
  = let fail=TplTypeLine { ok=false, name=tpl_empty(), fields=tpl_empty() } in
    let at=tpl_skip_space(line,5) in
    if !tpl_starts(line,"@type") || at==5 || !tpl_ident_start(tpl_b(line,at)) then fail else
    let end=tpl_skip_word(line,at+1,false) in
    if tpl_b(line,end)!=40 then fail else
    match tpl_paren_tail(line,end+1) {
      None => fail,
      Some(fields) => TplTypeLine { ok=true, name=tpl_slice(line,at,end), fields=fields } }

type TplHeader = { index:i64, types:Arr TplType _, err:Arr u8 _ }
private fn tpl_type_decl(move s:TplHeader, borrow line:Arr u8 _, borrow path:Arr u8 _) -> TplHeader
  = let decl=tpl_type_line(line) in
    if !decl.ok then s with { err=concat(path,": use @type Name(field: text, ...)") }
    else if tpl_type_index(s.types,decl.name)>=0 || tpl_builtin(decl.name) || !(tpl_b(decl.name,0)>=65 && tpl_b(decl.name,0)<=90) then
      s with { err=concat(path,": @type ",decl.name," must be a new name starting with a capital letter") }
    else match tpl_fields(decl.fields,path,tpl_no_types()) {
      Err(e) => s with { err=e },
      Ok(fields) => s with { index=s.index+1, types=push(s.types,TplType { name=decl.name, fields=fields }) } }

private fn tpl_lines_from(borrow lines:Arr Arr u8 _ _, start:i64) -> Arr Arr u8 _ _
  = loop (o=tpl_no_words(), i=start) while i<len(lines) next (push(o,tpl_word_at(lines,i)), i+1) yield o

; Parses and validates a .view source: @props, @type lines, then the body.
fn tpl_parse(borrow name:Arr u8 _, borrow source:Arr u8 _, borrow path:Arr u8 _) -> Result<TplTemplate,Arr u8 _>
  = let lines=tpl_split(source,10) in
    match tpl_props_line(tpl_word_at(lines,0)) {
      None => Err::<TplTemplate,Arr u8 _>(concat(path,": first line must be @props(name: text, ...)")),
      Some(props_text) => tpl_parse_rest(name,lines,props_text,path) }
private fn tpl_parse_rest(borrow name:Arr u8 _, borrow lines:Arr Arr u8 _ _, borrow props_text:Arr u8 _, borrow path:Arr u8 _) -> Result<TplTemplate,Arr u8 _>
  = if len(lines)<2 then Err::<TplTemplate,Arr u8 _>(concat(path,": first line must be @props(name: text, ...)")) else
    ; Record declarations describe fields of a Neo record type the application
    ; defines. Neo's checker verifies them when the generated code compiles.
    let header=loop (s=TplHeader { index=1, types=tpl_no_types(), err=tpl_empty() })
      while len(s.err)==0 && s.index<len(lines) && tpl_starts(tpl_word_at(lines,s.index),"@type")
      next (tpl_type_decl(s,tpl_word_at(lines,s.index),path)) yield s in
    if len(header.err)>0 then Err::<TplTemplate,Arr u8 _>(header.err) else
    let props=tpl_fields(props_text,path,header.types)? in
    let template=TplTemplate { name=name, props=props, body=tpl_join(tpl_lines_from(lines,header.index),"\n"), path=path, types=header.types } in
    let valid=tpl_validate_html(template)? in
    Ok::<TplTemplate,Arr u8 _>(template)

type TplWalk = { kind:Arr u8 _, bad:i64 }
private fn tpl_walk(borrow types:Arr TplType _, move w:TplWalk, borrow part:Arr u8 _, at:i64) -> TplWalk
  = let fields=tpl_type_fields(types,tpl_type_index(types,w.kind)) in let f=tpl_index(fields,part) in
    if f<0 then w with { bad=at } else w with { kind=tpl_pair_at(fields,f).value }
; The kind of a dotted name, or None when it does not resolve.
fn tpl_resolve_kind(borrow name:Arr u8 _, borrow kinds:Arr TplPair _, borrow types:Arr TplType _) -> Option<Arr u8 _>
  = let parts=tpl_split(name,46) in let first=tpl_index(kinds,tpl_word_at(parts,0)) in
    if first<0 then None::<Arr u8 _>() else
    let walk=loop (w=TplWalk { kind=tpl_pair_at(kinds,first).value, bad= -1 }, i=1) while w.bad<0 && i<len(parts)
      next (tpl_walk(types,w,tpl_word_at(parts,i),i), i+1) yield w in
    if walk.bad>=0 then None::<Arr u8 _>() else Some::<Arr u8 _>(walk.kind)
private fn tpl_kind_is(borrow name:Arr u8 _, borrow kinds:Arr TplPair _, borrow types:Arr TplType _, borrow want:Arr u8 _) -> bool
  = match tpl_resolve_kind(name,kinds,types) { None => false, Some(kind) => tpl_eq(kind,want) }

; ---------------------------------------------------------------- tokens

; End of the TOKEN match ({{.*?}} or {%.*?%}, re.S) at i, or -1.
private fn tpl_token_end(borrow body:Arr u8 _, i:i64) -> i64
  = if tpl_b(body,i)!=123 then -1
    else if tpl_b(body,i+1)==123 then let close=tpl_find(body,"}}",i+2) in if close<0 then -1 else close+2
    else if tpl_b(body,i+1)==37 then let close=tpl_find(body,"%}",i+2) in if close<0 then -1 else close+2
    else -1

type TplSplit = { words:Arr Arr u8 _ _, start:i64, i:i64 }
private fn tpl_tokens_step(borrow body:Arr u8 _, move s:TplSplit) -> TplSplit
  = let e=tpl_token_end(body,s.i) in
    if e<0 then s with { i=s.i+1 } else
    TplSplit { words=push(push(s.words,tpl_slice(body,s.start,s.i)),tpl_slice(body,s.i,e)), start=e, i=e }
; TOKEN.split(body): text, token, text, ..., text.
fn tpl_tokens(borrow body:Arr u8 _) -> Arr Arr u8 _ _
  = let s=loop (st=TplSplit { words=tpl_no_words(), start=0, i=0 }) while st.i<len(body) next (tpl_tokens_step(body,st)) yield st in
    push(s.words,tpl_slice(body,s.start,len(body)))

; ---------------------------------------------------------------- validate_html

; Interpolation can be HTML text or a quoted attribute value, never part of a
; tag/attribute name. Escaping alone cannot make dynamic syntax safe.
type TplScan = { i:i64, in_tag:bool, quote:i64, bad:bool }
private fn tpl_scan_step(borrow body:Arr u8 _, move s:TplScan) -> TplScan
  = let e=tpl_token_end(body,s.i) in
    if e>=0 then (if s.in_tag && (s.quote==0 || tpl_b(body,s.i+1)==37) then s with { bad=true } else s with { i=e })
    else let c=tpl_b(body,s.i) in
    if !s.in_tag then s with { i=s.i+1, in_tag=c==60 }
    else if s.quote!=0 then s with { i=s.i+1, quote=if c==s.quote then 0 else s.quote }
    else if c==34 || c==39 then s with { i=s.i+1, quote=c }
    else if c==62 then s with { i=s.i+1, in_tag=false }
    else s with { i=s.i+1 }

type TplForScan = { ok:bool, end:i64, item:Arr u8 _, index:Arr u8 _, source:Arr u8 _ }
; re.match of {%\s*for\s+(\w+)(?:\s*,\s*(\w+))?\s+in\s+([\w.]+)\s*%} at p.
private fn tpl_for_scan(borrow body:Arr u8 _, p:i64) -> TplForScan
  = let fail=TplForScan { ok=false, end=p, item=tpl_empty(), index=tpl_empty(), source=tpl_empty() } in
    if tpl_b(body,p)!=123 || tpl_b(body,p+1)!=37 then fail else
    let a=tpl_skip_space(body,p+2) in
    if !bytes_match_at(body,a,"for") then fail else
    let b=tpl_skip_space(body,a+3) in
    let c=tpl_skip_word(body,b,false) in
    if b==a+3 || c==b then fail else
    let g1=tpl_skip_space(body,c) in let g2=tpl_skip_space(body,g1+1) in let g3=tpl_skip_word(body,g2,false) in
    let grouped=tpl_b(body,g1)==44 && g3>g2 in
    let after=if grouped then g3 else c in
    let d=tpl_skip_space(body,after) in
    let e=tpl_skip_space(body,d+2) in
    let f=tpl_skip_word(body,e,true) in
    let g=tpl_skip_space(body,f) in
    if d==after || !bytes_match_at(body,d,"in") || e==d+2 || f==e || !bytes_match_at(body,g,"%}") then fail else
    TplForScan { ok=true, end=g+2, item=tpl_slice(body,b,c), index=if grouped then tpl_slice(body,g2,g3) else tpl_empty(),
                 source=tpl_slice(body,e,f) }

type TplLocals = { kinds:Arr TplPair _, p:i64 }
private fn tpl_locals_step(borrow body:Arr u8 _, borrow types:Arr TplType _, move s:TplLocals) -> TplLocals
  = let m=tpl_for_scan(body,s.p) in
    if !m.ok then s with { p=s.p+1 } else
    let kind=match tpl_resolve_kind(m.source,s.kinds,types) { None => tpl_empty(), Some(k) => k } in
    let typed=if tpl_ends(kind,"[]") then tpl_put(s.kinds,m.item,tpl_slice(kind,0,len(kind)-2)) else s.kinds in
    TplLocals { kinds=if len(m.index)>0 then tpl_put(typed,m.index,"int") else typed, p=m.end }

; ----- html.parser.HTMLParser(convert_charrefs=False).feed(body), as the
; 3.12 standard library implements it; close() is never called, so an
; unterminated construct ends parsing without being reported.

private fn tpl_ws5(b:i64) -> bool = b==9 || b==10 || b==12 || b==13 || b==32       ; [\t\n\r\f ]
private fn tpl_tag_stop(b:i64) -> bool = tpl_ws5(b) || b==47 || b==62               ; [\t\n\r\f />]
private fn tpl_name_stop(b:i64) -> bool = tpl_tag_stop(b) || b==61                  ; [\t\n\r\f /=>]
private fn tpl_before_attr(b:i64) -> bool = b==34 || b==39 || tpl_ws5(b) || b==47    ; ['"\t\n\r\f /]

; End of a '...', "..." or bare attribute value at v; -1 for an unclosed quote.
private fn tpl_value_at(borrow body:Arr u8 _, v:i64) -> i64
  = let b=tpl_b(body,v) in
    if b==34 || b==39 then (let close=tpl_find_byte(body,b,v+1) in if close<0 then -1 else close+1)
    else loop (w=v) while w<len(body) && !tpl_ws5(tpl_b(body,w)) && tpl_b(body,w)!=62 next (w+1) yield w

type TplValue = { has:bool, start:i64, end:i64 }
; The optional ([\t\n\r\f ]*=[\t\n\r\f ]*(value)) after an attribute name that
; ends at a. When a quoted value is unclosed, backtracking gives one space back
; and matches an empty bare value there.
private fn tpl_value_indicator(borrow body:Arr u8 _, a:i64) -> TplValue
  = let r=loop (j=a) while tpl_ws5(tpl_b(body,j)) next (j+1) yield j in
    if tpl_b(body,r)!=61 then TplValue { has=false, start=a, end=a } else
    let v=loop (j=r+1) while tpl_ws5(tpl_b(body,j)) next (j+1) yield j in
    let e=tpl_value_at(body,v) in
    if e>=0 then TplValue { has=true, start=v, end=e }
    else if v>r+1 then TplValue { has=true, start=v-1, end=v-1 }
    else TplValue { has=false, start=a, end=a }

; An attribute name can start at q: (?<=['"\t\n\r\f /])[^\t\n\r\f />]
private fn tpl_attr_start(borrow body:Arr u8 _, q:i64) -> bool
  = q>=1 && q<len(body) && tpl_before_attr(tpl_b(body,q-1)) && !tpl_tag_stop(tpl_b(body,q))
private fn tpl_attr_name_end(borrow body:Arr u8 _, q:i64) -> i64
  = loop (j=q+1) while j<len(body) && !tpl_name_stop(tpl_b(body,j)) next (j+1) yield j
private fn tpl_slash_space(borrow body:Arr u8 _, k:i64) -> i64                       ; [\t\n\r\f /]*
  = loop (j=k) while tpl_ws5(tpl_b(body,j)) || tpl_b(body,j)==47 next (j+1) yield j
private fn tpl_tag_space(borrow body:Arr u8 _, k:i64) -> i64                         ; (?:[\t\n\r\f ]|/(?!>))*
  = loop (j=k) while tpl_ws5(tpl_b(body,j)) || (tpl_b(body,j)==47 && tpl_b(body,j+1)!=62) next (j+1) yield j
private fn tpl_tag_name_end(borrow body:Arr u8 _, p:i64) -> i64
  = loop (q=p+1) while q<len(body) && !tpl_tag_stop(tpl_b(body,q)) next (q+1) yield q
private fn tpl_locate_attr(borrow body:Arr u8 _, q:i64) -> i64
  = let a=tpl_attr_name_end(body,q) in let value=tpl_value_indicator(body,a) in
    tpl_slash_space(body,if value.has then value.end else a)
; locatetagend.match(body, p).end()
private fn tpl_locate_tag_end(borrow body:Arr u8 _, p:i64) -> i64
  = let spaced=tpl_slash_space(body,tpl_tag_name_end(body,p)) in
    let attrs=loop (q=spaced) while tpl_attr_start(body,q) next (tpl_locate_attr(body,q)) yield q in
    if tpl_b(body,attrs)==62 then attrs+1 else attrs

type TplAttrMatch = { ok:bool, name:Arr u8 _, has:bool, value:Arr u8 _, end:i64 }
; attrfind_tolerant.match(body, k)
private fn tpl_attrfind(borrow body:Arr u8 _, k:i64) -> TplAttrMatch
  = if !tpl_attr_start(body,k) then TplAttrMatch { ok=false, name=tpl_empty(), has=false, value=tpl_empty(), end=k } else
    let a=tpl_attr_name_end(body,k) in let value=tpl_value_indicator(body,a) in
    TplAttrMatch { ok=true, name=tpl_slice(body,k,a), has=value.has, value=tpl_slice(body,value.start,value.end),
                   end=tpl_tag_space(body,if value.has then value.end else a) }

; A digit of a numeric character reference in base 10 or 16 (html.unescape
; itself is text_html_unescape in cli/text.neo).
private fn tpl_ref_digit(b:i64, base:i64) -> bool = if base==16 then text_hex_value(b)>=0 else tpl_ascii_digit(b)

; ----- the Validator's checks

type TplAttr = { key:Arr u8 _, value:Arr u8 _, has:bool }
private fn tpl_no_attrs() -> Arr TplAttr _ = arr(i in 0..0) TplAttr { key="", value="", has=false }
; dict(attrs).get(key): the last value; has=false for None or a missing key.
private fn tpl_attr_get(borrow attrs:Arr TplAttr _, borrow key:Arr u8 _) -> TplAttr
  = loop (i=0, found=TplAttr { key=tpl_empty(), value=tpl_empty(), has=false }) while i<len(attrs)
      next (i+1, if i>=0 && i<len(attrs) && tpl_eq(attrs[i].key,key) then attrs[i] else found) yield found
private fn tpl_attr_value(borrow raw:Arr u8 _) -> Arr u8 _
  = let quoted=len(raw)>=1 && ((tpl_b(raw,0)==39 && tpl_b(raw,len(raw)-1)==39) || (tpl_b(raw,0)==34 && tpl_b(raw,len(raw)-1)==34)) in
    let inner=if quoted then tpl_slice(raw,1,len(raw)-1) else raw in
    if len(inner)>0 then text_html_unescape(inner) else inner

; Attributes a browser resolves as URLs. A dynamic value must be one url prop,
; because escaping cannot stop a javascript: or data: scheme.
private fn tpl_url_attribute(borrow key:Arr u8 _) -> bool
  = tpl_eq(key,"href") || tpl_eq(key,"src") || tpl_eq(key,"action") || tpl_eq(key,"formaction") || tpl_eq(key,"xlink:href")
    || tpl_eq(key,"data") || tpl_eq(key,"poster") || tpl_eq(key,"cite") || tpl_eq(key,"background") || tpl_eq(key,"ping")
    || tpl_eq(key,"manifest") || tpl_eq(key,"codebase") || tpl_eq(key,"archive") || tpl_eq(key,"longdesc")
    || tpl_eq(key,"usemap") || tpl_eq(key,"icon") || tpl_eq(key,"profile") || tpl_eq(key,"lowsrc") || tpl_eq(key,"dynsrc")

; End of a re.IGNORECASE match of pattern at t[p:], or -1.
private fn tpl_ci_match(borrow t:Arr u8 _, p:i64, borrow pattern:Arr u8 _) -> i64
  = loop (i=p, k=0, ok=true) while ok && k<len(pattern)
      next (i+tpl_width(t,i), k+tpl_width(pattern,k), i<len(t) && text_fold_code(tpl_code(t,i))==text_fold_code(tpl_code(pattern,k)))
      yield if ok then i else -1
; (javascript|vbscript|data): at p, re.IGNORECASE.
private fn tpl_scheme(borrow t:Arr u8 _, p:i64, data:bool) -> bool
  = let a=tpl_ci_match(t,p,"javascript") in let b=tpl_ci_match(t,p,"vbscript") in let c=if data then tpl_ci_match(t,p,"data") else -1 in
    (a>=0 && tpl_b(t,a)==58) || (b>=0 && tpl_b(t,b)==58) || (c>=0 && tpl_b(t,c)==58)
; EXECUTABLE_URL.match(value)
private fn tpl_executable_url(borrow value:Arr u8 _) -> bool = tpl_scheme(value,tpl_skip_space(value,0),false)
; re.search(r'url\s*=\s*[\'"]?\s*(javascript|vbscript|data):', value, re.I)
private fn tpl_refresh_at(borrow t:Arr u8 _, p:i64) -> bool
  = let u=tpl_ci_match(t,p,"url") in let a=tpl_skip_space(t,u) in let b=tpl_skip_space(t,a+1) in
    let q=if tpl_b(t,b)==34 || tpl_b(t,b)==39 then b+1 else b in
    u>=0 && tpl_b(t,a)==61 && tpl_scheme(t,tpl_skip_space(t,q),true)
private fn tpl_refresh_url(borrow value:Arr u8 _) -> bool
  = loop (p=0, found=false) while !found && p<len(value) next (p+tpl_width(value,p), tpl_refresh_at(value,p)) yield found

type TplNameToken = { ok:bool, end:i64, name:Arr u8 _ }
; {{\s*([\w.]+)\s*}} at p
private fn tpl_name_token(borrow t:Arr u8 _, p:i64) -> TplNameToken
  = let a=tpl_skip_space(t,p+2) in let b=tpl_skip_word(t,a,true) in let c=tpl_skip_space(t,b) in
    if tpl_b(t,p)==123 && tpl_b(t,p+1)==123 && b>a && tpl_b(t,c)==125 && tpl_b(t,c+1)==125 then
      TplNameToken { ok=true, end=c+2, name=tpl_slice(t,a,b) }
    else TplNameToken { ok=false, end=p+1, name=tpl_empty() }
type TplNames = { names:Arr Arr u8 _ _, p:i64 }
private fn tpl_names_step(borrow t:Arr u8 _, move s:TplNames) -> TplNames
  = let m=tpl_name_token(t,s.p) in if m.ok then TplNames { names=push(s.names,m.name), p=m.end } else s with { p=s.p+1 }
; re.findall(r'{{\s*([\w.]+)\s*}}', value)
private fn tpl_value_names(borrow t:Arr u8 _) -> Arr Arr u8 _ _
  = let s=loop (st=TplNames { names=tpl_no_words(), p=0 }) while st.p<len(t) next (tpl_names_step(t,st)) yield st in s.names
; re.fullmatch(r'\s*{{\s*[\w.]+\s*}}\s*', value)
private fn tpl_single_name(borrow t:Arr u8 _) -> bool
  = let m=tpl_name_token(t,tpl_skip_space(t,0)) in m.ok && tpl_skip_space(t,m.end)==len(t)
; key\s*=\s*["'] at q, re.IGNORECASE.
private fn tpl_key_at(borrow raw:Arr u8 _, q:i64, borrow key:Arr u8 _) -> bool
  = let e=tpl_ci_match(raw,q,key) in let a=tpl_skip_space(raw,e) in let b=tpl_skip_space(raw,a+1) in
    e>=0 && tpl_b(raw,a)==61 && (tpl_b(raw,b)==34 || tpl_b(raw,b)==39)
; re.search(r'(?:^|\s)'+re.escape(key)+r'\s*=\s*[\"\']', raw, re.I)
private fn tpl_key_search(borrow raw:Arr u8 _, borrow key:Arr u8 _) -> bool
  = tpl_key_at(raw,0,key) ||
    loop (p=0, found=false) while !found && p<len(raw)
      next (p+tpl_width(raw,p), tpl_space(tpl_code(raw,p)) && tpl_key_at(raw,p+tpl_width(raw,p),key)) yield found

type TplVal = { path:Arr u8 _, kinds:Arr TplPair _, types:Arr TplType _ }
private fn tpl_any_html(borrow v:TplVal, borrow names:Arr Arr u8 _ _) -> bool
  = loop (i=0, found=false) while !found && i<len(names) next (i+1, tpl_kind_is(tpl_word_at(names,i),v.kinds,v.types,"html")) yield found
; The Validator's checks of one attribute: the error (without the path) or "".
private fn tpl_attr_check(borrow v:TplVal, borrow attr:TplAttr, refresh:bool, borrow raw:Arr u8 _) -> Arr u8 _
  = let key=attr.key in let value=attr.value in let truthy=attr.has && len(value)>0 in
    if tpl_starts(key,"on") || tpl_eq(key,"srcdoc") then "executable HTML attributes are not supported"
    else if truthy && tpl_executable_url(value) then "executable URLs are not supported"
    else if refresh && tpl_eq(key,"content") && truthy && tpl_refresh_url(value) then "executable URLs are not supported"
    else if !truthy || !tpl_has_open(value) then tpl_empty()
    else if tpl_eq(key,"style") || tpl_eq(key,"srcset") || tpl_starts(key,"on") then concat("dynamic ",key," is unsupported")
    else if refresh && tpl_eq(key,"content") then "dynamic meta refresh is unsupported"
    else let names=tpl_value_names(value) in
    if tpl_url_attribute(key) && (len(names)!=1 || !tpl_single_name(value) || !tpl_kind_is(tpl_word_at(names,0),v.kinds,v.types,"url")) then
      concat("dynamic ",key," requires one url prop")
    else if tpl_contains(value,"{%") || !tpl_key_search(raw,key) then "interpolate only inside quoted attribute values"
    else if tpl_any_html(v,names) then "HTML props cannot appear in attributes"
    else tpl_empty()

; Parser state: mode 0 is ordinary data, 1 raw text up to </elem (script,
; style, ...), 2 escapable raw text (textarea, title), 3 plaintext. raw is the
; Validator's stack of open script/style elements.
type TplHp = { pos:i64, mode:i64, elem:Arr u8 _, raw:Arr Arr u8 _ _, stop:bool, err:Arr u8 _ }
private fn tpl_hp_fail(move s:TplHp, borrow v:TplVal, borrow msg:Arr u8 _) -> TplHp
  = if s.stop then s else s with { err=concat(v.path,": ",msg), stop=true }
private fn tpl_hp_data(move s:TplHp, borrow v:TplVal, borrow body:Arr u8 _, a:i64, b:i64) -> TplHp
  = if len(s.raw)>0 && tpl_has_open(tpl_slice(body,a,b)) then tpl_hp_fail(s,v,"interpolation inside script/style is not supported") else s
private fn tpl_hp_comment_data(move s:TplHp, borrow v:TplVal, borrow body:Arr u8 _, a:i64, b:i64) -> TplHp
  = if tpl_has_open(tpl_slice(body,a,b)) then tpl_hp_fail(s,v,"interpolation inside HTML comments is not supported") else s

private fn tpl_hp_start(borrow v:TplVal, move s:TplHp, borrow tag:Arr u8 _, borrow attrs:Arr TplAttr _, borrow raw:Arr u8 _) -> TplHp
  = let pushed=if tpl_eq(tag,"script") || tpl_eq(tag,"style") then s with { raw=push(s.raw,tag) } else s in
    let src=tpl_attr_get(attrs,"src") in
    if tpl_eq(tag,"script") && !(src.has && len(src.value)>0) then tpl_hp_fail(pushed,v,"use external JavaScript modules, not inline scripts") else
    let equiv=tpl_strip(tpl_attr_get(attrs,"http-equiv").value) in
    let refresh=tpl_eq(tag,"meta") && len(equiv)==7 && tpl_ascii_ci_at(equiv,0,"refresh") in
    let err=loop (i=0, err=tpl_empty()) while len(err)==0 && i<len(attrs)
      next (i+1, if i>=0 && i<len(attrs) then tpl_attr_check(v,attrs[i],refresh,raw) else tpl_empty()) yield err in
    if len(err)>0 then tpl_hp_fail(pushed,v,err) else pushed
private fn tpl_hp_end(move s:TplHp, borrow tag:Arr u8 _) -> TplHp
  = if len(s.raw)>0 && tpl_eq(tpl_word_at(s.raw,len(s.raw)-1),tag) then s with { raw=tpl_pop(s.raw) } else s

private fn tpl_cdata_mode(borrow tag:Arr u8 _) -> i64
  = if tpl_eq(tag,"script") || tpl_eq(tag,"style") || tpl_eq(tag,"xmp") || tpl_eq(tag,"iframe") || tpl_eq(tag,"noembed")
       || tpl_eq(tag,"noframes") then 1
    else if tpl_eq(tag,"plaintext") then 3
    else if tpl_eq(tag,"textarea") || tpl_eq(tag,"title") then 2 else 0
; </elem(?=[\t\n\r\f />]) at p, ASCII case-insensitive.
private fn tpl_cdata_end_at(borrow body:Arr u8 _, p:i64, borrow elem:Arr u8 _) -> bool
  = tpl_b(body,p)==60 && tpl_b(body,p+1)==47 && tpl_ascii_ci_at(body,p+2,elem) && tpl_tag_stop(tpl_b(body,p+2+len(elem)))
; self.interesting.search(body, i).start(), or -1.
private fn tpl_interesting(borrow body:Arr u8 _, mode:i64, borrow elem:Arr u8 _, i:i64) -> i64
  = if mode==3 then len(body) else
    loop (p=i, found= -1) while found<0 && p<len(body)
      next (p+1, let b=tpl_b(body,p) in
            if mode==0 then (if b==38 || b==60 then p else -1)
            else if (mode==2 && b==38) || tpl_cdata_end_at(body,p,elem) then p else -1) yield found

type TplStartTag = { k:i64, attrs:Arr TplAttr _, done:bool }
private fn tpl_start_attr(borrow body:Arr u8 _, move st:TplStartTag) -> TplStartTag
  = let m=tpl_attrfind(body,st.k) in
    if !m.ok then st with { done=true } else
    TplStartTag { k=m.end, done=false,
      attrs=push(st.attrs,TplAttr { key=text_lower_unicode(m.name), value=if m.has then tpl_attr_value(m.value) else tpl_empty(), has=m.has }) }
; parse_starttag at s.pos (a '<' and an ASCII letter).
private fn tpl_hp_starttag(borrow body:Arr u8 _, borrow v:TplVal, move s:TplHp) -> TplHp
  = let i=s.pos in let endpos=tpl_locate_tag_end(body,i+1) in
    if tpl_b(body,endpos-1)!=62 then s with { stop=true } else
    let name_end=tpl_tag_name_end(body,i+1) in
    let tag=text_lower_unicode(tpl_slice(body,i+1,name_end)) in
    let parsed=loop (st=TplStartTag { k=tpl_tag_space(body,name_end), attrs=tpl_no_attrs(), done=false }) while !st.done && st.k<endpos
      next (tpl_start_attr(body,st)) yield st in
    let rest=tpl_strip(tpl_slice(body,parsed.k,endpos)) in
    if !tpl_eq(rest,">") && !tpl_eq(rest,"/>") then
      (let shown=tpl_hp_data(s,v,body,i,endpos) in if shown.stop then shown else shown with { pos=endpos })
    else let started=tpl_hp_start(v,s,tag,parsed.attrs,tpl_slice(body,i,endpos)) in
    if started.stop then started
    else if tpl_eq(rest,"/>") then tpl_hp_end(started,tag) with { pos=endpos }
    else let mode=tpl_cdata_mode(tag) in
      if mode==0 then started with { pos=endpos } else started with { pos=endpos, mode=mode, elem=tag }
; parse_bogus_comment at s.pos ('<!' or '</').
private fn tpl_hp_bogus(borrow body:Arr u8 _, borrow v:TplVal, move s:TplHp) -> TplHp
  = let close=tpl_find_byte(body,62,s.pos+2) in
    if close<0 then s with { stop=true } else
    let checked=tpl_hp_comment_data(s,v,body,s.pos+2,close) in if checked.stop then checked else checked with { pos=close+1 }
; parse_endtag at s.pos ('</').
private fn tpl_hp_endtag(borrow body:Arr u8 _, borrow v:TplVal, move s:TplHp) -> TplHp
  = let i=s.pos in
    if tpl_find_byte(body,62,i+2)<0 then s with { stop=true }
    else if !tpl_alpha(tpl_b(body,i+2)) then (if tpl_b(body,i+2)==62 then s with { pos=i+3 } else tpl_hp_bogus(body,v,s))
    else let end=tpl_locate_tag_end(body,i+2) in
    if tpl_b(body,end-1)!=62 then s with { stop=true } else
    let tag=text_lower_unicode(tpl_slice(body,i+2,tpl_tag_name_end(body,i+2))) in
    tpl_hp_end(s,tag) with { pos=end, mode=0, elem=tpl_empty() }
; parse_comment at s.pos ('<!--').
private fn tpl_hp_comment(borrow body:Arr u8 _, borrow v:TplVal, move s:TplHp) -> TplHp
  = let i=s.pos in
    let close=loop (p=i+4, found= -1) while found<0 && p<len(body)
      next (p+1, if tpl_b(body,p)==45 && tpl_b(body,p+1)==45 && (tpl_b(body,p+2)==62 || (tpl_b(body,p+2)==33 && tpl_b(body,p+3)==62)) then p else -1)
      yield found in
    let end=if close>=0 then (if tpl_b(body,close+2)==62 then close+3 else close+4)
      else if tpl_b(body,i+4)==62 then i+5 else if tpl_b(body,i+4)==45 && tpl_b(body,i+5)==62 then i+6 else -1 in
    if end<0 then s with { stop=true } else
    let checked=tpl_hp_comment_data(s,v,body,i+4,if close>=0 then close else i+4) in
    if checked.stop then checked else checked with { pos=end }
private fn tpl_hp_until(borrow body:Arr u8 _, move s:TplHp, from:i64) -> TplHp
  = let close=tpl_find_byte(body,62,from) in if close<0 then s with { stop=true } else s with { pos=close+1 }
; parse_html_declaration at s.pos ('<!' but not '<!--').
private fn tpl_hp_declaration(borrow body:Arr u8 _, borrow v:TplVal, move s:TplHp) -> TplHp
  = let i=s.pos in
    if bytes_match_at(body,i,"<![CDATA[") then
      (let close=tpl_find(body,"]]>",i+9) in if close<0 then s with { stop=true } else s with { pos=close+3 })
    else if tpl_ascii_ci_at(body,i,"<!doctype") then tpl_hp_until(body,s,i+9)
    else if bytes_match_at(body,i,"<![") then
      (let close=tpl_find_byte(body,62,i+3) in
       if close<0 then s with { stop=true }
       else if tpl_b(body,close-1)==93 then s with { pos=close+1 }
       else let checked=tpl_hp_comment_data(s,v,body,i+2,close) in if checked.stop then checked else checked with { pos=close+1 })
    else tpl_hp_bogus(body,v,s)
private fn tpl_hp_lt(borrow body:Arr u8 _, borrow v:TplVal, move s:TplHp) -> TplHp
  = let i=s.pos in let b=tpl_b(body,i+1) in
    if tpl_alpha(b) then tpl_hp_starttag(body,v,s)
    else if b==47 then tpl_hp_endtag(body,v,s)
    else if bytes_match_at(body,i,"<!--") then tpl_hp_comment(body,v,s)
    else if b==63 then tpl_hp_until(body,s,i+2)
    else if b==33 then tpl_hp_declaration(body,v,s)
    else if i+1<len(body) then s with { pos=i+1 }
    else s with { stop=true }
; A '&' in data: a character or entity reference, a lone '&', or the end of
; what feed() can parse.
private fn tpl_hp_amp(borrow body:Arr u8 _, move s:TplHp) -> TplHp
  = let i=s.pos in let n=len(body) in
    if tpl_b(body,i+1)==35 then
      ; charref: &#(?:[0-9]+|[xX][0-9a-fA-F]+)[^0-9a-fA-F]
      let hex=tpl_b(body,i+2)==120 || tpl_b(body,i+2)==88 in
      let start=if tpl_ascii_digit(tpl_b(body,i+2)) then i+2 else if hex && text_hex_value(tpl_b(body,i+3))>=0 then i+3 else -1 in
      let end=if start<0 then -1 else loop (j=start) while tpl_ref_digit(tpl_b(body,j),if start==i+3 then 16 else 10) next (j+1) yield j in
      if start>=0 && end<n && text_hex_value(tpl_b(body,end))<0 then s with { pos=if tpl_b(body,end)==59 then end+1 else end }
      else if tpl_find_byte(body,59,i)>=0 then s with { pos=i+2, stop=true }
      else s with { stop=true }
    else
      ; entityref: &([a-zA-Z][-.a-zA-Z0-9]*)[^a-zA-Z0-9], backtracking to a
      ; '-' or '.' when the name runs to the end.
      let first=tpl_alpha(tpl_b(body,i+1)) in
      let e=loop (j=i+2) while j<n && (tpl_alpha(tpl_b(body,j)) || tpl_ascii_digit(tpl_b(body,j)) || tpl_b(body,j)==45 || tpl_b(body,j)==46) next (j+1) yield j in
      let back=loop (j=e-1, found= -1) while found<0 && j>=i+2 next (j-1, if tpl_b(body,j)==45 || tpl_b(body,j)==46 then j else -1) yield found in
      if first && e<n then s with { pos=if tpl_b(body,e)==59 then e+1 else e }
      else if first && back>=0 then s with { pos=back }
      else if first then s with { stop=true }
      else if i+1<n then s with { pos=i+1 }
      else s with { stop=true }
private fn tpl_hp_step(borrow body:Arr u8 _, borrow v:TplVal, move s:TplHp) -> TplHp
  = let i=s.pos in let found=tpl_interesting(body,s.mode,s.elem,i) in
    if found<0 && s.mode!=0 then s with { stop=true } else
    let j=if found<0 then len(body) else found in
    let shown=if i<j then tpl_hp_data(s,v,body,i,j) else s in
    if shown.stop then shown
    else if j>=len(body) then shown with { pos=j, stop=true }
    else if tpl_b(body,j)==60 then tpl_hp_lt(body,v,shown with { pos=j })
    else tpl_hp_amp(body,shown with { pos=j })

fn tpl_validate_html(borrow template:TplTemplate) -> Result<bool,Arr u8 _>
  = let body=template.body in
    let scan=loop (st=TplScan { i=0, in_tag=false, quote=0, bad=false }) while !st.bad && st.i<len(body) next (tpl_scan_step(body,st)) yield st in
    if scan.bad then Err::<bool,Arr u8 _>(concat(template.path,": dynamic tag/attribute syntax is not supported")) else
    let locals=loop (st=TplLocals { kinds=template.props, p=0 }) while st.p<len(body) next (tpl_locals_step(body,template.types,st)) yield st in
    let v=TplVal { path=template.path, kinds=locals.kinds, types=template.types } in
    let parsed=loop (st=TplHp { pos=0, mode=0, elem=tpl_empty(), raw=tpl_no_words(), stop=false, err=tpl_empty() })
      while !st.stop && st.pos<len(body) next (tpl_hp_step(body,v,st)) yield st in
    if len(parsed.err)>0 then Err::<bool,Arr u8 _>(parsed.err) else Ok::<bool,Arr u8 _>(true)

; ---------------------------------------------------------------- compile_template

type TplCtx = { name:Arr u8 _, path:Arr u8 _, props:Arr TplPair _, types:Arr TplType _, components:Arr TplTemplate _, assets:Arr TplPair _ }
; Compilation state. expr, end and has_end carry a sequence's result back to
; its caller; kinds maps names to their kinds and locals maps loop
; variables to their Neo names.
type TplC = { tokens:Arr Arr u8 _ _, pos:i64, helpers:Arr Arr u8 _ _, deps:Arr Arr u8 _ _, kinds:Arr TplPair _,
              locals:Arr TplPair _, failed:bool, err:Arr u8 _, expr:Arr u8 _, end:Arr u8 _, has_end:bool }
; One sequence(): the parts so far, and the end directive once found.
type TplSeq = { c:TplC, parts:Arr Arr u8 _ _, done:bool, end:Arr u8 _ }
type TplFound = { expr:Arr u8 _, kind:Arr u8 _ }

private fn tpl_cfail_message(move c:TplC, borrow message:Arr u8 _) -> TplC
  = if c.failed then c else c with { failed=true, err=message }
private fn tpl_cfail(move c:TplC, borrow ctx:TplCtx, borrow message:Arr u8 _) -> TplC
  = tpl_cfail_message(c,concat(ctx.path,": ",message))
private fn tpl_seq_fail(move s:TplSeq, borrow ctx:TplCtx, borrow message:Arr u8 _) -> TplSeq
  = s with { c=tpl_cfail(s.c,ctx,message) }
private fn tpl_seq_error(move s:TplSeq, borrow message:Arr u8 _) -> TplSeq
  = s with { c=tpl_cfail_message(s.c,message) }

; PATH.fullmatch(name)
private fn tpl_path_ok(borrow name:Arr u8 _) -> bool
  = let parts=tpl_split(name,46) in
    loop (i=0, ok=true) while ok && i<len(parts)
      next (i+1, let part=tpl_word_at(parts,i) in tpl_ident_start(tpl_b(part,0)) && tpl_skip_word(part,1,false)==len(part)) yield ok

type TplResolveWalk = { expr:Arr u8 _, kind:Arr u8 _, bad:i64 }
private fn tpl_resolve_step(borrow types:Arr TplType _, move w:TplResolveWalk, borrow part:Arr u8 _, at:i64) -> TplResolveWalk
  = let fields=tpl_type_fields(types,tpl_type_index(types,w.kind)) in let f=tpl_index(fields,part) in
    if f<0 then w with { bad=at } else TplResolveWalk { expr=concat(w.expr,".",part), kind=tpl_pair_at(fields,f).value, bad= -1 }
private fn tpl_resolve(borrow ctx:TplCtx, borrow kinds:Arr TplPair _, borrow locals:Arr TplPair _, borrow name:Arr u8 _) -> Result<TplFound,Arr u8 _>
  = if !tpl_path_ok(name) then Err::<TplFound,Arr u8 _>(concat(ctx.path,": arbitrary expressions are not supported: ",tpl_repr(name))) else
    let parts=tpl_split(name,46) in let first=tpl_word_at(parts,0) in let at=tpl_index(kinds,first) in
    if at<0 then Err::<TplFound,Arr u8 _>(concat(ctx.path,": unknown prop ",tpl_repr(first))) else
    let local=tpl_index(locals,first) in
    let start=TplResolveWalk { expr=if local>=0 then tpl_pair_at(locals,local).value else concat("p_",first), kind=tpl_pair_at(kinds,at).value, bad= -1 } in
    let walk=loop (w=start, i=1) while w.bad<0 && i<len(parts) next (tpl_resolve_step(ctx.types,w,tpl_word_at(parts,i),i), i+1) yield w in
    if walk.bad>=0 then Err::<TplFound,Arr u8 _>(concat(ctx.path,": ",tpl_repr(name)," has no field ",tpl_repr(tpl_word_at(parts,walk.bad))))
    else Ok::<TplFound,Arr u8 _>(TplFound { expr=walk.expr, kind=walk.kind })

private fn tpl_operator(borrow t:Arr u8 _, at:i64) -> Arr u8 _
  = if bytes_match_at(t,at,"==") then "==" else if bytes_match_at(t,at,"!=") then "!=" else if bytes_match_at(t,at,"<=") then "<="
    else if bytes_match_at(t,at,">=") then ">=" else if tpl_b(t,at)==60 then "<" else if tpl_b(t,at)==62 then ">" else ""
; -?\d{1,18}, "[^"\\]*" or [A-Za-z_][\w.]* spanning all of operand.
private fn tpl_operand_ok(borrow t:Arr u8 _) -> bool
  = let s=if tpl_b(t,0)==45 then 1 else 0 in
    let digits=loop (j=s, count=0) while count<18 && j<len(t) && text_is_decimal(tpl_code(t,j)) next (j+tpl_width(t,j), count+1) yield j in
    let close=loop (j=1) while j<len(t) && tpl_b(t,j)!=34 && tpl_b(t,j)!=92 next (j+1) yield j in
    (digits>s && digits==len(t))
    || (tpl_b(t,0)==34 && close==len(t)-1 && tpl_b(t,close)==34)
    || (tpl_ident_start(tpl_b(t,0)) && tpl_skip_word(t,1,true)==len(t))
; re.fullmatch(r'-?\d+', operand)
private fn tpl_int_operand(borrow t:Arr u8 _) -> bool
  = let s=if tpl_b(t,0)==45 then 1 else 0 in
    let e=loop (j=s) while j<len(t) && text_is_decimal(tpl_code(t,j)) next (j+tpl_width(t,j)) yield j in
    e>s && e==len(t)
; re.fullmatch(r'[\w.]+', test)
private fn tpl_word_dots(borrow t:Arr u8 _) -> bool = len(t)>0 && tpl_skip_word(t,0,true)==len(t)
private fn tpl_text_test(borrow value:Arr u8 _, borrow other:Arr u8 _, borrow op:Arr u8 _) -> Result<Arr u8 _,Arr u8 _>
  = let test=concat("str_equal(",value,",",other,")") in
    Ok::<Arr u8 _,Arr u8 _>(if tpl_eq(op,"==") then test else concat("!",test))
private fn tpl_equality(borrow op:Arr u8 _) -> bool = tpl_eq(op,"==") || tpl_eq(op,"!=")

; re.fullmatch(r'(!)?\s*([A-Za-z_][\w.]*)\s*(?:(==|!=|<=|>=|<|>)\s*(-?\d{1,18}|"[^"\\]*"|[A-Za-z_][\w.]*))?', text)
; and the Neo test it compiles to.
private fn tpl_condition(borrow ctx:TplCtx, borrow kinds:Arr TplPair _, borrow locals:Arr TplPair _, borrow text:Arr u8 _) -> Result<Arr u8 _,Arr u8 _>
  = let negative=tpl_b(text,0)==33 in
    let a=tpl_skip_space(text,if negative then 1 else 0) in
    let b=tpl_skip_word(text,a+1,true) in
    let c=tpl_skip_space(text,b) in
    let op=tpl_operator(text,c) in
    let d=tpl_skip_space(text,c+len(op)) in
    let operand=tpl_slice(text,d,len(text)) in
    if !tpl_ident_start(tpl_b(text,a)) || (len(op)==0 && c<len(text)) || (len(op)>0 && !tpl_operand_ok(operand)) then
      Err::<Arr u8 _,Arr u8 _>(concat(ctx.path,": unsupported condition ",tpl_repr(text))) else
    let name=tpl_slice(text,a,b) in
    let found=tpl_resolve(ctx,kinds,locals,name)? in
    let value=found.expr in let kind=found.kind in
    if len(op)==0 then tpl_truth(ctx,value,kind,negative)
    else if negative then Err::<Arr u8 _,Arr u8 _>(concat(ctx.path,": use != instead of ! with a comparison"))
    else if tpl_int_operand(operand) then
      (if !tpl_eq(kind,"int") then Err::<Arr u8 _,Arr u8 _>(concat(ctx.path,": ",name," is not an int"))
       else Ok::<Arr u8 _,Arr u8 _>(concat("(",value,op,if tpl_b(operand,0)==45 then concat("(0-",tpl_slice(operand,1,len(operand)),")") else operand,")")))
    else if tpl_b(operand,0)==34 then
      (if !tpl_eq(kind,"text") || !tpl_equality(op) then Err::<Arr u8 _,Arr u8 _>(concat(ctx.path,": compare text with == or !="))
       else tpl_text_test(value,tpl_literal(tpl_slice(operand,1,len(operand)-1)),op))
    else
      let other=tpl_resolve(ctx,kinds,locals,operand)? in
      if !tpl_eq(other.kind,kind) || !(tpl_eq(kind,"int") || tpl_eq(kind,"text")) || (tpl_eq(kind,"text") && !tpl_equality(op)) then
        Err::<Arr u8 _,Arr u8 _>(concat(ctx.path,": incompatible comparison ",tpl_repr(text)))
      else if tpl_eq(kind,"text") then tpl_text_test(value,other.expr,op)
      else Ok::<Arr u8 _,Arr u8 _>(concat("(",value,op,other.expr,")"))
private fn tpl_truth(borrow ctx:TplCtx, borrow value:Arr u8 _, borrow kind:Arr u8 _, negative:bool) -> Result<Arr u8 _,Arr u8 _>
  = let test=if tpl_eq(kind,"bool") then value else if tpl_eq(kind,"text") || tpl_ends(kind,"[]") then concat("len(",value,")>0") else tpl_empty() in
    if len(test)==0 then Err::<Arr u8 _,Arr u8 _>(concat(ctx.path,": if requires a bool, text or list value; compare other values explicitly"))
    else if !negative then Ok::<Arr u8 _,Arr u8 _>(test)
    else Ok::<Arr u8 _,Arr u8 _>(if tpl_word_dots(test) then concat("!",test) else concat("!(",test,")"))

private fn tpl_join_parts(borrow parts:Arr Arr u8 _ _) -> Arr u8 _
  = if len(parts)==0 then tpl_literal(tpl_empty()) else if len(parts)==1 then tpl_word_at(parts,0)
    else concat("concat(",tpl_join(parts,","),")")

; sequence(nested): parts up to an end directive (else, elif, endif, endfor,
; endcomponent) or the last token.
private fn tpl_sequence(borrow ctx:TplCtx, move c:TplC, nested:bool) -> TplC
  = let s=loop (st=TplSeq { c=c, parts=tpl_no_words(), done=false, end=tpl_empty() })
      while !st.done && !st.c.failed && st.c.pos<len(st.c.tokens)
      next (tpl_seq_step(ctx,st,nested)) yield st in
    let expr=tpl_join_parts(s.parts) in
    s.c with { expr=expr, end=s.end, has_end=s.done }

private fn tpl_seq_step(borrow ctx:TplCtx, move s:TplSeq, nested:bool) -> TplSeq
  = let token=tpl_word_at(s.c.tokens,s.c.pos) in
    let moved=s with { c=s.c with { pos=s.c.pos+1 } } in
    if tpl_starts(token,"{{") then tpl_seq_value(ctx,moved,tpl_strip(tpl_slice(token,2,len(token)-2)))
    else if tpl_starts(token,"{%") then tpl_seq_directive(ctx,moved,tpl_strip(tpl_slice(token,2,len(token)-2)),nested)
    else tpl_seq_text(ctx,moved,token)

private fn tpl_render(borrow found:TplFound) -> Arr u8 _
  = let v=found.expr in let k=found.kind in
    if tpl_eq(k,"text") then concat("html_escape(",v,")") else if tpl_eq(k,"int") then concat("int_text(",v,")")
    else if tpl_eq(k,"bool") then concat("(if ",v," then \"true\" else \"false\")")
    else if tpl_eq(k,"url") then concat("html_escape(",v,".value)") else concat(v,".bytes")
private fn tpl_seq_value(borrow ctx:TplCtx, move s:TplSeq, borrow name:Arr u8 _) -> TplSeq
  = match tpl_resolve(ctx,s.c.kinds,s.c.locals,name) {
      Err(e) => tpl_seq_error(s,e),
      Ok(found) => tpl_seq_render(ctx,s,found) }
private fn tpl_seq_render(borrow ctx:TplCtx, move s:TplSeq, borrow found:TplFound) -> TplSeq
  = if tpl_ends(found.kind,"[]") then tpl_seq_fail(s,ctx,"render list props with a for loop")
    else if tpl_type_index(ctx.types,found.kind)>=0 then tpl_seq_fail(s,ctx,"render record fields, not the record")
    else s with { parts=push(s.parts,tpl_render(found)) }

private fn tpl_seq_directive(borrow ctx:TplCtx, move s:TplSeq, borrow d:Arr u8 _, nested:bool) -> TplSeq
  = if tpl_eq(d,"else") || tpl_eq(d,"endif") || tpl_eq(d,"endfor") || tpl_eq(d,"endcomponent") || tpl_starts(d,"elif ") then
      (if !nested then tpl_seq_fail(s,ctx,concat("unexpected ",d)) else s with { done=true, end=d })
    else if tpl_starts(d,"if ") then
      (let branch=tpl_branch(ctx,s.c,tpl_strip(tpl_slice(d,3,len(d)))) in
       let expr=branch.expr in s with { c=branch, parts=push(s.parts,expr) })
    else if tpl_starts(d,"for ") then tpl_for(ctx,s,d)
    else if tpl_starts(d,"component ") then tpl_component(ctx,s,d,true)
    else if tpl_starts(d,"include ") then tpl_component(ctx,s,d,false)
    else tpl_seq_fail(s,ctx,concat("unsupported directive ",tpl_repr(d)))

; branch(text): the if expression up to its endif.
private fn tpl_branch(borrow ctx:TplCtx, move c:TplC, borrow text:Arr u8 _) -> TplC
  = match tpl_condition(ctx,c.kinds,c.locals,text) {
      Err(e) => tpl_cfail_message(c,e),
      Ok(test) => tpl_branch_body(ctx,c,test) }
private fn tpl_branch_body(borrow ctx:TplCtx, move c:TplC, borrow test:Arr u8 _) -> TplC
  = let yes=tpl_sequence(ctx,c,true) in
    if yes.failed then yes else
    let yes_expr=yes.expr in
    let elif_text=if yes.has_end && tpl_starts(yes.end,"elif ") then tpl_strip(tpl_slice(yes.end,5,len(yes.end))) else tpl_empty() in
    let no=if yes.has_end && tpl_eq(yes.end,"else") then tpl_sequence(ctx,yes,true)
      else if yes.has_end && tpl_starts(yes.end,"elif ") then tpl_branch(ctx,yes,elif_text)
      else yes with { expr=tpl_literal(tpl_empty()) } in
    if no.failed then no
    else if !no.has_end || !tpl_eq(no.end,"endif") then tpl_cfail(no,ctx,"missing endif")
    else let no_expr=no.expr in no with { expr=concat("(if ",test," then ",yes_expr," else ",no_expr,")") }

type TplForDirective = { ok:bool, item:Arr u8 _, index:Arr u8 _, source:Arr u8 _ }
; re.fullmatch(r'for ([A-Za-z_]\w*)(?:\s*,\s*([A-Za-z_]\w*))? in ([A-Za-z_][\w.]*)', directive)
private fn tpl_for_directive(borrow d:Arr u8 _) -> TplForDirective
  = let fail=TplForDirective { ok=false, item=tpl_empty(), index=tpl_empty(), source=tpl_empty() } in
    let a=tpl_skip_word(d,5,false) in
    let g1=tpl_skip_space(d,a) in let g2=tpl_skip_space(d,g1+1) in
    let grouped=tpl_b(d,g1)==44 && tpl_ident_start(tpl_b(d,g2)) in
    let g3=if grouped then tpl_skip_word(d,g2+1,false) else g2 in
    let after=if grouped then g3 else a in
    let e=tpl_skip_word(d,after+5,true) in
    if !tpl_starts(d,"for ") || !tpl_ident_start(tpl_b(d,4)) || !bytes_match_at(d,after," in ") || !tpl_ident_start(tpl_b(d,after+4)) || e!=len(d) then fail
    else TplForDirective { ok=true, item=tpl_slice(d,4,a), index=if grouped then tpl_slice(d,g2,g3) else tpl_empty(), source=tpl_slice(d,after+4,e) }

type TplArgs = { text:Arr u8 _, err:Arr u8 _ }
; ','.join(prefix+name+': '+native(kind, types) for name, kind in pairs), or
; with leading=true ''.join(','+...) for the captured locals.
private fn tpl_args(borrow pairs:Arr TplPair _, borrow kinds:Arr TplPair _, borrow types:Arr TplType _, leading:bool) -> TplArgs
  = loop (a=TplArgs { text=tpl_empty(), err=tpl_empty() }, i=0) while len(a.err)==0 && i<len(pairs)
      next (let pair=tpl_pair_at(pairs,i) in
            let name=if leading then pair.value else concat("p_",pair.key) in
            let kind=if leading then tpl_get(kinds,pair.key) else pair.value in
            match tpl_native(kind,types) {
              Err(e) => a with { err=e },
              Ok(native) => a with { text=if leading || i>0 then concat(a.text,",",name,": ",native) else concat(name,": ",native) } },
            i+1) yield a
private fn tpl_call(borrow props:Arr TplPair _, borrow captures:Arr TplPair _) -> Arr u8 _
  = let names=loop (o=tpl_no_words(), i=0) while i<len(props) next (push(o,concat("p_",tpl_pair_at(props,i).key)), i+1) yield o in
    let all=loop (o=names, i=0) while i<len(captures) next (push(o,tpl_pair_at(captures,i).value), i+1) yield o in
    tpl_join(all,",")

private fn tpl_for(borrow ctx:TplCtx, move s:TplSeq, borrow d:Arr u8 _) -> TplSeq
  = let m=tpl_for_directive(d) in
    if !m.ok then tpl_seq_fail(s,ctx,"use for item in list_prop, or for item, index in list_prop") else
    match tpl_resolve(ctx,s.c.kinds,s.c.locals,m.source) {
      Err(e) => tpl_seq_error(s,e),
      Ok(source) => tpl_for_body(ctx,s,m,source) }
private fn tpl_for_body(borrow ctx:TplCtx, move s:TplSeq, borrow m:TplForDirective, borrow source:TplFound) -> TplSeq
  = let indexed=len(m.index)>0 in
    if !tpl_ends(source.kind,"[]") || tpl_has(s.c.kinds,m.item) || (indexed && (tpl_has(s.c.kinds,m.index) || tpl_eq(m.index,m.item))) then
      tpl_seq_fail(s,ctx,"for requires a list and fresh item/index names") else
    let captures=s.c.locals in
    let slot=len(s.c.helpers) in
    let helper=concat("text_",ctx.name,"_loop_",int_text(slot)) in
    let kinds=push(s.c.kinds,TplPair { key=m.item, value=tpl_slice(source.kind,0,len(source.kind)-2) }) in
    let locals=push(s.c.locals,TplPair { key=m.item, value=concat("item_",m.item) }) in
    let kinds=if indexed then push(kinds,TplPair { key=m.index, value="int" }) else kinds in
    let locals=if indexed then push(locals,TplPair { key=m.index, value=concat("idx_",m.index) }) else locals in
    let inner=tpl_sequence(ctx,s.c with { helpers=push(s.c.helpers,tpl_empty()), kinds=kinds, locals=locals },true) in
    if inner.failed then s with { c=inner } else
    let kinds=tpl_drop(inner.kinds,m.item) in let locals=tpl_drop(inner.locals,m.item) in
    let kinds=if indexed then tpl_drop(kinds,m.index) else kinds in
    let locals=if indexed then tpl_drop(locals,m.index) else locals in
    let restored=inner with { kinds=kinds, locals=locals } in
    if !restored.has_end || !tpl_eq(restored.end,"endfor") then s with { c=tpl_cfail(restored,ctx,"missing endfor") } else
    let props=tpl_args(ctx.props,ctx.props,ctx.types,false) in
    let captured=tpl_args(captures,kinds,ctx.types,true) in
    if len(props.err)>0 then s with { c=tpl_cfail_message(restored,props.err) }
    else if len(captured.err)>0 then s with { c=tpl_cfail_message(restored,captured.err) } else
    let call=tpl_call(ctx.props,captures) in
    let binding=if indexed then concat("let idx_",m.index,"=at in ") else tpl_empty() in
    ; A balanced tree avoids quadratic string copying for long lists.
    let code=concat("fn ",helper,"(",props.text,captured.text,",at:i64,count:i64) -> Arr u8 _ = ",
      "if count<=0 then \"\" else if count==1 then check at>=0 && at<len(",source.expr,") in ",
      concat("let item_",m.item,"=",source.expr,"[at] in ",binding,restored.expr," else let half=count/2 in "),
      concat("concat(",helper,"(",call,",at,half),",helper,"(",call,",at+half,count-half))\n")) in
    let helpers=tpl_set_word(restored.helpers,slot,code) in
    TplSeq { c=restored with { helpers=helpers }, parts=push(s.parts,concat(helper,"(",call,",0,len(",source.expr,"))")), done=false, end=tpl_empty() }

type TplBinding = { key:Arr u8 _, expr:Arr u8 _, kind:Arr u8 _ }
type TplBinds = { items:Arr TplBinding _, err:Arr u8 _ }
private fn tpl_no_bindings() -> Arr TplBinding _ = arr(i in 0..0) TplBinding { key="", expr="", kind="" }
private fn tpl_binding_at(borrow items:Arr TplBinding _, i:i64) -> TplBinding
  = if i>=0 && i<len(items) then items[i] else TplBinding { key=tpl_empty(), expr=tpl_empty(), kind=tpl_empty() }
private fn tpl_binding_index(borrow items:Arr TplBinding _, borrow key:Arr u8 _) -> i64
  = loop (i=0, found= -1) while found<0 && i<len(items)
      next (i+1, if i>=0 && i<len(items) && tpl_eq(items[i].key,key) then i else -1) yield found
; key=value words of a component block (block) or an include.
private fn tpl_bind(borrow ctx:TplCtx, borrow kinds:Arr TplPair _, borrow locals:Arr TplPair _, move b:TplBinds, borrow word:Arr u8 _, block:bool) -> TplBinds
  = let eq=tpl_find_byte(word,61,0) in
    let key=if eq<0 then word else tpl_slice(word,0,eq) in
    if eq<0 || tpl_binding_index(b.items,key)>=0 || (block && tpl_eq(key,"content")) then
      b with { err=concat(ctx.path,if block then ": invalid component binding" else ": component bindings use prop=local_prop") }
    else match tpl_resolve(ctx,kinds,locals,tpl_slice(word,eq+1,len(word))) {
      Err(e) => b with { err=e },
      Ok(found) => b with { items=push(b.items,TplBinding { key=key, expr=found.expr, kind=found.kind }) } }
; set(bindings) == set(props), leaving out content for a block.
private fn tpl_bindings_cover(borrow items:Arr TplBinding _, borrow props:Arr TplPair _, block:bool) -> bool
  = let wanted=if block && tpl_has(props,"content") then len(props)-1 else len(props) in
    len(items)==wanted && loop (i=0, ok=true) while ok && i<len(items)
      next (i+1, let key=tpl_binding_at(items,i).key in tpl_has(props,key) && !(block && tpl_eq(key,"content"))) yield ok
private fn tpl_bad_binding(borrow items:Arr TplBinding _, borrow props:Arr TplPair _) -> i64
  = loop (i=0, found= -1) while found<0 && i<len(items)
      next (i+1, let item=tpl_binding_at(items,i) in if tpl_eq(item.kind,tpl_get(props,item.key)) then -1 else i) yield found
private fn tpl_component_args(borrow props:Arr TplPair _, borrow items:Arr TplBinding _, borrow content:Arr u8 _) -> Arr u8 _
  = let args=loop (o=tpl_no_words(), i=0) while i<len(props)
      next (let prop=tpl_pair_at(props,i).key in
            push(o,if len(content)>0 && tpl_eq(prop,"content") then concat("web_html(",content,")")
                   else tpl_binding_at(items,tpl_binding_index(items,prop)).expr), i+1) yield o in
    tpl_join(args,",")

; {% component Name prop=local %}...{% endcomponent %} (block) and
; {% include Name prop=local %}.
private fn tpl_component(borrow ctx:TplCtx, move s:TplSeq, borrow d:Arr u8 _, block:bool) -> TplSeq
  = let words=tpl_split_space(d) in
    let name=tpl_word_at(words,1) in
    let at=tpl_template_index(ctx.components,name) in
    let props=tpl_template_props(ctx.components,at) in
    if block && (at<0 || !tpl_eq(tpl_get(props,"content"),"html")) then tpl_seq_fail(s,ctx,"component blocks require a content:html slot")
    else if !block && len(words)<2 then tpl_seq_fail(s,ctx,"include requires a component name")
    else if !block && at<0 then tpl_seq_fail(s,ctx,concat("unknown component ",name)) else
    let binds=loop (b=TplBinds { items=tpl_no_bindings(), err=tpl_empty() }, i=2) while len(b.err)==0 && i<len(words)
      next (tpl_bind(ctx,s.c.kinds,s.c.locals,b,tpl_word_at(words,i),block), i+1) yield b in
    if len(binds.err)>0 then tpl_seq_error(s,binds.err)
    else if !tpl_bindings_cover(binds.items,props,block) then
      tpl_seq_fail(s,ctx,if block then "missing component props" else concat(name," requires props ",tpl_keys_repr(props)))
    else let bad=tpl_bad_binding(binds.items,props) in
    if bad>=0 then
      (let key=tpl_binding_at(binds.items,bad).key in
       tpl_seq_fail(s,ctx,if block then concat("incompatible component prop ",key) else concat("incompatible prop ",key," for ",name)))
    else if !block then
      let c=s.c with { deps=push(s.c.deps,name) } in
      s with { c=c, parts=push(s.parts,concat("view_",name,"(",tpl_component_args(props,binds.items,tpl_empty()),").bytes")) }
    else
      let inner=tpl_sequence(ctx,s.c,true) in
      if inner.failed then s with { c=inner }
      else if !inner.has_end || !tpl_eq(inner.end,"endcomponent") then s with { c=tpl_cfail(inner,ctx,"missing endcomponent") }
      else let args=tpl_component_args(props,binds.items,inner.expr) in
      TplSeq { c=inner with { deps=push(inner.deps,name) }, parts=push(s.parts,concat("view_",name,"(",args,").bytes")), done=false, end=tpl_empty() }

type TplAssets = { out:Arr u8 _, i:i64, missing:Arr u8 _, failed:bool }
private fn tpl_asset_step(borrow token:Arr u8 _, borrow assets:Arr TplPair _, move a:TplAssets) -> TplAssets
  = let close=if bytes_match_at(token,a.i,"@asset(") then tpl_find_byte(token,41,a.i+7) else -1 in
    if close>a.i+7 then
      (let key=tpl_slice(token,a.i+7,close) in let at=tpl_index(assets,key) in
       if at<0 then a with { missing=key, failed=true } else a with { out=concat(a.out,tpl_pair_at(assets,at).value), i=close+1 })
    else a with { out=push(a.out,u8(tpl_b(token,a.i))), i=a.i+1 }
private fn tpl_seq_text(borrow ctx:TplCtx, move s:TplSeq, borrow token:Arr u8 _) -> TplSeq
  = if tpl_has_open(token) then tpl_seq_fail(s,ctx,"unterminated template expression") else
    ; @asset(name) resolves at build time: re.sub(r'@asset\(([^)]+)\)', ...)
    let sub=loop (a=TplAssets { out=tpl_empty(), i=0, missing=tpl_empty(), failed=false }) while !a.failed && a.i<len(token)
      next (tpl_asset_step(token,ctx.assets,a)) yield a in
    if sub.failed then tpl_seq_fail(s,ctx,concat("missing asset ",sub.missing))
    else if len(sub.out)==0 then s
    else s with { parts=push(s.parts,tpl_literal(sub.out)) }

; Neo code for one template: its loop helpers, text_<name> (the bare concat)
; and view_<name>; the components it uses; and its text_ expression.
fn tpl_compile_template(borrow template:TplTemplate, borrow components:Arr TplTemplate _, borrow assets:Arr TplPair _) -> Result<TplCompiled,Arr u8 _>
  = let ctx=TplCtx { name=template.name, path=template.path, props=template.props, types=template.types, components=components, assets=assets } in
    let start=TplC { tokens=tpl_tokens(template.body), pos=0, helpers=tpl_no_words(), deps=tpl_no_words(), kinds=template.props,
                     locals=tpl_no_pairs(), failed=false, err=tpl_empty(), expr=tpl_empty(), end=tpl_empty(), has_end=false } in
    let done=tpl_sequence(ctx,start,false) in
    if done.failed then Err::<TplCompiled,Arr u8 _>(done.err) else
    let args=tpl_args(template.props,template.props,template.types,false) in
    if len(args.err)>0 then Err::<TplCompiled,Arr u8 _>(args.err) else
    let call=tpl_call(template.props,tpl_no_pairs()) in
    ; text_* is the bare concat, so a text_* call inside another template's concat
    ; is inlined and flattened by the compiler instead of copied as a finished string.
    let code=concat(tpl_join(done.helpers,""),"fn text_",template.name,"(",args.text,") -> Arr u8 _ = ",done.expr,"\n",
      concat("fn view_",template.name,"(",args.text,") -> WebHtml = web_html(text_",template.name,"(",call,"))\n")) in
    Ok::<TplCompiled,Arr u8 _>(TplCompiled { code=code, deps=done.deps, expression=done.expr })

; ---------------------------------------------------------------- compile_all

type TplEdge = { name:Arr u8 _, deps:Arr Arr u8 _ _ }
private fn tpl_edge_index(borrow edges:Arr TplEdge _, borrow name:Arr u8 _) -> i64
  = loop (i=0, found= -1) while found<0 && i<len(edges)
      next (i+1, if i>=0 && i<len(edges) && tpl_eq(edges[i].name,name) then i else -1) yield found
private fn tpl_edge_deps(borrow edges:Arr TplEdge _, i:i64) -> Arr Arr u8 _ _
  = if i>=0 && i<len(edges) then edges[i].deps else tpl_no_words()
private fn tpl_edge_name(borrow edges:Arr TplEdge _, i:i64) -> Arr u8 _
  = if i>=0 && i<len(edges) then edges[i].name else tpl_empty()
; visit(name, active): the recursion error, or "".
private fn tpl_visit(borrow edges:Arr TplEdge _, borrow name:Arr u8 _, borrow active:Arr Arr u8 _ _) -> Arr u8 _
  = let path=push(active,name) in
    if tpl_words_have(active,name) then concat("Recursive template component: ",tpl_join(path," -> ")) else
    let children=tpl_edge_deps(edges,tpl_edge_index(edges,name)) in
    loop (i=0, err=tpl_empty()) while len(err)==0 && i<len(children) next (i+1, tpl_visit(edges,tpl_word_at(children,i),path)) yield err

type TplAllState = { output:Arr Arr u8 _ _, edges:Arr TplEdge _, expressions:Arr TplPair _, err:Arr u8 _ }
private fn tpl_all_step(borrow template:TplTemplate, borrow components:Arr TplTemplate _, borrow assets:Arr TplPair _, move s:TplAllState) -> TplAllState
  = match tpl_compile_template(template,components,assets) {
      Err(e) => s with { err=e },
      Ok(compiled) =>
        (let at=tpl_edge_index(s.edges,template.name) in
         let edge=TplEdge { name=template.name, deps=compiled.deps } in
         TplAllState { output=push(s.output,compiled.code),
           edges=if at>=0 && at<len(s.edges) then set(s.edges,at,edge) else push(s.edges,edge),
           expressions=tpl_put(s.expressions,template.name,compiled.expression), err=tpl_empty() }) }

; All templates' code joined by newlines, after rejecting component cycles.
fn tpl_compile_all(borrow templates:Arr TplTemplate _, borrow components:Arr TplTemplate _, borrow assets:Arr TplPair _) -> Result<TplAll,Arr u8 _>
  = let s=loop (st=TplAllState { output=tpl_no_words(), edges=arr(i in 0..0) TplEdge { name="", deps=tpl_no_words() }, expressions=tpl_no_pairs(), err=tpl_empty() }, i=0)
      while len(st.err)==0 && i<len(templates)
      next (if i>=0 && i<len(templates) then tpl_all_step(templates[i],components,assets,st) else st, i+1) yield st in
    if len(s.err)>0 then Err::<TplAll,Arr u8 _>(s.err) else
    let cycle=loop (i=0, err=tpl_empty()) while len(err)==0 && i<len(s.edges)
      next (i+1, tpl_visit(s.edges,tpl_edge_name(s.edges,i),tpl_no_words())) yield err in
    if len(cycle)>0 then Err::<TplAll,Arr u8 _>(cycle) else
    Ok::<TplAll,Arr u8 _>(TplAll { code=tpl_join(s.output,"\n"), expressions=s.expressions })

; ---------------------------------------------------------------- substitute

; End of the STRING match "(?:[^"\\]|\\.)*" at i, or -1.
private fn tpl_string_end(borrow t:Arr u8 _, i:i64) -> i64
  = if tpl_b(t,i)!=34 then -1 else
    loop (j=i+1, end= -1) while end== -1 && j>=0
      next (let b=tpl_b(t,j) in
            if b==34 then j else if b==92 && tpl_b(t,j+1)>=0 && tpl_b(t,j+1)!=10 then j+2 else if b<0 || b==92 then -2 else j+1,
            let b=tpl_b(t,j) in if b==34 then j+1 else if b<0 || (b==92 && (tpl_b(t,j+1)<0 || tpl_b(t,j+1)==10)) then -2 else -1)
      yield if end>0 then end else -1
private fn tpl_insert_by_length(borrow sorted:Arr TplPair _, borrow item:TplPair) -> Arr TplPair _
  = let at=loop (k=0) while k<len(sorted) && len(tpl_pair_at(sorted,k).key)>=len(item.key) next (k+1) yield k in
    loop (o=tpl_no_pairs(), k=0) while k<=len(sorted)
      next (if k==at then (if k<len(sorted) then push(push(o,item),tpl_pair_at(sorted,k)) else push(o,item)) else push(o,tpl_pair_at(sorted,k)), k+1)
      yield o
type TplSub = { out:Arr u8 _, p:i64 }
; (?<![\w.])(?:name|...)(?!\w) at p of one segment: the mapping index or -1.
private fn tpl_sub_match(borrow seg:Arr u8 _, p:i64, borrow names:Arr TplPair _) -> i64
  = let behind=p==0 || (let c=tpl_code(seg,tpl_prev(seg,p)) in !text_is_word_char(c) && c!=46) in
    if !behind then -1 else
    loop (k=0, found= -1) while found<0 && k<len(names)
      next (k+1, let name=tpl_pair_at(names,k).key in let e=p+len(name) in
            if len(name)>0 && bytes_match_at(seg,p,name) && (e>=len(seg) || !text_is_word_char(tpl_code(seg,e))) then k else -1) yield found
private fn tpl_sub_step(borrow seg:Arr u8 _, borrow names:Arr TplPair _, move s:TplSub) -> TplSub
  = let k=tpl_sub_match(seg,s.p,names) in
    if k<0 then TplSub { out=push(s.out,u8(tpl_b(seg,s.p))), p=s.p+1 }
    else let pair=tpl_pair_at(names,k) in TplSub { out=concat(s.out,pair.value), p=s.p+len(pair.key) }
private fn tpl_sub_segment(move out:Arr u8 _, borrow seg:Arr u8 _, borrow names:Arr TplPair _) -> Arr u8 _
  = let s=loop (st=TplSub { out=out, p=0 }) while st.p<len(seg) next (tpl_sub_step(seg,names,st)) yield st in s.out
type TplSubst = { out:Arr u8 _, last:i64, i:i64 }
private fn tpl_subst_step(borrow t:Arr u8 _, borrow names:Arr TplPair _, move s:TplSubst) -> TplSubst
  = let e=tpl_string_end(t,s.i) in
    if e<0 then s with { i=s.i+1 } else
    TplSubst { out=concat(tpl_sub_segment(s.out,tpl_slice(t,s.last,s.i),names),tpl_slice(t,s.i,e)), last=e, i=e }
; Replace identifiers in generated Neo code, never inside string literals.
; Mapping keys are non-empty (an empty key, which a regular expression would
; match at every boundary, is ignored).
fn tpl_substitute(borrow expression:Arr u8 _, borrow mapping:Arr TplPair _) -> Arr u8 _
  = if len(mapping)==0 then expression else
    let names=loop (o=tpl_no_pairs(), i=0) while i<len(mapping) next (tpl_insert_by_length(o,tpl_pair_at(mapping,i)), i+1) yield o in
    let s=loop (st=TplSubst { out=tpl_empty(), last=0, i=0 }) while st.i<len(expression) next (tpl_subst_step(expression,names,st)) yield st in
    tpl_sub_segment(s.out,tpl_slice(expression,s.last,len(expression)),names)
