---
import Row from "./Row.astro";
import "../../../../shared/site.css";
const { value } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Framework catalog</title></head><body><main id="benchmark" data-n={value.n} data-seed={value.seed}><h1>Framework catalog</h1><p class="request" id="request-token">{value.token}</p><output class="stamp" id="render-stamp">{value.stamp}</output><slot/><table><thead><tr><th>ID</th><th>Name</th><th>Price</th><th>Stock</th><th>Note</th></tr></thead><tbody id="catalog-rows">{value.rows.map(row => <Row row={row}/>)}</tbody><tfoot><tr><td colspan="5" id="checksum">{value.checksum}</td></tr></tfoot></table></main></body></html>
