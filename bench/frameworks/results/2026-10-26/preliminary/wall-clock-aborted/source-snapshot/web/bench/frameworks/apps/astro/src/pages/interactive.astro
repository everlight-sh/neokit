---
import Document from "../components/Document.astro";
import { data } from "./../../../../shared/model.js";
import Counter from "../components/Counter.astro";
const isStatic=process.env.BENCH_MODE==="static";
if (!isStatic) Astro.response.headers.set("Cache-Control","no-store");
const value=data(isStatic ? {} : Astro.url.searchParams,50,isStatic ? 0 : Date.now());
---
<Document value={value}><Counter/></Document>
