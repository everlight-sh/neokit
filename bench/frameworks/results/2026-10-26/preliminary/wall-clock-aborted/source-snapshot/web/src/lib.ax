import "std:http"
import "std:io"
import "std:json"

; Templates produce HTML; text props always pass through html_escape.
type WebHtml = { bytes: Arr u8 _ }
type WebRequest = { method: Arr u8 _, path: Arr u8 _, query: Arr u8 _, body: Arr u8 _, param: Arr u8 _, server: bool, stamp: i64 }
type WebResponse = { status: i64, body: Arr u8 _, content_type: Arr u8 _, immutable: bool }

fn web_html(body: Arr u8 n) -> WebHtml = WebHtml { bytes=body }
fn web_reply(status: i64, body: Arr u8 n, content_type: Arr u8 m) -> WebResponse
  = WebResponse { status=status,body=body,content_type=content_type,immutable=false }
fn web_document(body: WebHtml) -> WebResponse = web_reply(200,body.bytes,"text/html; charset=utf-8")
fn web_json(body: Arr u8 n) -> WebResponse = web_reply(200,body,"application/json; charset=utf-8")

fn web_encode(response: WebResponse, head: bool) -> Arr u8 _
  = let reason=if response.status==200 then "OK" else if response.status==400 then "Bad Request" else if response.status==404 then "Not Found" else if response.status==405 then "Method Not Allowed" else "Error" in
    concat("HTTP/1.1 ",int_text(response.status)," ",reason,"\r\nContent-Length: ",int_text(len(response.body)),
      "\r\nContent-Type: ",response.content_type,"\r\nCache-Control: ",if response.immutable then "public, max-age=31536000, immutable" else "no-store",
      "\r\nX-Content-Type-Options: nosniff\r\nContent-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; base-uri 'self'; frame-ancestors 'none'\r\n",
      if response.status==405 then "Allow: GET, HEAD\r\n" else "", "Connection: keep-alive\r\n\r\n",if head then "" else response.body)

fn web_query(request: Arr u8 n) -> Arr u8 _
  = let first=str_find(request," ") in if !first.present then "" else
    let rest=str_slice(request,first.value+1,n) in let end=str_find(rest," ") in
    if !end.present then "" else let target=str_slice(rest,0,end.value) in let query=str_find(target,"?") in
    if query.present then str_slice(target,query.value+1,len(target)) else ""
fn web_normal_path(path: Arr u8 n) -> Arr u8 _
  = if n>1 && str_byte(path,n-1)==47 then str_slice(path,0,n-1) else path
fn web_request(raw: Arr u8 n, stamp: i64) -> WebRequest
  = WebRequest { method=http_method(raw),path=web_normal_path(http_path(raw)),query=web_query(raw),body=http_body(raw),param="",server=true,stamp=stamp }
fn web_static_request(path: Arr u8 n) -> WebRequest
  = WebRequest { method="GET",path=path,query="",body="",param="",server=false,stamp=0 }

fn web_header(raw: Arr u8 n, name: Arr u8 m) -> Arr u8 _
  = let first=http_line_end(raw,0) in
    loop(at=if first<0 then n else first+2,value="",done=false) while !done && at<n
      next(let end=http_line_end(raw,at) in if end<0 then n else end+2,
        let end=http_line_end(raw,at) in let line=str_slice(raw,at,end) in let colon=str_find(line,":") in
        if colon.present && str_equal(http_lower(str_slice(line,0,colon.value)),name) then str_trim(str_slice(line,colon.value+1,len(line))) else value,
        let end=http_line_end(raw,at) in end<=at) yield value

fn web_decode(text: Arr u8 n) -> OptionBytes
  = loop(i=0,out="",valid=true) while valid && i<n
      next(i+(if str_byte(text,i)==37 then 3 else 1),
        let byte=str_byte(text,i) in if byte==37 then
          let hi=http_hex(str_byte(text,i+1)) in let lo=http_hex(str_byte(text,i+2)) in
          if i+2<n && hi>=0 && lo>=0 then let value=hi*16+lo in check value>=0 && value<=255 in concat(out,arr(k in 0..1) u8(value)) else out
        else concat(out,if byte==43 then " " else str_slice(text,i,i+1)),
        if str_byte(text,i)==37 then i+2<n && http_hex(str_byte(text,i+1))>=0 && http_hex(str_byte(text,i+2))>=0 else true)
      yield if valid && utf8_valid(out) && !str_find(out,"\0").present then some_bytes(out) else none_bytes()
fn web_query_get(query: Arr u8 n, name: Arr u8 m) -> OptionBytes
  = loop(at=0,value=none_bytes(),done=false) while !done && at<n
      next(let found=str_find(str_slice(query,at,n),"&") in if found.present then at+found.value+1 else n,
        let found=str_find(str_slice(query,at,n),"&") in let end=if found.present then at+found.value else n in
        let part=str_slice(query,at,end) in let equal=str_find(part,"=") in
        let key=web_decode(if equal.present then str_slice(part,0,equal.value) else part) in
        if key.present && str_equal(key.value,name) then web_decode(if equal.present then str_slice(part,equal.value+1,len(part)) else "") else value,
        let found=str_find(str_slice(query,at,n),"&") in let end=if found.present then at+found.value else n in
        let part=str_slice(query,at,end) in let equal=str_find(part,"=") in
        let key=web_decode(if equal.present then str_slice(part,0,equal.value) else part) in key.present && str_equal(key.value,name)) yield value
fn web_segment(path: Arr u8 n, prefix: Arr u8 m) -> OptionBytes
  = if !str_starts(path,prefix) || n<=m then none_bytes() else
    let rest=str_slice(path,m,n) in let value=web_decode(rest) in
    if str_find(rest,"/").present || !value.present || str_find(value.value,"/").present || str_find(value.value,"\\").present || str_equal(value.value,".") || str_equal(value.value,"..") then none_bytes() else value
