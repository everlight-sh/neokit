import "std:event_stream"

; Server code chooses the channel; ordinary before hooks authorize admission.
effect(process) fn web_channel(name:Arr u8 n)->EventChannel = event_channel(name)
effect(time,process) fn web_publish(channel:EventChannel,event:Arr u8 n,json:Arr u8 m)->IntResult
  = let clock=time_unix_ms() in if !clock.ok then clock else event_publish(channel,event,json,clock.value)
private fn realtime_cursor(epoch:i64,sequence:i64)->Arr u8 _ = concat(int_text(epoch),".",int_text(sequence))
; Scalar state: channel ID, completed cursor, epoch, heartbeat, lifetime,
; offset in the next event (only for a frame larger than a send budget).
private fn realtime_wake(now:i64,deadline:i64)->i64 = if now+15000<deadline then now+15000 else deadline-1
private type RealtimeOutput = {bytes:Arr u8 _,after:i64,offset:i64,ok:bool}
private effect(process) fn realtime_append(channel:EventChannel,epoch:i64,message:EventMessage,output:RealtimeOutput)->RealtimeOutput
  = let prepared=event_stream_frame(channel,epoch,message) in
    let payload=if prepared.ok then http_async_frame_payload(prepared.frame) else
      if prepared.error.code==27 then sse_encode(message.event,message.json,realtime_cursor(epoch,message.sequence)) else bytes_error(prepared.error.code,"Event frame unavailable",0) in
    if !payload.ok || output.offset>len(payload.value) then output with {ok=false} else
    let room=48000-len(output.bytes) in let remaining=len(payload.value)-output.offset in
    let size=if remaining<room then remaining else room in
    RealtimeOutput {bytes=concat(output.bytes,str_slice(payload.value,output.offset,output.offset+size)),
      after=if size==remaining then message.sequence else output.after,offset=if size==remaining then 0 else output.offset+size,ok=true}

; Common delivery retains numeric state and borrows a cached prepared frame.
; Neo copies any unsent suffix into connection-owned storage before returning.
; Timers only drive heartbeat and renewal; publication drives data readiness.
effect(fs,net,env,time,process) fn web_events_step(capture:Arr u8 n)->Arr u8 _
  = let restored=http_async_state_get() in let now=monotonic_ms() in
    if !restored.ok || !now.ok then http_async_close("") else let state=restored.value in
    let deadline=state.word4 in if now.value+1>=deadline then http_async_close(": reconnect\n\n") else
    if !http_async_event_ready() then
      let saved=http_async_state_set(state with {word3=now.value}) in
      http_async_send_bytes(": heartbeat\n\n",realtime_wake(now.value,deadline)) else
    let channel=event_channel_from_id(state.word0) in let batch=event_read(channel,state.word1,4) in
    if !batch.ok then (if batch.error.code==11 then let watched=event_watch_unlock(channel) in http_async_send_bytes("",deadline-1) else http_async_close("")) else
    let reset=batch.reset || state.word2!=batch.epoch in
    if reset && state.word5!=0 then http_async_close("") else
    let first=if len(batch.events)==1 && !reset && state.word5==0 then
      check len(batch.events)==1 in event_stream_frame(channel,batch.epoch,batch.events[0]) else http_async_no_frame() in
    if first.ok then
      let after=check len(batch.events)==1 in batch.events[0].sequence in
      let saved=http_async_state_set(state with {word1=after,word2=batch.epoch,word3=now.value,word5=0}) in
      let watched=event_watch(channel,after) in http_async_send_frame(first.frame,realtime_wake(now.value,deadline)) else
    let prefix=if reset then sse_encode("neokit-reset","{\"reason\":\"replay-window\"}","").value else "" in
    let output=loop(i=0,out=RealtimeOutput {bytes=prefix,after=if reset && len(batch.events)>0 then check len(batch.events)>0 in batch.events[0].sequence-1 else if reset then batch.latest else state.word1,offset=state.word5,ok=true})
      while out.ok && i<len(batch.events) && len(out.bytes)<48000 && (i==0 || out.offset==0)
      next(i+1,check i>=0 && i<len(batch.events) in realtime_append(channel,batch.epoch,batch.events[i],out)) yield out in
    if !output.ok then http_async_close("") else
    let sent=len(output.bytes)>0 || now.value-state.word3>=15000 in
    let heart=if sent then now.value else state.word3 in
    let saved=http_async_state_set(state with {word1=output.after,word2=batch.epoch,word3=heart,word5=output.offset}) in
    let watched=event_watch(channel,output.after) in
    http_async_send_bytes(if len(output.bytes)==0 && sent then ": heartbeat\n\n" else output.bytes,realtime_wake(heart,deadline))

effect(net,time,process) fn web_subscribe_with(request:WebRequest,channel:EventChannel,step:Effect<fs,net,env,time,process>(Arr u8 _)->Arr u8 _)->Arr u8 _
  = let name=event_channel_name(channel) in let latest=event_latest(channel) in let now=monotonic_ms() in
    if len(name)==0 || !latest.ok || !now.ok then web_encode_close(web_reply(503,"Realtime unavailable","text/plain; charset=utf-8"),false) else
    let header=web_request_header(request,"last-event-id") in let query=web_query_get(request.query,"after").value in let cursor=if len(header)>0 then header else query in
    let split=str_find(cursor,".") in let epoch=int_parse(str_slice(cursor,0,split.value)) in let sequence=int_parse(str_slice(cursor,split.value+1,len(cursor))) in
    if len(cursor)>80 || len(cursor)>0 && (!split.present || !epoch.ok || !sequence.ok || sequence.value<0 || sequence.value>9007199254740991) then web_encode_close(web_reply(400,"Invalid event cursor","text/plain; charset=utf-8"),false) else
    let after=if len(cursor)==0 then (if latest.latest>0 then latest.latest-1 else 0) else if epoch.value!=latest.epoch then latest.latest+1 else sequence.value in
    let lifetime=now.value+60000 in
    let ready=sse_encode("neokit-ready",concat("{\"channel\":",json_quote(name),",\"latest\":",int_text(latest.latest),"}"),"").value in
    let response=web_with_header(web_reply(200,concat("retry: 1000\n\n",ready),"text/event-stream; charset=utf-8"),"X-Accel-Buffering","no") in
    let started=http_async_response(response,"",step,now.value+15000,lifetime) in
    if started.ok then
      let saved=http_async_state_set(HttpAsyncState {word0=event_channel_id(channel),word1=after,word2=latest.epoch,word3=now.value,word4=lifetime,word5=0,word6=0,word7=0}) in
      let watched=event_watch(channel,after) in started.value else web_encode_close(web_reply(503,"Realtime capacity unavailable","text/plain; charset=utf-8"),false)
effect(net,time,process) fn web_subscribe(request:WebRequest,channel:EventChannel)->Arr u8 _
  = web_subscribe_with(request,channel,function(web_events_step))
