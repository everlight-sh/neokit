@props(title: text, slug: text, summary: text)
<article class="article-page"><a class="text-link" href="/" data-web-link>← Back to the workbench</a><div class="eyebrow">FIELD NOTE / {{ slug }}</div><h1>{{ title }}<span class="green-period">.</span></h1><p class="article-lede">{{ summary }}</p><div class="article-note">This route comes from <code>app/notes/[slug]/</code>. Its loader receives the decoded path parameter; the template escapes it as text.</div><div class="demo-card small-counter" data-web-widget="counter"><span class="card-kicker">THE SAME COMPONENT, ANOTHER PAGE</span><div class="inline-counter"><output data-count aria-live="polite" aria-label="Counter value">0</output><button class="button button-dark" data-increment type="button">Add one +</button><button class="button-reset" data-reset type="button">Reset ↺</button></div></div></article>
