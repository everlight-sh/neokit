@props(title:text,n:int,seed:int,token:text,stamp:int,checksum:int,rows:html,interactive:bool,metrics:bool)
<main class="mx-auto my-12 max-w-[1100px] px-6" id="benchmark" data-n="{{ n }}" data-seed="{{ seed }}"><h1 class="mb-5 font-serif text-5xl tracking-[-2px]">{{ title }}</h1><p class="request" id="request-token">{{ token }}</p><output class="stamp" id="render-stamp">{{ stamp }}</output>{% if interactive %}<section class="counter" data-web-widget="counter"><output data-count aria-label="Counter value" aria-live="polite">0</output><button type="button" data-increment>Add one +</button><button type="button" data-reset>Reset</button></section>{% endif %}<table class="w-full border-collapse bg-white"><thead><tr><th>ID</th><th>Name</th><th>Price</th><th>Stock</th><th>Note</th></tr></thead><tbody id="catalog-rows">{{ rows }}</tbody><tfoot><tr><td colspan="5" id="checksum">{{ checksum }}</td></tr></tfoot></table></main>

{% if metrics %}<script defer src="/browser-metrics.js"></script>{% endif %}
