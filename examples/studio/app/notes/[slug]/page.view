@props(title: text, slug: text, summary: text)
<article class="mx-auto min-h-[70vh] max-w-4xl px-6 py-16 sm:py-20"><a class="text-sm font-medium text-indigo-600 hover:text-indigo-500" href="/" data-web-link>← Back to home</a><span class="mt-10 block text-sm font-semibold text-indigo-600">Guide / {{ slug }}</span><h1 class="mt-3 text-4xl font-bold tracking-tight break-words text-slate-900 sm:text-5xl">{{ title }}</h1><p class="mt-6 text-lg leading-8 text-slate-600">{{ summary }}</p><p class="mt-6 text-sm leading-6 text-slate-500">This page is rendered from a dynamic route. Its title and content come from a Neo loader.</p><section class="mt-10 rounded-xl border border-slate-200 bg-slate-50 p-6" data-web-widget="counter"><h2 class="font-semibold">Try a client-side interaction</h2><p class="mt-2 text-sm text-slate-600">The same counter works after navigating between pages.</p><div class="mt-6 flex flex-wrap items-center gap-4"><output class="min-w-12 text-4xl font-semibold tabular-nums" data-count aria-live="polite" aria-label="Counter value">0</output><button class="cursor-pointer rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" data-increment type="button">Add one +</button><button class="cursor-pointer rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" data-reset type="button">Reset</button></div></section></article>
