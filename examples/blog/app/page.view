@props(title:text,server:bool,query:text,category:text,cards:html[],featured:bool,empty:bool)
<section class="journal-intro wrap"><span class="eyebrow">AN INDEPENDENT JOURNAL</span><h1>Ideas worth<br><em>slowing down for.</em></h1><p>Thoughts on design, engineering, and the everyday.<br>A fresh perspective, a few times a month.</p></section>
{% if featured %}<section class="featured wrap"><a class="featured-art" href="/journal/a-smaller-web"><img src="/cover-0.svg" alt="Abstract illustration of a sun and a small doorway in a terracotta landscape" width="800" height="520"></a><div class="featured-copy"><div class="story-meta"><span>FEATURED STORY</span><span>Engineering · 7 min read</span></div><h2><a href="/journal/a-smaller-web">Make room for<br>a smaller web.</a></h2><p>The best thing we can send to a browser is often a little less. On building useful experiences with fewer moving parts.</p><div class="story-author"><span class="avatar">MC</span><span>Maya Chen<small>November 8, 2026</small></span><a href="/journal/a-smaller-web" aria-label="Read Make room for a smaller web">↗</a></div></div></section>{% endif %}
<section class="stories wrap" id="stories"><div class="stories-toolbar"><h2>Fresh perspectives</h2>{% if server %}<form action="/" method="get" role="search"><label class="sr-only" for="story-search">Search stories</label><input id="story-search" name="q" value="{{ query }}" placeholder="Search stories…" maxlength="120"><input type="hidden" name="category" value="{{ category }}"><button type="submit" aria-label="Search">↗</button></form>{% endif %}</div>{% if server %}<nav class="categories" aria-label="Story categories"><a href="/">All stories</a><a href="/?category=design#stories">Design</a><a href="/?category=engineering#stories">Engineering</a><a href="/?category=notes#stories">Notes & observations</a></nav>{% endif %}{% if empty %}<div class="empty"><h3>No stories found.</h3><p>Try another phrase, or explore the full journal.</p><a href="/">See all stories ↗</a></div>{% endif %}<div class="story-grid">{% for card in cards %}{{ card }}{% endfor %}</div></section>
