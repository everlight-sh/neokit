@props(title:text,category:text,minutes:text,date:text,author:text,initials:text,excerpt:text,cover:url,body:html,related:html[])
<article class="article"><header class="article-head"><a class="back" href="/">← Back to the journal</a><div class="story-meta"><span>{{ category }}</span><span>{{ minutes }}</span></div><h1>{{ title }}</h1><p class="article-deck">{{ excerpt }}</p><div class="story-author"><span class="avatar">{{ initials }}</span><span>{{ author }}<small>{{ date }}</small></span></div></header><img class="article-cover" src="{{ cover }}" alt="Editorial illustration for this story" width="800" height="520"><div class="article-body">{{ body }}<aside class="article-note">Fieldnotes is a fictional publication and a working NeoKit example. Every story arrives as a complete server-rendered document.</aside></div></article><section class="stories wrap"><div class="stories-toolbar"><h2>A little more to explore</h2><a href="/">All stories ↗</a></div><div class="story-grid related">{% for card in related %}{{ card }}{% endfor %}</div></section>
