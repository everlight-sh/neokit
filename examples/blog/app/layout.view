@props(title:text,content:html,client:bool,mode:text)
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ title }} · Fieldnotes</title><meta name="description" content="An independent journal on design, engineering, and the everyday."><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="stylesheet" href="@asset(site.css)"></head><body data-render-mode="{{ mode }}"><a class="skip" href="#web-page">Skip to content</a><progress class="reading-progress" max="1" value="0" aria-label="Reading progress"></progress><header class="masthead wrap"><a href="/" class="wordmark">fieldnotes<span>✳</span></a><nav aria-label="Main navigation"><a href="/">The journal</a><a href="/about">About us</a><a class="nav-button" href="/about#stay-curious">Stay curious ↗</a></nav></header><main id="web-page" tabindex="-1">{{ content }}</main><footer class="footer wrap"><div><a class="wordmark" href="/">fieldnotes<span>✳</span></a><p>A little perspective goes a long way.</p></div><div class="footer-right"><span>Made with care. Rendered with NeoKit.</span><span class="speed" data-performance><i></i><output>Server-rendered HTML</output></span></div></footer>{% if client %}<script type="module" src="@asset(client.js)"></script>{% endif %}</body></html>
