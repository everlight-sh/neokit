@props(title:text,content:html,client:bool,mode:text)
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ title }} · Forma</title><meta name="description" content="A small architecture studio creating thoughtful places to live."><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="stylesheet" href="@asset(site.css)"></head><body data-render-mode="{{ mode }}"><a class="skip" href="#web-page">Skip to content</a><header class="site-header wrap"><a class="brand" href="/" aria-label="Forma home">forma<span>®</span></a><nav aria-label="Main navigation"><a href="/#work">Selected work</a><a href="/studio">The studio</a><a class="contact-link" href="/studio#contact">Start a conversation <span aria-hidden="true">↗</span></a></nav></header><main id="web-page" tabindex="-1">{{ content }}</main><footer class="wrap footer"><a class="brand" href="/">forma<span>®</span></a><p>Thoughtful by design. Native by NeoKit.</p><span class="speed" data-performance><i></i><output>Server-rendered HTML</output></span></footer>{% if client %}<script type="module" src="@asset(client.js)"></script>{% endif %}</body></html>
