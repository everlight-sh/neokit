@props(title:text,server:bool,records:int,total:text,query:text,all:bool,growth:bool,pro:bool,enterprise:bool,large:bool,rows:html[],found:text,page:int,pages:int,has_previous:bool,has_next:bool,previous:url,next_url:url,csv:url,empty:bool,range_label:text)
<section class="page-heading"><div><span class="eyebrow">PEOPLE BEHIND THE NUMBERS</span><h1>Customers <span class="title-count">{{ total }}</span></h1><p>Know your customers. Keep the good ones close.</p></div>{% if server %}<a class="button secondary" href="{{ csv }}" download>↓ Export filtered CSV</a>{% else %}<span class="button secondary">Static snapshot</span>{% endif %}</section><section class="panel customer-directory">{% if server %}<form class="customer-filter" action="/customers" method="get" role="search"><div class="search-field"><span aria-hidden="true">⌕</span><label class="sr-only" for="customer-search">Search companies</label><input id="customer-search" name="q" value="{{ query }}" placeholder="Search companies…" maxlength="80"></div><label class="sr-only" for="plan-filter">Subscription plan</label><select id="plan-filter" name="plan">{% if all %}<option value="all" selected>All plans</option>{% else %}<option value="all">All plans</option>{% endif %}{% if growth %}<option value="Growth" selected>Growth</option>{% else %}<option value="Growth">Growth</option>{% endif %}{% if pro %}<option value="Pro" selected>Pro</option>{% else %}<option value="Pro">Pro</option>{% endif %}{% if enterprise %}<option value="Enterprise" selected>Enterprise</option>{% else %}<option value="Enterprise">Enterprise</option>{% endif %}</select><label class="sr-only" for="directory-count">Demo dataset</label><select id="directory-count" name="records">{% if large %}<option value="1000">1,000 accounts</option><option value="10000" selected>10,000 accounts</option>{% else %}<option value="1000" selected>1,000 accounts</option><option value="10000">10,000 accounts</option>{% endif %}</select><button class="button compact" type="submit">Filter</button><a class="reset-filter" href="/customers">Reset</a></form>{% else %}<p class="snapshot-note">Static snapshot. Search, filters, CSV exports and pagination are available in the native SSR app.</p>{% endif %}<div class="directory-caption"><span><strong>{{ found }}</strong> matching accounts</span><span>25 rows per page · rendered on the server</span></div><div class="table-scroll"><table class="customer-table"><thead><tr><th>Company</th><th>Plan</th><th>Status</th><th class="numeric">Monthly revenue</th><th>Joined</th></tr></thead><tbody>{% for row in rows %}{{ row }}{% endfor %}</tbody></table></div>{% if empty %}<div class="empty"><h2>No matching customers.</h2><p>Try another name or subscription plan.</p></div>{% endif %}<nav class="table-footer pagination" aria-label="Customer pagination"><span>Showing {{ range_label }} of {{ found }}</span><div>{% if server %}{% if has_previous %}<a class="page-button" href="{{ previous }}">← Previous</a>{% endif %}<span>Page {{ page }} of {{ pages }}</span>{% if has_next %}<a class="page-button" href="{{ next_url }}">Next →</a>{% endif %}{% endif %}</div></nav></section>
