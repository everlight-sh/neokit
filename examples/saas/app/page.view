@props(title:text,server:bool,records:int,record_count:text,range:int,week:bool,month:bool,quarter:bool,large:bool,revenue:text,change:text,mrr:text,active:text,trials:text,total:text,caption:text,chart:html,sources:html,customers:html[],csv:url,customers_url:url)
<section class="page-heading"><div><span class="eyebrow">YOUR BUSINESS, AT A GLANCE</span><h1>Overview</h1><p>A little clarity on how things are going.</p></div>{% if server %}<a class="button secondary" href="{{ csv }}" download>↓ Export customers</a>{% else %}<span class="button secondary">Static snapshot</span>{% endif %}</section>
<div class="dashboard-toolbar"><div class="view-tabs"><span class="selected">Business overview</span><a href="{{ customers_url }}">Customer insights ↗</a></div>{% if server %}<form method="get" action="/" class="range-form"><label class="sr-only" for="period">Reporting period</label><select id="period" name="range">{% if week %}<option value="7" selected>Last 7 days</option>{% else %}<option value="7">Last 7 days</option>{% endif %}{% if month %}<option value="30" selected>Last 30 days</option>{% else %}<option value="30">Last 30 days</option>{% endif %}{% if quarter %}<option value="90" selected>Last 90 days</option>{% else %}<option value="90">Last 90 days</option>{% endif %}</select><label class="sr-only" for="record-count">Demo dataset</label><select id="record-count" name="records">{% if large %}<option value="1000">1,000 accounts</option><option value="10000" selected>10,000 accounts</option>{% else %}<option value="1000" selected>1,000 accounts</option><option value="10000">10,000 accounts</option>{% endif %}</select><button class="button compact" type="submit">Apply</button></form>{% else %}<span class="snapshot-note">30-day snapshot · filters available in SSR</span>{% endif %}</div>
<section class="metrics" aria-label="Key metrics"><article class="metric"><div>Net revenue<span aria-hidden="true">↗</span></div><strong data-metric="revenue">{{ revenue }}</strong><p><span class="positive">↑ {{ change }}</span> vs. previous period</p></article><article class="metric"><div>Monthly recurring revenue<span aria-hidden="true">↗</span></div><strong>{{ mrr }}</strong><p><span class="metric-note">Across paid demo accounts</span></p></article><article class="metric"><div>Active customers<span aria-hidden="true">♧</span></div><strong data-metric="active">{{ active }}</strong><p><span class="metric-note">of {{ total }} total accounts</span></p></article><article class="metric"><div>Trial accounts<span aria-hidden="true">◷</span></div><strong>{{ trials }}</strong><p><span class="metric-note">A new chapter starts here</span></p></article></section>
{% if server %}<section class="panel live-panel" data-live>
<header class="panel-heading"><div><h2>Live workspace <span class="live-dot" aria-hidden="true"></span></h2><p>Simulated events, published by Neo · shared across connected tabs</p></div><div class="live-controls"><output data-live-status aria-live="polite">Connecting</output><button class="button secondary compact" type="button" data-live-toggle>Pause</button></div></header>
<div class="live-metrics"><div><span>Demo revenue</span><strong data-live-revenue>$0</strong><small>Since this server started</small></div><div><span>New signups</span><strong data-live-signups>0</strong><small>From the shared demo feed</small></div><div><span>Events received</span><strong data-live-count>0</strong><small data-live-updated>Waiting for the first event</small></div></div>
<div class="live-content"><figure class="live-chart"><figcaption>Payment activity <span>Latest 60 received events</span></figcaption><svg viewBox="0 0 600 140" role="img" aria-label="Live payment amounts in dollars"><path class="live-grid" d="M0 10H600 M0 70H600 M0 130H600"/><path class="live-line" data-live-line d="M0 130H600"/></svg><p data-live-chart-label>Live data arrives after the initial server-rendered page.</p></figure><div><h3>Happening now</h3><ol class="live-feed" data-live-feed aria-label="Recent live activity"><li class="live-empty">Waiting for a server event…</li></ol></div></div>
<footer class="live-footer"><span>SSE · automatic reconnect · bounded replay</span><span data-live-cursor>One subscription for this dashboard</span></footer></section>{% else %}<p class="snapshot-note">Live workspace is available when running the native server. This export is a static snapshot.</p>{% endif %}
<section class="charts-grid"><article class="panel revenue-panel" data-chart><header class="panel-heading"><div><h2>Revenue over time</h2><p>{{ caption }} · {{ range }} daily data points</p></div><div class="chart-legend"><span><i class="current-dot"></i>Current</span><span><i></i>Previous</span></div></header>{{ chart }}</article><article class="panel source-panel"><header class="panel-heading"><div><h2>Where customers find you</h2><p>Acquisition mix · demo cohort</p></div><span class="panel-icon">↗</span></header><div class="source-total"><strong>{{ total }}</strong><span>total customers</span></div>{{ sources }}<p class="panel-footnote">A balanced mix makes room for growth.</p></article></section>
<section class="panel customers-panel"><header class="panel-heading"><div><h2>Customer snapshot <span class="count-pill">{{ record_count }}</span></h2><p>Good relationships start with a little context.</p></div><a class="text-button" href="{{ customers_url }}">View all customers ↗</a></header><div class="table-scroll"><table class="customer-table"><thead><tr><th>Company</th><th>Plan</th><th>Status</th><th class="numeric">Monthly revenue</th><th>Joined</th></tr></thead><tbody>{% for customer in customers %}{{ customer }}{% endfor %}</tbody></table></div><div class="table-footer"><span>8 featured accounts from {{ record_count }} generated records</span><a href="{{ customers_url }}">Explore the dataset →</a></div></section>
