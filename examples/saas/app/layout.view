@props(title:text,content:html,client:bool,mode:text)
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ title }} · Meridian</title><meta name="description" content="Meridian is a native NeoKit SaaS dashboard example. All account and revenue data is synthetic."><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="stylesheet" href="@asset(site.css)"></head><body data-render-mode="{{ mode }}"><a class="skip" href="#web-page">Skip to content</a><aside class="sidebar"><a href="/" class="brand"><span class="brand-symbol">m</span>meridian<span class="brand-dot">.</span></a><div class="workspace"><span class="workspace-avatar">AC</span><span>Acme workspace<small>Demo workspace</small></span><span class="workspace-mark">⌘</span></div><p class="nav-label">WORKSPACE</p><nav aria-label="Main navigation"><a href="/" data-nav="/"><span aria-hidden="true">◫</span>Overview</a><a href="/customers" data-nav="/customers"><span aria-hidden="true">♧</span>Customers</a><a href="/activity" data-nav="/activity"><span aria-hidden="true">◷</span>Activity</a></nav><div class="sidebar-note"><span class="note-icon">✳</span><strong>Small footprint.<br>Big possibilities.</strong><p>Complete HTML, native charts, and a little JavaScript.</p><a href="/customers">Explore the dataset ↗</a></div><div class="account"><span class="user-avatar">JD</span><span>Jamie Davis<small>Demo account</small></span><span class="online-dot" title="Demo workspace"></span></div></aside><div class="app-shell"><header class="topbar"><div class="breadcrumb">Workspace <span>/</span> <strong>{{ title }}</strong></div><div class="topbar-right"><span class="demo-pill"><i></i>Demo data</span><span class="speed" data-performance><output>Server-rendered HTML</output></span><span class="topbar-avatar" aria-label="Demo account JD">JD</span></div></header><main id="web-page" tabindex="-1">{{ content }}</main><footer class="app-footer"><span>Meridian · Built with NeoKit</span><span>Synthetic data. Real server rendering.</span></footer></div>{% if client %}<script type="module" src="@asset(client.js)"></script>{% endif %}</body></html>
