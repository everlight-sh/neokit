import "../../src/lib.neo"
import "../../src/auth.neo"
import "../../src/oauth.neo"
import "pkg:document-store"
import "std:vec"

fn task_text(value:Json,key:Arr u8 n) -> Arr u8 _ = json_text(json_get(value,key).value).value
fn task_bool(value:Json,key:Arr u8 n) -> bool = json_bool(json_get(value,key).value).value
fn dashboard_error(code:i64,message:Arr u8 n) -> JsonResult = JsonResult {ok=false,value=json_none().value,error=Error {code=code,message=message,position=0}}
effect(env) fn dashboard_secret() -> Arr u8 _ = env_get("NEOKIT_SESSION_SECRET").value
effect(env) fn dashboard_origin() -> Arr u8 _ = env_get("NEOKIT_ORIGIN").value
effect(env) fn dashboard_database() -> DocumentStore
  = let directory=env_get("NEOKIT_DATA_DIR").value in document_store(if len(directory)>0 then concat(directory,"/tasks.json") else "")
fn dashboard_initial(value:Json) -> JsonResult
  = if value.kind==1 then json_parse("{\"schema\":1,\"tasks\":[]}") else
    if json_int(json_get(value,"schema").value).value!=1 || json_get(value,"tasks").value.kind!=5 then dashboard_error(22,"Unsupported database schema") else JsonResult {ok=true,value=value,error=no_error()}
type DashboardChange = {operation:Arr u8 _,id:Arr u8 _,owner:Arr u8 _,title:Arr u8 _}
fn dashboard_change(change:DashboardChange,previous:Json) -> JsonResult
  = let initial=dashboard_initial(previous) in if !initial.ok then initial else
    let tasks=json_array_values(json_get(initial.value,"tasks").value) in
    if len(tasks)>=10000 && str_equal(change.operation,"add") then dashboard_error(27,"Task limit reached") else
    let matched=loop(i=0,found=false,owned=false) while i<len(tasks) next(i+1,
      check i>=0 && i<len(tasks) in found || str_equal(task_text(tasks[i],"id"),change.id),
      check i>=0 && i<len(tasks) in owned || str_equal(task_text(tasks[i],"id"),change.id) && str_equal(task_text(tasks[i],"owner"),change.owner)) yield owned in
    if !str_equal(change.operation,"add") && !matched then dashboard_error(2,"Task not found") else
    let updated=loop(i=0,builder=json_array_builder()) while i<len(tasks) next(i+1,
      check i>=0 && i<len(tasks) in let task=tasks[i] in let mine=str_equal(task_text(task,"id"),change.id) && str_equal(task_text(task,"owner"),change.owner) in
      if mine && str_equal(change.operation,"delete") then builder else
        if mine then json_array_builder_push(builder,json_parse(concat("{\"id\":",json_quote(change.id),",\"owner\":",json_quote(change.owner),",\"title\":",json_quote(if str_equal(change.operation,"toggle") then task_text(task,"title") else change.title),",\"done\":",if str_equal(change.operation,"toggle") && !task_bool(task,"done") then "true" else "false","}")).value)
        else json_array_builder_push(builder,task)) yield builder in
    let updated=if str_equal(change.operation,"add") then json_array_builder_push(updated,json_parse(concat("{\"id\":",json_quote(change.id),",\"owner\":",json_quote(change.owner),",\"title\":",json_quote(change.title),",\"done\":false}")).value) else updated in
    let array=json_array_builder_finish(updated) in if !array.ok then array else json_parse(concat("{\"schema\":1,\"tasks\":",json_encode(array.value),"}"))
fn dashboard_input(request:WebRequest,name:Arr u8 n) -> OptionBytes
  = if str_starts(web_request_header(request,"content-type"),"application/json") then
      let document=json_parse(request.body) in if !document.ok then none_bytes() else
      let field=json_get(document.value,name) in let value=json_text(field.value) in if field.present && value.ok then some_bytes(value.value) else none_bytes()
    else web_form(request,name)
effect fn dashboard_mutate(request:WebRequest,operation:Arr u8 n,id:Arr u8 m) -> WebResponse
  = let key=dashboard_secret() in let session=web_session_read(request,key) in
    if !session.authenticated || str_equal(session.subject,"anonymous") then web_reply(401,"Unauthorized","text/plain") else
    if !web_csrf(request,session,dashboard_origin()) then web_reply(403,"CSRF validation failed","text/plain") else
    let title=web_required(dashboard_input(request,"title"),1,200) in
    if (str_equal(operation,"add") || str_equal(operation,"update")) && !title.ok then web_status(web_json("{\"error\":\"Title must contain 1..200 bytes\"}"),422) else
    let change=DashboardChange {operation=operation,id=id,owner=session.subject,title=title.value} in
    let stored=document_transaction(dashboard_database(),change,function(dashboard_change)) in
    if !stored.ok then web_status(web_json(concat("{\"error\":",json_quote(stored.error.message),"}")),if stored.error.code==2 then 404 else 503) else
      web_status(web_json(concat("{\"ok\":true,\"id\":",json_quote(id),"}")),if str_equal(operation,"add") then 201 else 200)
effect fn dashboard_api(request:WebRequest) -> WebResponse
  = let entropy=random_bytes(18) in if !entropy.ok then web_reply(503,"Randomness unavailable","text/plain") else
    let operation=if str_equal(request.method,"POST") then "add" else if str_equal(request.method,"DELETE") then "delete" else "update" in
    dashboard_mutate(request,operation,if str_equal(operation,"add") then base64url_encode(entropy.value) else web_param(request,"id").value)
effect fn dashboard_action(request:WebRequest) -> WebResponse
  = let operation=web_form(request,"operation").value in
    if !str_equal(operation,"add") && !str_equal(operation,"delete") && !str_equal(operation,"toggle") && !str_equal(operation,"update") then web_reply(400,"Unknown action","text/plain") else
    let entropy=random_bytes(18) in if !entropy.ok then web_reply(503,"Randomness unavailable","text/plain") else
    let response=dashboard_mutate(request,operation,if str_equal(operation,"add") then base64url_encode(entropy.value) else web_form(request,"id").value) in
    if response.status>=400 then response else web_redirect("/dashboard",303)
fn dashboard_row(task:Json,csrf:Arr u8 n) -> WebHtml
  = let id=html_escape(task_text(task,"id")) in let title=html_escape(task_text(task,"title")) in let csrf=html_escape(csrf) in
    web_html(concat("<li data-task-id=\"",id,"\"><span>",title,"</span><span>",if task_bool(task,"done") then "Done" else "Open","</span>",
      "<form method=\"post\" action=\"/actions/tasks\" data-web-form><input type=\"hidden\" name=\"_csrf\" value=\"",csrf,"\"><input type=\"hidden\" name=\"id\" value=\"",id,"\"><button name=\"operation\" value=\"toggle\">Toggle</button><button name=\"operation\" value=\"delete\">Delete</button></form></li>"))
type DashboardProps={title:Arr u8 _,subject:Arr u8 _,csrf:Arr u8 _,rows:Arr WebHtml _,failed:bool}
effect fn dashboard_load(request:WebRequest) -> DashboardProps
  = let session=web_session_read(request,dashboard_secret()) in let stored=document_read(dashboard_database()) in
    let state=if !stored.ok && stored.error.code==2 then json_parse("{\"schema\":1,\"tasks\":[]}") else stored in
    let tasks=json_array_values(json_get(state.value,"tasks").value) in
    let rows=loop(i=0,rows=vec_empty::<WebHtml>()) while i<len(tasks) next(i+1,
      check i>=0 && i<len(tasks) in if str_equal(task_text(tasks[i],"owner"),session.subject) then vec_push(rows,dashboard_row(tasks[i],session.csrf)) else rows) yield rows in
    let count=vec_len(rows) in check count>=0 in
    DashboardProps {title="Your tasks",subject=session.subject,csrf=session.csrf,failed= !state.ok,
      rows=arr(i in 0..count) match vec_get(rows,i) {None=>web_html(""),Some(row)=>row}}
fn dashboard_login_form(csrf:Arr u8 n,message:Arr u8 m,social:bool) -> WebResponse
  = web_reply(200,concat("<!doctype html><html><head><title>Sign in · NeoKit Tasks</title><link rel=\"stylesheet\" href=\"/site.css\"></head><body><main><h1>Sign in</h1><p>",html_escape(message),"</p>",if social then "<p><a href=\"/oauth\">Sign in with your identity provider</a></p>" else "","<form method=\"post\" action=\"/login\"><input type=\"hidden\" name=\"_csrf\" value=\"",html_escape(csrf),"\"><label>Username<input name=\"username\" autocomplete=\"username\" required></label><label>Password<input type=\"password\" name=\"password\" autocomplete=\"current-password\" required></label><button>Sign in</button></form></main></body></html>"),"text/html; charset=utf-8")
effect fn dashboard_login(request:WebRequest) -> WebResponse
  = let key=dashboard_secret() in let origin=dashboard_origin() in let social=len(env_get("NEOKIT_OAUTH_CLIENT_ID").value)>0 in
    if len(key)<32 || len(origin)==0 || len(env_get("NEOKIT_ADMIN_PASSWORD_HASH").value)==0 then web_reply(503,"Configure session secret, origin and admin password hash","text/plain") else
    if str_equal(request.method,"GET") || str_equal(request.method,"HEAD") then
      let current=web_session_read(request,key) in if current.authenticated && !str_equal(current.subject,"anonymous") then web_redirect("/dashboard",303) else
      let token=web_session_create("anonymous",key,request.stamp,600000) in if !token.ok then web_reply(503,"Session unavailable","text/plain") else
      let session=web_session_verify(token.value,key,request.stamp) in
      web_session_cookie(dashboard_login_form(session.csrf,"Use your configured account.",social),token.value,600,str_starts(origin,"https://")) else
    let session=web_session_read(request,key) in if !web_csrf(request,session,origin) then web_reply(403,"CSRF validation failed","text/plain") else
    let allowed=web_rate_limit(concat(env_get("NEOKIT_DATA_DIR").value,"/login-rate"),request.stamp,20,60000) in if !allowed then web_reply(429,"Try again later","text/plain") else
    let username=web_form(request,"username").value in let configured=env_get("NEOKIT_ADMIN_USER") in let password=web_form(request,"password").value in
    if !crypto_equal(username,if configured.present then configured.value else "admin") || !web_password_verify(password,env_get("NEOKIT_ADMIN_PASSWORD_HASH").value) then web_status(dashboard_login_form(session.csrf,"Invalid credentials.",social),401) else
    let token=web_session_create(username,key,request.stamp,3600000) in if !token.ok then web_reply(503,"Session unavailable","text/plain") else
      web_session_cookie(web_redirect("/dashboard",303),token.value,3600,str_starts(origin,"https://"))
effect fn dashboard_logout(request:WebRequest) -> WebResponse
  = let session=web_session_read(request,dashboard_secret()) in
    if !web_csrf(request,session,dashboard_origin()) then web_reply(403,"CSRF validation failed","text/plain") else
      web_session_cookie(web_redirect("/login",303),"",0,str_starts(dashboard_origin(),"https://"))

effect fn dashboard_provider()->OAuthProvider
  = let configured=env_get("NEOKIT_OAUTH_SCOPE") in let provider=oauth_provider(env_get("NEOKIT_OAUTH_AUTHORIZE_URL").value,env_get("NEOKIT_OAUTH_TOKEN_URL").value,env_get("NEOKIT_OAUTH_USERINFO_URL").value,env_get("NEOKIT_OAUTH_CLIENT_ID").value,concat(dashboard_origin(),"/oauth/callback"),if configured.present then configured.value else "openid profile") in
    let claim=env_get("NEOKIT_OAUTH_SUBJECT_CLAIM") in let provider=if claim.present then oauth_subject_claim(provider,claim.value) else provider in
    let issuer=env_get("NEOKIT_OIDC_ISSUER") in let jwks=env_get("NEOKIT_OIDC_JWKS_URL") in
    if issuer.present || jwks.present then oauth_oidc(provider,issuer.value,jwks.value) else provider
effect fn dashboard_oauth(request:WebRequest)->WebResponse = neokit_oauth_start(dashboard_provider(),dashboard_secret(),request.stamp)
effect fn dashboard_oauth_callback(request:WebRequest)->WebResponse
  = let provider=dashboard_provider() in let identity=neokit_oauth_finish(request,provider,dashboard_secret(),env_get("NEOKIT_OAUTH_CLIENT_SECRET").value) in
    if !identity.ok then neokit_oauth_clear(web_reply(401,"Identity provider sign-in failed","text/plain"),provider) else
    let subject=concat("oauth:",base64url_encode(sha256(concat(identity.issuer,":",identity.subject)))) in
    let token=web_session_create(subject,dashboard_secret(),request.stamp,3600000) in
    if !token.ok then neokit_oauth_clear(web_reply(503,"Session unavailable","text/plain"),provider) else
      neokit_oauth_clear(web_session_cookie(web_redirect("/dashboard",303),token.value,3600,str_starts(dashboard_origin(),"https://")),provider)
