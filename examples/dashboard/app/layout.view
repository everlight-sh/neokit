@props(title:text,content:html,client:bool,mode:text)
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{ title }} · NeoKit Tasks</title><link rel="stylesheet" href="/site.css"></head><body><main id="web-page" tabindex="-1">{{ content }}</main>{% if client %}<script type="module" src="@asset(client.js)"></script>{% endif %}</body></html>
