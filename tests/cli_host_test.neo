; Unit tests for cli/host.neo. The expected values at the end of this file were
; recorded from the Python reference (last present at commit 4757083) and now fixed.
;
; The test_ functions are pure and run under `neo test`. The fs_test_
; functions need files and processes, which `neo test --unit-only` cannot
; run inside its `check`s: tests/cli_golden/host/effects.neo runs them as the
; "host effectful unit cases" entry of tests/cli_golden/host/host.neo.toml.
; Their scratch trees go under build/ in the project and are removed
; afterwards.
import "std:json"
import "std:result"
import "std:io"
import "std:fs"
import "std:process"
import "../cli/host.neo"

fn same(actual:Arr u8 _, expected:Arr u8 _) -> bool = text_equal(actual,expected)
fn shown(borrow result:Result<Arr u8 _,Arr u8 _>) -> Arr u8 _ = match result { Ok(value) => value, Err(message) => concat("error: ",message) }
fn flag(value:bool) -> Arr u8 _ = if value then "True" else "False"
fn number(borrow text:Arr u8 _) -> i64 = let parsed=int_parse(text) in if parsed.ok then parsed.value else 0
; A list field of a case: items separated by \x1d.
fn list_of(borrow text:Arr u8 _) -> Arr Arr u8 _ _ = if len(text)==0 then text_words() else text_split(text,"\x1d")
fn listed(borrow words:Arr Arr u8 _ _) -> Arr u8 _ = text_join(words,"\x1d")
fn words2(borrow a:Arr u8 _, borrow b:Arr u8 _) -> Arr Arr u8 _ _ = push(push(text_words(),a),b)
fn words3(borrow a:Arr u8 _, borrow b:Arr u8 _, borrow c:Arr u8 _) -> Arr Arr u8 _ _ = push(words2(a,b),c)

; ---- the generated pure cases ----

; What the host function behind op gives for the arguments, printed in the
; form of the recorded answers.
fn apply(borrow op:Arr u8 _, borrow a:Arr u8 _, borrow b:Arr u8 _, borrow c:Arr u8 _) -> Arr u8 _
  = if text_equal(op,"normalize") then host_normalize(a)
    else if text_equal(op,"join") then host_join(a,b)
    else if text_equal(op,"parts") then text_repr_tuple(host_parts(a))
    else if text_equal(op,"parent") then host_parent(a)
    else if text_equal(op,"parents") then text_repr_list(host_parents(a))
    else if text_equal(op,"name") then host_name(a)
    else if text_equal(op,"stem") then host_stem(a)
    else if text_equal(op,"suffix") then host_suffix(a)
    else if text_equal(op,"is_absolute") then flag(host_is_absolute(a))
    else if text_equal(op,"with_name") then shown(host_with_name(a,b))
    else if text_equal(op,"equal") then flag(host_path_equal(a,b))
    else if text_equal(op,"is_relative_to") then flag(host_is_relative_to(a,b))
    else if text_equal(op,"relative_to") then shown(host_relative_to(a,b))
    else if text_equal(op,"normpath") then host_normpath(a)
    else if text_equal(op,"abspath") then host_abspath_at(a,b)
    else if text_equal(op,"relpath") then shown(host_relpath_at(a,b,c))
    else if text_equal(op,"expanduser") then shown(host_expanduser_with(a,b))
    else if text_equal(op,"less") then flag(host_path_less(a,b))
    else if text_equal(op,"sorted") then listed(host_sort_paths(list_of(a)))
    else if text_equal(op,"fnmatch") then flag(host_glob_match(a,b))
    else if text_equal(op,"utf8") then host_utf8_error(a)
    else if text_equal(op,"strerror") then host_strerror(number(a))
    else if text_equal(op,"os_error") then host_os_error(number(a),b)
    else if text_equal(op,"os_error2") then host_os_error2(number(a),b,c)
    else if text_equal(op,"signal") then host_signal_repr(number(a))
    else if text_equal(op,"process_error") then
      host_process_error(list_of(a),HostRun { ok=true, code=number(b), signal=number(c), output="", errors="", error="" })
    else concat("unknown op ",op)
; The mismatching cases of op ("" for every op), one line each; "" when
; they all agree with the recorded answers.
fn mismatches(borrow op:Arr u8 _) -> Arr u8 _
  = let cases=text_split(host_cases(),"\x1e") in
    loop (out=text_empty(), i=0) while i<len(cases)
      next (let r=text_split(text_word(cases,i),"\x1f") in
            if len(op)>0 && !text_equal(text_word(r,0),op) then out else
            let got=apply(text_word(r,0),text_word(r,1),text_word(r,2),text_word(r,3)) in
            if text_equal(got,text_word(r,4)) then out
            else concat(out,"FAIL ",text_word(r,0),"(",text_repr(text_word(r,1)),", ",text_repr(text_word(r,2)),", ",text_repr(text_word(r,3)),
              "): ",text_repr(got)," != ",text_repr(text_word(r,4)),"\n"), i+1) yield out
fn case_count(borrow op:Arr u8 _) -> i64
  = let cases=text_split(host_cases(),"\x1e") in
    loop (count=0, i=0) while i<len(cases) next (if text_starts(text_word(cases,i),concat(op,"\x1f")) then count+1 else count, i+1) yield count
fn agrees(borrow op:Arr u8 _) -> bool = case_count(op)>0 && len(mismatches(op))==0

fn test_normalize_and_join() -> bool = agrees("normalize") && agrees("join") && agrees("equal")
fn test_parts_parent_and_parents() -> bool = agrees("parts") && agrees("parent") && agrees("parents") && agrees("is_absolute")
fn test_name_stem_suffix() -> bool = agrees("name") && agrees("stem") && agrees("suffix") && agrees("with_name")
fn test_relative_to_is_component_wise() -> bool = agrees("is_relative_to") && agrees("relative_to")
fn test_normpath_abspath_relpath() -> bool = agrees("normpath") && agrees("abspath") && agrees("relpath")
fn test_expanduser() -> bool = agrees("expanduser")
fn test_path_order_is_component_order() -> bool
  = agrees("less") && agrees("sorted")
    && same(listed(host_sort_paths(words3("a-b/x","a/x","a.b"))),"a/x\x1da-b/x\x1da.b")
    && same(listed(text_sort(words3("a-b/x","a/x","a.b"))),"a-b/x\x1da.b\x1da/x")
fn test_glob_patterns_match_fnmatch() -> bool = agrees("fnmatch")
fn test_utf8_errors_match_the_decoder() -> bool = agrees("utf8")
fn test_os_error_texts() -> bool = agrees("strerror") && agrees("os_error") && agrees("os_error2")
fn test_process_error_texts() -> bool = agrees("signal") && agrees("process_error")

; ---- pure helpers without recorded cases ----

fn test_sha256_hex() -> bool
  = same(host_sha256_hex(""),"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    && same(host_sha256_hex("abc"),"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    && same(host_hex("\x00\x0f\xff"),"000fff") && same(host_hex(""),"")

fn env() -> Arr Arr u8 _ _ = push(words3("PATH=/bin","HOME=/root","A=1"),"PATH=/second")
fn test_environment_lists_behave_like_a_dict() -> bool
  = same(host_env_get(env(),"PATH").value,"/bin") && host_env_get(env(),"HOME").present && !host_env_get(env(),"HOM").present
    && same(host_env_get(env(),"A").value,"1") && !host_env_get(env(),"B").present
    && same(listed(host_env_set(env(),"PATH","/x")),"PATH=/x\x1dHOME=/root\x1dA=1")
    && same(listed(host_env_set(env(),"NEO_HOME","/n")),"PATH=/bin\x1dHOME=/root\x1dA=1\x1dPATH=/second\x1dNEO_HOME=/n")
    && same(listed(host_env_setdefault(env(),"A","2")),listed(env()))
    && same(listed(host_env_setdefault(env(),"NEO_INLINE_BUDGET","100")),concat(listed(env()),"\x1dNEO_INLINE_BUDGET=100"))
    && same(listed(host_env_remove(env(),"PATH")),"HOME=/root\x1dA=1") && same(listed(host_env_remove(env(),"NEOC")),listed(env()))
    && same(host_env_get(push(text_words(),"EMPTY="),"EMPTY").value,"") && host_env_get(push(text_words(),"EMPTY="),"EMPTY").present

; ---- effectful cases (run by tests/cli_golden/host/effects.neo) ----

effect fn scratch(borrow name:Arr u8 _) -> Arr u8 _
  = let project=env_get("NEO_TEST_PROJECT") in let cwd=fs_cwd() in
    let root=if project.present && len(project.value)>0 then project.value else cwd.value in
    concat(root,"/build/cli-host-test-",name,"-",text_int(process_id()))
; Builds the generated fixture under root: lines "d PATH", "f PATH MODE
; CONTENT" and "l PATH TARGET", fields separated by \x1f.
effect fn build_tree(borrow root:Arr u8 _, borrow spec:Arr u8 _) -> bool
  = let lines=text_split(spec,"\x1e") in
    loop (ok=true, i=0) while i<len(lines)
      next (let f=text_split(text_word(lines,i),"\x1f") in let kind=text_word(f,0) in let path=host_join(root,text_word(f,1)) in
            let parent=host_mkdirs(host_parent(path)) in
            let made=if text_equal(kind,"d") then host_mkdirs(path)
              else if text_equal(kind,"l") then host_symlink(text_word(f,2),path)
              else host_write_mode(path,text_word(f,3),number(text_word(f,2))) in
            ok && result_is_ok(made), i+1) yield ok
; A path below root as the recorded answers give it: relative, "." for root.
fn rel(borrow root:Arr u8 _, borrow path:Arr u8 _) -> Arr u8 _
  = if text_equal(path,root) then "." else if text_starts(path,concat(root,"/")) then text_from(path,len(root)+1) else concat("?",path)
fn rels(borrow root:Arr u8 _, borrow paths:Arr Arr u8 _ _) -> Arr u8 _
  = text_join(arr(i in 0..len(paths)) rel(root,text_word(paths,i)),",")
fn walk_text(borrow root:Arr u8 _, borrow walked:Arr HostWalk _) -> Arr u8 _
  = loop (out=text_empty(), i:i64{i>=0}=0) while i<len(walked)
      next (concat(out,rel(root,walked[i].path),"|",text_join(walked[i].folders,","),"|",text_join(walked[i].names,","),"\n"), i+1) yield out
effect fn report(borrow label:Arr u8 _, borrow got:Arr u8 _, borrow expected:Arr u8 _) -> bool
  = text_equal(got,expected) || (let shown=print_error(concat("host ",label,":\n  got      ",text_repr(got),"\n  expected ",text_repr(expected),"\n")) in false)

effect fn fs_test_walk_glob_and_listdir() -> bool
  = let root=scratch("tree") in
    let built=build_tree(root,fixture_spec()) in
    let cache=report("walk cache_identity",walk_text(root,host_walk(root,list_of(walk_skip_cache()),false)),expected_walk_cache()) in
    let release=report("walk copy_sources",walk_text(root,host_walk(root,list_of(walk_skip_release()),true)),expected_walk_release()) in
    let watched=report("walk fingerprint",walk_text(root,host_walk_skipping(root,HostWalkSkip { names=list_of(walk_skip_cache()), hidden=false,
      paths=push(text_words(),host_join(root,"a/sub")) })),expected_walk_fingerprint()) in
    let names=report("listdir",match host_listdir(root) { Ok(found) => text_join(found,","), Err(message) => message },expected_listdir()) in
    let css=report("glob *.css",rels(root,host_glob(host_join(root,"styles"),"*.css")),expected_glob_css()) in
    let bins=report("glob */bin",rels(root,host_glob(root,"*/bin")),expected_glob_bin()) in
    let pages=report("rglob page.toml",rels(root,host_rglob(root,"page.toml")),expected_rglob_pages()) in
    let all=report("rglob *",rels(root,host_rglob(root,"*")),expected_rglob_all()) in
    let missing=report("glob missing",rels(root,host_glob(host_join(root,"nowhere"),"*")),"") in
    let cleaned=result_is_ok(host_remove_tree(root)) in
    built && cache && release && watched && names && css && bins && pages && all && missing && cleaned && !host_lexists(root)

effect fn resolved(borrow real:Arr u8 _, borrow root:Arr u8 _, borrow query:Arr u8 _) -> Arr u8 _
  = match host_resolve(host_join(root,query)) {
      Ok(path) => rel(real,path),
      Err(message) => concat("error: ",text_replace(message,real,"<root>")) }
effect fn fs_test_resolve_follows_symlinks() -> bool
  = let root=scratch("resolve") in
    let built=build_tree(root,fixture_spec()) in
    let real=match host_resolve(root) { Ok(path) => path, Err(message) => message } in
    let queries=list_of(resolve_queries()) in
    let got=loop (out=text_empty(), i=0) while i<len(queries) next (concat(out,text_word(queries,i)," -> ",resolved(real,root,text_word(queries,i)),"\n"), i+1) yield out in
    let ok=report("resolve",got,expected_resolve()) in
    let cwd=fs_cwd() in
    let relative=report("resolve relative",shown(host_resolve("tests/../cli")),concat(cwd.value,"/cli"))
      && report("resolve empty",shown(host_resolve("")),cwd.value)
      && report("abspath",shown(host_abspath("x/../y")),concat(cwd.value,"/y"))
      && report("relpath",shown(host_relpath(concat(cwd.value,"/a/b"),"a")),"b") in
    let cleaned=result_is_ok(host_remove_tree(root)) in
    built && ok && relative && cleaned

effect fn fs_test_read_text_and_errors() -> bool
  = let root=scratch("files") in
    let made=host_mkdirs(root) in
    let crlf=host_join(root,"crlf.txt") in let bad=host_join(root,"bad.txt") in let missing=host_join(root,"missing.txt") in
    let w1=host_write_bytes(crlf,"one\r\ntwo\rthree\n\r\n") in let w2=host_write_bytes(bad,"ok\nabc\xff") in
    let text=report("read_text crlf",shown(host_read_text(crlf)),"one\ntwo\nthree\n\n")
      && report("read_bytes crlf",shown(host_read_bytes(crlf)),"one\r\ntwo\rthree\n\r\n")
      && report("read_text invalid",shown(host_read_text(bad)),expected_read_bad())
      && report("read missing",shown(host_read_text(missing)),concat("error: [Errno 2] No such file or directory: ",text_repr(missing)))
      && report("read directory",shown(host_read_bytes(root)),concat("error: [Errno 21] Is a directory: ",text_repr(root)))
      && report("read under a file",shown(host_read_bytes(concat(crlf,"/x"))),concat("error: [Errno 20] Not a directory: ",text_repr(concat(crlf,"/x")))) in
    let errors=report("mkdir exists",shown(match host_mkdir(root,false,false) { Ok(n) => Ok::<Arr u8 _,Arr u8 _>("made"), Err(m) => Err::<Arr u8 _,Arr u8 _>(m) }),
        concat("error: [Errno 17] File exists: ",text_repr(root)))
      && result_is_ok(host_mkdir(root,false,true)) && result_is_ok(host_mkdirs(host_join(root,"p/q/r"))) && host_is_dir(host_join(root,"p/q/r"))
      && report("mkdir no parent",shown(match host_mkdir(host_join(root,"m/n"),false,true) { Ok(n) => Ok::<Arr u8 _,Arr u8 _>("made"), Err(m) => Err::<Arr u8 _,Arr u8 _>(m) }),
        concat("error: [Errno 2] No such file or directory: ",text_repr(host_join(root,"m/n"))))
      && report("rmdir non-empty",shown(match host_rmdir(host_join(root,"p")) { Ok(n) => Ok::<Arr u8 _,Arr u8 _>("gone"), Err(m) => Err::<Arr u8 _,Arr u8 _>(m) }),
        concat("error: [Errno ",if text_equal(os_name(),"macos") then "66" else "39","] Directory not empty: ",text_repr(host_join(root,"p"))))
      && report("listdir file",shown(match host_listdir(crlf) { Ok(n) => Ok::<Arr u8 _,Arr u8 _>("listed"), Err(m) => Err::<Arr u8 _,Arr u8 _>(m) }),
        concat("error: [Errno 20] Not a directory: ",text_repr(crlf)))
      && report("rename missing",shown(match host_rename(missing,bad) { Ok(n) => Ok::<Arr u8 _,Arr u8 _>("moved"), Err(m) => Err::<Arr u8 _,Arr u8 _>(m) }),
        concat("error: [Errno 2] No such file or directory: ",text_repr(missing)," -> ",text_repr(bad)))
      && report("rmtree file",shown(match host_remove_tree(crlf) { Ok(n) => Ok::<Arr u8 _,Arr u8 _>("gone"), Err(m) => Err::<Arr u8 _,Arr u8 _>(m) }),
        concat("error: [Errno 20] Not a directory: ",text_repr(crlf)))
      && report("rmtree missing",shown(match host_remove_tree(missing) { Ok(n) => Ok::<Arr u8 _,Arr u8 _>("gone"), Err(m) => Err::<Arr u8 _,Arr u8 _>(m) }),
        concat("error: [Errno 2] No such file or directory: ",text_repr(missing)))
      && result_is_ok(host_remove_file(missing,true)) && !result_is_ok(host_remove_file(missing,false)) in
    let cleaned=result_is_ok(host_remove_tree(root)) in
    result_is_ok(made) && result_is_ok(w1) && result_is_ok(w2) && text && errors && cleaned

; The process's umask, from the shell.
effect fn umask() -> i64
  = let run=host_run(words3("/bin/sh","-c","umask")) in
    loop (value=0, i=0) while i<len(run.output) next (let d=text_byte(run.output,i) in if d>=48 && d<=55 then value*8+d-48 else value, i+1) yield value
fn octal(value:i64) -> Arr u8 _
  = if value<8 then text_int(value) else concat(octal(value/8),text_int(value%8))
fn listing_line(borrow rel_path:Arr u8 _, borrow kind:Arr u8 _, mode:i64, size:i64) -> Arr u8 _
  = concat(rel_path," ",kind,if text_equal(kind,"file") then concat(" ",octal(mode)," ",text_int(size)) else "","\n")
; The tree below root as the recorded copytree listing gives it: each path,
; its kind, and for a file its octal mode and size.
effect fn listing(borrow root:Arr u8 _) -> Arr u8 _
  = let paths=host_rglob(root,"*") in
    loop (out=text_empty(), i=0) while i<len(paths)
      next (let path=text_word(paths,i) in
            let kind=if host_is_symlink(path) then "link" else if host_is_dir(path) then "dir" else "file" in
            concat(out,listing_line(rel(root,path),kind,match host_mode(path) { Ok(m) => m, Err(e) => -1 },match host_size(path) { Ok(s) => s, Err(e) => -1 })), i+1) yield out
effect fn fs_test_writes_copies_and_removal() -> bool
  = let root=scratch("copy") in
    let built=build_tree(root,fixture_spec()) in
    let mask=umask() in
    let fresh=host_join(root,"fresh.txt") in
    let w=host_write_bytes(fresh,"new") in
    let created=report("new file mode",text_int(match host_mode(fresh) { Ok(m) => m, Err(e) => -1 }),text_int(bit_and(438,4095-mask))) in
    let launcher=host_join(root,"launcher") in
    let l=host_write_mode(launcher,"#!/bin/sh\nexit 0\n",493) in
    let exec=host_is_executable(launcher) && !host_is_executable(fresh) && !host_is_executable(host_join(root,"nowhere"))
      && report("launcher mode",text_int(match host_mode(launcher) { Ok(m) => m, Err(e) => -1 }),text_int(bit_and(493,4095-mask))) in
    let kept=host_write_mode(fresh,"x",448) in let rewritten=host_write_text(fresh,"rewritten") in
    let keeps=report("rewrite keeps mode",text_int(match host_mode(fresh) { Ok(m) => m, Err(e) => -1 }),text_int(bit_and(448,4095-mask)))
      && report("rewrite content",shown(host_read_text(fresh)),"rewritten")
      && report("size",text_int(match host_size(fresh) { Ok(s) => s, Err(e) => -1 }),"9")
      && (match host_mtime_ns(fresh) { Ok(t) => t>1000000000000000000, Err(e) => false }) in
    let copied=host_copy_tree(host_join(root,"copyme"),host_join(root,"copied"),words2("skip*","__pycache__"),false) in
    let tree=report("copytree",listing(host_join(root,"copied")),expected_copytree()) in
    let again=report("copytree exists",shown(match host_copy_tree(host_join(root,"copyme"),host_join(root,"copied"),text_words(),false) {
        Ok(n) => Ok::<Arr u8 _,Arr u8 _>("copied"), Err(m) => Err::<Arr u8 _,Arr u8 _>(m) }),
      concat("error: [Errno 17] File exists: ",text_repr(host_join(root,"copied"))))
      && result_is_ok(host_copy_tree(host_join(root,"copyme"),host_join(root,"copied"),text_words(),true)) in
    let into=host_copy_file(host_join(root,"copyme/run.sh"),host_join(root,"copied")) in
    let file=report("copy into a directory",shown(into),host_join(root,"copied/run.sh"))
      && report("copy keeps mode",text_int(match host_mode(host_join(root,"copied/run.sh")) { Ok(m) => m, Err(e) => -1 }),text_int(bit_and(493,4095-mask))) in
    let moved=host_rename(fresh,host_join(root,"moved.txt")) in
    let renamed=result_is_ok(moved) && !host_exists(fresh) && host_is_file(host_join(root,"moved.txt")) in
    let kinds=host_is_symlink(host_join(root,"linkdir")) && host_is_dir(host_join(root,"linkdir")) && !host_is_file(host_join(root,"linkdir"))
      && host_is_file(host_join(root,"linkfile")) && !host_exists(host_join(root,"dangling")) && host_lexists(host_join(root,"dangling"))
      && host_is_symlink(host_join(root,"dangling")) && !host_is_symlink(host_join(root,"a")) in
    let link=report("rmtree symlink",shown(match host_remove_tree(host_join(root,"linkdir")) { Ok(n) => Ok::<Arr u8 _,Arr u8 _>("gone"), Err(m) => Err::<Arr u8 _,Arr u8 _>(m) }),
      "error: Cannot call rmtree on a symbolic link") in
    let victim=result_is_ok(host_remove_tree(host_join(root,"victim"))) && !host_lexists(host_join(root,"victim")) && host_is_file(host_join(root,"keep/file")) in
    let cleaned=result_is_ok(host_remove_tree(root)) in
    built && result_is_ok(w) && created && result_is_ok(l) && exec && result_is_ok(kept) && result_is_ok(rewritten) && keeps
      && result_is_ok(copied) && tree && again && file && renamed && kinds && link && victim && cleaned

; Directory modes: host_mkdir and host_mkdirs give 0777 & ~umask to the
; directory and every parent they create; host_copy_tree gives each copy its
; source directory's bits, filtered by the umask (std:fs has no chmod).
effect fn mode_of(borrow path:Arr u8 _) -> Arr u8 _ = octal(match host_mode(path) { Ok(m) => m, Err(e) => -1 })
effect fn fs_test_directory_modes() -> bool
  = let root=scratch("modes") in let mask=umask() in
    let made=host_mkdirs(host_join(root,"a/b/c")) in
    let one=host_mkdir(host_join(root,"single"),false,false) in
    let wide=octal(bit_and(511,4095-mask)) in
    let mkdirs=report("makedirs leaf mode",mode_of(host_join(root,"a/b/c")),wide)
      && report("makedirs parent mode",mode_of(host_join(root,"a/b")),wide)
      && report("makedirs top mode",mode_of(root),wide)
      && report("mkdir mode",mode_of(host_join(root,"single")),wide) in
    let source=host_join(root,"src") in
    let s1=fs_mkdir_mode(source,488) in let s2=fs_mkdir_mode(host_join(source,"inner"),448) in
    let s3=fs_mkdir_mode(host_join(source,"open"),493) in
    let s4=host_write_bytes(host_join(source,"inner/f"),"f") in
    let copied=host_copy_tree(source,host_join(root,"dst/deep/copy"),text_words(),false) in
    let copies=result_is_ok(copied)
      && report("copytree created parent mode",mode_of(host_join(root,"dst/deep")),wide)
      && report("copytree top mode",mode_of(host_join(root,"dst/deep/copy")),octal(bit_and(488,4095-mask)))
      && report("copytree private mode",mode_of(host_join(root,"dst/deep/copy/inner")),octal(bit_and(448,4095-mask)))
      && report("copytree open mode",mode_of(host_join(root,"dst/deep/copy/open")),octal(bit_and(493,4095-mask))) in
    let cleaned=result_is_ok(host_remove_tree(root)) in
    result_is_ok(made) && result_is_ok(one) && mkdirs && s1.ok && s2.ok && s3.ok && result_is_ok(s4) && copies && cleaned

effect fn fs_test_mkdtemp_names_and_modes() -> bool
  = let root=scratch("temp") in let made=host_mkdirs(root) in
    let first=host_mkdtemp(".prepare-",root) in let second=host_mkdtemp(".prepare-",root) in
    let name=host_name(shown(first)) in
    let shaped=len(name)==17 && text_starts(name,".prepare-") && text_only(text_from(name,9),"a-z0-9_") in
    let ok=result_is_ok(first) && result_is_ok(second) && !text_equal(shown(first),shown(second)) && shaped
      && host_is_dir(shown(first)) && text_equal(host_parent(shown(first)),root)
      && report("mkdtemp mode",text_int(match host_mode(shown(first)) { Ok(m) => m, Err(e) => -1 }),text_int(bit_and(448,4095-umask()))) in
    let defaulted=host_mkdtemp("neokit-host-test-","") in
    let tmp=result_is_ok(defaulted) && host_is_dir(shown(defaulted)) && result_is_ok(host_remove_tree(shown(defaulted))) in
    let cleaned=result_is_ok(host_remove_tree(root)) in
    result_is_ok(made) && ok && text_starts(shown(host_mkdtemp("x",host_join(root,"none"))),"error: [Errno 2] No such file or directory: ") && tmp && cleaned

effect fn fs_test_processes_run_like_subprocess() -> bool
  = let root=scratch("run") in let made=host_mkdirs(root) in
    let script="pwd; cat; echo oops >&2; exit 3" in
    let run=host_run_with(words3("sh","-c",script),env_list(),root,"hello\nworld") in
    let captured=run.ok && run.code==3 && run.signal==0
      && report("run stdout",run.output,concat(root,"\nhello\nworld")) && report("run stderr",run.errors,"oops\n")
      && report("run error",host_process_error(words3("sh","-c",script),run),concat("Command '['sh', '-c', '",script,"']' returned non-zero exit status 3.")) in
    let big=text_repeat("0123456789abcdef",40000) in
    let piped=host_run_with(push(text_words(),"cat"),env_list(),"",big) in
    let large=piped.ok && piped.code==0 && len(piped.output)==len(big) && text_equal(piped.output,big) in
    let killed=host_run(words3("/bin/sh","-c","kill -9 $$")) in
    let signal=killed.ok && killed.code==137 && killed.signal==9
      && report("signal error",host_process_error(words3("/bin/sh","-c","kill -9 $$"),killed),"Command '['/bin/sh', '-c', 'kill -9 $$']' died with <Signals.SIGKILL: 9>.") in
    let script_path=host_join(root,"plain.txt") in let w=host_write_bytes(script_path,"echo hi\n") in
    let failures=report("missing program",host_run(push(text_words(),"neokit-no-such-program")).error,"[Errno 2] No such file or directory: 'neokit-no-such-program'")
      && report("not executable",host_run(push(text_words(),script_path)).error,concat("[Errno 13] Permission denied: ",text_repr(script_path)))
      && report("missing cwd",host_run_with(push(text_words(),"pwd"),env_list(),host_join(root,"none"),"").error,
        concat("[Errno 2] No such file or directory: ",text_repr(host_join(root,"none"))))
      && report("cwd is a file",host_run_with(push(text_words(),"pwd"),env_list(),script_path,"").error,
        concat("[Errno 20] Not a directory: ",text_repr(script_path)))
      && !host_run(push(text_words(),"neokit-no-such-program")).ok in
    let environment=host_run_with(words3("/bin/sh","-c","echo \"$NEOKIT_HOST_TEST\""),host_env_set(env_list(),"NEOKIT_HOST_TEST","set here"),"","") in
    let passed=report("environment",environment.output,"set here\n") in
    let inherited=host_run_inherit(words3("/bin/sh","-c","exit 5"),env_list(),root) in
    let status=inherited.ok && inherited.code==5 && len(inherited.output)==0 in
    let bin=host_join(root,"bin") in let other=host_join(root,"other") in
    let t1=host_mkdirs(bin) in let t2=host_mkdirs(other) in let t3=host_mkdirs(host_join(root,"bin/dir-tool")) in
    let t4=host_write_mode(host_join(other,"tool"),"#!/bin/sh\n",493) in let t5=host_write_mode(host_join(bin,"tool"),"#!/bin/sh\n",420) in
    let which=report("which",host_which_in("tool",concat(bin,":",other)),host_join(other,"tool"))
      && report("which dir",host_which_in("dir-tool",bin),"")
      && report("which none",host_which_in("tool",""),"")
      && report("which slash",host_which_in(host_join(other,"tool"),"/nowhere"),host_join(other,"tool"))
      && text_ends(host_which("sh"),"/sh") in
    let cleaned=result_is_ok(host_remove_tree(root)) in
    result_is_ok(made) && captured && large && signal && result_is_ok(w) && failures && passed && status && which && cleaned

effect fn fs_test_home_and_cache_directories() -> bool
  = let home=env_get("HOME") in let xdg=env_get("XDG_CACHE_HOME") in
    let found=host_home() in
    let homes=if home.present then report("home",shown(found),host_normalize(if len(text_rstrip_chars(home.value,"/"))==0 then "/" else text_rstrip_chars(home.value,"/")))
      else !result_is_ok(found) in
    let cache=if xdg.present then report("cache",shown(host_cache_home()),host_normalize(xdg.value))
      else if home.present then report("cache",shown(host_cache_home()),host_join(shown(found),".cache")) else true in
    let expanded=if home.present then report("expanduser",shown(host_expanduser("~/x//y")),host_join(shown(found),"x/y")) else true in
    homes && cache && expanded && report("expanduser plain",shown(host_expanduser("a//b")),"a/b")

