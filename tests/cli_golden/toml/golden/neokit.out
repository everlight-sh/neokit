=== tests/cli_golden/toml/cases/neokit.cases page.toml with every option
{
  "loader": "load",
  "mode": "static",
  "client": false,
  "export": true,
  "async": false,
  "async_timeout_ms": 2000,
  "cache_ttl": 60,
  "stale_ttl": 10,
  "cache_tag": "features",
  "cache_query": [
    "q",
    "page"
  ],
  "guard": "signed_in",
  "paths_fn": "all_posts",
  "paths": [
    "/blog/a",
    "/blog/b-c",
    "/blog/d_e.html"
  ]
}
