=== tests/cli_golden/toml/cases/neokit.cases full web.toml
{
  "site": {
    "name": "NeoKit starter",
    "url": "https://example.com/",
    "description": "Typed routes & native pages <fast>",
    "og_title": "Starter",
    "og_image": "https://example.com/og.png",
    "canonical": "https://example.com/"
  },
  "server": {
    "access_log": true,
    "timing": false,
    "shutdown_grace_ms": 250,
    "before": "guard",
    "after": "decorate",
    "startup": "boot",
    "migrate": "migrate"
  },
  "css": {
    "tailwind": [
      "site.css",
      "admin.css"
    ]
  },
  "security": {
    "csp": "default-src 'self'; script-src 'self'"
  },
  "realtime": {
    "channels": 16,
    "history": 128,
    "max_event_bytes": 4096
  },
  "images": {
    "files": [
      "hero.jpg",
      "photos/team.png"
    ],
    "widths": [
      320,
      640,
      1280
    ],
    "formats": [
      "webp",
      "jpeg"
    ]
  },
  "redirects": [
    {
      "from": "/old-pricing",
      "to": "/pricing",
      "status": 308,
      "query": true
    }
  ]
}
