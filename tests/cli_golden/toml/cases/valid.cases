  1, # one
  2,
  # a comment line

  3,
]
strings = ["a", 'b', """c""", '''d''']
trailing = [1,2,]
spaced = [ 1 , 2 ]
empty_lines = [

]
#--- inline tables
empty = {}
spaced_empty = {   }
point = { x = 1, y = 2 }
nested = { a = { b = { c = 1 } }, d = [1, 2] }
dotted = { a.b = 1, a.c = 2 }
quoted = { "k k" = 1, 'l' = 2 }
array_of_inline = [ { a = 1 }, { a = 2 } ]
#--- tables
[site]
name = "x"
[server]
timing = true
[a.b.c]
d = 1
[a]
e = 2
[a.b]
f = 3
[ "quoted" . 'key' ]
g = 4
[empty]
#--- dotted keys then tables
a.b.c = 1
a.d = 2
[x]
y.z = 3
y.w = 4
[x.v]
#--- implicit table made explicit later
[a.b]
c = 1
[a]
d = 2
#--- arrays of tables
[[redirects]]
from = "/old"
to = "/new"
[[redirects]]
from = "/a"
to = "https://example.com/b"
status = 301
query = false
[[fruit]]
name = "apple"
[fruit.physical]
color = "red"
[[fruit.variety]]
name = "red delicious"
[[fruit.variety]]
name = "granny smith"
[[fruit]]
name = "banana"
[[fruit.variety]]
name = "plantain"
#--- array of tables reopens dotted keys
[[a]]
b.c = 1
[[a]]
b.c = 2
[a.b.d]
#--- empty arrays of tables
[[a]]
[[a]]
[[b.c]]
#--- key order is source order
zebra = 1
apple = 2
middle = 3
[mango]
b = 1
a = 2
[banana]
#--- whitespace and comments everywhere
  key = "value"   # trailing comment
[ table ] # comment
	tabbed = 1
[[ list ]] # comment
x=1#tight
#--- non-ASCII text for ensure_ascii
"é" = "ü"
emoji = "😀🎉"
astral = "\U0001F600\U0010FFFF"
bmp = "\uFFFF\u2028\u2029\uE000"
controls = "\u0001\u0008\u000b\u001b"
quote_mix = "it's \"x\""
del = "\u007f"
latin = "\u0080\u009f\u00ad\u00ff"
cjk = { "日本" = "東京" }
#--- deep nesting
a = [[[[[[[[[[1]]]]]]]]]]
b = {c = {d = {e = {f = {g = 1}}}}}
[x.y.z.w.v.u]
t = true
