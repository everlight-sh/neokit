#--- empty document
#--- comments and blank lines only
# just a comment
   # indented comment	with a tab


#--- basic strings
plain = "hello"
escapes = "tab\there\nnewline \"quoted\" back\\slash \b\f\r"
unicode = "caf\u00e9 \u4e2d \U0001F600 \u0000 \u001f \u007f \u00A0"
raw = "café 中文 😀 ñ"
empty = ""
hash = "# not a comment"
