c = '''four''''
d = '''five'''''
e = '''
'''
#--- keys
bare_key-1 = 1
"quoted key" = 2
'literal key' = 3
"" = 4
"ключ" = 5
a.b.c = 6
a . d = 7
"x.y".z = 8
1234 = 9
-key = 10
"esc\u0041\t" = 11
#--- integers
dec = 42
pos = +17
neg = -5
zero = 0
plus_zero = +0
minus_zero = -0
under = 1_000_000
hex = 0xDEAD_beef
hex_lower = 0xff
oct = 0o755
bin = 0b1101_0110
max = 9223372036854775807
min = -9223372036854775808
hex_max = 0x7fffffffffffffff
#--- booleans
yes = true
no = false
#--- arrays
empty = []
ints = [1, 2, 3]
mixed = [1, "two", true, [3], {four = 4}]
nested = [[1, 2], [], [[3]]]
