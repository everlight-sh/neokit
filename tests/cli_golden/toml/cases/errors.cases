#--- table into an inline table
a = {b = 1}
[a.c]
#--- inline table declared again
a = {b = 1}
[a]
#--- array of tables into a static array
a = []
[[a]]
#--- table into a static array
a = [{b = 1}]
[a.c]
#--- array table under a static array
a = [1]
[[a.b]]
#--- dotted key array table reopened
[[a]]
b.c = 1
[a.b]
#--- inline table duplicate key
a = {b = 1, b = 2}
#--- inline table frozen member
a = {b = {c = 1}, b.d = 2}
#--- inline table frozen array member
a = {b = [1], b.c = 2}
#--- inline table overwrite through dotted key
a = {b = 1, b.c = 2}
#--- inline table duplicate after dotted keys
a = {b.c = 1, b = 2}
#--- inline table trailing comma
a = {b = 1,}
#--- inline table across lines
a = {b = 1,
c = 2}
#--- unclosed inline table
a = {b = 1
#--- inline table missing comma
a = {b = 1 c = 2}
#--- unclosed array
a = [1, 2
#--- array missing comma
a = [1 2]
#--- array with only a comma
a = [,]
