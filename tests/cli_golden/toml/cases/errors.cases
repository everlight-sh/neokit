["it's"]
["it's"]
#--- repr of a key with both quotes
["say \"it's\""]
["say \"it's\""]
#--- literal string key cannot escape
['it\'s']
#--- repr of a key with a backslash
['a\b']
['a\b']
#--- multi-line string as a key
"""a""" = 1
#--- invalid statement
!
#--- statement starting with a closing bracket
] = 1
