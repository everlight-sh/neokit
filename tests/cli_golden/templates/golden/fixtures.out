body "<h1>{{ title }}</h1>{% if query %}<p class=\"q\">Results for {{ query }}</p>{% else %}<p class=\"q\">No query</p>{% endif %}<ul>{% for post, index in posts %}<li data-rank=\"{{ index }}\"><a href=\"{{ post.href }}\">{{ post.title }}</a>{% if post.views >= 1000 %} popular{% elif post.views == 0 %} new{% else %} normal{% endif %}</li>{% endfor %}</ul>{% if query == \"neo\" %}<p>exact</p>{% endif %}"
