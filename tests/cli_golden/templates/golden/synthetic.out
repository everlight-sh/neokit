code
fn text_Card(p_title: Arr u8 _,p_content: WebHtml) -> Arr u8 _ = concat("<div>",html_escape(p_title),p_content.bytes,"</div>")
fn view_Card(p_title: Arr u8 _,p_content: WebHtml) -> WebHtml = web_html(text_Card(p_title,p_content))

fn text_Badge(p_label: Arr u8 _) -> Arr u8 _ = concat("<b>",html_escape(p_label),"</b>")
fn view_Badge(p_label: Arr u8 _) -> WebHtml = web_html(text_Badge(p_label))

fn text_Test() -> Arr u8 _ = ""
fn view_Test() -> WebHtml = web_html(text_Test())
end code
