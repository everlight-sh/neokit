fn text_Test_loop_0(p_value: Arr u8 _,p_link: WebURL,p_rich: WebHtml,p_flag: bool,p_count: i64,p_items: Arr Arr u8 _ _,p_people: Arr Person _,at:i64,count:i64) -> Arr u8 _ = if count<=0 then "" else if count==1 then check at>=0 && at<len(p_people) in let item_person=p_people[at] in concat("<a href=\"",html_escape(item_person.home.value),"\">",html_escape(item_person.name),"</a>") else let half=count/2 in concat(text_Test_loop_0(p_value,p_link,p_rich,p_flag,p_count,p_items,p_people,at,half),text_Test_loop_0(p_value,p_link,p_rich,p_flag,p_count,p_items,p_people,at+half,count-half))
