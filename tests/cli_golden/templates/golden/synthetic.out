fn view_Test(p_value: Arr u8 _,p_link: WebURL,p_rich: WebHtml,p_flag: bool,p_count: i64,p_items: Arr Arr u8 _ _,p_people: Arr Person _) -> WebHtml = web_html(text_Test(p_value,p_link,p_rich,p_flag,p_count,p_items,p_people))
