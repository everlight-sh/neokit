code
fn text_Page_8a5edab282(p_title: Arr u8 _) -> Arr u8 _ = concat("<h1>",html_escape(p_title),"</h1>")
fn view_Page_8a5edab282(p_title: Arr u8 _) -> WebHtml = web_html(text_Page_8a5edab282(p_title))

fn text_Layout(p_title: Arr u8 _,p_content: WebHtml,p_client: bool,p_mode: Arr u8 _) -> Arr u8 _ = concat("<!doctype html><html><head><title>",html_escape(p_title),"</title></head><body>",p_content.bytes,"</body></html>")
fn view_Layout(p_title: Arr u8 _,p_content: WebHtml,p_client: bool,p_mode: Arr u8 _) -> WebHtml = web_html(text_Layout(p_title,p_content,p_client,p_mode))
end code
