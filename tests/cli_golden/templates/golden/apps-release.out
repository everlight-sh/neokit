parse 0 Page_9adef84dae examples/saas/app/activity/page.view
props title:text events:html[]
body "<section class=\"page-heading\"><div><span class=\"eyebrow\">THE LITTLE THINGS ADD UP</span><h1>Activity</h1><p>A clear view of the moments moving your business forward.</p></div><a class=\"button secondary\" href=\"/customers\">Explore customers \xe2\x86\x97</a></section><section class=\"panel activity-panel\"><header class=\"panel-heading\"><div><h2>Recent activity</h2><p>Synthetic events from the demo workspace</p></div><span class=\"demo-pill\">18 events</span></header><div class=\"activity-list\">{% for event in events %}{{ event }}{% endfor %}</div></section>\n"
parse 1 Page_121a6110c5 examples/saas/app/customers/page.view
props title:text server:bool records:int total:text query:text all:bool growth:bool pro:bool enterprise:bool large:bool rows:html[] found:text page:int pages:int has_previous:bool has_next:bool previous:url next_url:url csv:url empty:bool range_label:text
body "<section class=\"page-heading\"><div><span class=\"eyebrow\">PEOPLE BEHIND THE NUMBERS</span><h1>Customers <span class=\"title-count\">{{ total }}</span></h1><p>Know your customers. Keep the good ones close.</p></div>{% if server %}<a class=\"button secondary\" href=\"{{ csv }}\" download>\xe2\x86\x93 Export filtered CSV</a>{% else %}<span class=\"button secondary\">Static snapshot</span>{% endif %}</section><section class=\"panel customer-directory\">{% if server %}<form class=\"customer-filter\" action=\"/customers\" method=\"get\" role=\"search\"><div class=\"search-field\"><span aria-hidden=\"true\">\xe2\x8c\x95</span><label class=\"sr-only\" for=\"customer-search\">Search companies</label><input id=\"customer-search\" name=\"q\" value=\"{{ query }}\" placeholder=\"Search companies\xe2\x80\xa6\" maxlength=\"80\"></div><label class=\"sr-only\" for=\"plan-filter\">Subscription plan</label><select id=\"plan-filter\" name=\"plan\">{% if all %}<option value=\"all\" selected>All plans</option>{% else %}<option value=\"all\">All plans</option>{% endif %}{% if growth %}<option value=\"Growth\" selected>Growth</option>{% else %}<option value=\"Growth\">Growth</option>{% endif %}{% if pro %}<option value=\"Pro\" selected>Pro</option>{% else %}<option value=\"Pro\">Pro</option>{% endif %}{% if enterprise %}<option value=\"Enterprise\" selected>Enterprise</option>{% else %}<option value=\"Enterprise\">Enterprise</option>{% endif %}</select><label class=\"sr-only\" for=\"directory-count\">Demo dataset</label><select id=\"directory-count\" name=\"records\">{% if large %}<option value=\"1000\">1,000 accounts</option><option value=\"10000\" selected>10,000 accounts</option>{% else %}<option value=\"1000\" selected>1,000 accounts</option><option value=\"10000\">10,000 accounts</option>{% endif %}</select><button class=\"button compact\" type=\"submit\">Filter</button><a class=\"reset-filter\" href=\"/customers\">Reset</a></form>{% else %}<p class=\"snapshot-note\">Static snapshot. Search, filters, CSV exports and pagination are available in the native SSR app.</p>{% endif %}<div class=\"directory-caption\"><span><strong>{{ found }}</strong> matching accounts</span><span>25 rows per page \xc2\xb7 rendered on the server</span></div><div class=\"table-scroll\"><table class=\"customer-table\"><thead><tr><th>Company</th><th>Plan</th><th>Status</th><th class=\"numeric\">Monthly revenue</th><th>Joined</th></tr></thead><tbody>{% for row in rows %}{{ row }}{% endfor %}</tbody></table></div>{% if empty %}<div class=\"empty\"><h2>No matching customers.</h2><p>Try another name or subscription plan.</p></div>{% endif %}<nav class=\"table-footer pagination\" aria-label=\"Customer pagination\"><span>Showing {{ range_label }} of {{ found }}</span><div>{% if server %}{% if has_previous %}<a class=\"page-button\" href=\"{{ previous }}\">\xe2\x86\x90 Previous</a>{% endif %}<span>Page {{ page }} of {{ pages }}</span>{% if has_next %}<a class=\"page-button\" href=\"{{ next_url }}\">Next \xe2\x86\x92</a>{% endif %}{% endif %}</div></nav></section>\n"
parse 2 Page_8a5edab282 examples/saas/app/page.view
props title:text server:bool records:int record_count:text range:int week:bool month:bool quarter:bool large:bool revenue:text change:text mrr:text active:text trials:text total:text caption:text chart:html sources:html customers:html[] csv:url customers_url:url
body "<section class=\"page-heading\"><div><span class=\"eyebrow\">YOUR BUSINESS, AT A GLANCE</span><h1>Overview</h1><p>A little clarity on how things are going.</p></div>{% if server %}<a class=\"button secondary\" href=\"{{ csv }}\" download>\xe2\x86\x93 Export customers</a>{% else %}<span class=\"button secondary\">Static snapshot</span>{% endif %}</section>\n<div class=\"dashboard-toolbar\"><div class=\"view-tabs\"><span class=\"selected\">Business overview</span><a href=\"{{ customers_url }}\">Customer insights \xe2\x86\x97</a></div>{% if server %}<form method=\"get\" action=\"/\" class=\"range-form\"><label class=\"sr-only\" for=\"period\">Reporting period</label><select id=\"period\" name=\"range\">{% if week %}<option value=\"7\" selected>Last 7 days</option>{% else %}<option value=\"7\">Last 7 days</option>{% endif %}{% if month %}<option value=\"30\" selected>Last 30 days</option>{% else %}<option value=\"30\">Last 30 days</option>{% endif %}{% if quarter %}<option value=\"90\" selected>Last 90 days</option>{% else %}<option value=\"90\">Last 90 days</option>{% endif %}</select><label class=\"sr-only\" for=\"record-count\">Demo dataset</label><select id=\"record-count\" name=\"records\">{% if large %}<option value=\"1000\">1,000 accounts</option><option value=\"10000\" selected>10,000 accounts</option>{% else %}<option value=\"1000\" selected>1,000 accounts</option><option value=\"10000\">10,000 accounts</option>{% endif %}</select><button class=\"button compact\" type=\"submit\">Apply</button></form>{% else %}<span class=\"snapshot-note\">30-day snapshot \xc2\xb7 filters available in SSR</span>{% endif %}</div>\n<section class=\"metrics\" aria-label=\"Key metrics\"><article class=\"metric\"><div>Net revenue<span aria-hidden=\"true\">\xe2\x86\x97</span></div><strong data-metric=\"revenue\">{{ revenue }}</strong><p><span class=\"positive\">\xe2\x86\x91 {{ change }}</span> vs. previous period</p></article><article class=\"metric\"><div>Monthly recurring revenue<span aria-hidden=\"true\">\xe2\x86\x97</span></div><strong>{{ mrr }}</strong><p><span class=\"metric-note\">Across paid demo accounts</span></p></article><article class=\"metric\"><div>Active customers<span aria-hidden=\"true\">\xe2\x99\xa7</span></div><strong data-metric=\"active\">{{ active }}</strong><p><span class=\"metric-note\">of {{ total }} total accounts</span></p></article><article class=\"metric\"><div>Trial accounts<span aria-hidden=\"true\">\xe2\x97\xb7</span></div><strong>{{ trials }}</strong><p><span class=\"metric-note\">A new chapter starts here</span></p></article></section>\n{% if server %}<section class=\"panel live-panel\" data-live>\n<header class=\"panel-heading\"><div><h2>Live workspace <span class=\"live-dot\" aria-hidden=\"true\"></span></h2><p>Simulated events, published by Neo \xc2\xb7 shared across connected tabs</p></div><div class=\"live-controls\"><output data-live-status aria-live=\"polite\">Connecting</output><button class=\"button secondary compact\" type=\"button\" data-live-toggle>Pause</button></div></header>\n<div class=\"live-metrics\"><div><span>Demo revenue</span><strong data-live-revenue>$0</strong><small>Since this server started</small></div><div><span>New signups</span><strong data-live-signups>0</strong><small>From the shared demo feed</small></div><div><span>Events received</span><strong data-live-count>0</strong><small data-live-updated>Waiting for the first event</small></div></div>\n<div class=\"live-content\"><figure class=\"live-chart\"><figcaption>Payment activity <span>Latest 60 received events</span></figcaption><svg viewBox=\"0 0 600 140\" role=\"img\" aria-label=\"Live payment amounts in dollars\"><path class=\"live-grid\" d=\"M0 10H600 M0 70H600 M0 130H600\"/><path class=\"live-line\" data-live-line d=\"M0 130H600\"/></svg><p data-live-chart-label>Live data arrives after the initial server-rendered page.</p></figure><div><h3>Happening now</h3><ol class=\"live-feed\" data-live-feed aria-label=\"Recent live activity\"><li class=\"live-empty\">Waiting for a server event\xe2\x80\xa6</li></ol></div></div>\n<footer class=\"live-footer\"><span>SSE \xc2\xb7 automatic reconnect \xc2\xb7 bounded replay</span><span data-live-cursor>One subscription for this dashboard</span></footer></section>{% else %}<p class=\"snapshot-note\">Live workspace is available when running the native server. This export is a static snapshot.</p>{% endif %}\n<section class=\"charts-grid\"><article class=\"panel revenue-panel\" data-chart><header class=\"panel-heading\"><div><h2>Revenue over time</h2><p>{{ caption }} \xc2\xb7 {{ range }} daily data points</p></div><div class=\"chart-legend\"><span><i class=\"current-dot\"></i>Current</span><span><i></i>Previous</span></div></header>{{ chart }}</article><article class=\"panel source-panel\"><header class=\"panel-heading\"><div><h2>Where customers find you</h2><p>Acquisition mix \xc2\xb7 demo cohort</p></div><span class=\"panel-icon\">\xe2\x86\x97</span></header><div class=\"source-total\"><strong>{{ total }}</strong><span>total customers</span></div>{{ sources }}<p class=\"panel-footnote\">A balanced mix makes room for growth.</p></article></section>\n<section class=\"panel customers-panel\"><header class=\"panel-heading\"><div><h2>Customer snapshot <span class=\"count-pill\">{{ record_count }}</span></h2><p>Good relationships start with a little context.</p></div><a class=\"text-button\" href=\"{{ customers_url }}\">View all customers \xe2\x86\x97</a></header><div class=\"table-scroll\"><table class=\"customer-table\"><thead><tr><th>Company</th><th>Plan</th><th>Status</th><th class=\"numeric\">Monthly revenue</th><th>Joined</th></tr></thead><tbody>{% for customer in customers %}{{ customer }}{% endfor %}</tbody></table></div><div class=\"table-footer\"><span>8 featured accounts from {{ record_count }} generated records</span><a href=\"{{ customers_url }}\">Explore the dataset \xe2\x86\x92</a></div></section>\n"
parse 3 Layout examples/saas/app/layout.view
props title:text content:html client:bool mode:text
body "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>{{ title }} \xc2\xb7 Meridian</title><meta name=\"description\" content=\"Meridian is a native NeoKit SaaS dashboard example. All account and revenue data is synthetic.\"><link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\"><link rel=\"stylesheet\" href=\"@asset(site.css)\"></head><body data-render-mode=\"{{ mode }}\"><a class=\"skip\" href=\"#web-page\">Skip to content</a><aside class=\"sidebar\"><a href=\"/\" class=\"brand\"><span class=\"brand-symbol\">m</span>meridian<span class=\"brand-dot\">.</span></a><div class=\"workspace\"><span class=\"workspace-avatar\">AC</span><span>Acme workspace<small>Demo workspace</small></span><span class=\"workspace-mark\">\xe2\x8c\x98</span></div><p class=\"nav-label\">WORKSPACE</p><nav aria-label=\"Main navigation\"><a href=\"/\" data-nav=\"/\"><span aria-hidden=\"true\">\xe2\x97\xab</span>Overview</a><a href=\"/customers\" data-nav=\"/customers\"><span aria-hidden=\"true\">\xe2\x99\xa7</span>Customers</a><a href=\"/activity\" data-nav=\"/activity\"><span aria-hidden=\"true\">\xe2\x97\xb7</span>Activity</a></nav><div class=\"sidebar-note\"><span class=\"note-icon\">\xe2\x9c\xb3</span><strong>Small footprint.<br>Big possibilities.</strong><p>Complete HTML, native charts, and a little JavaScript.</p><a href=\"/customers\">Explore the dataset \xe2\x86\x97</a></div><div class=\"account\"><span class=\"user-avatar\">JD</span><span>Jamie Davis<small>Demo account</small></span><span class=\"online-dot\" title=\"Demo workspace\"></span></div></aside><div class=\"app-shell\"><header class=\"topbar\"><div class=\"breadcrumb\">Workspace <span>/</span> <strong>{{ title }}</strong></div><div class=\"topbar-right\"><span class=\"demo-pill\"><i></i>Demo data</span><span class=\"speed\" data-performance><output>Server-rendered HTML</output></span><span class=\"topbar-avatar\" aria-label=\"Demo account JD\">JD</span></div></header><main id=\"web-page\" tabindex=\"-1\">{{ content }}</main><footer class=\"app-footer\"><span>Meridian \xc2\xb7 Built with NeoKit</span><span>Synthetic data. Real server rendering.</span></footer></div>{% if client %}<script type=\"module\" src=\"@asset(client.js)\"></script>{% endif %}</body></html>\n"
