fn text_Page_121a6110c5(p_title: Arr u8 _,p_server: bool,p_records: i64,p_total: Arr u8 _,p_query: Arr u8 _,p_all: bool,p_growth: bool,p_pro: bool,p_enterprise: bool,p_large: bool,p_rows: Arr WebHtml _,p_found: Arr u8 _,p_page: i64,p_pages: i64,p_has_previous: bool,p_has_next: bool,p_previous: WebURL,p_next_url: WebURL,p_csv: WebURL,p_empty: bool,p_range_label: Arr u8 _) -> Arr u8 _ = concat("<section class=\"page-heading\"><div><span class=\"eyebrow\">PEOPLE BEHIND THE NUMBERS</span><h1>Customers <span class=\"title-count\">",html_escape(p_total),"</span></h1><p>Know your customers. Keep the good ones close.</p></div>",(if p_server then concat("<a class=\"button secondary\" href=\"",html_escape(p_csv.value),"\" download>\xe2\x86\x93 Export filtered CSV</a>") else "<span class=\"button secondary\">Static snapshot</span>"),"</section><section class=\"panel customer-directory\">",(if p_server then concat("<form class=\"customer-filter\" action=\"/customers\" method=\"get\" role=\"search\"><div class=\"search-field\"><span aria-hidden=\"true\">\xe2\x8c\x95</span><label class=\"sr-only\" for=\"customer-search\">Search companies</label><input id=\"customer-search\" name=\"q\" value=\"",html_escape(p_query),"\" placeholder=\"Search companies\xe2\x80\xa6\" maxlength=\"80\"></div><label class=\"sr-only\" for=\"plan-filter\">Subscription plan</label><select id=\"plan-filter\" name=\"plan\">",(if p_all then "<option value=\"all\" selected>All plans</option>" else "<option value=\"all\">All plans</option>"),(if p_growth then "<option value=\"Growth\" selected>Growth</option>" else "<option value=\"Growth\">Growth</option>"),(if p_pro then "<option value=\"Pro\" selected>Pro</option>" else "<option value=\"Pro\">Pro</option>"),(if p_enterprise then "<option value=\"Enterprise\" selected>Enterprise</option>" else "<option value=\"Enterprise\">Enterprise</option>"),"</select><label class=\"sr-only\" for=\"directory-count\">Demo dataset</label><select id=\"directory-count\" name=\"records\">",(if p_large then "<option value=\"1000\">1,000 accounts</option><option value=\"10000\" selected>10,000 accounts</option>" else "<option value=\"1000\" selected>1,000 accounts</option><option value=\"10000\">10,000 accounts</option>"),"</select><button class=\"button compact\" type=\"submit\">Filter</button><a class=\"reset-filter\" href=\"/customers\">Reset</a></form>") else "<p class=\"snapshot-note\">Static snapshot. Search, filters, CSV exports and pagination are available in the native SSR app.</p>"),"<div class=\"directory-caption\"><span><strong>",html_escape(p_found),"</strong> matching accounts</span><span>25 rows per page \xc2\xb7 rendered on the server</span></div><div class=\"table-scroll\"><table class=\"customer-table\"><thead><tr><th>Company</th><th>Plan</th><th>Status</th><th class=\"numeric\">Monthly revenue</th><th>Joined</th></tr></thead><tbody>",text_Page_121a6110c5_loop_0(p_title,p_server,p_records,p_total,p_query,p_all,p_growth,p_pro,p_enterprise,p_large,p_rows,p_found,p_page,p_pages,p_has_previous,p_has_next,p_previous,p_next_url,p_csv,p_empty,p_range_label,0,len(p_rows)),"</tbody></table></div>",(if p_empty then "<div class=\"empty\"><h2>No matching customers.</h2><p>Try another name or subscription plan.</p></div>" else ""),"<nav class=\"table-footer pagination\" aria-label=\"Customer pagination\"><span>Showing ",html_escape(p_range_label)," of ",html_escape(p_found),"</span><div>",(if p_server then concat((if p_has_previous then concat("<a class=\"page-button\" href=\"",html_escape(p_previous.value),"\">\xe2\x86\x90 Previous</a>") else ""),"<span>Page ",int_text(p_page)," of ",int_text(p_pages),"</span>",(if p_has_next then concat("<a class=\"page-button\" href=\"",html_escape(p_next_url.value),"\">Next \xe2\x86\x92</a>") else "")) else ""),"</div></nav></section>\n")
fn view_Page_121a6110c5(p_title: Arr u8 _,p_server: bool,p_records: i64,p_total: Arr u8 _,p_query: Arr u8 _,p_all: bool,p_growth: bool,p_pro: bool,p_enterprise: bool,p_large: bool,p_rows: Arr WebHtml _,p_found: Arr u8 _,p_page: i64,p_pages: i64,p_has_previous: bool,p_has_next: bool,p_previous: WebURL,p_next_url: WebURL,p_csv: WebURL,p_empty: bool,p_range_label: Arr u8 _) -> WebHtml = web_html(text_Page_121a6110c5(p_title,p_server,p_records,p_total,p_query,p_all,p_growth,p_pro,p_enterprise,p_large,p_rows,p_found,p_page,p_pages,p_has_previous,p_has_next,p_previous,p_next_url,p_csv,p_empty,p_range_label))

fn text_Layout(p_title: Arr u8 _,p_content: WebHtml,p_client: bool,p_mode: Arr u8 _) -> Arr u8 _ = concat("<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>",html_escape(p_title)," \xc2\xb7 Meridian</title><meta name=\"description\" content=\"Meridian is a native NeoKit SaaS dashboard example. All account and revenue data is synthetic.\"><link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\"><link rel=\"stylesheet\" href=\"/_web/site-7e60278ed99b.css\"></head><body data-render-mode=\"",html_escape(p_mode),"\"><a class=\"skip\" href=\"#web-page\">Skip to content</a><aside class=\"sidebar\"><a href=\"/\" class=\"brand\"><span class=\"brand-symbol\">m</span>meridian<span class=\"brand-dot\">.</span></a><div class=\"workspace\"><span class=\"workspace-avatar\">AC</span><span>Acme workspace<small>Demo workspace</small></span><span class=\"workspace-mark\">\xe2\x8c\x98</span></div><p class=\"nav-label\">WORKSPACE</p><nav aria-label=\"Main navigation\"><a href=\"/\" data-nav=\"/\"><span aria-hidden=\"true\">\xe2\x97\xab</span>Overview</a><a href=\"/customers\" data-nav=\"/customers\"><span aria-hidden=\"true\">\xe2\x99\xa7</span>Customers</a><a href=\"/activity\" data-nav=\"/activity\"><span aria-hidden=\"true\">\xe2\x97\xb7</span>Activity</a></nav><div class=\"sidebar-note\"><span class=\"note-icon\">\xe2\x9c\xb3</span><strong>Small footprint.<br>Big possibilities.</strong><p>Complete HTML, native charts, and a little JavaScript.</p><a href=\"/customers\">Explore the dataset \xe2\x86\x97</a></div><div class=\"account\"><span class=\"user-avatar\">JD</span><span>Jamie Davis<small>Demo account</small></span><span class=\"online-dot\" title=\"Demo workspace\"></span></div></aside><div class=\"app-shell\"><header class=\"topbar\"><div class=\"breadcrumb\">Workspace <span>/</span> <strong>",html_escape(p_title),"</strong></div><div class=\"topbar-right\"><span class=\"demo-pill\"><i></i>Demo data</span><span class=\"speed\" data-performance><output>Server-rendered HTML</output></span><span class=\"topbar-avatar\" aria-label=\"Demo account JD\">JD</span></div></header><main id=\"web-page\" tabindex=\"-1\">",p_content.bytes,"</main><footer class=\"app-footer\"><span>Meridian \xc2\xb7 Built with NeoKit</span><span>Synthetic data. Real server rendering.</span></footer></div>",(if p_client then "<script type=\"module\" src=\"/_web/client-5fcz8tmt.js\"></script>" else ""),"</body></html>\n")
fn view_Layout(p_title: Arr u8 _,p_content: WebHtml,p_client: bool,p_mode: Arr u8 _) -> WebHtml = web_html(text_Layout(p_title,p_content,p_client,p_mode))
end code
expression Page_8a5edab282 "concat(\"<section class=\\\"page-heading\\\"><div><span class=\\\"eyebrow\\\">YOUR BUSINESS, AT A GLANCE</span><h1>Overview</h1><p>A little clarity on how things are going.</p></div>\",(if p_server then concat(\"<a class=\\\"button secondary\\\" href=\\\"\",html_escape(p_csv.value),\"\\\" download>\\xe2\\x86\\x93 Export customers</a>\") else \"<span class=\\\"button secondary\\\">Static snapshot</span>\"),\"</section>\\n<div class=\\\"dashboard-toolbar\\\"><div class=\\\"view-tabs\\\"><span class=\\\"selected\\\">Business overview</span><a href=\\\"\",html_escape(p_customers_url.value),\"\\\">Customer insights \\xe2\\x86\\x97</a></div>\",(if p_server then concat(\"<form method=\\\"get\\\" action=\\\"/\\\" class=\\\"range-form\\\"><label class=\\\"sr-only\\\" for=\\\"period\\\">Reporting period</label><select id=\\\"period\\\" name=\\\"range\\\">\",(if p_week then \"<option value=\\\"7\\\" selected>Last 7 days</option>\" else \"<option value=\\\"7\\\">Last 7 days</option>\"),(if p_month then \"<option value=\\\"30\\\" selected>Last 30 days</option>\" else \"<option value=\\\"30\\\">Last 30 days</option>\"),(if p_quarter then \"<option value=\\\"90\\\" selected>Last 90 days</option>\" else \"<option value=\\\"90\\\">Last 90 days</option>\"),\"</select><label class=\\\"sr-only\\\" for=\\\"record-count\\\">Demo dataset</label><select id=\\\"record-count\\\" name=\\\"records\\\">\",(if p_large then \"<option value=\\\"1000\\\">1,000 accounts</option><option value=\\\"10000\\\" selected>10,000 accounts</option>\" else \"<option value=\\\"1000\\\" selected>1,000 accounts</option><option value=\\\"10000\\\">10,000 accounts</option>\"),\"</select><button class=\\\"button compact\\\" type=\\\"submit\\\">Apply</button></form>\") else \"<span class=\\\"snapshot-note\\\">30-day snapshot \\xc2\\xb7 filters available in SSR</span>\"),\"</div>\\n<section class=\\\"metrics\\\" aria-label=\\\"Key metrics\\\"><article class=\\\"metric\\\"><div>Net revenue<span aria-hidden=\\\"true\\\">\\xe2\\x86\\x97</span></div><strong data-metric=\\\"revenue\\\">\",html_escape(p_revenue),\"</strong><p><span class=\\\"positive\\\">\\xe2\\x86\\x91 \",html_escape(p_change),\"</span> vs. previous period</p></article><article class=\\\"metric\\\"><div>Monthly recurring revenue<span aria-hidden=\\\"true\\\">\\xe2\\x86\\x97</span></div><strong>\",html_escape(p_mrr),\"</strong><p><span class=\\\"metric-note\\\">Across paid demo accounts</span></p></article><article class=\\\"metric\\\"><div>Active customers<span aria-hidden=\\\"true\\\">\\xe2\\x99\\xa7</span></div><strong data-metric=\\\"active\\\">\",html_escape(p_active),\"</strong><p><span class=\\\"metric-note\\\">of \",html_escape(p_total),\" total accounts</span></p></article><article class=\\\"metric\\\"><div>Trial accounts<span aria-hidden=\\\"true\\\">\\xe2\\x97\\xb7</span></div><strong>\",html_escape(p_trials),\"</strong><p><span class=\\\"metric-note\\\">A new chapter starts here</span></p></article></section>\\n\",(if p_server then \"<section class=\\\"panel live-panel\\\" data-live>\\n<header class=\\\"panel-heading\\\"><div><h2>Live workspace <span class=\\\"live-dot\\\" aria-hidden=\\\"true\\\"></span></h2><p>Simulated events, published by Neo \\xc2\\xb7 shared across connected tabs</p></div><div class=\\\"live-controls\\\"><output data-live-status aria-live=\\\"polite\\\">Connecting</output><button class=\\\"button secondary compact\\\" type=\\\"button\\\" data-live-toggle>Pause</button></div></header>\\n<div class=\\\"live-metrics\\\"><div><span>Demo revenue</span><strong data-live-revenue>$0</strong><small>Since this server started</small></div><div><span>New signups</span><strong data-live-signups>0</strong><small>From the shared demo feed</small></div><div><span>Events received</span><strong data-live-count>0</strong><small data-live-updated>Waiting for the first event</small></div></div>\\n<div class=\\\"live-content\\\"><figure class=\\\"live-chart\\\"><figcaption>Payment activity <span>Latest 60 received events</span></figcaption><svg viewBox=\\\"0 0 600 140\\\" role=\\\"img\\\" aria-label=\\\"Live payment amounts in dollars\\\"><path class=\\\"live-grid\\\" d=\\\"M0 10H600 M0 70H600 M0 130H600\\\"/><path class=\\\"live-line\\\" data-live-line d=\\\"M0 130H600\\\"/></svg><p data-live-chart-label>Live data arrives after the initial server-rendered page.</p></figure><div><h3>Happening now</h3><ol class=\\\"live-feed\\\" data-live-feed aria-label=\\\"Recent live activity\\\"><li class=\\\"live-empty\\\">Waiting for a server event\\xe2\\x80\\xa6</li></ol></div></div>\\n<footer class=\\\"live-footer\\\"><span>SSE \\xc2\\xb7 automatic reconnect \\xc2\\xb7 bounded replay</span><span data-live-cursor>One subscription for this dashboard</span></footer></section>\" else \"<p class=\\\"snapshot-note\\\">Live workspace is available when running the native server. This export is a static snapshot.</p>\"),\"\\n<section class=\\\"charts-grid\\\"><article class=\\\"panel revenue-panel\\\" data-chart><header class=\\\"panel-heading\\\"><div><h2>Revenue over time</h2><p>\",html_escape(p_caption),\" \\xc2\\xb7 \",int_text(p_range),\" daily data points</p></div><div class=\\\"chart-legend\\\"><span><i class=\\\"current-dot\\\"></i>Current</span><span><i></i>Previous</span></div></header>\",p_chart.bytes,\"</article><article class=\\\"panel source-panel\\\"><header class=\\\"panel-heading\\\"><div><h2>Where customers find you</h2><p>Acquisition mix \\xc2\\xb7 demo cohort</p></div><span class=\\\"panel-icon\\\">\\xe2\\x86\\x97</span></header><div class=\\\"source-total\\\"><strong>\",html_escape(p_total),\"</strong><span>total customers</span></div>\",p_sources.bytes,\"<p class=\\\"panel-footnote\\\">A balanced mix makes room for growth.</p></article></section>\\n<section class=\\\"panel customers-panel\\\"><header class=\\\"panel-heading\\\"><div><h2>Customer snapshot <span class=\\\"count-pill\\\">\",html_escape(p_record_count),\"</span></h2><p>Good relationships start with a little context.</p></div><a class=\\\"text-button\\\" href=\\\"\",html_escape(p_customers_url.value),\"\\\">View all customers \\xe2\\x86\\x97</a></header><div class=\\\"table-scroll\\\"><table class=\\\"customer-table\\\"><thead><tr><th>Company</th><th>Plan</th><th>Status</th><th class=\\\"numeric\\\">Monthly revenue</th><th>Joined</th></tr></thead><tbody>\",text_Page_8a5edab282_loop_0(p_title,p_server,p_records,p_record_count,p_range,p_week,p_month,p_quarter,p_large,p_revenue,p_change,p_mrr,p_active,p_trials,p_total,p_caption,p_chart,p_sources,p_customers,p_csv,p_customers_url,0,len(p_customers)),\"</tbody></table></div><div class=\\\"table-footer\\\"><span>8 featured accounts from \",html_escape(p_record_count),\" generated records</span><a href=\\\"\",html_escape(p_customers_url.value),\"\\\">Explore the dataset \\xe2\\x86\\x92</a></div></section>\\n\")"
