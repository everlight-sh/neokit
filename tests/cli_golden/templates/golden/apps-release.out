substitute "concat(\"<!doctype html><html lang=\\\"en\\\"><head><meta charset=\\\"utf-8\\\"><meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\"><title>\",html_escape(props.title),\" \\xc2\\xb7 Forma</title><meta name=\\\"description\\\" content=\\\"A small architecture studio creating thoughtful places to live.\\\"><link rel=\\\"icon\\\" href=\\\"/favicon.svg\\\" type=\\\"image/svg+xml\\\"><link rel=\\\"stylesheet\\\" href=\\\"/_web/site-1d0d876e6744.css\\\"></head><body data-render-mode=\\\"\",html_escape((if request.server then \"native SSR\" else \"static export\")),\"\\\"><a class=\\\"skip\\\" href=\\\"#web-page\\\">Skip to content</a><header class=\\\"site-header wrap\\\"><a class=\\\"brand\\\" href=\\\"/\\\" aria-label=\\\"Forma home\\\">forma<span>\\xc2\\xae</span></a><nav aria-label=\\\"Main navigation\\\"><a href=\\\"/#work\\\">Selected work</a><a href=\\\"/studio\\\">The studio</a><a class=\\\"contact-link\\\" href=\\\"/studio#contact\\\">Start a conversation <span aria-hidden=\\\"true\\\">\\xe2\\x86\\x97</span></a></nav></header><main id=\\\"web-page\\\" tabindex=\\\"-1\\\">\",text_Page_8a5edab282(props.title,props.stamp,props.server),\"</main><footer class=\\\"wrap footer\\\"><a class=\\\"brand\\\" href=\\\"/\\\">forma<span>\\xc2\\xae</span></a><p>Thoughtful by design. Native by NeoKit.</p><span class=\\\"speed\\\" data-performance><i></i><output>Server-rendered HTML</output></span></footer>\",(if true then \"<script type=\\\"module\\\" src=\\\"/_web/client-mdw7azs3.js\\\"></script>\" else \"\"),\"</body></html>\\n\")"
substitute "concat(\"<!doctype html><html lang=\\\"en\\\"><head><meta charset=\\\"utf-8\\\"><meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\"><title>\",html_escape(props.title),\" \\xc2\\xb7 Forma</title><meta name=\\\"description\\\" content=\\\"A small architecture studio creating thoughtful places to live.\\\"><link rel=\\\"icon\\\" href=\\\"/favicon.svg\\\" type=\\\"image/svg+xml\\\"><link rel=\\\"stylesheet\\\" href=\\\"/_web/site-1d0d876e6744.css\\\"></head><body data-render-mode=\\\"\",html_escape((if request.server then \"native SSR\" else \"static export\")),\"\\\"><a class=\\\"skip\\\" href=\\\"#web-page\\\">Skip to content</a><header class=\\\"site-header wrap\\\"><a class=\\\"brand\\\" href=\\\"/\\\" aria-label=\\\"Forma home\\\">forma<span>\\xc2\\xae</span></a><nav aria-label=\\\"Main navigation\\\"><a href=\\\"/#work\\\">Selected work</a><a href=\\\"/studio\\\">The studio</a><a class=\\\"contact-link\\\" href=\\\"/studio#contact\\\">Start a conversation <span aria-hidden=\\\"true\\\">\\xe2\\x86\\x97</span></a></nav></header><main id=\\\"web-page\\\" tabindex=\\\"-1\\\">\",text_Page_5b0f3f2119(props.title),\"</main><footer class=\\\"wrap footer\\\"><a class=\\\"brand\\\" href=\\\"/\\\">forma<span>\\xc2\\xae</span></a><p>Thoughtful by design. Native by NeoKit.</p><span class=\\\"speed\\\" data-performance><i></i><output>Server-rendered HTML</output></span></footer>\",(if true then \"<script type=\\\"module\\\" src=\\\"/_web/client-mdw7azs3.js\\\"></script>\" else \"\"),\"</body></html>\\n\")"
