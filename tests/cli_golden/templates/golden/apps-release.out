body "<header class=\"border-b border-slate-200 bg-white\">\n  <div class=\"mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-5\">\n    <a class=\"flex items-center gap-3 rounded-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-600\" href=\"/\" data-web-link aria-label=\"NeoKit home\"><span class=\"flex size-9 items-center justify-center rounded-lg bg-indigo-600 text-lg font-bold text-white\">N</span><span class=\"text-lg font-semibold tracking-tight text-slate-900\">NeoKit</span><span class=\"rounded-md bg-slate-100 px-2 py-1 text-xs font-medium text-slate-600\">Starter</span></a>\n    <nav class=\"flex items-center gap-6 text-sm font-medium text-slate-600\" aria-label=\"Main navigation\"><a class=\"transition hover:text-indigo-600\" href=\"/\" data-web-link>Home</a><a class=\"transition hover:text-indigo-600\" href=\"/notes/native\" data-web-link data-web-match=\"/notes\">Guides</a><a class=\"transition hover:text-indigo-600\" href=\"/stress\" data-web-link>Stress test</a><a class=\"transition hover:text-indigo-600\" href=\"/about\" data-web-link>About</a></nav>\n  </div>\n</header>\n"
parse 6 Layout examples/studio/app/layout.view
props title:text content:html client:bool mode:text
body "<!doctype html>\n<html lang=\"en\" class=\"scroll-smooth motion-reduce:scroll-auto\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><meta name=\"description\" content=\"A simple NeoKit starter with Tailwind CSS, server-rendered pages, and interactive examples.\"><title>{{ title }} \xc2\xb7 NeoKit</title><link rel=\"icon\" href=\"/mark.svg\" type=\"image/svg+xml\"><link rel=\"stylesheet\" href=\"@asset(site.css)\"></head>\n<body class=\"bg-white font-sans text-slate-900 antialiased\" data-render-mode=\"{{ mode }}\">\n<a class=\"sr-only rounded-md bg-indigo-600 px-4 py-2 text-white focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50\" href=\"#web-page\">Skip to content</a>\n{% include Header %}\n<main id=\"web-page\" tabindex=\"-1\" class=\"focus:outline-none\">{{ content }}</main>\n<footer class=\"border-t border-slate-200 bg-white\"><div class=\"mx-auto flex max-w-6xl flex-col gap-4 px-6 py-8 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between\"><p>NeoKit starter \xc2\xb7 Built with Tailwind CSS</p><div class=\"flex flex-wrap items-center gap-5\"><span>Rendered with {{ mode }}</span><a class=\"font-medium text-slate-600 hover:text-indigo-600\" href=\"/about\" data-web-link>About this starter</a></div></div></footer>\n{% if client %}<script type=\"module\" src=\"@asset(client.js)\"></script>{% endif %}\n</body></html>\n"
compile_all
