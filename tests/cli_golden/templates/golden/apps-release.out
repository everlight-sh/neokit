parse 0 Page_8a5edab282 examples/ssr-site/app/page.view
props title:text stamp:int server:bool
body "<section class=\"hero wrap\"><div class=\"hero-copy\"><span class=\"eyebrow\">INDEPENDENT ARCHITECTURE STUDIO \xc2\xb7 EST. 2018</span><h1>Good spaces.<br><em>Better days.</em></h1><p>Homes and places that feel like they belong.<br>Considered, enduring, and quietly extraordinary.</p><a class=\"button\" href=\"#work\">Explore our work <span aria-hidden=\"true\">\xe2\x86\x98</span></a><div class=\"hero-note\"><span class=\"small-orbit\" aria-hidden=\"true\">\xe2\x9c\xb3</span><span>Designed around life.<br>Built for the long run.</span></div></div><figure class=\"hero-art\"><img src=\"/courtyard.svg\" alt=\"Architectural illustration of a sunlit courtyard home with an olive tree\" width=\"720\" height=\"680\"><figcaption><span>01 / COURTYARD HOUSE</span><span>2026 \xc2\xb7 Residential</span></figcaption></figure></section>\n<section class=\"intro wrap\"><span class=\"eyebrow\">LESS, BUT BETTER</span><h2>We believe the best spaces<br>make room for what matters.</h2><p>Natural light. Honest materials. A little breathing room. We work closely with people to create architecture that feels as good as it looks.</p></section>\n<section id=\"work\" class=\"work wrap\"><div class=\"section-heading\"><h2>Selected work<span>02</span></h2><a href=\"/studio\">Our approach \xe2\x86\x97</a></div><div class=\"work-grid\"><article><a href=\"/studio#courtyard\"><img src=\"/courtyard.svg\" alt=\"Courtyard House, a quiet home arranged around a planted courtyard\" width=\"720\" height=\"680\" loading=\"lazy\"><div class=\"project-title\"><h3>Courtyard House</h3><span>Residential \xc2\xb7 2026 \xe2\x86\x97</span></div></a></article><article><a href=\"/studio#hillside\"><img src=\"/hillside.svg\" alt=\"Hillside Retreat, a timber home nestled in a green landscape\" width=\"720\" height=\"680\" loading=\"lazy\"><div class=\"project-title\"><h3>Hillside Retreat</h3><span>Residential \xc2\xb7 2025 \xe2\x86\x97</span></div></a></article></div></section>\n<section class=\"invitation wrap\"><p>Have something in mind?</p><h2>Let's make<br><em>room for it.</em></h2><a class=\"button light\" href=\"/studio#contact\">Meet your architects \xe2\x86\x97</a></section>\n<div class=\"render-note wrap\">{% if server %}A complete HTML document, rendered for this request.<span>Request timestamp <code>{{ stamp }}</code></span>{% else %}A complete HTML document, rendered at build time.<span>Static export snapshot</span>{% endif %}</div>\n"
parse 1 Page_5b0f3f2119 examples/ssr-site/app/studio/page.view
props title:text
body "<article class=\"studio wrap\"><span class=\"eyebrow\">THE STUDIO</span><h1>A small studio.<br><em>A long view.</em></h1><div class=\"studio-body\"><p class=\"lead\">We bring calm thinking and a hands-on approach to the spaces you call your own.</p><div><h2>Built around people</h2><p>Every project begins with a conversation, not a drawing. How do you spend your mornings? Where does the light fall? What would make an ordinary day a little better?</p><p>We work from those details outward, using natural materials and clear ideas to create places that will grow with you.</p></div></div><div class=\"studio-projects\"><section id=\"courtyard\"><img src=\"/courtyard.svg\" alt=\"Courtyard House illustration\" width=\"720\" height=\"680\"><h2>Courtyard House</h2><p>A home turned inward toward a quiet garden. Deep window reveals, limewashed walls, and a generous threshold connect every room to the outdoors.</p></section><section id=\"hillside\"><img src=\"/hillside.svg\" alt=\"Hillside Retreat illustration\" width=\"720\" height=\"680\"><h2>Hillside Retreat</h2><p>A compact timber house follows the shape of its landscape. A single broad roof creates a sheltered edge for watching the weather pass.</p></section></div><section id=\"contact\" class=\"contact\"><span class=\"eyebrow\">SAY HELLO</span><h2>Good things start<br>with a conversation.</h2><a href=\"mailto:hello@forma.example\">hello@forma.example \xe2\x86\x97</a><p>Forma is a fictional studio built to demonstrate NeoKit. See the example README to make it your own.</p></section></article>\n"
parse 2 Layout examples/ssr-site/app/layout.view
props title:text content:html client:bool mode:text
body "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>{{ title }} \xc2\xb7 Forma</title><meta name=\"description\" content=\"A small architecture studio creating thoughtful places to live.\"><link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\"><link rel=\"stylesheet\" href=\"@asset(site.css)\"></head><body data-render-mode=\"{{ mode }}\"><a class=\"skip\" href=\"#web-page\">Skip to content</a><header class=\"site-header wrap\"><a class=\"brand\" href=\"/\" aria-label=\"Forma home\">forma<span>\xc2\xae</span></a><nav aria-label=\"Main navigation\"><a href=\"/#work\">Selected work</a><a href=\"/studio\">The studio</a><a class=\"contact-link\" href=\"/studio#contact\">Start a conversation <span aria-hidden=\"true\">\xe2\x86\x97</span></a></nav></header><main id=\"web-page\" tabindex=\"-1\">{{ content }}</main><footer class=\"wrap footer\"><a class=\"brand\" href=\"/\">forma<span>\xc2\xae</span></a><p>Thoughtful by design. Native by NeoKit.</p><span class=\"speed\" data-performance><i></i><output>Server-rendered HTML</output></span></footer>{% if client %}<script type=\"module\" src=\"@asset(client.js)\"></script>{% endif %}</body></html>\n"
compile_all
code
fn text_Page_8a5edab282(p_title: Arr u8 _,p_stamp: i64,p_server: bool) -> Arr u8 _ = concat("<section class=\"hero wrap\"><div class=\"hero-copy\"><span class=\"eyebrow\">INDEPENDENT ARCHITECTURE STUDIO \xc2\xb7 EST. 2018</span><h1>Good spaces.<br><em>Better days.</em></h1><p>Homes and places that feel like they belong.<br>Considered, enduring, and quietly extraordinary.</p><a class=\"button\" href=\"#work\">Explore our work <span aria-hidden=\"true\">\xe2\x86\x98</span></a><div class=\"hero-note\"><span class=\"small-orbit\" aria-hidden=\"true\">\xe2\x9c\xb3</span><span>Designed around life.<br>Built for the long run.</span></div></div><figure class=\"hero-art\"><img src=\"/courtyard.svg\" alt=\"Architectural illustration of a sunlit courtyard home with an olive tree\" width=\"720\" height=\"680\"><figcaption><span>01 / COURTYARD HOUSE</span><span>2026 \xc2\xb7 Residential</span></figcaption></figure></section>\n<section class=\"intro wrap\"><span class=\"eyebrow\">LESS, BUT BETTER</span><h2>We believe the best spaces<br>make room for what matters.</h2><p>Natural light. Honest materials. A little breathing room. We work closely with people to create architecture that feels as good as it looks.</p></section>\n<section id=\"work\" class=\"work wrap\"><div class=\"section-heading\"><h2>Selected work<span>02</span></h2><a href=\"/studio\">Our approach \xe2\x86\x97</a></div><div class=\"work-grid\"><article><a href=\"/studio#courtyard\"><img src=\"/courtyard.svg\" alt=\"Courtyard House, a quiet home arranged around a planted courtyard\" width=\"720\" height=\"680\" loading=\"lazy\"><div class=\"project-title\"><h3>Courtyard House</h3><span>Residential \xc2\xb7 2026 \xe2\x86\x97</span></div></a></article><article><a href=\"/studio#hillside\"><img src=\"/hillside.svg\" alt=\"Hillside Retreat, a timber home nestled in a green landscape\" width=\"720\" height=\"680\" loading=\"lazy\"><div class=\"project-title\"><h3>Hillside Retreat</h3><span>Residential \xc2\xb7 2025 \xe2\x86\x97</span></div></a></article></div></section>\n<section class=\"invitation wrap\"><p>Have something in mind?</p><h2>Let's make<br><em>room for it.</em></h2><a class=\"button light\" href=\"/studio#contact\">Meet your architects \xe2\x86\x97</a></section>\n<div class=\"render-note wrap\">",(if p_server then concat("A complete HTML document, rendered for this request.<span>Request timestamp <code>",int_text(p_stamp),"</code></span>") else "A complete HTML document, rendered at build time.<span>Static export snapshot</span>"),"</div>\n")
fn view_Page_8a5edab282(p_title: Arr u8 _,p_stamp: i64,p_server: bool) -> WebHtml = web_html(text_Page_8a5edab282(p_title,p_stamp,p_server))

