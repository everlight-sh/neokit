fn text_Header() -> Arr u8 _ = "<header class=\"border-b border-slate-200 bg-white\">\n  <div class=\"mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-5\">\n    <a class=\"flex items-center gap-3 rounded-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-600\" href=\"/\" data-web-link aria-label=\"NeoKit home\"><span class=\"flex size-9 items-center justify-center rounded-lg bg-indigo-600 text-lg font-bold text-white\">N</span><span class=\"text-lg font-semibold tracking-tight text-slate-900\">NeoKit</span><span class=\"rounded-md bg-slate-100 px-2 py-1 text-xs font-medium text-slate-600\">Starter</span></a>\n    <nav class=\"flex items-center gap-6 text-sm font-medium text-slate-600\" aria-label=\"Main navigation\"><a class=\"transition hover:text-indigo-600\" href=\"/\" data-web-link>Home</a><a class=\"transition hover:text-indigo-600\" href=\"/notes/native\" data-web-link data-web-match=\"/notes\">Guides</a><a class=\"transition hover:text-indigo-600\" href=\"/stress\" data-web-link>Stress test</a><a class=\"transition hover:text-indigo-600\" href=\"/about\" data-web-link>About</a></nav>\n  </div>\n</header>\n"
fn view_Header() -> WebHtml = web_html(text_Header())

fn text_Page_8a5edab282(p_title: Arr u8 _,p_name: Arr u8 _,p_stamp: i64,p_server: bool) -> Arr u8 _ = concat("<section class=\"mx-auto grid max-w-6xl items-center gap-12 px-6 py-16 sm:py-24 lg:grid-cols-2 lg:gap-16\">\n  <div>\n    <span class=\"inline-flex items-center gap-2 rounded-full bg-indigo-50 px-3 py-1 text-sm font-medium text-indigo-700 ring-1 ring-inset ring-indigo-100\"><span class=\"size-1.5 rounded-full bg-indigo-600\"></span>NeoKit + Tailwind CSS</span>\n    <h1 class=\"mt-6 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl\">Build your next<br><span class=\"text-indigo-600\">idea.</span></h1>\n    <p class=\"mt-6 max-w-lg text-lg leading-8 text-slate-600\">A simple starting point for your next website. Server-rendered pages, responsive styles, and a little JavaScript where you need it.</p>\n    <div class=\"mt-8 flex flex-wrap items-center gap-4\"><a class=\"inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600\" href=\"#examples\">Explore the examples <span aria-hidden=\"true\">\xe2\x86\x92</span></a><a class=\"rounded-lg px-3 py-3 text-sm font-semibold text-slate-700 transition hover:text-indigo-600 focus-visible:outline-2 focus-visible:outline-indigo-600\" href=\"/notes/native\" data-web-link>Read the guide <span aria-hidden=\"true\">\xe2\x86\x97</span></a></div>\n    <p class=\"mt-6 text-xs font-medium tracking-wide text-slate-500\">",(if p_server then "<span class=\"inline-block size-1.5 rounded-full bg-emerald-500\"></span> LIVE SERVER RENDER" else "<span class=\"inline-block size-1.5 rounded-full bg-indigo-500\"></span> STATIC EXPORT"),"</p>\n  </div>\n  <div class=\"overflow-hidden rounded-xl border border-slate-200 bg-slate-950 shadow-lg\"><div class=\"flex items-center gap-2 border-b border-slate-800 px-5 py-4\"><span class=\"size-2.5 rounded-full bg-slate-600\"></span><span class=\"size-2.5 rounded-full bg-slate-600\"></span><span class=\"size-2.5 rounded-full bg-slate-600\"></span><span class=\"ml-3 font-mono text-xs text-slate-400\">app/page.view</span></div><pre class=\"overflow-x-auto p-6 font-mono text-sm leading-7 text-slate-300\"><code><span class=\"text-slate-500\">&lt;!-- Your next project starts here. --&gt;</span>\n&lt;<span class=\"text-sky-300\">h1</span> <span class=\"text-violet-300\">class</span>=<span class=\"text-emerald-300\">\"text-4xl font-bold\"</span>&gt;\n  Hello, Neo.\n&lt;/<span class=\"text-sky-300\">h1</span>&gt;</code></pre><div class=\"border-t border-slate-800 px-6 py-4 text-xs text-slate-400\">HTML templates. Tailwind utilities. Ready to make yours.</div></div>\n</section>\n<section class=\"border-y border-slate-200 bg-slate-50\" aria-labelledby=\"features-title\"><div class=\"mx-auto max-w-6xl px-6 py-14\"><h2 id=\"features-title\" class=\"text-2xl font-bold tracking-tight text-slate-900\">The essentials, ready to go.</h2><p class=\"mt-2 text-slate-600\">Everything in this starter is a working example.</p><div class=\"mt-8 grid gap-6 md:grid-cols-3\">\n  <article class=\"rounded-xl border border-slate-200 bg-white p-6 shadow-sm\"><span class=\"inline-flex size-10 items-center justify-center rounded-lg bg-indigo-50 font-mono text-lg font-bold text-indigo-600\" aria-hidden=\"true\">&lt;/&gt;</span><h3 class=\"mt-4 text-base font-semibold text-slate-900\">Server rendering</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">Send complete HTML on the first response. Keep your page data on the server.</p></article>\n  <article class=\"rounded-xl border border-slate-200 bg-white p-6 shadow-sm\"><span class=\"inline-flex size-10 items-center justify-center rounded-lg bg-indigo-50 text-xl font-semibold text-indigo-600\" aria-hidden=\"true\">\xe2\x86\x93</span><h3 class=\"mt-4 text-base font-semibold text-slate-900\">Static export</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">Build a folder of HTML, CSS, and JavaScript. Host it wherever you like.</p></article>\n  <article class=\"rounded-xl border border-slate-200 bg-white p-6 shadow-sm\"><span class=\"inline-flex size-10 items-center justify-center rounded-lg bg-indigo-50 text-xl font-semibold text-indigo-600\" aria-hidden=\"true\">+</span><h3 class=\"mt-4 text-base font-semibold text-slate-900\">Client interactivity</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">Add local state and small interactions with ordinary browser JavaScript.</p></article>\n</div></div></section>\n<section id=\"examples\" class=\"mx-auto max-w-6xl scroll-mt-6 px-6 py-16\" aria-labelledby=\"examples-title\"><h2 id=\"examples-title\" class=\"text-2xl font-bold tracking-tight text-slate-900\">Try it out.</h2><p class=\"mt-2 text-slate-600\">A client-side counter and a server-rendered greeting.</p><a class=\"mt-3 inline-block text-sm font-semibold text-indigo-600 hover:text-indigo-500\" href=\"/stress\" data-web-link>Stress-test 1,000 interactive rows \xe2\x86\x92</a><div class=\"mt-8 grid gap-6 md:grid-cols-2\">\n  <article class=\"rounded-xl border border-slate-200 p-6 shadow-sm\" data-web-widget=\"counter\"><span class=\"rounded-md bg-indigo-50 px-2 py-1 text-xs font-medium text-indigo-700\">Client side</span><h3 class=\"mt-4 text-lg font-semibold\">A simple counter</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">Click to update local state. No page reload needed.</p><output class=\"my-6 block text-5xl font-semibold tabular-nums text-slate-900\" data-count aria-live=\"polite\" aria-label=\"Counter value\">0</output><div class=\"flex items-center gap-3\"><button class=\"cursor-pointer rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600\" type=\"button\" data-increment>Add one +</button><button class=\"cursor-pointer rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600\" type=\"button\" data-reset>Reset</button></div></article>\n  <article class=\"rounded-xl border border-slate-200 p-6 shadow-sm\"><span class=\"rounded-md bg-emerald-50 px-2 py-1 text-xs font-medium text-emerald-700\">",(if p_server then "Server side" else "Static page"),"</span><h3 class=\"mt-4 text-lg font-semibold\">Say hello</h3>",(if p_server then concat("<p class=\"mt-2 text-sm leading-6 text-slate-600\">Send your name and get fresh HTML back from Neo.</p><form class=\"mt-5\" action=\"/greet\" method=\"get\" data-web-form data-web-target=\"#greeting-result\" data-web-pending=\"Asking the server\xe2\x80\xa6\" data-web-success=\"Fresh HTML, rendered by Neo.\" data-web-failure=\"Couldn't reach the server. Please try again.\"><label class=\"block text-sm font-medium text-slate-700\" for=\"visitor-name\">Your name</label><div class=\"mt-2 flex flex-col gap-3 sm:flex-row\"><input class=\"block w-full min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-indigo-500 focus:outline-2 focus:outline-indigo-500\" id=\"visitor-name\" name=\"name\" type=\"text\" maxlength=\"120\" placeholder=\"Jane Doe\" required><button class=\"cursor-pointer rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold whitespace-nowrap text-white shadow-sm transition hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600\" type=\"submit\" aria-label=\"Ask Neo to say hello\">Say hello</button></div><p class=\"mt-2 text-xs text-indigo-600\" data-web-status role=\"status\"></p></form><div id=\"greeting-result\" class=\"mt-5 rounded-lg bg-slate-50 p-4\" aria-live=\"polite\"><p class=\"text-lg font-medium text-slate-900\">Hello, ",html_escape(p_name),".</p><small class=\"mt-1 block text-xs text-slate-500\">Rendered on request \xc2\xb7 ",int_text(p_stamp),"</small></div>") else concat("<p class=\"mt-2 text-sm leading-6 text-slate-600\">This is the exported site. Local interactions work here; a live server is needed for the greeting form.</p><div class=\"mt-5 rounded-lg bg-slate-50 p-4\"><p class=\"text-lg font-medium text-slate-900\">Hello, ",html_escape(p_name),".</p><small class=\"mt-1 block text-xs text-slate-500\">Saved as HTML at build time.</small></div>")),"</article>\n</div></section>\n<section class=\"border-t border-slate-200 bg-slate-50\" data-web-widget=\"filter\"><div class=\"mx-auto max-w-6xl px-6 py-16\"><div class=\"flex flex-col justify-between gap-6 sm:flex-row sm:items-end\"><div><h2 class=\"text-2xl font-bold tracking-tight text-slate-900\">Keep building.</h2><p class=\"mt-2 text-slate-600\">Explore the guides included with your starter.</p></div><label class=\"block\"><span class=\"sr-only\">Filter guides</span><input class=\"block w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm shadow-sm placeholder:text-slate-400 focus:border-indigo-500 focus:outline-2 focus:outline-indigo-500 sm:w-60\" type=\"search\" data-search placeholder=\"Search guides\xe2\x80\xa6\" aria-label=\"Filter guides\"></label></div><div class=\"mt-8 grid gap-6 md:grid-cols-3\">\n  <a class=\"group rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-indigo-300 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600\" href=\"/notes/native\" data-web-link data-note=\"native server rendering neo\"><span class=\"text-xs font-medium text-indigo-600\">Rendering</span><h3 class=\"mt-3 font-semibold text-slate-900 group-hover:text-indigo-600\">Start with HTML <span aria-hidden=\"true\">\xe2\x86\x92</span></h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">Learn how request-time server rendering works.</p></a>\n  <a class=\"group rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-indigo-300 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600\" href=\"/notes/static\" data-web-link data-note=\"static export build deployment\"><span class=\"text-xs font-medium text-indigo-600\">Deployment</span><h3 class=\"mt-3 font-semibold text-slate-900 group-hover:text-indigo-600\">Export your site <span aria-hidden=\"true\">\xe2\x86\x92</span></h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">Turn your project into a folder of static files.</p></a>\n  <a class=\"group rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-indigo-300 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600\" href=\"/notes/islands\" data-web-link data-note=\"islands javascript browser interactivity\"><span class=\"text-xs font-medium text-indigo-600\">Interactivity</span><h3 class=\"mt-3 font-semibold text-slate-900 group-hover:text-indigo-600\">Add JavaScript <span aria-hidden=\"true\">\xe2\x86\x92</span></h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">Make parts of your page interactive.</p></a>\n</div><p class=\"mt-4 text-sm text-slate-500\" data-filter-status role=\"status\">3 guides available</p></div></section>\n")
fn view_Page_8a5edab282(p_title: Arr u8 _,p_name: Arr u8 _,p_stamp: i64,p_server: bool) -> WebHtml = web_html(text_Page_8a5edab282(p_title,p_name,p_stamp,p_server))

fn text_Page_979bddc4a8(p_title: Arr u8 _) -> Arr u8 _ = "<article class=\"mx-auto min-h-[70vh] max-w-4xl px-6 py-16 sm:py-20\"><a class=\"text-sm font-medium text-indigo-600 hover:text-indigo-500\" href=\"/\">\xe2\x86\x90 Back to home</a><span class=\"mt-10 block text-sm font-semibold text-indigo-600\">About the starter</span><h1 class=\"mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl\">A simple place to start.</h1><p class=\"mt-6 text-lg leading-8 text-slate-600\">This is a NeoKit starter styled with Tailwind CSS. Use it as the starting point for a site, dashboard, or small web application.</p><div class=\"mt-10 grid gap-6 sm:grid-cols-3\"><section class=\"rounded-xl border border-slate-200 p-5\"><h2 class=\"font-semibold\">Native server rendering</h2><p class=\"mt-3 text-sm leading-6 text-slate-600\">Templates compile to Neo functions. Pages arrive as complete HTML.</p></section><section class=\"rounded-xl border border-slate-200 p-5\"><h2 class=\"font-semibold\">Standard Tailwind</h2><p class=\"mt-3 text-sm leading-6 text-slate-600\">Default colors, spacing, typography utilities, and responsive breakpoints. Edit the classes to make it yours.</p></section><section class=\"rounded-xl border border-slate-200 p-5\"><h2 class=\"font-semibold\">Optional JavaScript</h2><p class=\"mt-3 text-sm leading-6 text-slate-600\">The counter and filter load small browser modules. This about page ships without JavaScript.</p></section></div><div class=\"mt-10 rounded-lg bg-slate-50 p-5 text-sm leading-6 text-slate-600\">NeoKit is an experimental framework with typed pages and actions, nested layouts, native data libraries, client navigation, and static export. Explore the feature and authenticated dashboard examples for the supported profiles.</div></article>\n"
fn view_Page_979bddc4a8(p_title: Arr u8 _) -> WebHtml = web_html(text_Page_979bddc4a8(p_title))

fn text_Page_7a9e867f6d(p_title: Arr u8 _,p_name: Arr u8 _,p_stamp: i64) -> Arr u8 _ = concat("<div class=\"rounded-lg bg-slate-50 p-4\"><p class=\"text-lg font-medium break-words text-slate-900\">Hello, ",html_escape(p_name),".</p><small class=\"mt-1 block text-xs text-slate-500\">Fresh HTML from the native server \xc2\xb7 <span data-server-stamp>",int_text(p_stamp),"</span></small><a class=\"mt-3 inline-block text-sm font-medium text-indigo-600 hover:text-indigo-500\" href=\"/\">\xe2\x86\x90 Back to home</a></div>\n")
fn view_Page_7a9e867f6d(p_title: Arr u8 _,p_name: Arr u8 _,p_stamp: i64) -> WebHtml = web_html(text_Page_7a9e867f6d(p_title,p_name,p_stamp))

fn text_Page_699ce509f3(p_title: Arr u8 _,p_count: i64,p_rows: WebHtml,p_data: WebHtml,p_full_url: WebURL,p_full: bool,p_server: bool,p_stamp: i64) -> Arr u8 _ = concat("<section class=\"mx-auto max-w-7xl px-6 py-10\" data-web-widget=\"list-stress\" data-ssr-stamp=\"",int_text(p_stamp),"\">\n",p_data.bytes,(if p_full then "<span hidden data-full-dom></span>" else ""),"\n<noscript><p>The first row window is shown. ",(if p_server then concat("<a href=\"",html_escape(p_full_url.value),"\">Render every record without JavaScript</a>.") else ""),"</p></noscript>\n<div class=\"flex flex-wrap items-start justify-between gap-4\"><div><span class=\"text-sm font-semibold text-indigo-600\">Interactive rendering test</span><h1 class=\"mt-2 text-3xl font-bold tracking-tight sm:text-4xl\">Large lists. Stable updates.</h1><p class=\"mt-3 max-w-3xl text-sm leading-6 text-slate-600\">",int_text(p_count)," logical rows are available. A bounded row window arrives as server-rendered HTML; the remaining values use inert page data. Type while updates run, then sort, shuffle, or filter.</p></div><a class=\"text-sm font-medium text-indigo-600 hover:text-indigo-500\" href=\"/\" data-web-link>\xe2\x86\x90 Home</a></div>\n<div class=\"mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4\">\n<div class=\"min-h-28 rounded-lg border border-slate-200 p-4\"><p class=\"text-xs font-medium text-slate-500\">Visible / total rows</p><p class=\"mt-2 text-xl font-semibold tabular-nums\" data-stress-count>",int_text(p_count)," / ",int_text(p_count),"</p></div>\n<div class=\"min-h-28 rounded-lg border border-slate-200 p-4\"><p class=\"text-xs font-medium text-slate-500\">Last / p95 steady keyed patch</p><p class=\"mt-2 text-xl font-semibold tabular-nums\" data-stress-time>Waiting for first update</p></div>\n<div class=\"min-h-28 rounded-lg border border-slate-200 p-4\"><p class=\"text-xs font-medium text-slate-500\">Blank frames / keyed focus losses</p><p class=\"mt-2 text-xl font-semibold tabular-nums\" data-stress-errors>0 / 0</p></div>\n<div class=\"min-h-28 rounded-lg border border-slate-200 p-4\"><p class=\"text-xs font-medium text-slate-500\">DOM nodes created / removed this update</p><p class=\"mt-2 text-xl font-semibold tabular-nums\" data-stress-churn>0 / 0</p></div>\n</div>\n<div class=\"mt-6 flex flex-wrap items-end gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4\">\n<label class=\"block text-xs font-medium text-slate-600\">Rows<select class=\"mt-1 block rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900\" data-stress-size aria-label=\"Row count\"><option value=\"100\">100</option><option value=\"1000\">1,000</option><option value=\"5000\">5,000 (heavy)</option><option value=\"10000\">10,000 (heavy)</option></select></label>\n<label class=\"block text-xs font-medium text-slate-600\">Renderer<select class=\"mt-1 block rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900\" data-stress-mode aria-label=\"Renderer\"><option value=\"keyed\">Windowed keyed updates</option><option value=\"replace\">Redraw visible window (comparison)</option></select></label>\n<button class=\"cursor-pointer rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500 disabled:opacity-50\" type=\"button\" data-stress-auto>Start live updates</button>\n<button class=\"cursor-pointer rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium hover:bg-slate-100\" type=\"button\" data-stress-update>Update every row</button>\n",(if p_server then "<button class=\"cursor-pointer rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium hover:bg-slate-100\" type=\"button\" data-stress-refresh>Refresh from Neo</button>" else ""),"\n<button class=\"cursor-pointer rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium hover:bg-slate-100\" type=\"button\" data-stress-shuffle>Shuffle</button>\n<button class=\"cursor-pointer rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium hover:bg-slate-100\" type=\"button\" data-stress-sort>Reverse order</button>\n<button class=\"cursor-pointer rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium hover:bg-slate-100\" type=\"button\" data-stress-add>Add 100</button>\n<button class=\"cursor-pointer rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium hover:bg-slate-100\" type=\"button\" data-stress-remove>Remove 100</button>\n<label class=\"block text-xs font-medium text-slate-600\">Filter<input class=\"mt-1 block w-48 rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900\" type=\"search\" placeholder=\"Item name or note\" data-stress-filter aria-label=\"Filter rows\"></label>\n</div>\n<p class=\"mt-3 min-h-12 text-sm leading-6 text-slate-600\" data-stress-status role=\"status\">Mounting the client controls; the first row window is server-rendered.</p>\n<p class=\"mt-2 text-sm text-slate-600\" data-stress-window></p><p hidden class=\"mt-2 rounded-lg bg-amber-50 p-3 text-sm text-amber-900\" data-stress-warning>Redraw deliberately replaces the visible rows. Focus loss and lost caret position are expected here. Switch back to stable keyed updates to compare.</p>\n<div class=\"mt-4 max-h-[520px] overflow-auto rounded-xl border border-slate-200 [overflow-anchor:none]\" data-stress-viewport><table class=\"w-full min-w-[900px] table-fixed border-collapse whitespace-nowrap text-left text-sm\"><colgroup><col class=\"w-20\"><col class=\"w-40\"><col class=\"w-24\"><col class=\"w-64\"><col class=\"w-28\"><col class=\"w-24\"></colgroup><thead class=\"sticky top-0 z-10 bg-slate-100 text-xs text-slate-600\"><tr><th class=\"px-4 py-3\">ID</th><th class=\"px-4 py-3\">Item</th><th class=\"px-4 py-3\">Value</th><th class=\"px-4 py-3\">Editable note</th><th class=\"px-4 py-3\">Selection</th><th class=\"px-4 py-3\">Counter</th></tr></thead><tbody data-stress-rows>",p_rows.bytes,"</tbody></table><p hidden class=\"p-8 text-center text-sm text-slate-500\" data-stress-empty>No matching rows.</p></div>\n<div class=\"mt-6 rounded-xl border border-slate-200 p-5\"><div class=\"flex flex-wrap items-center justify-between gap-4\"><div><h2 class=\"font-semibold\">Run the browser verification</h2><p class=\"mt-1 text-sm text-slate-600\">Checks node identity, input focus and caret, selection, sorting, filtering, and adding/removing rows on this actual DOM. The live site also checks a fresh Neo server render.</p></div><button class=\"cursor-pointer rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700 disabled:opacity-50\" type=\"button\" data-stress-verify>Run verification</button></div><output class=\"mt-4 block rounded-lg bg-slate-50 p-4 text-sm whitespace-pre-wrap text-slate-700\" data-testid=\"stress-check-report\">Not run yet.</output></div>\n<details class=\"mt-5 text-sm text-slate-600\"><summary class=\"cursor-pointer font-medium\">What this measures</summary><p class=\"mt-2 leading-6\">Windowing limits DOM work to visible rows plus overscan and a pinned focused row. Models retain notes, selection and counters outside the window. The live loop changes 10% of values every 100ms; Update every row changes all values. Focused rows keep their node and caret; offscreen rows are recreated from their models. Filtering intentionally removes nonmatching rows. The optional render=full query is an unvirtualized diagnostic reference and can stall. Blank-frame and focus checks do not prove the absence of every possible visual artifact; long-frame measurements provide an additional signal. Patch timings measure JavaScript DOM work, not browser layout and paint. The steady p95 excludes structural changes and the deliberately slow full-redraw comparison.</p><pre class=\"mt-3 overflow-auto rounded-lg bg-slate-50 p-4 text-xs\" data-testid=\"stress-metrics\">Waiting for client initialization.</pre></details>\n</section>\n")
fn view_Page_699ce509f3(p_title: Arr u8 _,p_count: i64,p_rows: WebHtml,p_data: WebHtml,p_full_url: WebURL,p_full: bool,p_server: bool,p_stamp: i64) -> WebHtml = web_html(text_Page_699ce509f3(p_title,p_count,p_rows,p_data,p_full_url,p_full,p_server,p_stamp))

fn text_Page_db23782daa(p_title: Arr u8 _,p_slug: Arr u8 _,p_summary: Arr u8 _) -> Arr u8 _ = concat("<article class=\"mx-auto min-h-[70vh] max-w-4xl px-6 py-16 sm:py-20\"><a class=\"text-sm font-medium text-indigo-600 hover:text-indigo-500\" href=\"/\" data-web-link>\xe2\x86\x90 Back to home</a><span class=\"mt-10 block text-sm font-semibold text-indigo-600\">Guide / ",html_escape(p_slug),"</span><h1 class=\"mt-3 text-4xl font-bold tracking-tight break-words text-slate-900 sm:text-5xl\">",html_escape(p_title),"</h1><p class=\"mt-6 text-lg leading-8 text-slate-600\">",html_escape(p_summary),"</p><p class=\"mt-6 text-sm leading-6 text-slate-500\">This page is rendered from a dynamic route. Its title and content come from a Neo loader.</p><section class=\"mt-10 rounded-xl border border-slate-200 bg-slate-50 p-6\" data-web-widget=\"counter\"><h2 class=\"font-semibold\">Try a client-side interaction</h2><p class=\"mt-2 text-sm text-slate-600\">The same counter works after navigating between pages.</p><div class=\"mt-6 flex flex-wrap items-center gap-4\"><output class=\"min-w-12 text-4xl font-semibold tabular-nums\" data-count aria-live=\"polite\" aria-label=\"Counter value\">0</output><button class=\"cursor-pointer rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600\" data-increment type=\"button\">Add one +</button><button class=\"cursor-pointer rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600\" data-reset type=\"button\">Reset</button></div></section></article>\n")
fn view_Page_db23782daa(p_title: Arr u8 _,p_slug: Arr u8 _,p_summary: Arr u8 _) -> WebHtml = web_html(text_Page_db23782daa(p_title,p_slug,p_summary))

fn text_Layout(p_title: Arr u8 _,p_content: WebHtml,p_client: bool,p_mode: Arr u8 _) -> Arr u8 _ = concat("<!doctype html>\n<html lang=\"en\" class=\"scroll-smooth motion-reduce:scroll-auto\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><meta name=\"description\" content=\"A simple NeoKit starter with Tailwind CSS, server-rendered pages, and interactive examples.\"><title>",html_escape(p_title)," \xc2\xb7 NeoKit</title><link rel=\"icon\" href=\"/mark.svg\" type=\"image/svg+xml\"><link rel=\"stylesheet\" href=\"/_web/site-5a0b4d2525b4.css\"></head>\n<body class=\"bg-white font-sans text-slate-900 antialiased\" data-render-mode=\"",html_escape(p_mode),"\">\n<a class=\"sr-only rounded-md bg-indigo-600 px-4 py-2 text-white focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50\" href=\"#web-page\">Skip to content</a>\n",view_Header().bytes,"\n<main id=\"web-page\" tabindex=\"-1\" class=\"focus:outline-none\">",p_content.bytes,"</main>\n<footer class=\"border-t border-slate-200 bg-white\"><div class=\"mx-auto flex max-w-6xl flex-col gap-4 px-6 py-8 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between\"><p>NeoKit starter \xc2\xb7 Built with Tailwind CSS</p><div class=\"flex flex-wrap items-center gap-5\"><span>Rendered with ",html_escape(p_mode),"</span><a class=\"font-medium text-slate-600 hover:text-indigo-600\" href=\"/about\" data-web-link>About this starter</a></div></div></footer>\n",(if p_client then "<script type=\"module\" src=\"/_web/client-nz5nzxch.js\"></script>" else ""),"\n</body></html>\n")
fn view_Layout(p_title: Arr u8 _,p_content: WebHtml,p_client: bool,p_mode: Arr u8 _) -> WebHtml = web_html(text_Layout(p_title,p_content,p_client,p_mode))
end code
expression Header "\"<header class=\\\"border-b border-slate-200 bg-white\\\">\\n  <div class=\\\"mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-5\\\">\\n    <a class=\\\"flex items-center gap-3 rounded-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-600\\\" href=\\\"/\\\" data-web-link aria-label=\\\"NeoKit home\\\"><span class=\\\"flex size-9 items-center justify-center rounded-lg bg-indigo-600 text-lg font-bold text-white\\\">N</span><span class=\\\"text-lg font-semibold tracking-tight text-slate-900\\\">NeoKit</span><span class=\\\"rounded-md bg-slate-100 px-2 py-1 text-xs font-medium text-slate-600\\\">Starter</span></a>\\n    <nav class=\\\"flex items-center gap-6 text-sm font-medium text-slate-600\\\" aria-label=\\\"Main navigation\\\"><a class=\\\"transition hover:text-indigo-600\\\" href=\\\"/\\\" data-web-link>Home</a><a class=\\\"transition hover:text-indigo-600\\\" href=\\\"/notes/native\\\" data-web-link data-web-match=\\\"/notes\\\">Guides</a><a class=\\\"transition hover:text-indigo-600\\\" href=\\\"/stress\\\" data-web-link>Stress test</a><a class=\\\"transition hover:text-indigo-600\\\" href=\\\"/about\\\" data-web-link>About</a></nav>\\n  </div>\\n</header>\\n\""
expression Page_8a5edab282 "concat(\"<section class=\\\"mx-auto grid max-w-6xl items-center gap-12 px-6 py-16 sm:py-24 lg:grid-cols-2 lg:gap-16\\\">\\n  <div>\\n    <span class=\\\"inline-flex items-center gap-2 rounded-full bg-indigo-50 px-3 py-1 text-sm font-medium text-indigo-700 ring-1 ring-inset ring-indigo-100\\\"><span class=\\\"size-1.5 rounded-full bg-indigo-600\\\"></span>NeoKit + Tailwind CSS</span>\\n    <h1 class=\\\"mt-6 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl\\\">Build your next<br><span class=\\\"text-indigo-600\\\">idea.</span></h1>\\n    <p class=\\\"mt-6 max-w-lg text-lg leading-8 text-slate-600\\\">A simple starting point for your next website. Server-rendered pages, responsive styles, and a little JavaScript where you need it.</p>\\n    <div class=\\\"mt-8 flex flex-wrap items-center gap-4\\\"><a class=\\\"inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600\\\" href=\\\"#examples\\\">Explore the examples <span aria-hidden=\\\"true\\\">\\xe2\\x86\\x92</span></a><a class=\\\"rounded-lg px-3 py-3 text-sm font-semibold text-slate-700 transition hover:text-indigo-600 focus-visible:outline-2 focus-visible:outline-indigo-600\\\" href=\\\"/notes/native\\\" data-web-link>Read the guide <span aria-hidden=\\\"true\\\">\\xe2\\x86\\x97</span></a></div>\\n    <p class=\\\"mt-6 text-xs font-medium tracking-wide text-slate-500\\\">\",(if p_server then \"<span class=\\\"inline-block size-1.5 rounded-full bg-emerald-500\\\"></span> LIVE SERVER RENDER\" else \"<span class=\\\"inline-block size-1.5 rounded-full bg-indigo-500\\\"></span> STATIC EXPORT\"),\"</p>\\n  </div>\\n  <div class=\\\"overflow-hidden rounded-xl border border-slate-200 bg-slate-950 shadow-lg\\\"><div class=\\\"flex items-center gap-2 border-b border-slate-800 px-5 py-4\\\"><span class=\\\"size-2.5 rounded-full bg-slate-600\\\"></span><span class=\\\"size-2.5 rounded-full bg-slate-600\\\"></span><span class=\\\"size-2.5 rounded-full bg-slate-600\\\"></span><span class=\\\"ml-3 font-mono text-xs text-slate-400\\\">app/page.view</span></div><pre class=\\\"overflow-x-auto p-6 font-mono text-sm leading-7 text-slate-300\\\"><code><span class=\\\"text-slate-500\\\">&lt;!-- Your next project starts here. --&gt;</span>\\n&lt;<span class=\\\"text-sky-300\\\">h1</span> <span class=\\\"text-violet-300\\\">class</span>=<span class=\\\"text-emerald-300\\\">\\\"text-4xl font-bold\\\"</span>&gt;\\n  Hello, Neo.\\n&lt;/<span class=\\\"text-sky-300\\\">h1</span>&gt;</code></pre><div class=\\\"border-t border-slate-800 px-6 py-4 text-xs text-slate-400\\\">HTML templates. Tailwind utilities. Ready to make yours.</div></div>\\n</section>\\n<section class=\\\"border-y border-slate-200 bg-slate-50\\\" aria-labelledby=\\\"features-title\\\"><div class=\\\"mx-auto max-w-6xl px-6 py-14\\\"><h2 id=\\\"features-title\\\" class=\\\"text-2xl font-bold tracking-tight text-slate-900\\\">The essentials, ready to go.</h2><p class=\\\"mt-2 text-slate-600\\\">Everything in this starter is a working example.</p><div class=\\\"mt-8 grid gap-6 md:grid-cols-3\\\">\\n  <article class=\\\"rounded-xl border border-slate-200 bg-white p-6 shadow-sm\\\"><span class=\\\"inline-flex size-10 items-center justify-center rounded-lg bg-indigo-50 font-mono text-lg font-bold text-indigo-600\\\" aria-hidden=\\\"true\\\">&lt;/&gt;</span><h3 class=\\\"mt-4 text-base font-semibold text-slate-900\\\">Server rendering</h3><p class=\\\"mt-2 text-sm leading-6 text-slate-600\\\">Send complete HTML on the first response. Keep your page data on the server.</p></article>\\n  <article class=\\\"rounded-xl border border-slate-200 bg-white p-6 shadow-sm\\\"><span class=\\\"inline-flex size-10 items-center justify-center rounded-lg bg-indigo-50 text-xl font-semibold text-indigo-600\\\" aria-hidden=\\\"true\\\">\\xe2\\x86\\x93</span><h3 class=\\\"mt-4 text-base font-semibold text-slate-900\\\">Static export</h3><p class=\\\"mt-2 text-sm leading-6 text-slate-600\\\">Build a folder of HTML, CSS, and JavaScript. Host it wherever you like.</p></article>\\n  <article class=\\\"rounded-xl border border-slate-200 bg-white p-6 shadow-sm\\\"><span class=\\\"inline-flex size-10 items-center justify-center rounded-lg bg-indigo-50 text-xl font-semibold text-indigo-600\\\" aria-hidden=\\\"true\\\">+</span><h3 class=\\\"mt-4 text-base font-semibold text-slate-900\\\">Client interactivity</h3><p class=\\\"mt-2 text-sm leading-6 text-slate-600\\\">Add local state and small interactions with ordinary browser JavaScript.</p></article>\\n</div></div></section>\\n<section id=\\\"examples\\\" class=\\\"mx-auto max-w-6xl scroll-mt-6 px-6 py-16\\\" aria-labelledby=\\\"examples-title\\\"><h2 id=\\\"examples-title\\\" class=\\\"text-2xl font-bold tracking-tight text-slate-900\\\">Try it out.</h2><p class=\\\"mt-2 text-slate-600\\\">A client-side counter and a server-rendered greeting.</p><a class=\\\"mt-3 inline-block text-sm font-semibold text-indigo-600 hover:text-indigo-500\\\" href=\\\"/stress\\\" data-web-link>Stress-test 1,000 interactive rows \\xe2\\x86\\x92</a><div class=\\\"mt-8 grid gap-6 md:grid-cols-2\\\">\\n  <article class=\\\"rounded-xl border border-slate-200 p-6 shadow-sm\\\" data-web-widget=\\\"counter\\\"><span class=\\\"rounded-md bg-indigo-50 px-2 py-1 text-xs font-medium text-indigo-700\\\">Client side</span><h3 class=\\\"mt-4 text-lg font-semibold\\\">A simple counter</h3><p class=\\\"mt-2 text-sm leading-6 text-slate-600\\\">Click to update local state. No page reload needed.</p><output class=\\\"my-6 block text-5xl font-semibold tabular-nums text-slate-900\\\" data-count aria-live=\\\"polite\\\" aria-label=\\\"Counter value\\\">0</output><div class=\\\"flex items-center gap-3\\\"><button class=\\\"cursor-pointer rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600\\\" type=\\\"button\\\" data-increment>Add one +</button><button class=\\\"cursor-pointer rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600\\\" type=\\\"button\\\" data-reset>Reset</button></div></article>\\n  <article class=\\\"rounded-xl border border-slate-200 p-6 shadow-sm\\\"><span class=\\\"rounded-md bg-emerald-50 px-2 py-1 text-xs font-medium text-emerald-700\\\">\",(if p_server then \"Server side\" else \"Static page\"),\"</span><h3 class=\\\"mt-4 text-lg font-semibold\\\">Say hello</h3>\",(if p_server then concat(\"<p class=\\\"mt-2 text-sm leading-6 text-slate-600\\\">Send your name and get fresh HTML back from Neo.</p><form class=\\\"mt-5\\\" action=\\\"/greet\\\" method=\\\"get\\\" data-web-form data-web-target=\\\"#greeting-result\\\" data-web-pending=\\\"Asking the server\\xe2\\x80\\xa6\\\" data-web-success=\\\"Fresh HTML, rendered by Neo.\\\" data-web-failure=\\\"Couldn't reach the server. Please try again.\\\"><label class=\\\"block text-sm font-medium text-slate-700\\\" for=\\\"visitor-name\\\">Your name</label><div class=\\\"mt-2 flex flex-col gap-3 sm:flex-row\\\"><input class=\\\"block w-full min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-indigo-500 focus:outline-2 focus:outline-indigo-500\\\" id=\\\"visitor-name\\\" name=\\\"name\\\" type=\\\"text\\\" maxlength=\\\"120\\\" placeholder=\\\"Jane Doe\\\" required><button class=\\\"cursor-pointer rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold whitespace-nowrap text-white shadow-sm transition hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600\\\" type=\\\"submit\\\" aria-label=\\\"Ask Neo to say hello\\\">Say hello</button></div><p class=\\\"mt-2 text-xs text-indigo-600\\\" data-web-status role=\\\"status\\\"></p></form><div id=\\\"greeting-result\\\" class=\\\"mt-5 rounded-lg bg-slate-50 p-4\\\" aria-live=\\\"polite\\\"><p class=\\\"text-lg font-medium text-slate-900\\\">Hello, \",html_escape(p_name),\".</p><small class=\\\"mt-1 block text-xs text-slate-500\\\">Rendered on request \\xc2\\xb7 \",int_text(p_stamp),\"</small></div>\") else concat(\"<p class=\\\"mt-2 text-sm leading-6 text-slate-600\\\">This is the exported site. Local interactions work here; a live server is needed for the greeting form.</p><div class=\\\"mt-5 rounded-lg bg-slate-50 p-4\\\"><p class=\\\"text-lg font-medium text-slate-900\\\">Hello, \",html_escape(p_name),\".</p><small class=\\\"mt-1 block text-xs text-slate-500\\\">Saved as HTML at build time.</small></div>\")),\"</article>\\n</div></section>\\n<section class=\\\"border-t border-slate-200 bg-slate-50\\\" data-web-widget=\\\"filter\\\"><div class=\\\"mx-auto max-w-6xl px-6 py-16\\\"><div class=\\\"flex flex-col justify-between gap-6 sm:flex-row sm:items-end\\\"><div><h2 class=\\\"text-2xl font-bold tracking-tight text-slate-900\\\">Keep building.</h2><p class=\\\"mt-2 text-slate-600\\\">Explore the guides included with your starter.</p></div><label class=\\\"block\\\"><span class=\\\"sr-only\\\">Filter guides</span><input class=\\\"block w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm shadow-sm placeholder:text-slate-400 focus:border-indigo-500 focus:outline-2 focus:outline-indigo-500 sm:w-60\\\" type=\\\"search\\\" data-search placeholder=\\\"Search guides\\xe2\\x80\\xa6\\\" aria-label=\\\"Filter guides\\\"></label></div><div class=\\\"mt-8 grid gap-6 md:grid-cols-3\\\">\\n  <a class=\\\"group rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-indigo-300 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600\\\" href=\\\"/notes/native\\\" data-web-link data-note=\\\"native server rendering neo\\\"><span class=\\\"text-xs font-medium text-indigo-600\\\">Rendering</span><h3 class=\\\"mt-3 font-semibold text-slate-900 group-hover:text-indigo-600\\\">Start with HTML <span aria-hidden=\\\"true\\\">\\xe2\\x86\\x92</span></h3><p class=\\\"mt-2 text-sm leading-6 text-slate-600\\\">Learn how request-time server rendering works.</p></a>\\n  <a class=\\\"group rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-indigo-300 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600\\\" href=\\\"/notes/static\\\" data-web-link data-note=\\\"static export build deployment\\\"><span class=\\\"text-xs font-medium text-indigo-600\\\">Deployment</span><h3 class=\\\"mt-3 font-semibold text-slate-900 group-hover:text-indigo-600\\\">Export your site <span aria-hidden=\\\"true\\\">\\xe2\\x86\\x92</span></h3><p class=\\\"mt-2 text-sm leading-6 text-slate-600\\\">Turn your project into a folder of static files.</p></a>\\n  <a class=\\\"group rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-indigo-300 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600\\\" href=\\\"/notes/islands\\\" data-web-link data-note=\\\"islands javascript browser interactivity\\\"><span class=\\\"text-xs font-medium text-indigo-600\\\">Interactivity</span><h3 class=\\\"mt-3 font-semibold text-slate-900 group-hover:text-indigo-600\\\">Add JavaScript <span aria-hidden=\\\"true\\\">\\xe2\\x86\\x92</span></h3><p class=\\\"mt-2 text-sm leading-6 text-slate-600\\\">Make parts of your page interactive.</p></a>\\n</div><p class=\\\"mt-4 text-sm text-slate-500\\\" data-filter-status role=\\\"status\\\">3 guides available</p></div></section>\\n\")"
expression Page_979bddc4a8 "\"<article class=\\\"mx-auto min-h-[70vh] max-w-4xl px-6 py-16 sm:py-20\\\"><a class=\\\"text-sm font-medium text-indigo-600 hover:text-indigo-500\\\" href=\\\"/\\\">\\xe2\\x86\\x90 Back to home</a><span class=\\\"mt-10 block text-sm font-semibold text-indigo-600\\\">About the starter</span><h1 class=\\\"mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl\\\">A simple place to start.</h1><p class=\\\"mt-6 text-lg leading-8 text-slate-600\\\">This is a NeoKit starter styled with Tailwind CSS. Use it as the starting point for a site, dashboard, or small web application.</p><div class=\\\"mt-10 grid gap-6 sm:grid-cols-3\\\"><section class=\\\"rounded-xl border border-slate-200 p-5\\\"><h2 class=\\\"font-semibold\\\">Native server rendering</h2><p class=\\\"mt-3 text-sm leading-6 text-slate-600\\\">Templates compile to Neo functions. Pages arrive as complete HTML.</p></section><section class=\\\"rounded-xl border border-slate-200 p-5\\\"><h2 class=\\\"font-semibold\\\">Standard Tailwind</h2><p class=\\\"mt-3 text-sm leading-6 text-slate-600\\\">Default colors, spacing, typography utilities, and responsive breakpoints. Edit the classes to make it yours.</p></section><section class=\\\"rounded-xl border border-slate-200 p-5\\\"><h2 class=\\\"font-semibold\\\">Optional JavaScript</h2><p class=\\\"mt-3 text-sm leading-6 text-slate-600\\\">The counter and filter load small browser modules. This about page ships without JavaScript.</p></section></div><div class=\\\"mt-10 rounded-lg bg-slate-50 p-5 text-sm leading-6 text-slate-600\\\">NeoKit is an experimental framework with typed pages and actions, nested layouts, native data libraries, client navigation, and static export. Explore the feature and authenticated dashboard examples for the supported profiles.</div></article>\\n\""
expression Page_7a9e867f6d "concat(\"<div class=\\\"rounded-lg bg-slate-50 p-4\\\"><p class=\\\"text-lg font-medium break-words text-slate-900\\\">Hello, \",html_escape(p_name),\".</p><small class=\\\"mt-1 block text-xs text-slate-500\\\">Fresh HTML from the native server \\xc2\\xb7 <span data-server-stamp>\",int_text(p_stamp),\"</span></small><a class=\\\"mt-3 inline-block text-sm font-medium text-indigo-600 hover:text-indigo-500\\\" href=\\\"/\\\">\\xe2\\x86\\x90 Back to home</a></div>\\n\")"
expression Page_699ce509f3 "concat(\"<section class=\\\"mx-auto max-w-7xl px-6 py-10\\\" data-web-widget=\\\"list-stress\\\" data-ssr-stamp=\\\"\",int_text(p_stamp),\"\\\">\\n\",p_data.bytes,(if p_full then \"<span hidden data-full-dom></span>\" else \"\"),\"\\n<noscript><p>The first row window is shown. \",(if p_server then concat(\"<a href=\\\"\",html_escape(p_full_url.value),\"\\\">Render every record without JavaScript</a>.\") else \"\"),\"</p></noscript>\\n<div class=\\\"flex flex-wrap items-start justify-between gap-4\\\"><div><span class=\\\"text-sm font-semibold text-indigo-600\\\">Interactive rendering test</span><h1 class=\\\"mt-2 text-3xl font-bold tracking-tight sm:text-4xl\\\">Large lists. Stable updates.</h1><p class=\\\"mt-3 max-w-3xl text-sm leading-6 text-slate-600\\\">\",int_text(p_count),\" logical rows are available. A bounded row window arrives as server-rendered HTML; the remaining values use inert page data. Type while updates run, then sort, shuffle, or filter.</p></div><a class=\\\"text-sm font-medium text-indigo-600 hover:text-indigo-500\\\" href=\\\"/\\\" data-web-link>\\xe2\\x86\\x90 Home</a></div>\\n<div class=\\\"mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4\\\">\\n<div class=\\\"min-h-28 rounded-lg border border-slate-200 p-4\\\"><p class=\\\"text-xs font-medium text-slate-500\\\">Visible / total rows</p><p class=\\\"mt-2 text-xl font-semibold tabular-nums\\\" data-stress-count>\",int_text(p_count),\" / \",int_text(p_count),\"</p></div>\\n<div class=\\\"min-h-28 rounded-lg border border-slate-200 p-4\\\"><p class=\\\"text-xs font-medium text-slate-500\\\">Last / p95 steady keyed patch</p><p class=\\\"mt-2 text-xl font-semibold tabular-nums\\\" data-stress-time>Waiting for first update</p></div>\\n<div class=\\\"min-h-28 rounded-lg border border-slate-200 p-4\\\"><p class=\\\"text-xs font-medium text-slate-500\\\">Blank frames / keyed focus losses</p><p class=\\\"mt-2 text-xl font-semibold tabular-nums\\\" data-stress-errors>0 / 0</p></div>\\n<div class=\\\"min-h-28 rounded-lg border border-slate-200 p-4\\\"><p class=\\\"text-xs font-medium text-slate-500\\\">DOM nodes created / removed this update</p><p class=\\\"mt-2 text-xl font-semibold tabular-nums\\\" data-stress-churn>0 / 0</p></div>\\n</div>\\n<div class=\\\"mt-6 flex flex-wrap items-end gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4\\\">\\n<label class=\\\"block text-xs font-medium text-slate-600\\\">Rows<select class=\\\"mt-1 block rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900\\\" data-stress-size aria-label=\\\"Row count\\\"><option value=\\\"100\\\">100</option><option value=\\\"1000\\\">1,000</option><option value=\\\"5000\\\">5,000 (heavy)</option><option value=\\\"10000\\\">10,000 (heavy)</option></select></label>\\n<label class=\\\"block text-xs font-medium text-slate-600\\\">Renderer<select class=\\\"mt-1 block rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900\\\" data-stress-mode aria-label=\\\"Renderer\\\"><option value=\\\"keyed\\\">Windowed keyed updates</option><option value=\\\"replace\\\">Redraw visible window (comparison)</option></select></label>\\n<button class=\\\"cursor-pointer rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500 disabled:opacity-50\\\" type=\\\"button\\\" data-stress-auto>Start live updates</button>\\n<button class=\\\"cursor-pointer rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium hover:bg-slate-100\\\" type=\\\"button\\\" data-stress-update>Update every row</button>\\n\",(if p_server then \"<button class=\\\"cursor-pointer rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium hover:bg-slate-100\\\" type=\\\"button\\\" data-stress-refresh>Refresh from Neo</button>\" else \"\"),\"\\n<button class=\\\"cursor-pointer rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium hover:bg-slate-100\\\" type=\\\"button\\\" data-stress-shuffle>Shuffle</button>\\n<button class=\\\"cursor-pointer rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium hover:bg-slate-100\\\" type=\\\"button\\\" data-stress-sort>Reverse order</button>\\n<button class=\\\"cursor-pointer rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium hover:bg-slate-100\\\" type=\\\"button\\\" data-stress-add>Add 100</button>\\n<button class=\\\"cursor-pointer rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium hover:bg-slate-100\\\" type=\\\"button\\\" data-stress-remove>Remove 100</button>\\n<label class=\\\"block text-xs font-medium text-slate-600\\\">Filter<input class=\\\"mt-1 block w-48 rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900\\\" type=\\\"search\\\" placeholder=\\\"Item name or note\\\" data-stress-filter aria-label=\\\"Filter rows\\\"></label>\\n</div>\\n<p class=\\\"mt-3 min-h-12 text-sm leading-6 text-slate-600\\\" data-stress-status role=\\\"status\\\">Mounting the client controls; the first row window is server-rendered.</p>\\n<p class=\\\"mt-2 text-sm text-slate-600\\\" data-stress-window></p><p hidden class=\\\"mt-2 rounded-lg bg-amber-50 p-3 text-sm text-amber-900\\\" data-stress-warning>Redraw deliberately replaces the visible rows. Focus loss and lost caret position are expected here. Switch back to stable keyed updates to compare.</p>\\n<div class=\\\"mt-4 max-h-[520px] overflow-auto rounded-xl border border-slate-200 [overflow-anchor:none]\\\" data-stress-viewport><table class=\\\"w-full min-w-[900px] table-fixed border-collapse whitespace-nowrap text-left text-sm\\\"><colgroup><col class=\\\"w-20\\\"><col class=\\\"w-40\\\"><col class=\\\"w-24\\\"><col class=\\\"w-64\\\"><col class=\\\"w-28\\\"><col class=\\\"w-24\\\"></colgroup><thead class=\\\"sticky top-0 z-10 bg-slate-100 text-xs text-slate-600\\\"><tr><th class=\\\"px-4 py-3\\\">ID</th><th class=\\\"px-4 py-3\\\">Item</th><th class=\\\"px-4 py-3\\\">Value</th><th class=\\\"px-4 py-3\\\">Editable note</th><th class=\\\"px-4 py-3\\\">Selection</th><th class=\\\"px-4 py-3\\\">Counter</th></tr></thead><tbody data-stress-rows>\",p_rows.bytes,\"</tbody></table><p hidden class=\\\"p-8 text-center text-sm text-slate-500\\\" data-stress-empty>No matching rows.</p></div>\\n<div class=\\\"mt-6 rounded-xl border border-slate-200 p-5\\\"><div class=\\\"flex flex-wrap items-center justify-between gap-4\\\"><div><h2 class=\\\"font-semibold\\\">Run the browser verification</h2><p class=\\\"mt-1 text-sm text-slate-600\\\">Checks node identity, input focus and caret, selection, sorting, filtering, and adding/removing rows on this actual DOM. The live site also checks a fresh Neo server render.</p></div><button class=\\\"cursor-pointer rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700 disabled:opacity-50\\\" type=\\\"button\\\" data-stress-verify>Run verification</button></div><output class=\\\"mt-4 block rounded-lg bg-slate-50 p-4 text-sm whitespace-pre-wrap text-slate-700\\\" data-testid=\\\"stress-check-report\\\">Not run yet.</output></div>\\n<details class=\\\"mt-5 text-sm text-slate-600\\\"><summary class=\\\"cursor-pointer font-medium\\\">What this measures</summary><p class=\\\"mt-2 leading-6\\\">Windowing limits DOM work to visible rows plus overscan and a pinned focused row. Models retain notes, selection and counters outside the window. The live loop changes 10% of values every 100ms; Update every row changes all values. Focused rows keep their node and caret; offscreen rows are recreated from their models. Filtering intentionally removes nonmatching rows. The optional render=full query is an unvirtualized diagnostic reference and can stall. Blank-frame and focus checks do not prove the absence of every possible visual artifact; long-frame measurements provide an additional signal. Patch timings measure JavaScript DOM work, not browser layout and paint. The steady p95 excludes structural changes and the deliberately slow full-redraw comparison.</p><pre class=\\\"mt-3 overflow-auto rounded-lg bg-slate-50 p-4 text-xs\\\" data-testid=\\\"stress-metrics\\\">Waiting for client initialization.</pre></details>\\n</section>\\n\")"
expression Page_db23782daa "concat(\"<article class=\\\"mx-auto min-h-[70vh] max-w-4xl px-6 py-16 sm:py-20\\\"><a class=\\\"text-sm font-medium text-indigo-600 hover:text-indigo-500\\\" href=\\\"/\\\" data-web-link>\\xe2\\x86\\x90 Back to home</a><span class=\\\"mt-10 block text-sm font-semibold text-indigo-600\\\">Guide / \",html_escape(p_slug),\"</span><h1 class=\\\"mt-3 text-4xl font-bold tracking-tight break-words text-slate-900 sm:text-5xl\\\">\",html_escape(p_title),\"</h1><p class=\\\"mt-6 text-lg leading-8 text-slate-600\\\">\",html_escape(p_summary),\"</p><p class=\\\"mt-6 text-sm leading-6 text-slate-500\\\">This page is rendered from a dynamic route. Its title and content come from a Neo loader.</p><section class=\\\"mt-10 rounded-xl border border-slate-200 bg-slate-50 p-6\\\" data-web-widget=\\\"counter\\\"><h2 class=\\\"font-semibold\\\">Try a client-side interaction</h2><p class=\\\"mt-2 text-sm text-slate-600\\\">The same counter works after navigating between pages.</p><div class=\\\"mt-6 flex flex-wrap items-center gap-4\\\"><output class=\\\"min-w-12 text-4xl font-semibold tabular-nums\\\" data-count aria-live=\\\"polite\\\" aria-label=\\\"Counter value\\\">0</output><button class=\\\"cursor-pointer rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600\\\" data-increment type=\\\"button\\\">Add one +</button><button class=\\\"cursor-pointer rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600\\\" data-reset type=\\\"button\\\">Reset</button></div></section></article>\\n\")"
