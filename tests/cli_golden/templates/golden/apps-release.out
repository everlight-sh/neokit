fn text_Page_9adef84dae(p_title: Arr u8 _,p_events: Arr WebHtml _) -> Arr u8 _ = concat("<section class=\"page-heading\"><div><span class=\"eyebrow\">THE LITTLE THINGS ADD UP</span><h1>Activity</h1><p>A clear view of the moments moving your business forward.</p></div><a class=\"button secondary\" href=\"/customers\">Explore customers \xe2\x86\x97</a></section><section class=\"panel activity-panel\"><header class=\"panel-heading\"><div><h2>Recent activity</h2><p>Synthetic events from the demo workspace</p></div><span class=\"demo-pill\">18 events</span></header><div class=\"activity-list\">",text_Page_9adef84dae_loop_0(p_title,p_events,0,len(p_events)),"</div></section>\n")
