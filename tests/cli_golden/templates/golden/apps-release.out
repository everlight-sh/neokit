props title:text subject:text csrf:text rows:html[] failed:bool
body "<h1>{{ title }}</h1><p>Signed in as {{ subject }}</p>{% if failed %}<p role=\"alert\">The database could not be read. Try again.</p>{% endif %}<form method=\"post\" action=\"/actions/tasks\" data-web-form><input type=\"hidden\" name=\"_csrf\" value=\"{{ csrf }}\"><input type=\"hidden\" name=\"operation\" value=\"add\"><label>New task<input name=\"title\" minlength=\"1\" maxlength=\"200\" required></label><button>Add task</button><output data-web-status role=\"status\"></output></form><ul data-task-list>{% for row in rows %}{{ row }}{% endfor %}</ul><form method=\"post\" action=\"/logout\"><input type=\"hidden\" name=\"_csrf\" value=\"{{ csrf }}\"><button>Sign out</button></form>\n"
