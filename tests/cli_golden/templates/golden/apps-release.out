=== blog release
parse 0 Page_979bddc4a8 examples/blog/app/about/page.view
props title:text
body "<article class=\"about article-body\"><span class=\"eyebrow\">ABOUT FIELDNOTES</span><h1>A place for<br><em>good ideas.</em></h1><p class=\"article-deck\">We are a small, fictional editorial team with a simple belief: the useful ideas are often hiding in ordinary things.</p><section><h2>Take a closer look</h2><p>A well-made tool. A clear explanation. A quiet moment that changes how you see the rest of the day. Fieldnotes collects perspectives on design, engineering, and the everyday.</p></section><section id=\"stay-curious\"><h2>Stay curious</h2><p>Start with a story, follow a question, and see where it takes you. There is no sign-up wall here.</p><a class=\"text-link\" href=\"/\">Explore the journal \xe2\x86\x97</a></section><aside class=\"article-note\">This is a native NeoKit example with searchable SSR pages, dynamic article routes, optional browser enhancement, and static export. Edit posts.neo to publish your own stories.</aside></article>\n"
parse 1 Page_385d927531 examples/blog/app/journal/[slug]/page.view
props title:text category:text minutes:text date:text author:text initials:text excerpt:text cover:url body:html related:html[]
body "<article class=\"article\"><header class=\"article-head\"><a class=\"back\" href=\"/\">\xe2\x86\x90 Back to the journal</a><div class=\"story-meta\"><span>{{ category }}</span><span>{{ minutes }}</span></div><h1>{{ title }}</h1><p class=\"article-deck\">{{ excerpt }}</p><div class=\"story-author\"><span class=\"avatar\">{{ initials }}</span><span>{{ author }}<small>{{ date }}</small></span></div></header><img class=\"article-cover\" src=\"{{ cover }}\" alt=\"Editorial illustration for this story\" width=\"800\" height=\"520\"><div class=\"article-body\">{{ body }}<aside class=\"article-note\">Fieldnotes is a fictional publication and a working NeoKit example. Every story arrives as a complete server-rendered document.</aside></div></article><section class=\"stories wrap\"><div class=\"stories-toolbar\"><h2>A little more to explore</h2><a href=\"/\">All stories \xe2\x86\x97</a></div><div class=\"story-grid related\">{% for card in related %}{{ card }}{% endfor %}</div></section>\n"
parse 2 Page_8a5edab282 examples/blog/app/page.view
props title:text server:bool query:text category:text cards:html[] featured:bool empty:bool
body "<section class=\"journal-intro wrap\"><span class=\"eyebrow\">AN INDEPENDENT JOURNAL</span><h1>Ideas worth<br><em>slowing down for.</em></h1><p>Thoughts on design, engineering, and the everyday.<br>A fresh perspective, a few times a month.</p></section>\n{% if featured %}<section class=\"featured wrap\"><a class=\"featured-art\" href=\"/journal/a-smaller-web\"><img src=\"/cover-0.svg\" alt=\"Abstract illustration of a sun and a small doorway in a terracotta landscape\" width=\"800\" height=\"520\"></a><div class=\"featured-copy\"><div class=\"story-meta\"><span>FEATURED STORY</span><span>Engineering \xc2\xb7 7 min read</span></div><h2><a href=\"/journal/a-smaller-web\">Make room for<br>a smaller web.</a></h2><p>The best thing we can send to a browser is often a little less. On building useful experiences with fewer moving parts.</p><div class=\"story-author\"><span class=\"avatar\">MC</span><span>Maya Chen<small>November 8, 2026</small></span><a href=\"/journal/a-smaller-web\" aria-label=\"Read Make room for a smaller web\">\xe2\x86\x97</a></div></div></section>{% endif %}\n<section class=\"stories wrap\" id=\"stories\"><div class=\"stories-toolbar\"><h2>Fresh perspectives</h2>{% if server %}<form action=\"/\" method=\"get\" role=\"search\"><label class=\"sr-only\" for=\"story-search\">Search stories</label><input id=\"story-search\" name=\"q\" value=\"{{ query }}\" placeholder=\"Search stories\xe2\x80\xa6\" maxlength=\"120\"><input type=\"hidden\" name=\"category\" value=\"{{ category }}\"><button type=\"submit\" aria-label=\"Search\">\xe2\x86\x97</button></form>{% endif %}</div>{% if server %}<nav class=\"categories\" aria-label=\"Story categories\"><a href=\"/\">All stories</a><a href=\"/?category=design#stories\">Design</a><a href=\"/?category=engineering#stories\">Engineering</a><a href=\"/?category=notes#stories\">Notes & observations</a></nav>{% endif %}{% if empty %}<div class=\"empty\"><h3>No stories found.</h3><p>Try another phrase, or explore the full journal.</p><a href=\"/\">See all stories \xe2\x86\x97</a></div>{% endif %}<div class=\"story-grid\">{% for card in cards %}{{ card }}{% endfor %}</div></section>\n"
parse 3 Layout examples/blog/app/layout.view
props title:text content:html client:bool mode:text
body "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>{{ title }} \xc2\xb7 Fieldnotes</title><meta name=\"description\" content=\"An independent journal on design, engineering, and the everyday.\"><link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\"><link rel=\"stylesheet\" href=\"@asset(site.css)\"></head><body data-render-mode=\"{{ mode }}\"><a class=\"skip\" href=\"#web-page\">Skip to content</a><progress class=\"reading-progress\" max=\"1\" value=\"0\" aria-label=\"Reading progress\"></progress><header class=\"masthead wrap\"><a href=\"/\" class=\"wordmark\">fieldnotes<span>\xe2\x9c\xb3</span></a><nav aria-label=\"Main navigation\"><a href=\"/\">The journal</a><a href=\"/about\">About us</a><a class=\"nav-button\" href=\"/about#stay-curious\">Stay curious \xe2\x86\x97</a></nav></header><main id=\"web-page\" tabindex=\"-1\">{{ content }}</main><footer class=\"footer wrap\"><div><a class=\"wordmark\" href=\"/\">fieldnotes<span>\xe2\x9c\xb3</span></a><p>A little perspective goes a long way.</p></div><div class=\"footer-right\"><span>Made with care. Rendered with NeoKit.</span><span class=\"speed\" data-performance><i></i><output>Server-rendered HTML</output></span></div></footer>{% if client %}<script type=\"module\" src=\"@asset(client.js)\"></script>{% endif %}</body></html>\n"
compile_all
