effect fn Action_0123456789ab(request:WebRequest) -> WebResponse = let input=web_input(request) in if !input.ok then web_status(web_json("{\"error\":\"Invalid request body\"}"),400) else let field_title=web_input_text(input,"title",1,50,true) in let field_count=web_input_int(input,"count",0,100,true) in let field_enabled=web_input_bool(input,"enabled",true) in if !(field_title.ok && field_count.ok && field_enabled.ok) then web_status(web_json("{\"error\":\"Invalid action fields\"}"),422) else feature_typed(request,TypedInput {title=field_title.value,count=field_count.value,enabled=field_enabled.value})
