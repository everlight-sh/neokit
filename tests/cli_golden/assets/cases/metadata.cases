events	html[]
#--- examples/saas/app/customers/page.toml
[site]
name="Meridian Analytics"
description="A native NeoKit SaaS dashboard with server-rendered charts and a searchable customer dataset."
[server]
timing=true
startup="saas_start"
#-- page
loader="saas_customers"
mode="ssr"
client=true
#-- props
title	text
server	bool
records	int
total	text
query	text
all	bool
growth	bool
pro	bool
enterprise	bool
large	bool
rows	html[]
found	text
page	int
pages	int
has_previous	bool
has_next	bool
previous	url
next_url	url
csv	url
empty	bool
range_label	text
#--- examples/saas/app/page.toml
[site]
name="Meridian Analytics"
description="A native NeoKit SaaS dashboard with server-rendered charts and a searchable customer dataset."
[server]
timing=true
startup="saas_start"
#-- page
loader="saas_overview"
mode="ssr"
client=true
#-- props
title	text
server	bool
records	int
record_count	text
range	int
week	bool
month	bool
quarter	bool
large	bool
revenue	text
change	text
mrr	text
active	text
trials	text
total	text
caption	text
chart	html
sources	html
customers	html[]
csv	url
customers_url	url
