#--- examples/blog/app/about/page.toml
[site]
name="Fieldnotes"
description="Independent thoughts on design, engineering, and the everyday."
[server]
timing=true
before="journal_guard"
#-- page
loader="journal_about"
client=true
#-- props
title	text
#--- examples/blog/app/journal/[slug]/page.toml
[site]
name="Fieldnotes"
description="Independent thoughts on design, engineering, and the everyday."
[server]
timing=true
before="journal_guard"
#-- page
loader="journal_article"
mode="ssr"
client=true
paths=["/journal/a-smaller-web","/journal/slower-mornings","/journal/quiet-interfaces"]
#-- props
title	text
category	text
minutes	text
date	text
author	text
initials	text
excerpt	text
cover	url
body	html
related	html[]
#--- examples/blog/app/page.toml
[site]
name="Fieldnotes"
description="Independent thoughts on design, engineering, and the everyday."
[server]
timing=true
before="journal_guard"
#-- page
loader="journal_home"
mode="ssr"
client=true
#-- props
title	text
server	bool
query	text
category	text
cards	html[]
featured	bool
empty	bool
#--- examples/dashboard/app/dashboard/page.toml
[site]
name="NeoKit Tasks"
[server]
before="dashboard_before"
after="dashboard_after"
#-- page
loader="dashboard_load"
export=false
client=true
#-- props
title	text
subject	text
csrf	text
rows	html[]
failed	bool
#--- examples/dashboard/app/page.toml
[site]
name="NeoKit Tasks"
[server]
before="dashboard_before"
after="dashboard_after"
#-- page
loader="landing_load"
#-- props
title	text
#--- examples/features/app/async-page/page.toml
[site]
name="NeoKit feature verification"
url="https://features.test"
description="Typed routes & native pages"
#-- page
loader="feature_async_page"
async=true
async_timeout_ms=2000
export=false
#-- props
title	text
body	text
#--- examples/features/app/cached/page.toml
[site]
name="NeoKit feature verification"
url="https://features.test"
description="Typed routes & native pages"
#-- page
loader="feature_cached"
cache_ttl=1
stale_ttl=10
cache_tag="features"
#-- props
title	text
stamp	int
#--- examples/features/app/docs/[[...slug]]/page.toml
[site]
name="NeoKit feature verification"
url="https://features.test"
description="Typed routes & native pages"
#-- page
loader="feature_docs"
paths=["/docs","/docs/a/b"]
#-- props
title	text
slug	text
#--- examples/features/app/org/[org]/items/[id]/page.toml
[site]
name="NeoKit feature verification"
url="https://features.test"
description="Typed routes & native pages"
#-- page
loader="feature_item"
paths=["/org/acme/items/42"]
#-- props
title	text
org	text
id	text
#--- examples/features/app/page.toml
[site]
name="NeoKit feature verification"
url="https://features.test"
description="Typed routes & native pages"
#-- page
loader="features_load"
#-- props
title	text
items	text[]
numbers	int[]
link	url
#--- examples/saas/app/activity/page.toml
[site]
name="Meridian Analytics"
description="A native NeoKit SaaS dashboard with server-rendered charts and a searchable customer dataset."
[server]
timing=true
startup="saas_start"
#-- page
loader="saas_activity"
mode="ssr"
client=true
#-- props
