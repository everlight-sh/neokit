; Unit tests for cli/release.neo's pure parts. The expected digests are
; Python 3.12's: hashlib.sha256 of tarfile.TarInfo.tobuf(USTAR_FORMAT) for
; the same fields, of the bytes tarfile.open(mode='w', format=USTAR_FORMAT)
; writes, and json.dumps(..., indent=2). The effectful parts (assemble,
; bundle, unpack_neo) are in tests/cli_golden/release/.
import "std:option"
import "std:result"
import "std:deflate"
import "../cli/release.neo"

fn same(actual:Arr u8 _, expected:Arr u8 _) -> bool = text_equal(actual,expected)
fn header_sha(borrow name:Arr u8 _, size:i64, mode:i64, mtime:i64) -> Arr u8 _
  = match rel_tar_header(name,size,mode,mtime) { Ok(block) => if len(block)==512 then host_sha256_hex(block) else "wrong size", Err(message) => concat("error: ",message) }
fn long_name() -> Arr u8 _ = concat("neokit-1.0.0/framework/",text_repeat("d",90),"/file.neo")
fn two_members() -> Arr u8 _
  = let first=match rel_tar_append(text_empty(),"neokit-1.0.0/README.md","hello",420,1700000000) { Ok(out) => out, Err(message) => text_empty() } in
    let second=match rel_tar_append(first,long_name(),text_repeat("z",600),493,1700000000) { Ok(out) => out, Err(message) => text_empty() } in
    rel_tar_finish(second)
fn entries_of(borrow tar:Arr u8 _) -> Arr RelTarEntry _
  = match rel_tar_entries(tar) { Ok(found) => found, Err(message) => arr(i in 0..0) RelTarEntry { name=message, kind=0, mode=0, size=0, offset=0 } }
fn at(borrow entries:Arr RelTarEntry _, i:i64) -> RelTarEntry = if i>=0 && i<len(entries) then entries[i] else RelTarEntry { name="missing", kind=0, mode=0, size=0, offset=0 }
fn damaged(borrow tar:Arr u8 _) -> Arr u8 _ = if len(tar)>3 then set(tar,3,u8(88)) else tar
fn entries_error(borrow tar:Arr u8 _) -> Arr u8 _ = match rel_tar_entries(tar) { Ok(found) => "ok", Err(message) => message }
fn file(borrow path:Arr u8 _, borrow digest:Arr u8 _) -> RelFile = RelFile { path=path, digest=digest }
fn files3(a:RelFile, b:RelFile, c:RelFile) -> Arr RelFile _ = push(push(push(arr(i in 0..0) file("",""),a),b),c)
fn epoch(borrow value:Arr u8 _) -> Arr u8 _
  = match rel_source_date_epoch(push(push(text_words(),"PATH=/bin"),concat("SOURCE_DATE_EPOCH=",value))) { Ok(found) => text_int(found), Err(message) => message }
fn parsed(borrow text:Arr u8 _) -> Arr u8 _ = let r=text_parse_int(text) in if r.ok then text_int(r.value) else text_int_error(text)
fn below(borrow name:Arr u8 _) -> Arr u8 _ = let m=rel_member(name) in if m.ok then concat("ok ",m.below) else "refused"

fn test_constants() -> bool
  = same(rel_neo_version(),"0.2.6") && same(text_join(rel_neo_binaries(),","),"darwin-arm64,linux-arm64,linux-x86_64")
    && same(text_join(rel_framework_files()," "),"neokit web neo.toml neo.lock package.json bun.lock Dockerfile .dockerignore README.md AGENTS.md LICENSE SECURITY.md CHANGELOG.md")
    && same(text_join(rel_source_dirs()," "),"cli client src examples docs deploy tools tests")
    && text_member(rel_source_suffixes(),".ts") && text_member(rel_source_suffixes(),".py") && len(rel_source_suffixes())==17

fn test_headers_match_tarfile() -> bool
  = same(header_sha("neokit-1.0.0/README.md",5,420,1700000000),"e9d8bfc38fdc116dbe43f06cafd267c4e69d7f4b53331d32943f3ec7a86fa25d")
    && same(header_sha(long_name(),0,493,0),"b95c44fb4e1abb5a2d35141301ff5658be817b081444ffefb37d0ee2b8a60e43")
    && same(header_sha(text_repeat("a",100),8589934591,420,4294967295),"4cc6be0dd131768441883bf5358328079eb32a411eac048faf930f602a41a709")
    && same(header_sha(concat(text_repeat("p",155),"/",text_repeat("n",100)),1,420,0),"8fdea7fc0982ac0f66c5d345752402ca16e79e422ab1108d7ecd62b03ece0bda")
    && same(header_sha("neokit/\xc3\xa9t\xc3\xa9",3,33261,1),"30a02f561f2889b91ec8284ff99c4e12a998eb8738a762dbb5463448715fb167")

fn test_header_errors_match_tarfile() -> bool
  = same(header_sha(text_repeat("a",101),1,420,0),"error: name is too long")
    && same(header_sha(concat(text_repeat("p",156),"/x"),1,420,0),"error: name is too long")
    && same(header_sha(concat(text_repeat("p",155),"/",text_repeat("n",101)),1,420,0),"error: name is too long")
    && same(header_sha("x",8589934592,420,0),"error: overflow in number field")

fn test_split_is_posix_split_name() -> bool
  = match rel_tar_split(long_name()) {
      Err(message) => false,
      Ok(split) => same(split.prefix,"neokit-1.0.0/framework") && same(split.name,concat(text_repeat("d",90),"/file.neo"))
    }

fn test_archive_matches_tarfile() -> bool
  = let tar=two_members() in
    len(tar)==10240 && same(host_sha256_hex(tar),"7648c84fc0c204a969102868b2d22471577f464fbfe9b115fe109a6d1bff8754")
    && same(host_sha256_hex(rel_tar_finish(text_empty())),"84ff92691f909a05b224e1c56abb4864f01b4f8e3c854e4bb4c7baf1d3f6d652")
    && len(rel_tar_finish(text_repeat("x",9216)))==10240 && len(rel_tar_finish(text_repeat("x",9728)))==20480

fn test_reader_round_trip() -> bool
  = let tar=two_members() in let found=entries_of(tar) in
    len(found)==2 && same(at(found,0).name,"neokit-1.0.0/README.md") && at(found,0).size==5 && at(found,0).mode==420 && at(found,0).offset==512
    && rel_tar_is_file(at(found,0)) && !rel_tar_is_dir(at(found,0))
    && same(text_slice(tar,at(found,0).offset,at(found,0).offset+at(found,0).size),"hello")
    && same(at(found,1).name,long_name()) && at(found,1).size==600 && at(found,1).mode==493 && at(found,1).offset==1536

; tarfile raises ReadError("empty file") for no header at offset 0 and
; "bad checksum" for a damaged first header. A truncated member is
; refused up front (tarfile reports it only when the data is read).
fn test_reader_errors() -> bool
  = let tar=two_members() in
    same(entries_error(text_empty()),"empty file") && same(entries_error(text_repeat("\x00",1024)),"empty file")
    && same(entries_error(damaged(tar)),"bad checksum")
    && same(entries_error(text_slice(tar,0,2000)),"unexpected end of data") && same(entries_error(text_slice(tar,0,1300)),"truncated header")
    && same(entries_error(text_slice(tar,0,200)),"truncated header")
    && same(entries_error(text_slice(tar,0,1024)),"ok")

fn test_gzip_header_is_gzipfile() -> bool
  = match rel_gzip(two_members(),1700000000) {
      Err(message) => false,
      Ok(packed) => same(host_hex(text_slice(packed,0,10)),"1f8b080000f1536502ff")
        && (let back=gzip_decode(packed,1048576) in back.ok && same(back.value,two_members()))
        && (match rel_tar_payload(packed) { Ok(tar) => same(tar,two_members()), Err(message) => false })
    }
    && (match rel_tar_payload("plain") { Ok(tar) => same(tar,"plain"), Err(message) => false })
    && (match rel_tar_payload("\x1f\x8b\x08\x00garbage") { Ok(tar) => false, Err(message) => text_starts(message,"Neo archive is not a valid gzip file: ") })

fn test_member_names_like_unpack_neo() -> bool
  = same(below("neo-0.2.6"),"ok ") && same(below("neo-0.2.6/"),"ok ") && same(below("neo-0.2.6/bin/neoc"),"ok bin/neoc")
    && same(below("./neo-0.2.6//bin/./x"),"ok bin/x")
    && same(below("/neo-0.2.6/x"),"refused") && same(below("neo-0.2.6/../x"),"refused") && same(below("neo-0.2.6/a/.."),"refused")
    && same(below("."),"refused") && same(below(""),"refused") && same(below("neo-0.2.4/x"),"refused") && same(below("neo-0.2.60/x"),"refused")

fn test_source_names_like_copy_sources() -> bool
  = rel_source_wanted(".env.example") && !rel_source_wanted(".env") && !rel_source_wanted(".hidden.neo")
    && rel_source_wanted("a.ts") && rel_source_wanted("a.py") && rel_source_wanted("page.view") && !rel_source_wanted("a.txt")
    && rel_source_wanted("LICENSE") && rel_source_wanted("LICENSE.md") && !rel_source_wanted("LICENSE-MIT")
    && rel_source_wanted("Caddyfile") && rel_source_wanted("Caddyfile.local") && !rel_source_wanted("Makefile") && !rel_source_wanted("noext")

; Python's int(): the cases behind SOURCE_DATE_EPOCH. Beyond i64 the
; value saturates (Python's is exact; both are out of range for an epoch).
; Python also accepts non-ASCII decimal digits; this does not.
fn test_int_like_python() -> bool
  = same(parsed(" 12 "),"12") && same(parsed("+5"),"5") && same(parsed("-0"),"0") && same(parsed("1_000"),"1000")
    && same(parsed("  -7\n"),"-7") && same(parsed("007"),"7") && same(parsed("\t3\x0b"),"3")
    && same(parsed("9223372036854775807"),"9223372036854775807") && same(parsed("9223372036854775808"),"9223372036854775807")
    && same(parsed("1__0"),"invalid literal for int() with base 10: '1__0'") && same(parsed("_1"),"invalid literal for int() with base 10: '_1'")
    && same(parsed("1_"),"invalid literal for int() with base 10: '1_'") && same(parsed("0x10"),"invalid literal for int() with base 10: '0x10'")
    && same(parsed(""),"invalid literal for int() with base 10: ''") && same(parsed("1 2"),"invalid literal for int() with base 10: '1 2'")
    && same(parsed("+"),"invalid literal for int() with base 10: '+'") && same(parsed("-"),"invalid literal for int() with base 10: '-'")

fn test_source_date_epoch() -> bool
  = (match rel_source_date_epoch(push(text_words(),"PATH=/bin")) { Ok(found) => found==0, Err(message) => false })
    && same(epoch("1700000000"),"1700000000") && same(epoch(" 17 "),"17") && same(epoch("4294967295"),"4294967295")
    && same(epoch("4294967296"),"SOURCE_DATE_EPOCH must be between 0 and 4294967295")
    && same(epoch("-1"),"SOURCE_DATE_EPOCH must be between 0 and 4294967295")
    && same(epoch("99999999999999999999"),"SOURCE_DATE_EPOCH must be between 0 and 4294967295")
    && same(epoch("soon"),"invalid literal for int() with base 10: 'soon'")

fn test_manifest_is_json_dumps() -> bool
  = same(rel_manifest_text("1.0.0","0.2.6",arr(i in 0..0) file("","")),
      "{\n  \"format\": 1,\n  \"version\": \"1.0.0\",\n  \"neo_version\": \"0.2.6\",\n  \"files\": {}\n}\n")
    && same(rel_manifest_text("1.0.0","0.2.6",push(push(arr(i in 0..0) file("",""),file("a/\xc3\xa9\"q","d1")),file("b","d2"))),
      "{\n  \"format\": 1,\n  \"version\": \"1.0.0\",\n  \"neo_version\": \"0.2.6\",\n  \"files\": {\n    \"a/\\u00e9\\\"q\": \"d1\",\n    \"b\": \"d2\"\n  }\n}\n")

; sorted(Path) order: "a/x" (parts a, x) before "a.txt".
fn test_sums_in_path_order() -> bool
  = (match rel_sums_text(files3(file("b","d2"),file("a.txt","d3"),file("a/x","d1"))) { Ok(text) => same(text,"d1  a/x\nd3  a.txt\nd2  b\n"), Err(message) => false })
    && (match rel_sums_text(files3(file("b","d2"),file("a\nb","d3"),file("a/x","d1"))) { Ok(text) => false, Err(message) => text_starts(message,"Release file names must not contain") })

fn test_bundle_json() -> bool
  = same(rel_bundle_json(RelBundle { archive="/tmp/x \xc3\xa9", version="1.0.0", sha256="ab" }),
      "{\n  \"archive\": \"/tmp/x \\u00e9\",\n  \"version\": \"1.0.0\",\n  \"sha256\": \"ab\"\n}")
