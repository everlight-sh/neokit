; Unit tests for cli/build.neo's pure helpers: content_type, snapshot_file,
; read_frames, the redirect, CORS and realtime checks and the code they
; generate, and embedded_response for inputs too small to compress. The
; expected values at the end of this file were
; recorded from the Python reference (last present at commit 4757083) and now fixed.
import "std:json"
import "std:result"
import "../cli/build.neo"

fn shown(borrow result:Result<Arr u8 _,Arr u8 _>) -> Arr u8 _ = match result { Ok(value) => value, Err(message) => concat("error: ",message) }
fn flag(value:bool) -> Arr u8 _ = if value then "True" else "False"
fn number(borrow text:Arr u8 _) -> i64 = let parsed=int_parse(text) in if parsed.ok then parsed.value else 0
fn config(borrow text:Arr u8 _) -> Json = match toml_load("web.toml",text) { Ok(value) => value, Err(message) => json_none().value }
fn list_of(borrow text:Arr u8 _) -> Arr Arr u8 _ _ = if len(text)==0 then text_words() else text_split(text,"\x1d")

fn frames_text(borrow output:Arr u8 _, count:i64) -> Arr u8 _
  = match gen_read_frames(output,count) { Ok(frames) => text_join(frames,"\x1d"), Err(message) => concat("error: ",message) }
fn rule_text(borrow rule:GenRedirect) -> Arr u8 _
  = text_join(push(push(push(push(push(push(text_words(),rule.source),rule.target),text_int(rule.status)),flag(rule.query)),flag(rule.absolute)),
      gen_redirect_response(rule)),"\x1d")
fn rules_text(borrow source:Arr u8 _) -> Arr u8 _
  = match gen_redirect_rules(config(source)) {
      Ok(rules) => text_join(arr(i in 0..len(rules)) if i>=0 && i<len(rules) then rule_text(rules[i]) else "","\x1c"),
      Err(message) => concat("error: ",message) }
fn cors_text(borrow source:Arr u8 _, streaming:bool) -> Arr u8 _
  = match gen_cors_options(config(source),"app/api/route.toml",streaming) {
      Ok(cors) => if !cors.present then "None" else
        text_join(push(push(push(push(text_words(),text_join(cors.origins,"\x1c")),text_join(cors.headers,"\x1c")),flag(cors.credentials)),
          gen_cors_function("Cors_x","h(request)",push(push(text_words(),"GET"),"POST"),cors)),"\x1d"),
      Err(message) => concat("error: ",message) }
fn realtime_text(borrow source:Arr u8 _) -> Arr u8 _
  = match gen_realtime_options(config(source)) {
      Ok(r) => concat(text_int(r.channels),"\x1d",text_int(r.history),"\x1d",text_int(r.payload)),
      Err(message) => concat("error: ",message) }

; What the gen_ function behind op gives for the arguments, printed in the
; form of the recorded answers.
fn apply(borrow op:Arr u8 _, borrow a:Arr u8 _, borrow b:Arr u8 _, borrow c:Arr u8 _) -> Arr u8 _
  = if text_equal(op,"content_type") then gen_content_type(a)
    else if text_equal(op,"snapshot") then gen_snapshot_file("/out/snapshots",a)
    else if text_equal(op,"frames") then frames_text(a,number(b))
    else if text_equal(op,"redirects") then rules_text(a)
    else if text_equal(op,"cors") then cors_text(a,text_equal(b,"True"))
    else if text_equal(op,"realtime") then realtime_text(a)
    else if text_equal(op,"embedded") then gen_embedded_response(a,b,c)
    else if text_equal(op,"allowed") then gen_allowed_method(list_of(a))
    else if text_equal(op,"header") then gen_header(a,b,c)
    else if text_equal(op,"bytes_repr") then gen_bytes_repr(a)
    else concat("unknown op ",op)
; The mismatching cases of op, one line each; "" when they all agree.
fn mismatches(borrow op:Arr u8 _) -> Arr u8 _
  = let cases=text_split(build_cases(),"\x1e") in
    loop (out=text_empty(), i=0) while i<len(cases)
      next (let r=text_split(text_word(cases,i),"\x1f") in
            if !text_equal(text_word(r,0),op) then out else
            let got=apply(text_word(r,0),text_word(r,1),text_word(r,2),text_word(r,3)) in
            if text_equal(got,text_word(r,4)) then out
            else concat(out,"FAIL ",op,"(",text_repr(text_word(r,1)),", ",text_repr(text_word(r,2)),"): ",text_repr(got)," != ",text_repr(text_word(r,4)),"\n"), i+1) yield out
fn case_count(borrow op:Arr u8 _) -> i64
  = let cases=text_split(build_cases(),"\x1e") in
    loop (count=0, i=0) while i<len(cases) next (if text_starts(text_word(cases,i),concat(op,"\x1f")) then count+1 else count, i+1) yield count
fn agrees(borrow op:Arr u8 _) -> bool = case_count(op)>0 && len(mismatches(op))==0

fn test_content_type_table() -> bool = agrees("content_type")
fn test_snapshot_file() -> bool = agrees("snapshot")
fn test_read_frames() -> bool = agrees("frames")
fn test_redirect_rules_and_responses() -> bool = agrees("redirects")
fn test_cors_options_and_wrapper() -> bool = agrees("cors")
fn test_realtime_options() -> bool = agrees("realtime")
fn test_embedded_response() -> bool = agrees("embedded") && agrees("allowed") && agrees("header")
fn test_bytes_repr() -> bool = agrees("bytes_repr")
fn test_origins_and_targets() -> bool
  = gen_origin("https://a.test") && gen_origin("http://a.test:8080") && !gen_origin("https://a.test/") && !gen_origin("https://a.test:")
    && !gen_origin("https://a.test:123456") && gen_origin("https://a.test:\xd9\xa1") && !gen_origin("https://") && !gen_origin("ftp://a.test")
    && gen_absolute_url("https://a.test/x?y") && !gen_absolute_url("https://a.test/caf\xc3\xa9") && gen_relative_url("/")
    && !gen_relative_url("//x") && !gen_relative_url("/a\\b") && !gen_relative_url("a")
fn test_snapshot_and_dev_layout() -> bool
  = text_equal(gen_dev_layout("<html><head></head><body></body></html>"),
      "<html><head><link rel=\"stylesheet\" href=\"/_web/neokit-dev.css\"></head><body><script type=\"module\" src=\"/_web/neokit-dev.js\"></script></body></html>")
    && text_equal(gen_dev_layout("</body><p>"),"</body><p>")

; ---- BEGIN GENERATED CASES: recorded from the Python reference (last present at commit 4757083) and now fixed; do not edit by hand.
; The cases: "op\x1fa\x1fb\x1fc\x1fexpected" records separated by \x1e.
