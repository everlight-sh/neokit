DOMAIN=tasks.example.com
# Worker threads; match the CPUs given to the container.
NEO_THREADS=2
NEOKIT_ADMIN_USER=admin
# Generate a unique random secret, at least 32 bytes. Never reuse across apps.
NEOKIT_SESSION_SECRET=
# Run ./neokit password in the project root. The value is a salted PBKDF2 hash.
NEOKIT_ADMIN_PASSWORD_HASH=
# Optional: a random secret of at least 32 bytes enables stale-page
# revalidation and forced refreshes through the X-NeoKit-Revalidate header.
NEOKIT_REVALIDATE_TOKEN=
# Optional container memory limit.
NEOKIT_MEMORY_LIMIT=1g
# Private subnet shared by the proxy and the app; the app trusts it for
# X-Forwarded-For. Change it only if it overlaps an existing host network.
NEOKIT_NETWORK=172.30.94.0/24
