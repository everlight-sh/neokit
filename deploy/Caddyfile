{
  grace_period 30s
}
{$DOMAIN} {
  header {
    Strict-Transport-Security "max-age=31536000"
    Referrer-Policy strict-origin-when-cross-origin
    -Server
  }
  # Neo serves precompressed static assets; Caddy compresses rendered pages.
  encode zstd gzip
  request_body {
    max_size 16MB
  }
  reverse_proxy app:8094
}
